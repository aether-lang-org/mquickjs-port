// genengine — the stdlib / atom-table generator, in Aether.
//
// First slice: the atom-defines path (`tool -a` -> mquickjs_atom.h). It
// holds the predefined `atoms[]` strings, builds an AtomList with the
// shared bt_atomlist helpers, and prints `#define JS_ATOM_<name> <off>`.
// The output must stay byte-identical to the former C dump_atom_defines:
// the engine hardcodes these atom offsets.
//
// The stdlib-table path (the class/cfunc walker) remains in
// mquickjs_build.c for now and is ported incrementally into this module.

import std.mem
import std.list

// AtomList helpers (gen/buildtool/bt_atomlist.ae) operating on the
// AtomList overlay (AL_TAB@0, AL_COUNT@8, AL_SIZE@12, AL_OFFSET@16) and
// AtomDef records (AD_STR@0, AD_OFFSET@8, stride 16).
extern add_atom(s: ptr, str: ptr) -> int
extern find_atom(s: ptr, str: ptr) -> int

extern printf(fmt: ptr, ...) -> int
extern fprintf(stream: ptr, fmt: ptr, ...) -> int
extern stderr_ptr() -> ptr
extern exit(code: int)
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern memset(p: ptr, c: int, n: long) -> ptr
extern strlen(s: ptr) -> long
extern strcpy(dst: ptr, src: ptr) -> ptr
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern bt_get_jsw() -> int
extern bt_set_jsw(w: int)
extern is_short_int(d: float) -> int
extern add_cfunc(s: ptr, name: ptr, length: int, magic: ptr, cproto_name: ptr, cfunc_name: ptr) -> int
extern strdup(s: ptr) -> ptr
extern qsort(base: ptr, nmemb: long, size: long, cmp: ptr)
extern atom_cmp(p1: ptr, p2: ptr) -> int
extern is_ascii_string(buf: ptr, len: int) -> int
extern is_numeric_string(buf: ptr, len: int) -> int

exports (dump_atom_defines, ge_dump_atom, dump_cfuncs, dump_cfinalizers)

// BuildContext layout (probed): atom_list@0 (AtomList, 24B),
// cfunc_list@24 (CFuncList: tab@24, count@32, size@36), cur_offset@40.
// CFuncDef stride 40: name@0, length@8, magic@16, cproto_name@24,
// cfunc_name@32. AtomList: tab@0, count@8, size@12, offset@16.
const BC_ATOM_LIST = 0
const BC_CFUNC_TAB = 24
const BC_CFUNC_COUNT = 32
const CFD_STRIDE = 40
const CFD_NAME = 0
const CFD_LENGTH = 8
const CFD_MAGIC = 16
const CFD_CPROTO = 24
const CFD_CFUNC = 32
const AL_TAB2 = 0
const AL_OFFSET2 = 16
const AD_STRIDE2 = 16
const AD_OFFSET2 = 8
const BC_CUR_OFFSET = 40
const BC_SORTED_OFF = 44
const BC_CLASS_LIST = 56
const CDE_FINALIZER = 32
const CDE_CLASS_ID = 40
const CDE_CLASS1 = 16
const PD_NAME = 8
const PD_U = 16
const PD_GETSET_GET = 32
const PD_GETSET_SET = 40
const PD_STRIDE = 48
const CD_FUNC_NAME = 24
const CD_CLASS_PROPS = 40
const CD_PROTO_PROPS = 48
const CD_PARENT = 56
const JS_DEF_END = 0
const JS_DEF_CGETSET = 2
const JS_DEF_PROP_STRING = 5
const JS_DEF_CLASS = 7
const PROPS_KIND_PROTO = 1
const PROPS_KIND_CLASS = 2
const PROPS_KIND_OBJECT = 3
const JS_DEF_PROP_DOUBLE = 3
const BC_CFUNC_LIST = 24
const GS_MAGIC = 16
const GS_CPROTO = 24
const CD_LENGTH = 8
const CD_CPROTO = 16
const CD_CLASS_ID = 32
const CD_FINALIZER = 64
const CDE_CLASS_IDX = 24
const JS_DEF_CFUNC = 1
const JS_DEF_PROP_UNDEFINED = 4
const JS_DEF_PROP_NULL = 6
const FUNC_LENGTH = 16
const FUNC_MAGIC = 24
const FUNC_CPROTO = 32
const FUNC_FUNC = 40
const PROPS_KIND_GLOBAL = 0
const BC_GLOBAL_OFF = 48

// Predefined atoms. Order matters — it fixes every JS_ATOM_* value.
const ATOM_COUNT = 73

// The atom strings, one per line, '\n'-joined in a single blob so the
// table is a compact constant. ge_atom(i) returns a malloc'd C string of
// the i-th atom; the order mirrors mquickjs_build.c's atoms[].
ge_atoms_blob() -> ptr {
    return "null\nfalse\ntrue\nif\nelse\nreturn\nvar\nthis\ndelete\nvoid\ntypeof\nnew\nin\ninstanceof\ndo\nwhile\nfor\nbreak\ncontinue\nswitch\ncase\ndefault\nthrow\ntry\ncatch\nfinally\nfunction\ndebugger\nwith\nclass\nconst\nenum\nexport\nextends\nimport\nsuper\nimplements\ninterface\nlet\npackage\nprivate\nprotected\npublic\nstatic\nyield\n\ntoString\nvalueOf\nnumber\nobject\nundefined\nstring\nboolean\n<ret>\n<eval>\neval\narguments\nvalue\nget\nset\nprototype\nconstructor\nlength\ntarget\nof\nNaN\nInfinity\n-Infinity\nname\nError\n__proto__\nindex\ninput"
}

// cvt_name: sanitize an atom string for the C #define. Empty -> "empty";
// '<' '>' '-' -> '_'. Writes into buf (caller-owned, >=256 bytes).
ge_cvt_name(buf: ptr, str: ptr) -> ptr {
    long len = strlen(str)
    if len == 0 {
        strcpy(buf, "empty")
        return buf
    }
    strcpy(buf, str)
    long i = 0
    while i < len {
        bp = mem.long_to_ptr(mem.ptr_to_long(buf) + i)
        int c = mem.get_byte(bp, 0)
        if c == 60 { mem.set_byte(bp, 0, 95) }        // '<' -> '_'
        else if c == 62 { mem.set_byte(bp, 0, 95) }   // '>' -> '_'
        else if c == 45 { mem.set_byte(bp, 0, 95) }   // '-' -> '_'
        i = i + 1
    }
    return buf
}

// Split the '\n'-joined blob into the i-th atom, malloc'd + NUL-terminated.
// (A blank line — the empty atom — yields a zero-length string.)
ge_nth_atom(blob: ptr, idx: int) -> ptr {
    long p = mem.ptr_to_long(blob)
    int cur = 0
    long start = p
    while cur < idx {
        int c = mem.get_byte(mem.long_to_ptr(p), 0)
        if c == 0 { break }
        if c == 10 { cur = cur + 1  start = p + 1 }
        p = p + 1
    }
    // measure from start to next '\n' or NUL
    long e = start
    int ec = mem.get_byte(mem.long_to_ptr(e), 0)
    while ec != 0 && ec != 10 {
        e = e + 1
        ec = mem.get_byte(mem.long_to_ptr(e), 0)
    }
    long n = e - start
    out = malloc(n + 1)
    mem.copy(out, mem.long_to_ptr(start), n)
    int ni = n
    mem.set_byte(out, ni, 0)
    return out
}

// void dump_atom_defines(void): emit mquickjs_atom.h's #define block.
dump_atom_defines() {
    // AtomList is { AtomDef *tab; int count, size; int offset } — 24 bytes,
    // memset to zero so add_atom lazily allocates tab.
    s = malloc(24)
    memset(s, 0, 24)
    blob = ge_atoms_blob()
    int i = 0
    while i < ATOM_COUNT {
        a = ge_nth_atom(blob, i)
        add_atom(s, a)
        free(a)
        i = i + 1
    }
    // print the defines
    buf = malloc(256)
    long tab = mem.ptr_to_long(mem.get_ptr(s, 0))
    int count = mem.get_int(s, 8)
    i = 0
    while i < count {
        long e = tab + i * 16
        strp = mem.get_ptr(mem.long_to_ptr(e), 0)
        int off = mem.get_int(mem.long_to_ptr(e), 8)
        ge_cvt_name(buf, strp)
        printf("#define JS_ATOM_%s %d\n", buf, off)
        i = i + 1
    }
    printf("\n")
    int total_off = mem.get_int(s, 16)
    printf("#define JS_ATOM_END %d\n", total_off)
    printf("\n")
    free(buf)
    free(s)
}

// uint32_t ge_dump_atom(BuildContext *s, const char *str, BOOL value_only):
// emit (or return) the ROM encoding of an atom. 1-char names become a
// STRING_CHAR special; longer names index the atom table. Mirrors the C
// dump_atom exactly so the stdlib table is byte-identical.
ge_dump_atom(s: ptr, str: ptr, value_only: int) -> int {
    int len = strlen(str)
    int i = 0
    while i < len {
        int c = mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(str) + i), 0) & 0xff
        if c >= 128 {
            fprintf(stderr_ptr(), "unicode property names are not supported yet (%s)\n", str)
            exit(1)
        }
        i = i + 1
    }
    if len >= 1 {
        int c0 = mem.get_byte(str, 0) & 0xff
        if c0 >= 48 && c0 <= 57 {
            fprintf(stderr_ptr(), "numeric property names are not supported yet (%s)\n", str)
            exit(1)
        }
    }
    if len == 1 {
        int c0 = mem.get_byte(str, 0) & 0xff
        if value_only != 0 {
            return (c0 << 5) | 0x1b          // hardcoded STRING_CHAR special
        }
        printf("JS_VALUE_MAKE_SPECIAL(JS_TAG_STRING_CHAR, %d)", c0)
    } else {
        al = mem.long_to_ptr(mem.ptr_to_long(s) + BC_ATOM_LIST)
        int idx = find_atom(al, str)
        if idx < 0 {
            fprintf(stderr_ptr(), "atom '%s' is undefined\n", str)
            exit(1)
        }
        long tab = mem.ptr_to_long(mem.get_ptr(al, AL_TAB2))
        int offset = mem.get_int(mem.long_to_ptr(tab + idx * AD_STRIDE2), AD_OFFSET2)
        if value_only != 0 {
            return (offset * bt_get_jsw()) + 1
        }
        printf("JS_ROM_VALUE(%d)", offset)
    }
    printf(" /* %s */", str)
    return 0
}

// void dump_cfuncs(BuildContext *s): emit the js_c_function_table[].
dump_cfuncs(s: ptr) {
    printf("static const JSCFunctionDef js_c_function_table[] = {\n")
    int count = mem.get_int(s, BC_CFUNC_COUNT)
    long tab = mem.ptr_to_long(mem.get_ptr(s, BC_CFUNC_TAB))
    int i = 0
    while i < count {
        long e = tab + i * CFD_STRIDE
        cproto = mem.get_ptr(mem.long_to_ptr(e), CFD_CPROTO)
        cfunc = mem.get_ptr(mem.long_to_ptr(e), CFD_CFUNC)
        name = mem.get_ptr(mem.long_to_ptr(e), CFD_NAME)
        int length = mem.get_int(mem.long_to_ptr(e), CFD_LENGTH)
        magic = mem.get_ptr(mem.long_to_ptr(e), CFD_MAGIC)
        printf("  { { .%s = %s },\n", cproto, cfunc)
        printf("    ")
        ge_dump_atom(s, name, 0)
        printf(",\n")
        printf("    JS_CFUNC_%s, %d, %s },\n", cproto, length, magic)
        i = i + 1
    }
    printf("};\n\n")
}

// void dump_cfinalizers(BuildContext *s): emit the per-class finalizer
// table. Walks the intrusive class_list (list_head{prev@0,next@8} at
// BC+56); each ClassDefEntry has link@0, class_id@40, finalizer_name@32.
dump_cfinalizers(s: ptr) {
    printf("static const JSCFinalizer js_c_finalizer_table[JS_CLASS_COUNT - JS_CLASS_USER] = {\n")
    long head = mem.ptr_to_long(s) + BC_CLASS_LIST
    long el = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(head), 8))   // head->next
    while el != head {
        // list_entry: link is at offset 0, so entry == el
        fin = mem.get_ptr(mem.long_to_ptr(el), CDE_FINALIZER)
        if mem.ptr_to_long(fin) != 0 {
            if ge_strcmp(fin, "NULL") != 0 {
                class_id = mem.get_ptr(mem.long_to_ptr(el), CDE_CLASS_ID)
                printf("  [%s - JS_CLASS_USER] = %s,\n", class_id, fin)
            }
        }
        el = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(el), 8))      // el->next
    }
    printf("};\n\n")
}

ge_strcmp(a: ptr, b: ptr) -> int {
    long pa = mem.ptr_to_long(a)
    long pb = mem.ptr_to_long(b)
    while 1 == 1 {
        int ca = mem.get_byte(mem.long_to_ptr(pa), 0) & 0xff
        int cb = mem.get_byte(mem.long_to_ptr(pb), 0) & 0xff
        if ca != cb { return ca - cb }
        if ca == 0 { return 0 }
        pa = pa + 1
        pb = pb + 1
    }
    return 0
}

// void dump_atoms(BuildContext *ctx): emit js_stdlib_table[] atom data
// (header word + packed UTF-8 bytes per atom) then the sorted atom table.
// Accumulates ctx->cur_offset by (len1 + 1) per atom exactly like the C.
dump_atoms(ctx: ptr) {
    al = mem.long_to_ptr(mem.ptr_to_long(ctx) + BC_ATOM_LIST)
    int count = mem.get_int(al, 8)               // AL_COUNT
    long tab = mem.ptr_to_long(mem.get_ptr(al, AL_TAB2))
    int jsw = bt_get_jsw()

    long bytes = count * AD_STRIDE2
    sorted = malloc(bytes)
    mem.copy(sorted, mem.long_to_ptr(tab), bytes)
    cmp = atom_cmp as fn(ptr, ptr) -> int
    qsort(sorted, count, AD_STRIDE2, cmp)

    int cur = mem.get_int(ctx, BC_CUR_OFFSET)
    printf("  /* atom_table */\n")
    int i = 0
    while i < count {
        strp = mem.get_ptr(mem.long_to_ptr(tab + i * AD_STRIDE2), 0)
        int len = strlen(strp)
        int is_ascii = is_ascii_string(strp, len)
        int is_numeric = is_numeric_string(strp, len)
        printf("  (JS_MTAG_STRING << 1) | (1 << JS_MTAG_BITS) | (%d << (JS_MTAG_BITS + 1)) | (%d << (JS_MTAG_BITS + 2)) | (%d << (JS_MTAG_BITS + 3)), /* \"%s\" (offset=%d) */\n", is_ascii, is_numeric, len, strp, cur)
        int len1 = (len + jsw) / jsw
        int j = 0
        while j < len1 {
            int rem = len - j * jsw
            int l = jsw
            if rem < l { l = rem }
            long v = 0
            int k = 0
            while k < l {
                int b = mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(strp) + j * jsw + k), 0) & 0xff
                long bl = b
                v = v | (bl << (k * 8))
                k = k + 1
            }
            ge_print_hexword(v, jsw * 2)
            j = j + 1
        }
        cur = cur + len1 + 1
        i = i + 1
    }
    printf("\n")

    mem.set_int(ctx, BC_SORTED_OFF, cur)
    printf("  /* sorted atom table (offset=%d) */\n", cur)
    printf("  JS_VALUE_ARRAY_HEADER(%d),\n", count)
    buf = malloc(256)
    i = 0
    while i < count {
        long e = mem.ptr_to_long(sorted) + i * AD_STRIDE2
        int eoff = mem.get_int(mem.long_to_ptr(e), AD_OFFSET2)
        es = mem.get_ptr(mem.long_to_ptr(e), 0)
        ge_cvt_name(buf, es)
        printf("  JS_ROM_VALUE(%d), /* %s */\n", eoff, buf)
        i = i + 1
    }
    free(buf)
    printf("\n")
    cur = cur + count + 1
    mem.set_int(ctx, BC_CUR_OFFSET, cur)
    free(sorted)
}

// Print "  0x<width-digit zero-padded hex>,\n".
ge_print_hexword(v: long, width: int) {
    hexbuf = malloc(40)
    mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(hexbuf) + 39), 0, 0)
    int pos = 38
    long uv = v
    int digits = 0
    int done = 0
    if uv == 0 {
        mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(hexbuf) + pos), 0, 48)
        pos = pos - 1
        digits = 1
        done = 1
    }
    while done == 0 {
        int d = uv & 15
        int ch = 48 + d
        if d >= 10 { ch = 97 + (d - 10) }
        mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(hexbuf) + pos), 0, ch)
        pos = pos - 1
        digits = digits + 1
        uv = (uv >> 4) & 0x0fffffffffffffff
        if uv == 0 { done = 1 }
    }
    while digits < width {
        mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(hexbuf) + pos), 0, 48)
        pos = pos - 1
        digits = digits + 1
    }
    start = mem.long_to_ptr(mem.ptr_to_long(hexbuf) + pos + 1)
    printf("  0x%s,\n", start)
    free(hexbuf)
}

// ---- atoms pass (first walk): register every property/atom name ----
// JSPropDef stride 48: def_type@0, name@8, u@16 (str/class1@16,
// getset.get@32, getset.set@40). JSClassDef stride 72: name@0,
// func_name@24, class_props@40, proto_props@48, parent@56.
// JS_DEF: END=0 CFUNC=1 CGETSET=2 PROP_DOUBLE=3 PROP_STRING=5 CLASS=7.

// build "get NAME" / "set NAME" into a malloc'd string (prefix is "get "/"set ").
ge_prefixed(prefix: ptr, name: ptr) -> ptr {
    long pl = strlen(prefix)
    long nl = strlen(name)
    out = malloc(pl + nl + 1)
    memcpy(out, prefix, pl)
    memcpy(mem.long_to_ptr(mem.ptr_to_long(out) + pl), name, nl)
    int total = pl + nl
    mem.set_byte(out, total, 0)
    return out
}

// ClassDefEntry *find_class(s, const JSClassDef *d): walk class_list for d.
ge_find_class(s: ptr, d: ptr) -> ptr {
    long head = mem.ptr_to_long(s) + BC_CLASS_LIST
    long el = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(head), 8))
    while el != head {
        c1 = mem.get_ptr(mem.long_to_ptr(el), CDE_CLASS1)
        if mem.ptr_to_long(c1) == mem.ptr_to_long(d) { return mem.long_to_ptr(el) }
        el = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(el), 8))
    }
    return mem.long_to_ptr(0)
}

// void define_atoms_props(BuildContext *s, const JSPropDef *props_def, kind)
define_atoms_props(s: ptr, props_def: ptr, props_kind: int) {
    al = mem.long_to_ptr(mem.ptr_to_long(s) + BC_ATOM_LIST)
    long d = mem.ptr_to_long(props_def)
    while mem.get_int(mem.long_to_ptr(d), 0) != JS_DEF_END {
        name = mem.get_ptr(mem.long_to_ptr(d), PD_NAME)
        add_atom(al, name)
        int dt = mem.get_int(mem.long_to_ptr(d), 0)
        if dt == JS_DEF_PROP_STRING {
            str = mem.get_ptr(mem.long_to_ptr(d), PD_U)
            add_atom(al, str)
        } else if dt == JS_DEF_CLASS {
            cl = mem.get_ptr(mem.long_to_ptr(d), PD_U)
            define_atoms_class(s, cl)
        } else if dt == JS_DEF_CGETSET {
            getn = mem.get_ptr(mem.long_to_ptr(d), PD_GETSET_GET)
            setn = mem.get_ptr(mem.long_to_ptr(d), PD_GETSET_SET)
            if ge_strcmp(getn, "NULL") != 0 {
                gp = ge_prefixed("get ", name)
                add_atom(al, gp)
                free(gp)
            }
            if ge_strcmp(setn, "NULL") != 0 {
                sp = ge_prefixed("set ", name)
                add_atom(al, sp)
                free(sp)
            }
        }
        d = d + PD_STRIDE
    }
}

// void define_atoms_class(BuildContext *s, const JSClassDef *d)
define_atoms_class(s: ptr, d: ptr) {
    e = ge_find_class(s, d)
    if mem.ptr_to_long(e) != 0 { return }
    // NOTE: the C version records the class via find_class's side-effect in
    // define_class; in the atoms pass find_class is read-only, so a class
    // can be revisited — matching the C (no dedup here beyond find_class).
    parent = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), CD_PARENT)
    if mem.ptr_to_long(parent) != 0 { define_atoms_class(s, parent) }
    fname = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), CD_FUNC_NAME)
    al = mem.long_to_ptr(mem.ptr_to_long(s) + BC_ATOM_LIST)
    if mem.ptr_to_long(fname) != 0 {
        cname = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), 0)
        add_atom(al, cname)
    }
    cprops = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), CD_CLASS_PROPS)
    if mem.ptr_to_long(cprops) != 0 {
        int kind = PROPS_KIND_OBJECT
        if mem.ptr_to_long(fname) != 0 { kind = PROPS_KIND_CLASS }
        define_atoms_props(s, cprops, kind)
    }
    pprops = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), CD_PROTO_PROPS)
    if mem.ptr_to_long(pprops) != 0 {
        define_atoms_props(s, pprops, PROPS_KIND_PROTO)
    }
}

// ---- value pass: define_value (per-prop ROM value emitter) ----
// Emits a float64 / getset / class value and returns its offset (ident),
// or -1 for inline-able defs. Mirrors the C define_value byte-for-byte.
// JS_DEF_PROP_DOUBLE=3. getset union: magic@16, cproto@24, get@32, set@40.
define_value(s: ptr, d: ptr) -> int {
    int ident = 0 - 1
    int dt = mem.get_int(mem.long_to_ptr(mem.ptr_to_long(d)), 0)
    if dt == JS_DEF_PROP_DOUBLE {
        float dv = mem.get_float64(mem.long_to_ptr(mem.ptr_to_long(d)), PD_U)
        if is_short_int(dv) == 0 {
            int cur = mem.get_int(s, BC_CUR_OFFSET)
            ident = cur
            printf("  /* float64 (offset=%d) */\n", ident)
            printf("  JS_MB_HEADER_DEF(JS_MTAG_FLOAT64),\n")
            long v = mem.get_long(mem.long_to_ptr(mem.ptr_to_long(d)), PD_U)   // float64 bits
            int jsw = bt_get_jsw()
            if jsw == 8 {
                ge_print_hexword(v, 16)
                printf("\n")
                mem.set_int(s, BC_CUR_OFFSET, cur + 2)
            } else {
                long lo = v & 0xffffffff
                long hi = (v >> 32) & 0xffffffff
                ge_print_hexword(lo, 8)
                ge_print_hexword(hi, 8)
                printf("\n")
                mem.set_int(s, BC_CUR_OFFSET, cur + 3)
            }
        }
    } else if dt == JS_DEF_CLASS {
        cl = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_U)
        ident = define_class(s, cl)
    } else if dt == JS_DEF_CGETSET {
        cflist = mem.long_to_ptr(mem.ptr_to_long(s) + BC_CFUNC_LIST)
        name = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_NAME)
        magic = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), GS_MAGIC)
        cproto = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), GS_CPROTO)
        getn = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_GETSET_GET)
        setn = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_GETSET_SET)
        int get_idx = 0 - 1
        int set_idx = 0 - 1
        if ge_strcmp(getn, "NULL") != 0 {
            gp = ge_prefixed("get ", name)
            get_idx = add_cfunc(cflist, gp, 0, magic, cproto, getn)
            free(gp)
        }
        if ge_strcmp(setn, "NULL") != 0 {
            sp = ge_prefixed("set ", name)
            set_idx = add_cfunc(cflist, sp, 1, magic, cproto, setn)
            free(sp)
        }
        int cur = mem.get_int(s, BC_CUR_OFFSET)
        ident = cur
        printf("  /* getset (offset=%d) */\n", ident)
        printf("  JS_VALUE_ARRAY_HEADER(2),\n")
        if get_idx >= 0 { printf("  JS_VALUE_MAKE_SPECIAL(JS_TAG_SHORT_FUNC, %d),\n", get_idx) }
        else { printf("  JS_UNDEFINED,\n") }
        if set_idx >= 0 { printf("  JS_VALUE_MAKE_SPECIAL(JS_TAG_SHORT_FUNC, %d),\n", set_idx) }
        else { printf("  JS_UNDEFINED,\n") }
        printf("\n")
        mem.set_int(s, BC_CUR_OFFSET, cur + 3)
    }
    return ident
}

// ---- value pass: define_class (emit a class ROM entry) ----
// Records a ClassDefEntry into class_list (intrusive list, link@0). Calls
// define_props (still C) for class/proto/object props. Mirrors C exactly.
// JSClassDef: name@0 length@8 cproto@16 func_name@24 class_id@32
// class_props@40 proto_props@48 parent@56 finalizer@64.
define_class(s: ptr, d: ptr) -> int {
    e = ge_find_class(s, d)
    if mem.ptr_to_long(e) != 0 { return mem.get_int(mem.long_to_ptr(mem.ptr_to_long(e)), CDE_CLASS_IDX) }

    long dl = mem.ptr_to_long(d)
    int parent_class_idx = 0 - 1
    parent = mem.get_ptr(mem.long_to_ptr(dl), CD_PARENT)
    if mem.ptr_to_long(parent) != 0 { parent_class_idx = define_class(s, parent) }

    int ctor_func_idx = 0 - 1
    fname = mem.get_ptr(mem.long_to_ptr(dl), CD_FUNC_NAME)
    cflist = mem.long_to_ptr(mem.ptr_to_long(s) + BC_CFUNC_LIST)
    if mem.ptr_to_long(fname) != 0 {
        cname = mem.get_ptr(mem.long_to_ptr(dl), 0)
        int clen = mem.get_int(mem.long_to_ptr(dl), CD_LENGTH)
        cid = mem.get_ptr(mem.long_to_ptr(dl), CD_CLASS_ID)
        cproto = mem.get_ptr(mem.long_to_ptr(dl), CD_CPROTO)
        ctor_func_idx = add_cfunc(cflist, cname, clen, cid, cproto, fname)
    }

    cprops = mem.get_ptr(mem.long_to_ptr(dl), CD_CLASS_PROPS)
    pprops = mem.get_ptr(mem.long_to_ptr(dl), CD_PROTO_PROPS)
    cid2 = mem.get_ptr(mem.long_to_ptr(dl), CD_CLASS_ID)
    int class_props_idx = 0 - 1
    int proto_props_idx = 0 - 1
    if ctor_func_idx >= 0 {
        class_props_idx = define_props(s, cprops, PROPS_KIND_CLASS, cid2)
        proto_props_idx = define_props(s, pprops, PROPS_KIND_PROTO, cid2)
    } else {
        if mem.ptr_to_long(cprops) != 0 {
            class_props_idx = define_props(s, cprops, PROPS_KIND_OBJECT, cid2)
        }
    }

    int ident = mem.get_int(s, BC_CUR_OFFSET)
    printf("  /* class (offset=%d) */\n", ident)
    printf("  JS_MB_HEADER_DEF(JS_MTAG_OBJECT),\n")
    if class_props_idx >= 0 { printf("  JS_ROM_VALUE(%d),\n", class_props_idx) }
    else { printf("  JS_NULL,\n") }
    printf("  %d,\n", ctor_func_idx)
    if proto_props_idx >= 0 { printf("  JS_ROM_VALUE(%d),\n", proto_props_idx) }
    else { printf("  JS_NULL,\n") }
    if parent_class_idx >= 0 { printf("  JS_ROM_VALUE(%d),\n", parent_class_idx) }
    else { printf("  JS_NULL,\n") }
    printf("\n")
    mem.set_int(s, BC_CUR_OFFSET, ident + 5)

    // ClassDefEntry: link@0(16), class1@16, class_idx@24, finalizer@32, class_id@40 (48 bytes)
    ent = malloc(48)
    memset(ent, 0, 48)
    mem.set_int(ent, CDE_CLASS_IDX, ident)
    mem.set_ptr(ent, CDE_CLASS1, d)
    if ctor_func_idx >= 0 {
        cid3 = mem.get_ptr(mem.long_to_ptr(dl), CD_CLASS_ID)
        fin = mem.get_ptr(mem.long_to_ptr(dl), CD_FINALIZER)
        mem.set_ptr(ent, CDE_CLASS_ID, strdup(cid3))
        mem.set_ptr(ent, CDE_FINALIZER, strdup(fin))
    }
    ge_list_add_tail(ent, mem.ptr_to_long(s) + BC_CLASS_LIST)
    return ident
}

// list_add_tail(new, head): insert new before head (at the tail).
// list_head{prev@0, next@8}.
ge_list_add_tail(newp: ptr, head: long) {
    long pnew = mem.ptr_to_long(newp)
    long prev = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(head), 0))   // head->prev
    mem.set_ptr(mem.long_to_ptr(pnew), 0, mem.long_to_ptr(prev))         // new->prev = prev
    mem.set_ptr(mem.long_to_ptr(pnew), 8, mem.long_to_ptr(head))         // new->next = head
    mem.set_ptr(mem.long_to_ptr(prev), 8, newp)                          // prev->next = new
    mem.set_ptr(mem.long_to_ptr(head), 0, newp)                          // head->prev = new
}

// ge_clz32(a): count leading zeros of a 32-bit value (a != 0).
ge_clz32(a: int) -> int {
    long ua = a & 0xffffffff
    int n = 0
    int bit = 31
    int done = 0
    while done == 0 {
        if (ua & (1 << bit)) != 0 { done = 1 }
        else { n = n + 1  bit = bit - 1  if bit < 0 { done = 1 } }
    }
    return n
}

// hash_prop(s, name): the property hash, must match the engine. Uses
// ge_dump_atom value_only to get the atom's ROM word, then (p/JSW)^(p%JSW).
ge_hash_prop(s: ptr, name: ptr) -> int {
    int prop = ge_dump_atom(s, name, 1)
    long up = prop & 0xffffffff
    int jsw = bt_get_jsw()
    long q = up / jsw
    long r = up % jsw
    return (q ^ r) & 0xffffffff
}

// the property-name for slot i: the def's name, or the synthetic
// "constructor"/"prototype" for the trailing PROTO/CLASS slot.
ge_prop_name(d: ptr, props_kind: int) -> ptr {
    int dt = mem.get_int(mem.long_to_ptr(mem.ptr_to_long(d)), 0)
    if dt != JS_DEF_END { return mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_NAME) }
    if props_kind == PROPS_KIND_PROTO { return "constructor" }
    return "prototype"
}

// int define_props(BuildContext *s, const JSPropDef *props_def, kind, class_id_str)
define_props(s: ptr, props_def: ptr, props_kind: int, class_id_str: ptr) -> int {
    int is_global = 0
    if props_kind == PROPS_KIND_GLOBAL { is_global = 1 }
    long pd = mem.ptr_to_long(props_def)
    if pd == 0 {
        // dummy_props = { JS_DEF_END }; use a heap stub
        stub = malloc(PD_STRIDE)
        memset(stub, 0, PD_STRIDE)
        mem.set_int(stub, 0, JS_DEF_END)
        pd = mem.ptr_to_long(stub)
    }
    // count props
    int n_props = 0
    long dd = pd
    while mem.get_int(mem.long_to_ptr(dd), 0) != JS_DEF_END {
        n_props = n_props + 1
        dd = dd + PD_STRIDE
    }
    if props_kind == PROPS_KIND_PROTO || props_kind == PROPS_KIND_CLASS { n_props = n_props + 1 }

    // ident_tab[i] = define_value(s, &props[i]) for the real props
    ident_tab = malloc(n_props * 4)
    int i = 0
    dd = pd
    while mem.get_int(mem.long_to_ptr(dd), 0) != JS_DEF_END {
        int iv = define_value(s, mem.long_to_ptr(dd))
        mem.set_int(ident_tab, i * 4, iv)
        i = i + 1
        dd = dd + PD_STRIDE
    }

    int props_ident = 0 - 1
    prop_hash = mem.long_to_ptr(0)
    int hash_size = 0
    if is_global != 0 {
        int cur = mem.get_int(s, BC_CUR_OFFSET)
        props_ident = cur
        printf("  /* global object properties (offset=%d) */\n", props_ident)
        printf("  JS_VALUE_ARRAY_HEADER(%d),\n", 2 * n_props)
        mem.set_int(s, BC_CUR_OFFSET, cur + 2 * n_props + 1)
    } else {
        int hash_size_log2 = 0
        if n_props > 1 { hash_size_log2 = (32 - ge_clz32(n_props - 1)) - 1 }
        hash_size = 1 << hash_size_log2
        int jsw = bt_get_jsw()
        int cap = 64 / jsw                  // ATOM_ALIGN / JSW
        if hash_size > cap { hash_size = cap }
        int hash_mask = hash_size - 1
        hash_table = malloc(hash_size * 4)
        prop_hash = malloc(n_props * 4)
        i = 0
        while i < hash_size { mem.set_int(hash_table, i * 4, 0)  i = i + 1 }
        int prop_idx = 0
        i = 0
        dd = pd
        while i < n_props {
            nm = ge_prop_name(mem.long_to_ptr(dd), props_kind)
            int h = ge_hash_prop(s, nm) & hash_mask
            mem.set_int(prop_hash, prop_idx * 4, mem.get_int(hash_table, h * 4))
            mem.set_int(hash_table, h * 4, 2 + hash_size + 3 * prop_idx)
            prop_idx = prop_idx + 1
            i = i + 1
            dd = dd + PD_STRIDE
        }
        int cur = mem.get_int(s, BC_CUR_OFFSET)
        props_ident = cur
        printf("  /* properties (offset=%d) */\n", props_ident)
        printf("  JS_VALUE_ARRAY_HEADER(%d),\n", 2 + hash_size + n_props * 3)
        printf("  %d << 1, /* n_props */\n", n_props)
        printf("  %d << 1, /* hash_mask */\n", hash_mask)
        i = 0
        while i < hash_size {
            printf("  %d << 1,\n", mem.get_int(hash_table, i * 4))
            i = i + 1
        }
        mem.set_int(s, BC_CUR_OFFSET, cur + hash_size + 3 + 3 * n_props)
        free(hash_table)
    }

    // emit each property entry
    int prop_idx2 = 0
    i = 0
    dd = pd
    while i < n_props {
        nm = ge_prop_name(mem.long_to_ptr(dd), props_kind)
        printf("  ")
        ge_dump_atom(s, nm, 0)
        printf(",\n")
        printf("  ")
        ge_emit_prop_value(s, mem.long_to_ptr(dd), props_kind, is_global, ident_tab, i, class_id_str)
        printf("\n")
        if is_global == 0 {
            int ph = mem.get_int(prop_hash, prop_idx2 * 4)
            ptype = ge_prop_type(mem.long_to_ptr(dd), props_kind)
            printf("  (%d << 1) | (JS_PROP_%s << 30),\n", ph, ptype)
        }
        prop_idx2 = prop_idx2 + 1
        i = i + 1
        dd = dd + PD_STRIDE
    }
    free(ident_tab)
    return props_ident
}

// the JS_PROP_<TYPE> tag string for the property's def_type.
ge_prop_type(d: ptr, props_kind: int) -> ptr {
    int dt = mem.get_int(mem.long_to_ptr(mem.ptr_to_long(d)), 0)
    if dt == JS_DEF_CGETSET { return "GETSET" }
    if dt == JS_DEF_END { return "SPECIAL" }
    return "NORMAL"
}

// emit the value column for one property entry.
ge_emit_prop_value(s: ptr, d: ptr, props_kind: int, is_global: int, ident_tab: ptr, i: int, class_id_str: ptr) {
    int dt = mem.get_int(mem.long_to_ptr(mem.ptr_to_long(d)), 0)
    int ident = mem.get_int(ident_tab, i * 4)
    if dt == JS_DEF_PROP_DOUBLE {
        if ident >= 0 { printf("JS_ROM_VALUE(%d),", ident)  return }
        float dv = mem.get_float64(mem.long_to_ptr(mem.ptr_to_long(d)), PD_U)
        int iv = dv                          // short int truncation like (int32_t)
        printf("%d << 1,", iv)
    } else if dt == JS_DEF_CGETSET {
        printf("JS_ROM_VALUE(%d),", ident)   // value_ptr
    } else if dt == JS_DEF_CLASS {
        printf("JS_ROM_VALUE(%d),", ident)
    } else if dt == JS_DEF_PROP_UNDEFINED {
        printf("JS_UNDEFINED,")
    } else if dt == JS_DEF_PROP_NULL {
        printf("JS_NULL,")
    } else if dt == JS_DEF_PROP_STRING {
        str = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_U)
        ge_dump_atom(s, str, 0)
        printf(",")
    } else if dt == JS_DEF_CFUNC {
        cflist = mem.long_to_ptr(mem.ptr_to_long(s) + BC_CFUNC_LIST)
        name = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), PD_NAME)
        int flen = mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(d)), FUNC_LENGTH) & 0xff
        magic = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), FUNC_MAGIC)
        cproto = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), FUNC_CPROTO)
        fn = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(d)), FUNC_FUNC)
        int idx = add_cfunc(cflist, name, flen, magic, cproto, fn)
        printf("JS_VALUE_MAKE_SPECIAL(JS_TAG_SHORT_FUNC, %d),", idx)
    } else if dt == JS_DEF_END {
        if props_kind == PROPS_KIND_PROTO {
            printf("(uint32_t)(-%s - 1) << 1,", class_id_str)
        } else {
            printf("%s << 1,", class_id_str)
        }
    }
}

// ---- orchestration: build_atoms (the generator entry point) ----

ge_init_list_head(head: long) {
    mem.set_ptr(mem.long_to_ptr(head), 0, mem.long_to_ptr(head))   // prev = head
    mem.set_ptr(mem.long_to_ptr(head), 8, mem.long_to_ptr(head))   // next = head
}

// free every ClassDefEntry in class_list and reinit the list.
free_class_entries(s: ptr) {
    long head = mem.ptr_to_long(s) + BC_CLASS_LIST
    long el = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(head), 8))
    while el != head {
        long nextel = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(el), 8))
        cid = mem.get_ptr(mem.long_to_ptr(el), CDE_CLASS_ID)
        fin = mem.get_ptr(mem.long_to_ptr(el), CDE_FINALIZER)
        if mem.ptr_to_long(cid) != 0 { free(cid) }
        if mem.ptr_to_long(fin) != 0 { free(fin) }
        free(mem.long_to_ptr(el))
        el = nextel
    }
    ge_init_list_head(head)
}

ge_usage(name: ptr) -> int {
    fprintf(stderr_ptr(), "usage: %s {-m32 | -m64} [-a]\n", name)
    fprintf(stderr_ptr(), "    create a ROM file for the mquickjs standard library\n--help       list options\n-m32         force generation for a 32 bit target\n-m64         force generation for a 64 bit target\n-a           generate the mquickjs_atom.h header\n")
    return 1
}

argv_at(argv: ptr, i: int) -> ptr { return mem.get_ptr(argv, i * 8) }

// int build_atoms(stdlib_name, global_obj, c_function_decl, argc, argv):
// the generator entry point. Parses -m32/-m64/-a, builds the BuildContext,
// runs both passes, and emits js_stdlib_table[] + the JSSTDLibraryDef.
build_atoms(stdlib_name: ptr, global_obj: ptr, c_function_decl: ptr, argc: int, argv: ptr) -> int {
    int jsw = 8                              // INTPTR_MAX >= INT64_MAX on our targets
    int build_atom_defines = 0
    int i = 1
    while i < argc {
        a = argv_at(argv, i)
        if ge_strcmp(a, "-m64") == 0 { jsw = 8 }
        else if ge_strcmp(a, "-m32") == 0 { jsw = 4 }
        else if ge_strcmp(a, "-a") == 0 { build_atom_defines = 1 }
        else if ge_strcmp(a, "-dsltest") == 0 { ge_dsl_selftest()  return 0 }
        else if ge_strcmp(a, "-dsl2test") == 0 { ge_dsl2test()  return 0 }
        else if ge_strcmp(a, "--help") == 0 { return ge_usage(argv_at(argv, 0)) }
        else {
            fprintf(stderr_ptr(), "invalid argument '%s'\n", a)
            return ge_usage(argv_at(argv, 0))
        }
        i = i + 1
    }
    bt_set_jsw(jsw)

    if build_atom_defines != 0 {
        dump_atom_defines()
        return 0
    }

    // BuildContext = atom_list(24) + cfunc_list(16, but laid at 24) ... total
    // sizeof per the C struct: class_list@56 + 16 = 72.
    s = malloc(80)
    memset(s, 0, 80)
    ge_init_list_head(mem.ptr_to_long(s) + BC_CLASS_LIST)
    al = mem.long_to_ptr(mem.ptr_to_long(s) + BC_ATOM_LIST)

    // predefined atoms
    blob = ge_atoms_blob()
    i = 0
    while i < ATOM_COUNT {
        at = ge_nth_atom(blob, i)
        add_atom(al, at)
        free(at)
        i = i + 1
    }

    // predefined c functions (c_function_decl[])
    cflist = mem.long_to_ptr(mem.ptr_to_long(s) + BC_CFUNC_LIST)
    if mem.ptr_to_long(c_function_decl) != 0 {
        long d = mem.ptr_to_long(c_function_decl)
        while mem.get_int(mem.long_to_ptr(d), 0) != JS_DEF_END {
            int dt = mem.get_int(mem.long_to_ptr(d), 0)
            if dt != JS_DEF_CFUNC {
                fprintf(stderr_ptr(), "only C functions are allowed in c_function_decl[]\n")
                exit(1)
            }
            name = mem.get_ptr(mem.long_to_ptr(d), PD_NAME)
            add_atom(al, name)
            int flen = mem.get_byte(mem.long_to_ptr(d), FUNC_LENGTH) & 0xff
            magic = mem.get_ptr(mem.long_to_ptr(d), FUNC_MAGIC)
            cproto = mem.get_ptr(mem.long_to_ptr(d), FUNC_CPROTO)
            fn = mem.get_ptr(mem.long_to_ptr(d), FUNC_FUNC)
            add_cfunc(cflist, name, flen, magic, cproto, fn)
            d = d + PD_STRIDE
        }
    }

    // first pass: define the atoms
    define_atoms_props(s, global_obj, PROPS_KIND_GLOBAL)
    free_class_entries(s)

    printf("/* this file is automatically generated - do not edit */\n\n")
    printf("#include \"mquickjs_priv.h\"\n\n")
    printf("static const uint%d_t __attribute((aligned(64))) js_stdlib_table[] = {\n", jsw * 8)

    dump_atoms(s)

    int gob = define_props(s, global_obj, PROPS_KIND_GLOBAL, mem.long_to_ptr(0))
    mem.set_int(s, BC_GLOBAL_OFF, gob)

    printf("};\n\n")

    dump_cfuncs(s)

    printf("#ifndef JS_CLASS_COUNT\n#define JS_CLASS_COUNT JS_CLASS_USER /* total number of classes */\n#endif\n\n")

    dump_cfinalizers(s)
    free_class_entries(s)

    printf("const JSSTDLibraryDef %s = {\n", stdlib_name)
    printf("  js_stdlib_table,\n")
    printf("  js_c_function_table,\n")
    printf("  js_c_finalizer_table,\n")
    printf("  %d,\n", mem.get_int(s, BC_CUR_OFFSET))
    printf("  %d,\n", 64)
    printf("  %d,\n", mem.get_int(s, BC_SORTED_OFF))
    printf("  %d,\n", mem.get_int(s, BC_GLOBAL_OFF))
    printf("  JS_CLASS_COUNT,\n")
    printf("};\n\n")
    free(s)
    return 0
}

// ===== N3b: stdlib spec tree builders =====
// Construct JSPropDef[] (stride 48) / JSClassDef (stride 72) trees in
// malloc'd memory matching the JS_*_DEF macro expansions, so build_atoms
// consumes them exactly as it did the static C tables.
// JS_DEF: CFUNC=1 CGETSET=2 PROP_DOUBLE=3 PROP_UNDEF=4 PROP_STRING=5
//         PROP_NULL=6 CLASS=7 END=0.

// A growable JSPropDef array: a 16-byte header {ptr tab; int count; int cap}
// then the JSPropDef records. pdl_new() returns the header.
pdl_new() -> ptr {
    h = malloc(16)
    t = malloc(48 * 8)            // initial capacity 8
    mem.set_ptr(h, 0, t)
    mem.set_int(h, 8, 0)
    mem.set_int(h, 12, 8)
    return h
}
pdl_slot(h: ptr) -> long {
    int count = mem.get_int(h, 8)
    int cap = mem.get_int(h, 12)
    if count >= cap {
        int ncap = cap * 2
        old = mem.get_ptr(h, 0)
        nt = malloc(48 * ncap)
        memcpy(nt, old, 48 * count)
        free(old)
        mem.set_ptr(h, 0, nt)
        mem.set_int(h, 12, ncap)
    }
    long tab = mem.ptr_to_long(mem.get_ptr(h, 0))
    long slot = tab + count * 48
    mem.set_int(h, 8, count + 1)
    // zero the slot
    memset(mem.long_to_ptr(slot), 0, 48)
    return slot
}
// finalize: append a JS_DEF_END terminator and return the tab pointer.
pdl_finish(h: ptr) -> ptr {
    e = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(e), 0, JS_DEF_END)
    tab = mem.get_ptr(h, 0)
    free(h)
    return tab
}

// JS_CFUNC_DEF(name,len,fn): {CFUNC, name, {.func={len,"0","generic",fn}}}
pd_cfunc(h: ptr, name: ptr, length: int, fn: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CFUNC)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_byte(mem.long_to_ptr(s), FUNC_LENGTH, length)
    mem.set_ptr(mem.long_to_ptr(s), FUNC_MAGIC, "0")
    mem.set_ptr(mem.long_to_ptr(s), FUNC_CPROTO, "generic")
    mem.set_ptr(mem.long_to_ptr(s), FUNC_FUNC, fn)
}
// JS_CFUNC_MAGIC_DEF(name,len,fn,magic): cproto "generic_magic"
pd_cfunc_magic(h: ptr, name: ptr, length: int, fn: ptr, magic: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CFUNC)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_byte(mem.long_to_ptr(s), FUNC_LENGTH, length)
    mem.set_ptr(mem.long_to_ptr(s), FUNC_MAGIC, magic)
    mem.set_ptr(mem.long_to_ptr(s), FUNC_CPROTO, "generic_magic")
    mem.set_ptr(mem.long_to_ptr(s), FUNC_FUNC, fn)
}
// JS_CFUNC_SPECIAL_DEF(name,len,proto,fn): magic "0", cproto = proto
pd_cfunc_special(h: ptr, name: ptr, length: int, proto: ptr, fn: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CFUNC)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_byte(mem.long_to_ptr(s), FUNC_LENGTH, length)
    mem.set_ptr(mem.long_to_ptr(s), FUNC_MAGIC, "0")
    mem.set_ptr(mem.long_to_ptr(s), FUNC_CPROTO, proto)
    mem.set_ptr(mem.long_to_ptr(s), FUNC_FUNC, fn)
}
// JS_CGETSET_DEF(name,get,set): {CGETSET, name, {.getset={"0","generic",get,set}}}
pd_cgetset(h: ptr, name: ptr, getn: ptr, setn: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CGETSET)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_ptr(mem.long_to_ptr(s), GS_MAGIC, "0")
    mem.set_ptr(mem.long_to_ptr(s), GS_CPROTO, "generic")
    mem.set_ptr(mem.long_to_ptr(s), PD_GETSET_GET, getn)
    mem.set_ptr(mem.long_to_ptr(s), PD_GETSET_SET, setn)
}
// JS_CGETSET_MAGIC_DEF(name,get,set,magic): cproto "generic_magic"
pd_cgetset_magic(h: ptr, name: ptr, getn: ptr, setn: ptr, magic: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CGETSET)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_ptr(mem.long_to_ptr(s), GS_MAGIC, magic)
    mem.set_ptr(mem.long_to_ptr(s), GS_CPROTO, "generic_magic")
    mem.set_ptr(mem.long_to_ptr(s), PD_GETSET_GET, getn)
    mem.set_ptr(mem.long_to_ptr(s), PD_GETSET_SET, setn)
}
// JS_PROP_DOUBLE_DEF(name,val): {PROP_DOUBLE, name, {.f64=val}}
pd_double(h: ptr, name: ptr, val: float) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_PROP_DOUBLE)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_float64(mem.long_to_ptr(s), PD_U, val)
}
// pd_double_bits: like pd_double but stores the exact 64-bit pattern.
pd_double_bits(h: ptr, name: ptr, bits: long) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_PROP_DOUBLE)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_long(mem.long_to_ptr(s), PD_U, bits)
}

// JS_PROP_STRING_DEF(name,str): {PROP_STRING, name, {.str=str}}
pd_string(h: ptr, name: ptr, str: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_PROP_STRING)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_ptr(mem.long_to_ptr(s), PD_U, str)
}
pd_undefined(h: ptr, name: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_PROP_UNDEFINED)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
}
pd_null(h: ptr, name: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_PROP_NULL)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
}
// JS_PROP_CLASS_DEF(name,cl): {CLASS, name, {.class1=cl}}
pd_class_ref(h: ptr, name: ptr, cl: ptr) {
    s = pdl_slot(h)
    mem.set_int(mem.long_to_ptr(s), 0, JS_DEF_CLASS)
    mem.set_ptr(mem.long_to_ptr(s), PD_NAME, name)
    mem.set_ptr(mem.long_to_ptr(s), PD_U, cl)
}

// Build a JSClassDef (stride 72). cproto = "constructor" (or
// "constructor_magic" for the magic variant). props are finished tabs (or 0).
mk_class(name: ptr, length: int, cproto: ptr, func_name: ptr, class_id: ptr,
         class_props: ptr, proto_props: ptr, parent: ptr, finalizer: ptr) -> ptr {
    c = malloc(72)
    memset(c, 0, 72)
    mem.set_ptr(c, 0, name)
    mem.set_int(c, 8, length)
    mem.set_ptr(c, CD_CPROTO, cproto)
    mem.set_ptr(c, CD_FUNC_NAME, func_name)
    mem.set_ptr(c, CD_CLASS_ID, class_id)
    mem.set_ptr(c, CD_CLASS_PROPS, class_props)
    mem.set_ptr(c, CD_PROTO_PROPS, proto_props)
    mem.set_ptr(c, CD_PARENT, parent)
    mem.set_ptr(c, CD_FINALIZER, finalizer)
    return c
}

// ge_dsl_selftest: build a 2-entry propdef array via the DSL and print the
// raw record fields so a host test can assert the layout matches the macros.
ge_dsl_selftest() {
    h = pdl_new()
    pd_cfunc(h, "foo", 2, "js_foo")
    pd_double(h, "PI", 3.14)
    tab = pdl_finish(h)
    long t = mem.ptr_to_long(tab)
    // entry 0: CFUNC
    printf("e0 type=%d name=%s len=%d cproto=%s fn=%s\n",
        mem.get_int(mem.long_to_ptr(t), 0),
        mem.get_ptr(mem.long_to_ptr(t), 8),
        mem.get_byte(mem.long_to_ptr(t), 16) & 0xff,
        mem.get_ptr(mem.long_to_ptr(t), 32),
        mem.get_ptr(mem.long_to_ptr(t), 40))
    // entry 1: PROP_DOUBLE
    long e1 = t + 48
    printf("e1 type=%d name=%s\n",
        mem.get_int(mem.long_to_ptr(e1), 0),
        mem.get_ptr(mem.long_to_ptr(e1), 8))
    // entry 2: END
    long e2 = t + 96
    printf("e2 type=%d (should be 0)\n", mem.get_int(mem.long_to_ptr(e2), 0))
}

// ===== N3b: list-based declarative stdlib DSL =====
// A spec tree of nested std.list nodes; each property entry is a list
// [DSL_KIND, name, ...]. The builders (cfunc/klass/statics/proto/...) take
// an injected _ctx collector and append to it; the materializer (_mat_props
// / _mat_class) walks the tree and emits JSPropDef[]/JSClassDef via the
// pd_*/mk_class writers, exactly reproducing mqjs_stdlib.c's tables.

const DSL_CFUNC         = 1
const DSL_CFUNC_MAGIC   = 2
const DSL_CFUNC_SPECIAL = 3
const DSL_CGETSET       = 4
const DSL_CGETSET_MAGIC = 5
const DSL_DOUBLE        = 6     // carries the exact float bit-pattern
const DSL_UNDEF         = 7
const DSL_NULLP         = 8
const DSL_STR           = 9
const DSL_CLASSREC      = 10

dsl_r(kind: int) -> ptr { r = list.new()  list.add(r, mem.long_to_ptr(kind))  return r }
dsl_ri(r: ptr, i: int) -> int { v, _ = list.get(r, i)  return mem.ptr_to_long(v) }
dsl_rl(r: ptr, i: int) -> long { v, _ = list.get(r, i)  return mem.ptr_to_long(v) }
dsl_rp(r: ptr, i: int) -> ptr { v, _ = list.get(r, i)  return v }
dsl_addi(r: ptr, v: int) { list.add(r, mem.long_to_ptr(v)) }
dsl_addl(r: ptr, v: long) { list.add(r, mem.long_to_ptr(v)) }

// --- property-leaf builders (append a spec to the current _ctx list) ---
cfunc(_ctx: ptr, name: ptr, length: int, fn: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_CFUNC)  list.add(r, name)  dsl_addi(r, length)  list.add(r, fn)
    list.add(_ctx, r)
}
cfunc_magic(_ctx: ptr, name: ptr, length: int, fn: ptr, magic: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_CFUNC_MAGIC)  list.add(r, name)  dsl_addi(r, length)  list.add(r, fn)  list.add(r, magic)
    list.add(_ctx, r)
}
cfunc_special(_ctx: ptr, name: ptr, length: int, proto: ptr, fn: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_CFUNC_SPECIAL)  list.add(r, name)  dsl_addi(r, length)  list.add(r, proto)  list.add(r, fn)
    list.add(_ctx, r)
}
cgetset(_ctx: ptr, name: ptr, getn: ptr, setn: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_CGETSET)  list.add(r, name)  list.add(r, getn)  list.add(r, setn)
    list.add(_ctx, r)
}
cgetset_magic(_ctx: ptr, name: ptr, getn: ptr, setn: ptr, magic: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_CGETSET_MAGIC)  list.add(r, name)  list.add(r, getn)  list.add(r, setn)  list.add(r, magic)
    list.add(_ctx, r)
}
double_bits(_ctx: ptr, name: ptr, bits: long) {
    if _ctx == null { return }
    r = dsl_r(DSL_DOUBLE)  list.add(r, name)  dsl_addl(r, bits)
    list.add(_ctx, r)
}
prop_double(_ctx: ptr, name: ptr, val: float) { double_bits(_ctx, name, mem.bits_of_float(val)) }
prop_undefined(_ctx: ptr, name: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_UNDEF)  list.add(r, name)  list.add(_ctx, r)
}
prop_null(_ctx: ptr, name: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_NULLP)  list.add(r, name)  list.add(_ctx, r)
}
prop_string(_ctx: ptr, name: ptr, cstr: ptr) {
    if _ctx == null { return }
    r = dsl_r(DSL_STR)  list.add(r, name)  list.add(r, cstr)  list.add(_ctx, r)
}
method(_ctx: ptr, name: ptr, length: int, fn: ptr) { cfunc(_ctx, name, length, fn) }
method_magic(_ctx: ptr, name: ptr, length: int, fn: ptr, magic: ptr) { cfunc_magic(_ctx, name, length, fn, magic) }

// --- class / object builders ---
// class spec: [0]=DSL_CLASSREC [1]=name [2]=len [3]=ctor [4]=class_id
//   [5]=parent_spec [6]=finalizer [7]=magic [8]=statics [9]=proto [10]=memo
class_rec(name: ptr, length: int, ctor: ptr, class_id: ptr, magic: int) -> ptr {
    r = dsl_r(DSL_CLASSREC)
    list.add(r, name)  dsl_addi(r, length)  list.add(r, ctor)  list.add(r, class_id)
    list.add(r, mem.long_to_ptr(0))     // [5] parent
    list.add(r, "NULL")                 // [6] finalizer
    dsl_addi(r, magic)                   // [7] magic
    list.add(r, list.new())            // [8] statics
    list.add(r, list.new())            // [9] proto
    list.add(r, mem.long_to_ptr(0))     // [10] memo
    return r
}
statics(_ctx: ptr) -> ptr { if _ctx == null { return mem.long_to_ptr(0) }  return dsl_rp(_ctx, 8) }
proto(_ctx: ptr)   -> ptr { if _ctx == null { return mem.long_to_ptr(0) }  return dsl_rp(_ctx, 9) }
statics_of(spec: ptr) -> ptr { return dsl_rp(spec, 8) }
proto_of(spec: ptr)   -> ptr { return dsl_rp(spec, 9) }
extends(_ctx: ptr, parent_spec: ptr) { if _ctx != null { list.set(_ctx, 5, parent_spec) } }
finalize(_ctx: ptr, finalizer: ptr) { if _ctx != null { list.set(_ctx, 6, finalizer) } }
set_parent(spec: ptr, parent_spec: ptr) { if spec != null { list.set(spec, 5, parent_spec) } }
set_finalizer(spec: ptr, fin: ptr) { if spec != null { list.set(spec, 6, fin) } }

klass_standalone(name: ptr, length: int, ctor: ptr, class_id: ptr) -> ptr {
    return class_rec(name, length, ctor, class_id, 0)
}
klass_magic_standalone(name: ptr, length: int, ctor: ptr, class_id: ptr) -> ptr {
    return class_rec(name, length, ctor, class_id, 1)
}
klass(_ctx: ptr, name: ptr, length: int, ctor: ptr, class_id: ptr) -> ptr {
    r = class_rec(name, length, ctor, class_id, 0)
    if _ctx != null { list.add(_ctx, r) }
    return r
}
klass_magic(_ctx: ptr, name: ptr, length: int, ctor: ptr, class_id: ptr) -> ptr {
    r = class_rec(name, length, ctor, class_id, 1)
    if _ctx != null { list.add(_ctx, r) }
    return r
}
object(_ctx: ptr, name: ptr) -> ptr {
    r = class_rec(name, 0, "", "", 0)
    if _ctx != null { list.add(_ctx, r) }
    return r
}
stdlib() -> ptr { return list.new() }

// --- materializer: spec tree -> JSPropDef[] / JSClassDef ---
mat_class(c: ptr) -> ptr {
    memo = dsl_rp(c, 10)
    if mem.ptr_to_long(memo) != 0 { return memo }
    name = dsl_rp(c, 1)
    int len = dsl_ri(c, 2)
    ctor = dsl_rp(c, 3)
    class_id = dsl_rp(c, 4)
    parent_sp = dsl_rp(c, 5)
    finalizer = dsl_rp(c, 6)
    int magic = dsl_ri(c, 7)
    statics_l = dsl_rp(c, 8)
    proto_l = dsl_rp(c, 9)

    int is_object = 0
    if mem.ptr_to_long(ctor) != 0 { if strlen(ctor) == 0 { is_object = 1 } }

    class_props = mem.long_to_ptr(0)
    if list.size(statics_l) > 0 { class_props = mat_props(statics_l) }
    proto_props = mem.long_to_ptr(0)
    if list.size(proto_l) > 0 { proto_props = mat_props(proto_l) }
    parent_ptr = mem.long_to_ptr(0)
    if mem.ptr_to_long(parent_sp) != 0 { parent_ptr = mat_class(parent_sp) }

    if is_object == 1 {
        // bare object: a JSClassDef with only name@0 + class_props@40
        p = malloc(72)
        memset(p, 0, 72)
        mem.set_ptr(p, 0, name)
        mem.set_ptr(p, CD_CLASS_PROPS, class_props)
        list.set(c, 10, p)
        return p
    }
    cproto = "constructor"
    if magic == 1 { cproto = "constructor_magic" }
    p = mk_class(name, len, cproto, ctor, class_id, class_props, proto_props, parent_ptr, finalizer)
    list.set(c, 10, p)
    return p
}

mat_props(spec: ptr) -> ptr {
    h = pdl_new()
    int n = list.size(spec)
    int i = 0
    while i < n {
        e, _ = list.get(spec, i)
        int kind = dsl_ri(e, 0)
        if kind == DSL_CFUNC { pd_cfunc(h, dsl_rp(e, 1), dsl_ri(e, 2), dsl_rp(e, 3)) }
        else if kind == DSL_CFUNC_MAGIC { pd_cfunc_magic(h, dsl_rp(e, 1), dsl_ri(e, 2), dsl_rp(e, 3), dsl_rp(e, 4)) }
        else if kind == DSL_CFUNC_SPECIAL { pd_cfunc_special(h, dsl_rp(e, 1), dsl_ri(e, 2), dsl_rp(e, 3), dsl_rp(e, 4)) }
        else if kind == DSL_CGETSET { pd_cgetset(h, dsl_rp(e, 1), dsl_rp(e, 2), dsl_rp(e, 3)) }
        else if kind == DSL_CGETSET_MAGIC { pd_cgetset_magic(h, dsl_rp(e, 1), dsl_rp(e, 2), dsl_rp(e, 3), dsl_rp(e, 4)) }
        else if kind == DSL_DOUBLE { pd_double_bits(h, dsl_rp(e, 1), dsl_rl(e, 2)) }
        else if kind == DSL_UNDEF { pd_undefined(h, dsl_rp(e, 1)) }
        else if kind == DSL_NULLP { pd_null(h, dsl_rp(e, 1)) }
        else if kind == DSL_STR { pd_string(h, dsl_rp(e, 1), dsl_rp(e, 2)) }
        else if kind == DSL_CLASSREC {
            cls = mat_class(e)
            pd_class_ref(h, dsl_rp(e, 1), cls)
        }
        i = i + 1
    }
    return pdl_finish(h)
}

build_global(spec: ptr) -> ptr { return mat_props(spec) }

// ge_dsl2test: build a small spec via the builder DSL, materialize it, and
// print the resulting JSPropDef records to prove the layer end-to-end.
ge_dsl2test() {
    g = stdlib() {
        klass("Object", 1, "js_object_constructor", "JS_CLASS_OBJECT") {
            statics() {
                cfunc("keys", 1, "js_object_keys")
            }
            proto() {
                cfunc("toString", 0, "js_object_toString")
            }
        }
        prop_double("NaN", mem.float_from_bits(0x7ff8000000000000))
    }
    tab = build_global(g)
    long t = mem.ptr_to_long(tab)
    // entry 0: CLASS "Object"
    printf("e0 type=%d name=%s\n", mem.get_int(mem.long_to_ptr(t), 0), mem.get_ptr(mem.long_to_ptr(t), 8))
    cls = mem.get_ptr(mem.long_to_ptr(t), 16)         // the JSClassDef*
    printf("  class name=%s len=%d ctor=%s class_id=%s\n",
        mem.get_ptr(cls, 0), mem.get_int(cls, 8), mem.get_ptr(cls, 24), mem.get_ptr(cls, 32))
    cprops = mem.get_ptr(cls, 40)                     // class_props (statics)
    printf("  statics[0] type=%d name=%s\n", mem.get_int(cprops, 0), mem.get_ptr(cprops, 8))
    pprops = mem.get_ptr(cls, 48)                     // proto_props
    printf("  proto[0] type=%d name=%s\n", mem.get_int(pprops, 0), mem.get_ptr(pprops, 8))
    // entry 1: DOUBLE "NaN"
    long e1 = t + 48
    printf("e1 type=%d name=%s\n", mem.get_int(mem.long_to_ptr(e1), 0), mem.get_ptr(mem.long_to_ptr(e1), 8))
}

// =====================================================================
// mqjs standard-library spec — the data, in this engine's DSL.
// Classes appear in the exact js_global_object[] order so atom-collection
// (and the ROM) stays byte-identical to the former mqjs_stdlib.c tables.
// =====================================================================

// one error subclass: proto carries just its "name" string; ctor is the
// shared js_error_constructor (magic), parent is the Error base.
ge_error_class(g: ptr, name: ptr, class_id: ptr, parent: ptr) {
    c = klass_magic(g, name, 1, "js_error_constructor", class_id)
    set_parent(c, parent)
    p = proto_of(c)
    prop_string(p, "name", name)
}

// one typed-array class: BYTES_PER_ELEMENT on both statics and proto,
// magic ctor js_typed_array_constructor, parent the TypedArray base.
ge_ta_class(g: ptr, name: ptr, class_id: ptr, bpe: long, parent: ptr) {
    c = klass_magic(g, name, 3, "js_typed_array_constructor", class_id)
    set_parent(c, parent)
    double_bits(statics_of(c), "BYTES_PER_ELEMENT", bpe)
    double_bits(proto_of(c), "BYTES_PER_ELEMENT", bpe)
}

mqjs_stdlib_spec(is_example: int) -> ptr {
    // shared bases (standalone; referenced via set_parent()).
    err_base = klass_magic_standalone("Error", 1, "js_error_constructor", "JS_CLASS_ERROR")
    ebp = proto_of(err_base)
    cfunc(ebp, "toString", 0, "js_error_toString")
    prop_string(ebp, "name", "Error")
    cgetset_magic(ebp, "message", "js_error_get_message", "NULL", "0")
    cgetset_magic(ebp, "stack", "js_error_get_message", "NULL", "1")

    ta_base = klass_standalone("TypedArray", 0, "js_typed_array_base_constructor", "JS_CLASS_TYPED_ARRAY")
    tap = proto_of(ta_base)
    cgetset_magic(tap, "length", "js_typed_array_get_length", "NULL", "0")
    cgetset_magic(tap, "byteLength", "js_typed_array_get_length", "NULL", "1")
    cgetset_magic(tap, "byteOffset", "js_typed_array_get_length", "NULL", "2")
    cgetset_magic(tap, "buffer", "js_typed_array_get_length", "NULL", "3")
    cfunc(tap, "join", 1, "js_array_join")
    cfunc(tap, "toString", 0, "js_array_toString")
    cfunc(tap, "subarray", 2, "js_typed_array_subarray")
    cfunc(tap, "set", 1, "js_typed_array_set")

    g = stdlib() {
        klass("Object", 1, "js_object_constructor", "JS_CLASS_OBJECT") {
            statics() {
                cfunc("defineProperty", 3, "js_object_defineProperty")
                cfunc("getPrototypeOf", 1, "js_object_getPrototypeOf")
                cfunc("setPrototypeOf", 2, "js_object_setPrototypeOf")
                cfunc("create", 2, "js_object_create")
                cfunc("keys", 1, "js_object_keys")
            }
            proto() {
                cfunc("hasOwnProperty", 1, "js_object_hasOwnProperty")
                cfunc("toString", 0, "js_object_toString")
            }
        }
        klass("Function", 1, "js_function_constructor", "JS_CLASS_CLOSURE") {
            proto() {
                cgetset("prototype", "js_function_get_prototype", "js_function_set_prototype")
                cfunc("call", 1, "js_function_call")
                cfunc("apply", 2, "js_function_apply")
                cfunc("bind", 1, "js_function_bind")
                cfunc("toString", 0, "js_function_toString")
                cgetset_magic("length", "js_function_get_length_name", "NULL", "0")
                cgetset_magic("name", "js_function_get_length_name", "NULL", "1")
            }
        }
        klass("Number", 1, "js_number_constructor", "JS_CLASS_NUMBER") {
            statics() {
                cfunc("parseInt", 2, "js_number_parseInt")
                cfunc("parseFloat", 1, "js_number_parseFloat")
                double_bits("MAX_VALUE", 0x7fefffffffffffff)
                double_bits("MIN_VALUE", 0x0000000000000001)
                double_bits("NaN", 0x7ff8000000000000)
                double_bits("NEGATIVE_INFINITY", 0xfff0000000000000)
                double_bits("POSITIVE_INFINITY", 0x7ff0000000000000)
                double_bits("EPSILON", 0x3cb0000000000000)
                double_bits("MAX_SAFE_INTEGER", 0x433fffffffffffff)
                double_bits("MIN_SAFE_INTEGER", 0xc33fffffffffffff)
            }
            proto() {
                cfunc("toExponential", 1, "js_number_toExponential")
                cfunc("toFixed", 1, "js_number_toFixed")
                cfunc("toPrecision", 1, "js_number_toPrecision")
                cfunc("toString", 1, "js_number_toString")
            }
        }
        klass("Boolean", 1, "js_boolean_constructor", "JS_CLASS_BOOLEAN") { }
        klass("String", 1, "js_string_constructor", "JS_CLASS_STRING") {
            statics() {
                cfunc_magic("fromCharCode", 1, "js_string_fromCharCode", "0")
                cfunc_magic("fromCodePoint", 1, "js_string_fromCharCode", "1")
            }
            proto() {
                cgetset("length", "js_string_get_length", "js_string_set_length")
                cfunc_magic("charAt", 1, "js_string_charAt", "magic_charAt")
                cfunc_magic("charCodeAt", 1, "js_string_charAt", "magic_charCodeAt")
                cfunc_magic("codePointAt", 1, "js_string_charAt", "magic_codePointAt")
                cfunc("slice", 2, "js_string_slice")
                cfunc("substring", 2, "js_string_substring")
                cfunc("concat", 1, "js_string_concat")
                cfunc_magic("indexOf", 1, "js_string_indexOf", "0")
                cfunc_magic("lastIndexOf", 1, "js_string_indexOf", "1")
                cfunc("match", 1, "js_string_match")
                cfunc_magic("replace", 2, "js_string_replace", "0")
                cfunc_magic("replaceAll", 2, "js_string_replace", "1")
                cfunc("search", 1, "js_string_search")
                cfunc("split", 2, "js_string_split")
                cfunc_magic("toLowerCase", 0, "js_string_toLowerCase", "1")
                cfunc_magic("toUpperCase", 0, "js_string_toLowerCase", "0")
                cfunc_magic("trim", 0, "js_string_trim", "3")
                cfunc_magic("trimEnd", 0, "js_string_trim", "2")
                cfunc_magic("trimStart", 0, "js_string_trim", "1")
                cfunc("toString", 0, "js_string_toString")
                cfunc("repeat", 1, "js_string_repeat")
            }
        }
        klass("Array", 1, "js_array_constructor", "JS_CLASS_ARRAY") {
            statics() { cfunc("isArray", 1, "js_array_isArray") }
            proto() {
                cfunc("concat", 1, "js_array_concat")
                cgetset("length", "js_array_get_length", "js_array_set_length")
                cfunc_magic("push", 1, "js_array_push", "0")
                cfunc("pop", 0, "js_array_pop")
                cfunc("join", 1, "js_array_join")
                cfunc("toString", 0, "js_array_toString")
                cfunc("reverse", 0, "js_array_reverse")
                cfunc("shift", 0, "js_array_shift")
                cfunc("slice", 2, "js_array_slice")
                cfunc("splice", 2, "js_array_splice")
                cfunc_magic("unshift", 1, "js_array_push", "1")
                cfunc_magic("indexOf", 1, "js_array_indexOf", "0")
                cfunc_magic("lastIndexOf", 1, "js_array_indexOf", "1")
                cfunc_magic("every", 1, "js_array_every", "js_special_every")
                cfunc_magic("some", 1, "js_array_every", "js_special_some")
                cfunc_magic("forEach", 1, "js_array_every", "js_special_forEach")
                cfunc_magic("map", 1, "js_array_every", "js_special_map")
                cfunc_magic("filter", 1, "js_array_every", "js_special_filter")
                cfunc_magic("reduce", 1, "js_array_reduce", "js_special_reduce")
                cfunc_magic("reduceRight", 1, "js_array_reduce", "js_special_reduceRight")
                cfunc_magic("reduce", 1, "js_array_reduce", "js_special_reduce")
                cfunc("sort", 1, "js_array_sort")
            }
        }
        object("Math") {
            statics() {
                cfunc_magic("min", 2, "js_math_min_max", "0")
                cfunc_magic("max", 2, "js_math_min_max", "1")
                cfunc_special("sign", 1, "f_f", "js_math_sign")
                cfunc_special("abs", 1, "f_f", "js_fabs")
                cfunc_special("floor", 1, "f_f", "js_floor")
                cfunc_special("ceil", 1, "f_f", "js_ceil")
                cfunc_special("round", 1, "f_f", "js_round_inf")
                cfunc_special("sqrt", 1, "f_f", "js_sqrt")
                double_bits("E", 0x4005bf0a8b145769)
                double_bits("LN10", 0x40026bb1bbb55516)
                double_bits("LN2", 0x3fe62e42fefa39ef)
                double_bits("LOG2E", 0x3ff71547652b82fe)
                double_bits("LOG10E", 0x3fdbcb7b1526e50e)
                double_bits("PI", 0x400921fb54442d18)
                double_bits("SQRT1_2", 0x3fe6a09e667f3bcd)
                double_bits("SQRT2", 0x3ff6a09e667f3bcd)
                cfunc_special("sin", 1, "f_f", "js_sin")
                cfunc_special("cos", 1, "f_f", "js_cos")
                cfunc_special("tan", 1, "f_f", "js_tan")
                cfunc_special("asin", 1, "f_f", "js_asin")
                cfunc_special("acos", 1, "f_f", "js_acos")
                cfunc_special("atan", 1, "f_f", "js_atan")
                cfunc("atan2", 2, "js_math_atan2")
                cfunc_special("exp", 1, "f_f", "js_exp")
                cfunc_special("log", 1, "f_f", "js_log")
                cfunc("pow", 2, "js_math_pow")
                cfunc("random", 0, "js_math_random")
                cfunc("imul", 2, "js_math_imul")
                cfunc("clz32", 1, "js_math_clz32")
                cfunc_special("fround", 1, "f_f", "js_math_fround")
                cfunc_special("trunc", 1, "f_f", "js_trunc")
                cfunc_special("log2", 1, "f_f", "js_log2")
                cfunc_special("log10", 1, "f_f", "js_log10")
            }
        }
        klass("Date", 7, "js_date_constructor", "JS_CLASS_DATE") {
            statics() { cfunc("now", 0, "js_date_now") }
            proto() { cfunc("valueOf", 0, "js_date_valueOf") }
        }
        object("JSON") {
            statics() {
                cfunc("parse", 2, "js_json_parse")
                cfunc("stringify", 3, "js_json_stringify")
            }
        }
        klass("RegExp", 2, "js_regexp_constructor", "JS_CLASS_REGEXP") {
            proto() {
                cgetset("lastIndex", "js_regexp_get_lastIndex", "js_regexp_set_lastIndex")
                cgetset("source", "js_regexp_get_source", "NULL")
                cgetset("flags", "js_regexp_get_flags", "NULL")
                cfunc_magic("exec", 1, "js_regexp_exec", "0")
                cfunc_magic("test", 1, "js_regexp_exec", "1")
            }
        }
    }

    // Error + its subclasses (Error first; subclasses extend err_base).
    list.add(g, err_base)
    ge_error_class(g, "EvalError", "JS_CLASS_EVAL_ERROR", err_base)
    ge_error_class(g, "RangeError", "JS_CLASS_RANGE_ERROR", err_base)
    ge_error_class(g, "ReferenceError", "JS_CLASS_REFERENCE_ERROR", err_base)
    ge_error_class(g, "SyntaxError", "JS_CLASS_SYNTAX_ERROR", err_base)
    ge_error_class(g, "TypeError", "JS_CLASS_TYPE_ERROR", err_base)
    ge_error_class(g, "URIError", "JS_CLASS_URI_ERROR", err_base)
    ge_error_class(g, "InternalError", "JS_CLASS_INTERNAL_ERROR", err_base)

    // ArrayBuffer + typed arrays (subclasses extend ta_base).
    abc = klass(g, "ArrayBuffer", 1, "js_array_buffer_constructor", "JS_CLASS_ARRAY_BUFFER")
    cgetset(proto_of(abc), "byteLength", "js_array_buffer_get_byteLength", "NULL")
    ge_ta_class(g, "Uint8ClampedArray", "JS_CLASS_UINT8C_ARRAY", 0x3ff0000000000000, ta_base)
    ge_ta_class(g, "Int8Array", "JS_CLASS_INT8_ARRAY", 0x3ff0000000000000, ta_base)
    ge_ta_class(g, "Uint8Array", "JS_CLASS_UINT8_ARRAY", 0x3ff0000000000000, ta_base)
    ge_ta_class(g, "Int16Array", "JS_CLASS_INT16_ARRAY", 0x4000000000000000, ta_base)
    ge_ta_class(g, "Uint16Array", "JS_CLASS_UINT16_ARRAY", 0x4000000000000000, ta_base)
    ge_ta_class(g, "Int32Array", "JS_CLASS_INT32_ARRAY", 0x4010000000000000, ta_base)
    ge_ta_class(g, "Uint32Array", "JS_CLASS_UINT32_ARRAY", 0x4010000000000000, ta_base)
    ge_ta_class(g, "Float32Array", "JS_CLASS_FLOAT32_ARRAY", 0x4010000000000000, ta_base)
    ge_ta_class(g, "Float64Array", "JS_CLASS_FLOAT64_ARRAY", 0x4020000000000000, ta_base)

    // global functions + values
    cfunc(g, "parseInt", 2, "js_number_parseInt")
    cfunc(g, "parseFloat", 1, "js_number_parseFloat")
    cfunc(g, "eval", 1, "js_global_eval")
    cfunc(g, "isNaN", 1, "js_global_isNaN")
    cfunc(g, "isFinite", 1, "js_global_isFinite")
    double_bits(g, "Infinity", 0x7ff0000000000000)
    double_bits(g, "NaN", 0x7ff8000000000000)
    prop_undefined(g, "undefined")
    prop_null(g, "globalThis")

    // console / performance (bare objects) + remaining global funcs
    cons = object(g, "console")
    cfunc(statics_of(cons), "log", 1, "js_print")
    perf = object(g, "performance")
    cfunc(statics_of(perf), "now", 0, "js_performance_now")
    cfunc(g, "print", 1, "js_print")
    if is_example != 0 {
        // CONFIG_CLASS_EXAMPLE: Rectangle + FilledRectangle (the host adds
        // their class specs via mqjs_example_classes()).
        mqjs_example_classes(g)
    } else {
        cfunc(g, "gc", 0, "js_gc")
        cfunc(g, "load", 1, "js_load")
        cfunc(g, "setTimeout", 2, "js_setTimeout")
        cfunc(g, "clearTimeout", 1, "js_clearTimeout")
    }
    return g
}

// mqjs_extra_cfuncs() — the c_function_decl[] tree (bound first).
mqjs_extra_cfuncs(is_example: int) -> ptr {
    d = stdlib() { }
    cfunc_special(d, "bound", 0, "generic_params", "js_function_bound")
    if is_example != 0 {
        cfunc_special(d, "rectangle_closure_test", 0, "generic_params", "js_rectangle_closure_test")
    }
    return d
}

// mqjs_example_classes(g): the demo's Rectangle + FilledRectangle, added to
// the global spec when is_example. Calls example_classes_spec.
mqjs_example_classes(g: ptr) { example_classes_spec(g) }

// build_stdlib_main(argc, argv): the spec-driven generator entry. Builds
// the global + c-function-decl trees from the Aether DSL spec and feeds
// them to build_atoms — fully replacing mqjs_stdlib.c's main + tables.
build_stdlib_main(argc: int, argv: ptr) -> int {
    global_obj = build_global(mqjs_stdlib_spec(0))
    cdecl_obj = build_global(mqjs_extra_cfuncs(0))
    return build_atoms("js_stdlib", global_obj, cdecl_obj, argc, argv)
}

// example_classes_spec(g): append the embedding demo's Rectangle +
// FilledRectangle classes (matches example_stdlib.c's tables). Called by
// build_example_main when building the example's stdlib ROM.
example_classes_spec(g: ptr) {
    rect = klass(g, "Rectangle", 2, "js_rectangle_constructor", "JS_CLASS_RECTANGLE")
    set_finalizer(rect, "js_rectangle_finalizer")
    rs = statics_of(rect)
    cfunc(rs, "getClosure", 1, "js_rectangle_getClosure")
    cfunc(rs, "call", 2, "js_rectangle_call")
    rp = proto_of(rect)
    cgetset(rp, "x", "js_rectangle_get_x", "NULL")
    cgetset(rp, "y", "js_rectangle_get_y", "NULL")

    fr = klass(g, "FilledRectangle", 3, "js_filled_rectangle_constructor", "JS_CLASS_FILLED_RECTANGLE")
    set_parent(fr, rect)
    set_finalizer(fr, "js_filled_rectangle_finalizer")
    frp = proto_of(fr)
    cgetset(frp, "color", "js_filled_rectangle_get_color", "NULL")
}

// build_example_main(argc, argv): the example demo's stdlib generator —
// the standard spec (is_example=1) with Rectangle/FilledRectangle layered.
build_example_main(argc: int, argv: ptr) -> int {
    global_obj = build_global(mqjs_stdlib_spec(1))
    cdecl_obj = build_global(mqjs_extra_cfuncs(1))
    return build_atoms("js_stdlib", global_obj, cdecl_obj, argc, argv)
}

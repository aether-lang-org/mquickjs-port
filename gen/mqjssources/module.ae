// Single source of truth for the engine source set shared by the two
// program builds (mqjs and the embedding example). Both call these so
// the binaries cannot drift in which translation units make up the
// engine. As engine logic migrates from C to Aether, a .c entry here
// becomes an .ae entry — in one place.

import c
import c (sources, aether_source)

exports (register_engine_c_sources, register_engine_sources)

// Engine C sources. `root` is the path prefix from the calling
// build node to the repo root ("." for the top-level node, ".." for
// example-app).
register_engine_c_sources(_ctx: ptr, root: string) {
    sources(string.concat(root, "/mquickjs.c"))
    sources(string.concat(root, "/dtoa.c"))
    sources(string.concat(root, "/libm.c"))
    sources(string.concat(root, "/ae/layout_guard.c"))
}

// Engine Aether translation units. `prefix` is the path to the ae/
// dir from the calling build node ("ae" top-level, "../ae" for
// example-app).
register_engine_sources(_ctx: ptr, prefix: string) {
    aether_source(string.concat(prefix, "/portinfo.ae"))
    aether_source(string.concat(prefix, "/jstag.ae"))
    aether_source(string.concat(prefix, "/cutils.ae"))
    aether_source(string.concat(prefix, "/mqtypes.ae"))
    aether_source(string.concat(prefix, "/pc2line.ae"))
    aether_source(string.concat(prefix, "/gc_size.ae"))
    aether_source(string.concat(prefix, "/rqsort.ae"))
    aether_source(string.concat(prefix, "/jshelpers.ae"))
    aether_source(string.concat(prefix, "/jsutil2.ae"))
    aether_source(string.concat(prefix, "/regexp_flags.ae"))
    aether_source(string.concat(prefix, "/parse_escape.ae"))
    aether_source(string.concat(prefix, "/mblock.ae"))
    aether_source(string.concat(prefix, "/jscontext.ae"))
    aether_source(string.concat(prefix, "/builtins_misc.ae"))
    aether_source(string.concat(prefix, "/builtins_math.ae"))
    aether_source(string.concat(prefix, "/jsbool.ae"))
    aether_source(string.concat(prefix, "/builtins_number.ae"))
    aether_source(string.concat(prefix, "/builtins_typedarray.ae"))
    aether_source(string.concat(prefix, "/builtins_string.ae"))
    aether_source(string.concat(prefix, "/builtins_regexp.ae"))
    aether_source(string.concat(prefix, "/builtins_numfmt.ae"))
    aether_source(string.concat(prefix, "/builtins_str2.ae"))
    aether_source(string.concat(prefix, "/builtins_charat.ae"))
    aether_source(string.concat(prefix, "/builtins_indexof.ae"))
    aether_source(string.concat(prefix, "/builtins_concat.ae"))
    aether_source(string.concat(prefix, "/builtins_repeat.ae"))
    aether_source(string.concat(prefix, "/builtins_trim.ae"))
    aether_source(string.concat(prefix, "/builtins_strctor.ae"))
    aether_source(string.concat(prefix, "/builtins_object.ae"))
    aether_source(string.concat(prefix, "/builtins_array.ae"))
}

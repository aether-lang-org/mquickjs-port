// Host build-tool predicates ported from mquickjs_build.c. These are pure
// leaves used while baking the stdlib ROM image: is_ascii_string tests a
// byte span for any non-ASCII byte; is_numeric_string recognises the three
// numeric-looking atom names; is_short_int tests whether a double fits the
// engine's short-integer range exactly. Provide the bare C symbols; the C
// bodies in mquickjs_build.c are removed.

import std.mem

extern strcmp(a: ptr, b: ptr) -> int

exports (is_ascii_string, is_numeric_string, is_short_int)

const JS_SHORTINT_MIN = 0 - 1073741824   // -(1<<30)
const JS_SHORTINT_MAX = 1073741823       // (1<<30)-1

// BOOL is_ascii_string(const char *buf, size_t len)
is_ascii_string(buf: ptr, len: long) -> int {
    long base = mem.ptr_to_long(buf)
    long i = 0
    while i < len {
        int c = mem.get_byte(mem.long_to_ptr(base + i), 0) & 0xff
        if c > 0x7f { return 0 }
        i = i + 1
    }
    return 1
}

// BOOL is_numeric_string(const char *buf, size_t len)
is_numeric_string(buf: ptr, len: long) -> int {
    if strcmp(buf, "NaN") == 0 { return 1 }
    if strcmp(buf, "Infinity") == 0 { return 1 }
    if strcmp(buf, "-Infinity") == 0 { return 1 }
    return 0
}

// BOOL is_short_int(double d)
is_short_int(d: float) -> int {
    if d < JS_SHORTINT_MIN { return 0 }
    if d > JS_SHORTINT_MAX { return 0 }
    int i = d                  // (int32_t)d
    float back = i             // compare (int32_t)d == d
    if back != d { return 0 }
    return 1
}

// Unit test for ae/cutils — UTF-8 encode/decode round-trips and the
// string helpers, exercised over malloc'd buffers.

import aeocha
import ae.cutils
import std.mem

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern strcpy(dst: ptr, src: ptr) -> ptr

// Encode codepoint, decode it back, assert round-trip + byte length.
check_roundtrip(fw: ptr, cp: int, want_len: int) {
    buf = malloc(8)
    n = cutils.__unicode_to_utf8(buf, cp)
    aeocha.assert_eq(n, want_len, "encode len")
    slot = malloc(8)
    got = cutils.__unicode_from_utf8(buf, 8, slot)
    aeocha.assert_eq(got, cp, "decode cp")
    aeocha.assert_eq(mem.get_long(slot, 0), want_len, "decode len")
    g2 = cutils.__utf8_get(buf, slot)
    aeocha.assert_eq(g2, cp, "utf8_get cp")
    aeocha.assert_eq(mem.get_long(slot, 0), want_len, "utf8_get len")
    free(slot)
    free(buf)
}

main() {
    fw = aeocha.init()

    aeocha.describe(fw, "cutils utf8") {
        aeocha.it("2-byte (U+00E9 e-acute)") callback {
            check_roundtrip(fw, 0xe9, 2)
        }
        aeocha.it("3-byte (U+20AC euro)") callback {
            check_roundtrip(fw, 0x20ac, 3)
        }
        aeocha.it("4-byte (U+1F600 emoji)") callback {
            check_roundtrip(fw, 0x1f600, 4)
        }
        aeocha.it("decode rejects bad lead byte") callback {
            buf = malloc(8)
            mem.set_byte(buf, 0, 0x80)
            slot = malloc(8)
            r = cutils.__unicode_from_utf8(buf, 8, slot)
            aeocha.assert_eq(r, 0 - 1, "lead 0x80 fails")
            free(slot)
            free(buf)
        }
    }

    aeocha.describe(fw, "cutils strings") {
        aeocha.it("pstrcpy copies and truncates") callback {
            src = malloc(16)
            strcpy(src, "hello")
            dst = malloc(4)
            cutils.pstrcpy(dst, 4, src)        // room for "hel\0"
            aeocha.assert_eq(mem.get_byte(dst, 0), 104, "h")
            aeocha.assert_eq(mem.get_byte(dst, 2), 108, "l")
            aeocha.assert_eq(mem.get_byte(dst, 3), 0, "nul-terminated")
            free(dst)
            free(src)
        }
        aeocha.it("strstart matches prefix") callback {
            s = malloc(16)
            strcpy(s, "foobar")
            pre = malloc(8)
            strcpy(pre, "foo")
            aeocha.assert_eq(cutils.strstart(s, pre, null), 1, "foo prefix")
            no = malloc(8)
            strcpy(no, "bar")
            aeocha.assert_eq(cutils.strstart(s, no, null), 0, "bar not prefix")
            free(no)
            free(pre)
            free(s)
        }
        aeocha.it("has_suffix matches suffix") callback {
            s = malloc(16)
            strcpy(s, "script.js")
            suf = malloc(8)
            strcpy(suf, ".js")
            aeocha.assert_eq(cutils.has_suffix(s, suf), 1, ".js suffix")
            bad = malloc(8)
            strcpy(bad, ".py")
            aeocha.assert_eq(cutils.has_suffix(s, bad), 0, ".py not suffix")
            free(bad)
            free(suf)
            free(s)
        }
    }

    aeocha.run_summary(fw)
}

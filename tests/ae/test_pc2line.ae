// Unit test for ae/pc2line bitstream decoders. Verifies get_bit,
// get_bits, get_bits_slow over known byte patterns, and the
// hoisted-code-len varint decoder.
//
// NB: assertions bind the function result to a local first — a nested
// call expression passed directly as an assert_eq argument inside an
// it() closure mis-evaluates.

import aeocha
import ae.pc2line
import std.mem

extern malloc(n: long) -> ptr
extern free(p: ptr)

main() {
    fw = aeocha.init()

    aeocha.describe(fw, "pc2line get_bit") {
        aeocha.it("reads MSB-first bits") callback {
            buf = malloc(4)
            mem.set_byte(buf, 0, 0xa0)   // 1010 0000
            b0 = pc2line.get_bit(buf, 0)
            b1 = pc2line.get_bit(buf, 1)
            b2 = pc2line.get_bit(buf, 2)
            b3 = pc2line.get_bit(buf, 3)
            aeocha.assert_eq(fw, b0, 1, "bit0=1")
            aeocha.assert_eq(fw, b1, 0, "bit1=0")
            aeocha.assert_eq(fw, b2, 1, "bit2=1")
            aeocha.assert_eq(fw, b3, 0, "bit3=0")
            free(buf)
        }
    }

    aeocha.describe(fw, "pc2line get_bits") {
        aeocha.it("slow path equals fast path for small n") callback {
            buf = malloc(8)
            mem.set_byte(buf, 0, 0xde)
            mem.set_byte(buf, 1, 0xad)
            mem.set_byte(buf, 2, 0xbe)
            mem.set_byte(buf, 3, 0xef)
            mem.set_byte(buf, 4, 0)
            mem.set_byte(buf, 5, 0)
            mem.set_byte(buf, 6, 0)
            mem.set_byte(buf, 7, 0)
            f8 = pc2line.get_bits(buf, 8, 0, 8)
            s8 = pc2line.get_bits_slow(buf, 0, 8)
            aeocha.assert_eq(fw, f8, 0xde, "first byte")
            aeocha.assert_eq(fw, s8, 0xde, "slow first byte")
            f4 = pc2line.get_bits(buf, 8, 0, 4)
            s4 = pc2line.get_bits_slow(buf, 0, 4)
            aeocha.assert_eq(fw, f4, 0xd, "nibble")
            aeocha.assert_eq(fw, s4, 0xd, "slow nibble")
            f16 = pc2line.get_bits(buf, 8, 0, 16)
            s16 = pc2line.get_bits_slow(buf, 0, 16)
            aeocha.assert_eq(fw, f16, 0xdead, "two bytes")
            aeocha.assert_eq(fw, s16, 0xdead, "slow two bytes")
            free(buf)
        }
    }

    aeocha.describe(fw, "pc2line hoisted len") {
        aeocha.it("decodes single-byte varint") callback {
            buf = malloc(4)
            mem.set_byte(buf, 0, 0x05)   // high bit clear -> v=5
            v = pc2line.get_pc2line_hoisted_code_len(buf, 1)
            aeocha.assert_eq(fw, v, 5, "v=5")
            free(buf)
        }
        aeocha.it("decodes multi-byte varint") callback {
            // read from the end: index 1 = last byte (0x82, continue),
            // index 0 = first decoded last (0x01, stop).
            // i=1: v=(0<<7)|2=2 (continue); i=0: v=(2<<7)|1=257 (stop)
            buf = malloc(4)
            mem.set_byte(buf, 0, 0x01)
            mem.set_byte(buf, 1, 0x82)
            v = pc2line.get_pc2line_hoisted_code_len(buf, 2)
            aeocha.assert_eq(fw, v, 257, "v=257")
            free(buf)
        }
    }

    aeocha.run_summary(fw)
}

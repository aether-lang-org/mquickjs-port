// check_circular_ref ported from mquickjs.c: while JSON.stringify walks an
// object graph it pushes each container onto the engine value stack in
// 3-JSValue records. Before descending into `val` this scans those records
// (from ctx->sp up to stack_top) for an identical value and throws a
// TypeError "circular reference" if found. Returns 0 if safe, -1 on throw.
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_throw_circular_ref(ctx: ptr) -> long

exports (check_circular_ref)

const JSON_REC_SIZE = 3   // JSValue units

// int check_circular_ref(JSContext *ctx, JSValue *stack_top, JSValue val)
check_circular_ref(ctx: ptr, stack_top: ptr, val: long) -> int {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    long top = mem.ptr_to_long(stack_top)
    while sp < top {
        if mem.get_long(mem.long_to_ptr(sp), 0) == val {
            js_throw_circular_ref(ctx)
            return 0 - 1
        }
        sp = sp + JSON_REC_SIZE * 8
    }
    return 0
}

// String-coercion + property-key + strict-eq helpers ported from
// mquickjs.c. JS_ToStringCheckObject rejects null/undefined; JS_ToPropertyKey
// canonicalises a property key (int stays, numeric strings become short
// ints, others become unique strings); get_special_prop resolves a ROM
// prototype/constructor index; js_strict_eq_slow is the VM's strict-eq
// slow path. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern JS_ToString(ctx: ptr, val: long) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern is_num_string(ctx: ptr, pval: ptr, val: long) -> int
extern JS_MakeUniqueString(ctx: ptr, val: long) -> long
extern js_strict_eq(ctx: ptr, op1: long, op2: long) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (JS_ToStringCheckObject, JS_ToPropertyKey, get_special_prop,
         js_strict_eq_slow)

const JS_CLASS_TYPE_ERROR = 14
const JSCTX_SP = 32
const JSCTX_CLASS_OBJ = 168
const JSCTX_CLASS_PROTO = 248

// JSValue JS_ToStringCheckObject(JSContext *ctx, JSValue val)
JS_ToStringCheckObject(ctx: ptr, val: long) -> long {
    if val == jstag.JS_NULL { return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "null or undefined are forbidden") }
    if val == jstag.JS_UNDEFINED { return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "null or undefined are forbidden") }
    return JS_ToString(ctx, val)
}

// JSValue JS_ToPropertyKey(JSContext *ctx, JSValue val)
JS_ToPropertyKey(ctx: ptr, val: long) -> long {
    if jstag.is_int(val) != 0 { return val }
    val = JS_ToString(ctx, val)
    if jstag.is_exception(val) != 0 { return val }
    slot = malloc(4)
    int isnum = is_num_string(ctx, slot, val)
    int n = mem.get_int(slot, 0)
    free(slot)
    if isnum != 0 { return jstag.new_short_int(n) }
    return JS_MakeUniqueString(ctx, val)
}

// JSValue get_special_prop(JSContext *ctx, JSValue val) : ROM proto/ctor
get_special_prop(ctx: ptr, val: long) -> long {
    int idx = jstag.get_int(val)
    if idx >= 0 {
        return mem.get_long(ctx, JSCTX_CLASS_PROTO + idx * 8)
    }
    // class_obj[-idx-1]: class_obj is a pointer to a JSValue array @168
    long base = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_CLASS_OBJ))
    int j = (0 - idx) - 1
    return mem.get_long(mem.long_to_ptr(base + j * 8), 0)
}

// JSValue js_strict_eq_slow(JSContext *ctx, BOOL is_neq)
js_strict_eq_slow(ctx: ptr, is_neq: int) -> long {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_SP))
    long op1 = mem.get_long(mem.long_to_ptr(sp + 8), 0)   // ctx->sp[1]
    long op2 = mem.get_long(mem.long_to_ptr(sp), 0)       // ctx->sp[0]
    int res = js_strict_eq(ctx, op1, op2)
    return jstag.new_bool(res ^ is_neq)
}

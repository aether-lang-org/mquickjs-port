// CLI host helpers ported from mqjs.c. js_gc is the `gc()` builtin (run a
// collection, return undefined). is_word / find_keyword back the REPL's
// syntax highlighter: is_word tests an identifier character; find_keyword
// tests whether a buffer span exactly matches one of the '|'-separated words
// in a keyword dictionary. Provide the bare C symbols; the C bodies in mqjs.c
// are removed.

import std.mem
import ae.jstag
import ae.consts

extern JS_GC(ctx: ptr)
extern strchr(s: ptr, c: int) -> ptr
extern memcmp(a: ptr, b: ptr, n: long) -> int
extern putchar(c: int) -> int
extern fwrite(buf: ptr, size: long, nmemb: long, stream: ptr) -> long
extern mqjs_stdout() -> ptr
extern JS_IsString(ctx: ptr, val: long) -> int
extern JS_ToCStringLen(ctx: ptr, plen: ptr, val: long, buf: ptr) -> ptr
extern JS_PrintValueF(ctx: ptr, val: long, flags: int)
extern JS_NewInt64(ctx: ptr, val: long) -> long
extern JS_NewDate(ctx: ptr, epoch_ms: float) -> long
extern JS_IsNumber(ctx: ptr, val: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern mqjs_get_date_ms() -> long
extern mqjs_get_time_ms() -> long
extern JS_ToCString(ctx: ptr, val: long, buf: ptr) -> ptr
extern JS_Eval(ctx: ptr, input: ptr, input_len: int, filename: ptr, eval_flags: int) -> long
extern load_file(filename: ptr, plen: ptr) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern strlen(s: ptr) -> long
extern JS_Parse(ctx: ptr, input: ptr, input_len: long, filename: ptr, eval_flags: int) -> long
extern JS_Run(ctx: ptr, val: long) -> long
extern JS_GetException(ctx: ptr) -> long
extern mqjs_set_log_err_flag(delta: int)
extern mqjs_term_color(idx: int) -> ptr
extern mqjs_stderr() -> ptr
extern mqjs_die(msg: ptr)
extern JS_IsBytecode(buf: ptr, buf_len: long) -> int
extern JS_RelocateBytecode(ctx: ptr, buf: ptr, buf_len: int) -> int
extern JS_LoadBytecode(ctx: ptr, buf: ptr) -> long
extern JS_NewArray(ctx: ptr, initial_len: int) -> long
extern JS_NewString(ctx: ptr, buf: ptr) -> long
extern JS_SetPropertyUint32(ctx: ptr, this_obj: long, idx: int, val: long) -> long
extern JS_GetGlobalObject(ctx: ptr) -> long
extern JS_SetPropertyStr(ctx: ptr, this_obj: long, str: ptr, val: long) -> long
extern JS_PushGCRef(ctx: ptr, ref: ptr) -> ptr
extern JS_PopGCRef(ctx: ptr, ref: ptr) -> long
extern mqjs_compile_new_ctx(mem_buf: ptr, mem_size: long) -> ptr
extern mqjs_write_bytecode(outfilename: ptr, hdr: ptr, hdr_len: int, data_buf: ptr, data_len: int)
extern JS_PrepareBytecode(ctx: ptr, hdr: ptr, pdata_buf: ptr, pdata_len: ptr, eval_code: long)
extern JS_PrepareBytecode64to32(ctx: ptr, hdr: ptr, pdata_buf: ptr, pdata_len: ptr, eval_code: long) -> int
extern JS_RelocateBytecode2(ctx: ptr, hdr: ptr, buf: ptr, buf_len: int, new_base_addr: long, update_atoms: int) -> int
extern JS_DumpMemory(ctx: ptr, is_long: int)
extern JS_FreeContext(ctx: ptr)
extern memset(dst: ptr, c: int, n: long) -> ptr
extern JS_IsFunction(ctx: ptr, val: long) -> int
extern JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int
extern JS_NewInt32(ctx: ptr, val: int) -> long
extern JS_AddGCRef(ctx: ptr, ref: ptr) -> ptr
extern JS_DeleteGCRef(ctx: ptr, ref: ptr)
extern mqjs_timer_list() -> ptr

exports (js_gc, is_word, find_keyword, js_print, js_date_now,
         js_performance_now, js_date_constructor, js_load, term_get_color,
         dump_error, eval_buf, eval_file, compile_file,
         js_setTimeout, js_clearTimeout)


ch_argv(argv: ptr, i: int) -> long { return mem.get_long(mem.long_to_ptr(mem.ptr_to_long(argv) + i * 8), 0) }

// JSValue js_print(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_print(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int i = 0
    while i < argc {
        if i != 0 { putchar(32) }
        long v = ch_argv(argv, i)
        if JS_IsString(ctx, v) != 0 {
            cbuf = malloc(8)           // JSCStringBuf (5 bytes) scratch
            plen = malloc(8)
            strp = JS_ToCStringLen(ctx, plen, v, cbuf)
            long len = mem.get_long(plen, 0)
            fwrite(strp, 1, len, mqjs_stdout())
            free(plen)
            free(cbuf)
        } else {
            JS_PrintValueF(ctx, v, consts.JS_DUMP_LONG)
        }
        i = i + 1
    }
    putchar(10)
    return jstag.JS_UNDEFINED
}

// JSValue js_load(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_load(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    cbuf = malloc(24)                  // JSCStringBuf scratch
    filename = JS_ToCString(ctx, ch_argv(argv, 0), cbuf)
    if mem.ptr_to_long(filename) == 0 { free(cbuf)  return jstag.JS_EXCEPTION }
    plen = malloc(4)
    buf = load_file(filename, plen)
    int buf_len = mem.get_int(plen, 0)
    free(plen)
    long ret = JS_Eval(ctx, buf, buf_len, filename, 0)
    free(buf)
    free(cbuf)
    return ret
}

// JSValue js_date_now(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_date_now(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    return JS_NewInt64(ctx, mqjs_get_date_ms())
}

// JSValue js_performance_now(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_performance_now(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    return JS_NewInt64(ctx, mqjs_get_time_ms())
}

// JSValue js_date_constructor(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_date_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int ac = argc & (0 - 1 - consts.FRAME_CF_CTOR)
    float val = 0.0
    if ac == 0 {
        long ms = mqjs_get_date_ms()
        val = ms
    } else { if ac == 1 && JS_IsNumber(ctx, ch_argv(argv, 0)) != 0 {
        pd = malloc(8)
        int err = JS_ToNumber(ctx, pd, ch_argv(argv, 0))
        val = mem.get_float64(pd, 0)
        free(pd)
        if err != 0 { return jstag.JS_EXCEPTION }
    } else {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "unsupported Date() parameter")
    } }
    return JS_NewDate(ctx, val)
}

// JSValue js_gc(JSContext *ctx, JSValue *this_val, int argc, JSValue *argv)
js_gc(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    JS_GC(ctx)
    return jstag.JS_UNDEFINED
}

// BOOL is_word(int c)
is_word(c: int) -> int {
    if c >= 48 && c <= 57 { return 1 }    // '0'..'9'
    if c >= 65 && c <= 90 { return 1 }    // 'A'..'Z'
    if c >= 97 && c <= 122 { return 1 }   // 'a'..'z'
    if c == 95 { return 1 }               // '_'
    if c == 36 { return 1 }               // '$'
    return 0
}

// BOOL find_keyword(const char *buf, size_t buf_len, const char *dict)
find_keyword(buf: ptr, buf_len: long, dict: ptr) -> int {
    long p = mem.ptr_to_long(dict)
    while mem.get_byte(mem.long_to_ptr(p), 0) != 0 {
        r = strchr(mem.long_to_ptr(p), 124)   // '|'
        if mem.ptr_to_long(r) == 0 { return 0 }
        long rl = mem.ptr_to_long(r)
        if (rl - p) == buf_len {
            if memcmp(buf, mem.long_to_ptr(p), buf_len) == 0 { return 1 }
        }
        p = rl + 1
    }
    return 0
}

// COLOR_* values (readline.h) returned as the syntax style.
const COLOR_GREEN = 3
const COLOR_CYAN = 7
const COLOR_WHITE = 8
const COLOR_BRIGHT_YELLOW = 12
const COLOR_BRIGHT_MAGENTA = 14
const COLOR_BRIGHT_CYAN = 15
const COLOR_BRIGHT_GREEN = 11
const COLOR_BRIGHT_WHITE = 16
const COLOR_NONE = 0
const COLOR_BRIGHT_RED = 10
const STYLE_RESULT = 16     // COLOR_BRIGHT_WHITE
const STYLE_ERROR_MSG = 10  // COLOR_BRIGHT_RED

ch_keywords() -> ptr {
    return "break|case|catch|continue|debugger|default|delete|do|else|finally|for|function|if|in|instanceof|new|return|switch|this|throw|try|typeof|while|with|class|const|enum|import|export|extends|super|implements|interface|let|package|private|protected|public|static|yield|undefined|null|true|false|Infinity|NaN|eval|arguments|await|"
}
ch_types() -> ptr { return "void|var|" }

ch_byte(buf: ptr, pos: int) -> int { return mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(buf) + pos), 0) & 0xff }

// int term_get_color(int *plen, const char *buf, int pos, int buf_len):
// REPL syntax highlighter. Returns the COLOR_* style for the token at
// `pos` and writes its length to *plen. Mirrors the former C term_get_color.
term_get_color(plen: ptr, buf: ptr, pos: int, buf_len: int) -> int {
    int c = ch_byte(buf, pos)
    int color = COLOR_BRIGHT_GREEN          // STYLE_DEFAULT
    int len = 1
    if c == 34 || c == 39 {                 // '"' or '\''
        int pos1 = pos + 1
        int loop = 1
        while loop != 0 {
            int b = ch_byte(buf, pos1)
            if b == 0 || b == c { loop = 0 }
            else if b == 92 && ch_byte(buf, pos1 + 1) != 0 { pos1 = pos1 + 2 }
            else { pos1 = pos1 + 1 }
        }
        if ch_byte(buf, pos1) != 0 { pos1 = pos1 + 1 }
        len = pos1 - pos
        color = COLOR_BRIGHT_CYAN           // STYLE_STRING
    } else if c == 47 && ch_byte(buf, pos + 1) == 42 {   // '/' '*'
        int pos1 = pos + 2
        while ch_byte(buf, pos1) != 0 && !(ch_byte(buf, pos1) == 42 && ch_byte(buf, pos1 + 1) == 47) {
            pos1 = pos1 + 1
        }
        if ch_byte(buf, pos1) != 0 { pos1 = pos1 + 2 }
        len = pos1 - pos
        color = COLOR_WHITE                 // STYLE_COMMENT
    } else if (c >= 48 && c <= 57) || c == 46 {          // digit or '.'
        int pos1 = pos + 1
        while is_word(ch_byte(buf, pos1)) != 0 { pos1 = pos1 + 1 }
        len = pos1 - pos
        color = COLOR_GREEN                 // STYLE_NUMBER
    } else if is_word(c) != 0 {
        int pos1 = pos + 1
        while is_word(ch_byte(buf, pos1)) != 0 { pos1 = pos1 + 1 }
        len = pos1 - pos
        tokptr = mem.long_to_ptr(mem.ptr_to_long(buf) + pos)
        if find_keyword(tokptr, len, ch_keywords()) != 0 {
            color = COLOR_BRIGHT_WHITE      // STYLE_KEYWORD
        } else {
            while ch_byte(buf, pos1) == 32 { pos1 = pos1 + 1 }
            if ch_byte(buf, pos1) == 40 {   // '('
                color = COLOR_BRIGHT_YELLOW // STYLE_FUNCTION
            } else if find_keyword(tokptr, len, ch_types()) != 0 {
                color = COLOR_BRIGHT_MAGENTA // STYLE_TYPE
            } else {
                color = COLOR_BRIGHT_GREEN  // STYLE_IDENTIFIER
            }
        }
    }
    mem.set_int(plen, 0, len)
    return color
}

// Emit a color escape (term_colors[idx]) to the given stream.
put_color(stream: ptr, idx: int) {
    s = mqjs_term_color(idx)
    fwrite(s, 1, strlen(s), stream)
}

// void dump_error(JSContext *ctx): print the pending exception in red to
// stderr, routing the engine's value-printer through js_log_func (stderr).
dump_error(ctx: ptr) {
    long obj = JS_GetException(ctx)
    err = mqjs_stderr()
    put_color(err, STYLE_ERROR_MSG)
    mqjs_set_log_err_flag(1)
    JS_PrintValueF(ctx, obj, consts.JS_DUMP_LONG)
    mqjs_set_log_err_flag(-1)
    put_color(err, COLOR_NONE)
    fwrite("\n", 1, 1, err)
}

// int eval_buf(ctx, eval_str, filename, is_repl, parse_flags): parse+run a
// source string. On exception, dump it (returns 1). In REPL mode, print the
// result value in bright white (returns 0).
eval_buf(ctx: ptr, eval_str: ptr, filename: ptr, is_repl: int, parse_flags: int) -> int {
    int flags = parse_flags
    if is_repl != 0 {
        flags = flags | consts.JS_EVAL_RETVAL | consts.JS_EVAL_REPL
    }
    long val = JS_Parse(ctx, eval_str, strlen(eval_str), filename, flags)
    if val != jstag.JS_EXCEPTION {
        val = JS_Run(ctx, val)
    }
    if val == jstag.JS_EXCEPTION {
        dump_error(ctx)
        return 1
    }
    if is_repl != 0 {
        out = mqjs_stdout()
        put_color(out, STYLE_RESULT)
        JS_PrintValueF(ctx, val, consts.JS_DUMP_LONG)
        put_color(out, COLOR_NONE)
        fwrite("\n", 1, 1, out)
    }
    return 0
}

// int eval_file(ctx, filename, argc, argv, parse_flags, allow_bytecode):
// load + parse-or-load-bytecode + run a file. If argc>0, expose argv as the
// global scriptArgs array (GC-rooting val and arr across the allocations).
eval_file(ctx: ptr, filename: ptr, argc: int, argv: ptr, parse_flags: int, allow_bytecode: int) -> int {
    plen = malloc(4)
    buf = load_file(filename, plen)
    int buf_len = mem.get_int(plen, 0)
    free(plen)

    long val = 0
    if allow_bytecode != 0 && JS_IsBytecode(buf, buf_len) != 0 {
        if JS_RelocateBytecode(ctx, buf, buf_len) != 0 {
            mqjs_die("Could not relocate bytecode")
        }
        val = JS_LoadBytecode(ctx, buf)
    } else {
        val = JS_Parse(ctx, buf, buf_len, filename, parse_flags)
    }

    int ret = 0
    if val == jstag.JS_EXCEPTION {
        dump_error(ctx)
        free(buf)
        return 1
    }

    if argc > 0 {
        // GC-roots: val_ref then arr_ref (each a 16-byte JSGCRef).
        val_ref = malloc(16)
        JS_PushGCRef(ctx, val_ref)
        mem.set_long(val_ref, 0, val)             // val_ref.val = val
        // arr must be created after JS_LoadBytecode()
        long arr = JS_NewArray(ctx, argc)
        arr_ref = malloc(16)
        JS_PushGCRef(ctx, arr_ref)
        mem.set_long(arr_ref, 0, arr)             // arr_ref.val = arr
        int i = 0
        while i < argc {
            argp = mem.get_ptr(mem.long_to_ptr(mem.ptr_to_long(argv) + i * 8), 0)
            JS_SetPropertyUint32(ctx, mem.get_long(arr_ref, 0), i, JS_NewString(ctx, argp))
            i = i + 1
        }
        arr = JS_PopGCRef(ctx, arr_ref)           // reload arr after allocs
        free(arr_ref)
        long obj = JS_GetGlobalObject(ctx)
        JS_SetPropertyStr(ctx, obj, "scriptArgs", arr)
        val = JS_PopGCRef(ctx, val_ref)           // reload val
        free(val_ref)
    }

    val = JS_Run(ctx, val)
    if val == jstag.JS_EXCEPTION {
        dump_error(ctx)
        ret = 1
    }
    free(buf)
    return ret
}

// Bytecode header sizes for this host (JSW==8): full 32 bytes, 32-bit 16.
const BYTECODE_HDR_LEN = 32
const BYTECODE_HDR32_LEN = 16

// void compile_file(filename, outfilename, mem_size, dump_memory, parse_flags,
//                   force_32bit): parse a file in a throwaway context and write
// its (optionally 64->32 converted) bytecode to outfilename.
compile_file(filename: ptr, outfilename: ptr, mem_size: long, dump_memory: int, parse_flags: int, force_32bit: int) {
    // A throwaway context: the stdlib content does not affect generated
    // bytecode, but its atoms must exist for parsing. Discarded after.
    mem_buf = malloc(mem_size)
    ctx = mqjs_compile_new_ctx(mem_buf, mem_size)

    eval_str = load_file(filename, null)
    long val = JS_Parse(ctx, eval_str, strlen(eval_str), filename, parse_flags)
    free(eval_str)
    if val == jstag.JS_EXCEPTION {
        dump_error(ctx)
        return
    }

    hdr = malloc(BYTECODE_HDR_LEN)      // union { JSBytecodeHeader; ...32 }
    memset(hdr, 0, BYTECODE_HDR_LEN)    // zero the alignment padding for a
                                        // deterministic file (the prepare
                                        // calls leave inter-field padding)
    pdata_buf = malloc(8)               // const uint8_t **
    pdata_len = malloc(4)               // uint32_t *
    int hdr_len = 0

    if force_32bit != 0 {
        if JS_PrepareBytecode64to32(ctx, hdr, pdata_buf, pdata_len, val) != 0 {
            mqjs_die("Could not convert the bytecode from 64 to 32 bits")
        }
        hdr_len = BYTECODE_HDR32_LEN
    } else {
        JS_PrepareBytecode(ctx, hdr, pdata_buf, pdata_len, val)
        if dump_memory != 0 {
            int is_long = 0
            if dump_memory >= 2 { is_long = 1 }
            JS_DumpMemory(ctx, is_long)
        }
        // Relocate to base 0 for deterministic output. JS_DumpMemory cannot
        // run once relocated, so relocate after it.
        data_buf = mem.get_ptr(pdata_buf, 0)
        int data_len = mem.get_int(pdata_len, 0)
        JS_RelocateBytecode2(ctx, hdr, data_buf, data_len, 0, 0)
        hdr_len = BYTECODE_HDR_LEN
    }

    data_buf = mem.get_ptr(pdata_buf, 0)
    int data_len = mem.get_int(pdata_len, 0)
    mqjs_write_bytecode(outfilename, hdr, hdr_len, data_buf, data_len)

    free(pdata_len)
    free(pdata_buf)
    free(hdr)
    JS_FreeContext(ctx)
    free(mem_buf)
}

// Timer table: JSTimer stride 32 { allocated@0(int), func@8(JSGCRef 16B:
// val@8/prev@16), timeout@24(int64) }. MAX_TIMERS = 16.
const TIMER_STRIDE = 32
const TIMER_ALLOCATED = 0
const TIMER_FUNC = 8
const TIMER_TIMEOUT = 24
const MAX_TIMERS = 16

timer_at(base: ptr, i: int) -> ptr {
    return mem.long_to_ptr(mem.ptr_to_long(base) + i * TIMER_STRIDE)
}

// JSValue js_setTimeout(ctx, this_val, argc, argv): register argv[0] to fire
// after argv[1] ms. Returns the timer id, or throws if full / bad args.
js_setTimeout(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long fn_val = ch_argv(argv, 0)
    if JS_IsFunction(ctx, fn_val) == 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }
    pdelay = malloc(4)
    int err = JS_ToInt32(ctx, pdelay, ch_argv(argv, 1))
    int delay = mem.get_int(pdelay, 0)
    free(pdelay)
    if err != 0 { return jstag.JS_EXCEPTION }

    base = mqjs_timer_list()
    int i = 0
    while i < MAX_TIMERS {
        th = timer_at(base, i)
        if mem.get_int(th, TIMER_ALLOCATED) == 0 {
            // pfunc = JS_AddGCRef(ctx, &th->func); *pfunc = argv[0]
            pfunc = JS_AddGCRef(ctx, mem.long_to_ptr(mem.ptr_to_long(th) + TIMER_FUNC))
            mem.set_long(pfunc, 0, fn_val)
            mem.set_long(th, TIMER_TIMEOUT, mqjs_get_time_ms() + delay)
            mem.set_int(th, TIMER_ALLOCATED, 1)
            return JS_NewInt32(ctx, i)
        }
        i = i + 1
    }
    return JS_ThrowError(ctx, consts.JS_CLASS_INTERNAL_ERROR, "too many timers")
}

// JSValue js_clearTimeout(ctx, this_val, argc, argv): cancel timer argv[0].
js_clearTimeout(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    pid = malloc(4)
    int err = JS_ToInt32(ctx, pid, ch_argv(argv, 0))
    int timer_id = mem.get_int(pid, 0)
    free(pid)
    if err != 0 { return jstag.JS_EXCEPTION }

    if timer_id >= 0 && timer_id < MAX_TIMERS {
        base = mqjs_timer_list()
        th = timer_at(base, timer_id)
        if mem.get_int(th, TIMER_ALLOCATED) != 0 {
            JS_DeleteGCRef(ctx, mem.long_to_ptr(mem.ptr_to_long(th) + TIMER_FUNC))
            mem.set_int(th, TIMER_ALLOCATED, 0)
        }
    }
    return jstag.JS_UNDEFINED
}

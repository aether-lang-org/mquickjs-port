// Engine-state struct overlays. Each extern struct byte-for-byte
// mirrors a C struct from mquickjs.c so engine code can touch fields
// directly via (ptr as *Type).field instead of through accessor
// shims. Correctness depends on offsets matching the C side exactly;
// ae/layout_guard.c carries _Static_asserts that fail the build if a
// C struct ever changes shape.
//
// Conventions:
//  - JSWord = uint64_t (8 bytes), JSW = 8. JS_MB_HEADER = gc_mark:1 +
//    mtag:3. JS_MB_PAD(n) = 64 - n.
//  - JSValue fields are `long` (8 bytes).
//  - Flexible-array tails (buf[]/arr[]) reached via base + offset
//    arithmetic, not element indexing.
//  - Unions are not declared inline; use an offset const + cast.
//  - Reserved field names (message, func) get a trailing underscore;
//    only the byte offset matters.

// JSMemBlockHeader mtag values (JS_MTAG_*). gc_mark is bit 0, mtag is
// bits 1..3. (No exports list in this module — overlays and consts
// stay default-public so engine code can reach the struct types.)
import ae.consts

// sizeof/offsetof constants (verified by ae/layout_guard.c, JSW=8).

// --- memory-block header bit layout ---------------------------------
// Every GC block starts with gc_mark:1, mtag:3 (JS_MTAG_BITS = 4).

// JSString: header(4) + is_unique:1 + is_ascii:1 + is_numeric:1 +
// len:57, then buf[] at offset 8.
extern struct JSString {
    gc_mark:    uint64_t : 1
    mtag:       uint64_t : 3
    is_unique:  uint64_t : 1
    is_ascii:   uint64_t : 1
    is_numeric: uint64_t : 1
    len:        uint64_t : 57
    buf:        byte[]
}

// JSByteArray: header(4) + size:60, then buf[] at offset 8.
extern struct JSByteArray {
    gc_mark: uint64_t : 1
    mtag:    uint64_t : 3
    size:    uint64_t : 60
    buf:     byte[]
}

// JSValueArray: header(4) + size:60, then arr[] (JSValue) at offset 8.
extern struct JSValueArray {
    gc_mark: uint64_t : 1
    mtag:    uint64_t : 3
    size:    uint64_t : 60
    arr:     long[0]
}

// JSObject: header(4) + class_id:8 + extra_size:52, then proto
// (JSValue @8), props (JSValue @16), union u @24.
extern struct JSObject {
    gc_mark:    uint64_t : 1
    mtag:       uint64_t : 3
    class_id:   uint64_t : 8
    extra_size: uint64_t : 52
    proto:      long
    props:      long
}

// JSObject union variants (selected by class_id), each at u offset 24.
extern struct JSClosureData {
    func_bytecode: long
    // var_refs[] follows
}

extern struct JSCFunctionData {
    idx:    uint32_t
    params: long      // JSValue; +4 padding before it in C? see guard
}

extern struct JSArrayData {
    tab: long         // JS_NULL or JSValueArray
    len: uint32_t
}

extern struct JSErrorData {
    message_: long    // JSValue string or JS_NULL
    stack:    long
}

extern struct JSArrayBuffer {
    byte_buffer: long
}

extern struct JSTypedArray {
    buffer: long
    len:    uint32_t
    offset: uint32_t
}

extern struct JSRegExp {
    source:     long
    byte_code:  long
    last_index: int
}

extern struct JSDate {
    dval: float
}

extern struct JSObjectUserData {
    opaque: ptr
}

// JSProperty: key(JSValue @0), value(JSValue @8), then
// hash_next:30 + prop_type:2 (uint32_t @16). Size 24 (8-byte aligned).
extern struct JSProperty {
    key:   long
    value: long
    hash_next: uint32_t : 30
    prop_type: uint32_t : 2
}

// JSVarRef: header(4) + is_detached:1 + dummy:59, then union u @8
// (value | {next, pvalue}).
extern struct JSVarRef {
    gc_mark:     uint64_t : 1
    mtag:        uint64_t : 3
    is_detached: uint64_t : 1
    dummy:       uint64_t : 59
}

// JSFunctionBytecode: header(4) + has_arguments:1 + has_local_func_name:1
// + has_column:1 + arg_count:16 + dummy:41 (8 bytes), then JSValues and
// trailing scalars.
extern struct JSFunctionBytecode {
    gc_mark:             uint64_t : 1
    mtag:                uint64_t : 3
    has_arguments:       uint64_t : 1
    has_local_func_name: uint64_t : 1
    has_column:          uint64_t : 1
    arg_count:           uint64_t : 16
    dummy:               uint64_t : 41
    func_name:   long    // @8
    byte_code:   long    // @16
    cpool:       long    // @24
    vars:        long    // @32
    ext_vars:    long    // @40
    stack_size:    uint16_t  // @48
    ext_vars_len:  uint16_t  // @50
    // pad to 8-byte alignment before next JSValue
    pad_:        uint32_t  // @52
    filename:    long    // @56
    pc2line:     long    // @64
    source_pos:  uint32_t  // @72
}

// JSContext head — the engine's root state. Modeled field-by-field so
// offsets match the C struct (verified in layout_guard.c). Pointer
// fields are `ptr`, JSValue fields are `long`. Explicit pad fields fill
// C alignment / fields not needed by ported code.
extern struct JSContext {
    heap_base:    ptr    // @0
    heap_free:    ptr    // @8
    stack_top:    ptr    // @16
    stack_bottom: ptr    // @24
    sp:           ptr    // @32
    fp:           ptr    // @40
    min_free_size: uint32_t  // @48
    in_out_of_memory:        uint8_t  // @52 (BOOL:8)
    n_rom_atom_tables:       uint8_t  // @53
    string_pos_cache_counter: uint8_t // @54
    flags_pad55_:            uint8_t  // @55
    class_count:             uint16_t // @56
    interrupt_counter:       uint16_t // @58 (int16)
    current_exception_is_uncatchable: uint8_t // @60 (BOOL:8)
    flags_pad61_:            uint8_t  // @61
    flags_pad62_:            uint16_t // @62
    parse_state:  ptr    // @64
    unique_strings_len: int  // @72
    js_call_rec_count:  int  // @76
    top_gc_ref:   ptr    // @80
    last_gc_ref:  ptr    // @88
    atom_table:   ptr    // @96
    rom_atom_0_:  ptr    // @104
    rom_atom_1_:  ptr    // @112
    c_function_table: ptr  // @120
    c_finalizer_table: ptr // @128
    random_state: long   // @136
    interrupt_handler: ptr // @144
    write_func:   ptr    // @152
    opaque:       ptr    // @160
    class_obj:    ptr    // @168
    // @176: string_pos_cache[2] = 2 * {JSValue str, uint32 str_pos[2]} = 2*16 = 32
    spc_0_str:    long   // @176
    spc_0_pos:    long   // @184
    spc_1_str:    long   // @192
    spc_1_pos:    long   // @200
    unique_strings:    long  // @208
    current_exception: long  // @216
    empty_props:  long   // @224
    global_obj:   long   // @232
    minus_zero:   long   // @240
    // class_proto[] flexible tail @248
}

// JSParseState — parser state. Offsets verified in layout_guard.c.
// jmp_env (jmp_buf, 200 bytes @144) is opaque here; the parser's
// setjmp/longjmp escape is replaced by try/catch on the Aether side.
extern struct JSParseState {
    ctx:          ptr     // @0
    // JSToken token @8 (24 bytes): val(int)@8, source_pos(u32)@12,
    //   u@16 (double d | {re_flags,re_end_pos}), value(JSValue)@24
    tok_val:      int     // @8
    tok_source_pos: uint32_t  // @12
    tok_u_lo:     uint32_t // @16 (re_flags, or low half of d)
    tok_u_hi:     uint32_t // @20 (re_end_pos, or high half of d)
    tok_value:    long    // @24
    got_lf:       uint8_t // @32
    is_eval:      uint8_t // @33
    has_retval:   uint8_t // @34
    is_repl:      uint8_t // @35
    has_column:   uint8_t // @36
    dropped_result: uint8_t // @37
    pad38_:       uint16_t // @38
    source_str:   long    // @40
    filename_str: long    // @48
    source_buf:   ptr     // @56
    buf_pos:      uint32_t // @64
    buf_len:      uint32_t // @68
    cur_func:     long    // @72
    byte_code:    long    // @80
    byte_code_len: uint32_t // @88
    last_opcode_pos: int  // @92
    last_pc2line_pos: int // @96
    last_pc2line_source_pos: uint32_t // @100
    pc2line_bit_len: uint32_t // @104
    pc2line_source_pos: uint32_t // @108
    cpool_len:    uint16_t // @112
    pad114_:      uint16_t // @114
    hoisted_code_len: uint32_t // @116
    local_vars_len: uint16_t // @120
    pad122_:      uint16_t // @122
    eval_ret_idx: int     // @124
    top_break:    long    // @128
    capture_count: uint8_t // @136
    re_flags_bits: uint8_t // @137 (re_in_js:1,multi_line:1,dotall:1,ignore_case:1,is_unicode:1)
    // jmp_env @144 (opaque 200 bytes), error_msg[64] @344
}

// JS_DefinePropertyInternal ported from mquickjs.c: define or redefine an
// own property as a value, a global var-ref, or a getter/setter pair.
// Copies ROM props to RAM, optionally looks up an existing record to
// update in place (rejecting kind changes), and otherwise creates a fresh
// record. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_update_props(ctx: ptr, obj: long) -> int
extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr
extern js_malloc(ctx: ptr, size: int, mtag: int) -> ptr
extern js_create_property(ctx: ptr, obj: long, prop: long) -> ptr
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (JS_DefinePropertyInternal)

const JS_MTAG_VARREF = 7
const SIZEOF_JSVARREF_DETACHED = 16     // sizeof(JSVarRef) - sizeof(JSValue)
const JSCTX_GLOBAL_OBJ = 232
const JSCTX_TOP_GC_REF = 80
const JSCTX_STACK_TOP = 16
const VA_ARR = 8
const PROP_VALUE = 8
const PROP_HASH_NEXT = 16
const VARREF_VALUE = 8

const JS_PROP_NORMAL = 0
const JS_PROP_GETSET = 1
const JS_PROP_VARREF = 2

const JS_DEF_PROP_LOOKUP = 1
const JS_DEF_PROP_RET_VAL = 2
const JS_DEF_PROP_HAS_VALUE = 4
const JS_DEF_PROP_HAS_GET = 8
const JS_DEF_PROP_HAS_SET = 16

dpi_prop_type(pr: ptr) -> int { int w = mem.get_int(pr, PROP_HASH_NEXT)  return (w >> 30) & 3 }
dpi_set_prop_type(pr: ptr, pt: int) {
    int w = mem.get_int(pr, PROP_HASH_NEXT)
    long lo = (w & 0xffffffff) & 0x3fffffff
    long ptl = pt
    long nw = lo | (ptl << 30)
    mem.set_int(pr, PROP_HASH_NEXT, nw)
}

dpi_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias  long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
dpi_is_rom(ctx: ptr, pp: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_STACK_TOP))
    if dpi_ult(pp, ctxl) != 0 { return 1 }
    if dpi_ult(pp, stop) == 0 { return 1 }
    return 0
}

// push a 4-value GC-root box (obj, prop, val, setter) and run js_update_props.
// returns the (possibly relocated) values via the box; result int = update ret.
flag_has(flags: int, bit: int) -> int { if (flags & bit) != 0 { return 1 } return 0 }

// JSValue JS_DefinePropertyInternal(JSContext *ctx, JSValue obj, JSValue prop, JSValue val, JSValue setter, int flags)
JS_DefinePropertyInternal(ctx: ptr, obj: long, prop: long, val: long, setter: long, flags: int) -> long {
    // GC-root obj/prop/val/setter across js_update_props (4 refs)
    box = malloc(64)
    mem.set_long(box, 0, obj)     mem.set_ptr(box, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
    mem.set_long(box, 16, prop)   mem.set_ptr(box, 24, mem.long_to_ptr(mem.ptr_to_long(box)))
    mem.set_long(box, 32, val)    mem.set_ptr(box, 40, mem.long_to_ptr(mem.ptr_to_long(box) + 16))
    mem.set_long(box, 48, setter) mem.set_ptr(box, 56, mem.long_to_ptr(mem.ptr_to_long(box) + 32))
    mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box) + 48))
    int ret = js_update_props(ctx, obj)
    obj = mem.get_long(box, 0)  prop = mem.get_long(box, 16)
    val = mem.get_long(box, 32)  setter = mem.get_long(box, 48)
    mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(box, 8))
    free(box)
    if ret != 0 { return jstag.JS_EXCEPTION }

    long pr_done = 0
    int found_done = 0

    if flag_has(flags, JS_DEF_PROP_LOOKUP) != 0 {
        pr = find_own_property(ctx, jstag.value_to_ptr(obj), prop)
        if pr != null {
            if flag_has(flags, JS_DEF_PROP_HAS_VALUE) != 0 {
                int pt = dpi_prop_type(pr)
                if pt == JS_PROP_NORMAL {
                    mem.set_long(pr, PROP_VALUE, val)
                } else { if pt == JS_PROP_VARREF {
                    pv = jstag.value_to_ptr(mem.get_long(pr, PROP_VALUE))
                    mem.set_long(pv, VARREF_VALUE, val)
                } else {
                    return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot modify getter/setter/value kind")
                } }
            } else {
                if flag_has(flags, JS_DEF_PROP_HAS_GET) != 0 || flag_has(flags, JS_DEF_PROP_HAS_SET) != 0 {
                    if dpi_prop_type(pr) != JS_PROP_GETSET {
                        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot modify getter/setter/value kind")
                    }
                    long gsv = mem.get_long(pr, PROP_VALUE)
                    arr = jstag.value_to_ptr(gsv)
                    if dpi_is_rom(ctx, mem.ptr_to_long(arr)) != 0 {
                        // move getset array to RAM
                        box2 = malloc(64)
                        mem.set_long(box2, 0, obj)     mem.set_ptr(box2, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
                        mem.set_long(box2, 16, prop)   mem.set_ptr(box2, 24, mem.long_to_ptr(mem.ptr_to_long(box2)))
                        mem.set_long(box2, 32, val)    mem.set_ptr(box2, 40, mem.long_to_ptr(mem.ptr_to_long(box2) + 16))
                        mem.set_long(box2, 48, setter) mem.set_ptr(box2, 56, mem.long_to_ptr(mem.ptr_to_long(box2) + 32))
                        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box2) + 48))
                        arr2 = js_alloc_value_array(ctx, 0, 2)
                        obj = mem.get_long(box2, 0)  prop = mem.get_long(box2, 16)
                        val = mem.get_long(box2, 32)  setter = mem.get_long(box2, 48)
                        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(box2, 8))
                        free(box2)
                        if arr2 == null { return jstag.JS_EXCEPTION }
                        pr = find_own_property(ctx, jstag.value_to_ptr(obj), prop)
                        arr = jstag.value_to_ptr(mem.get_long(pr, PROP_VALUE))
                        long ab = mem.ptr_to_long(arr2) + VA_ARR
                        long ob = mem.ptr_to_long(arr) + VA_ARR
                        mem.set_long(mem.long_to_ptr(ab), 0, mem.get_long(mem.long_to_ptr(ob), 0))
                        mem.set_long(mem.long_to_ptr(ab + 8), 0, mem.get_long(mem.long_to_ptr(ob + 8), 0))
                        mem.set_long(pr, PROP_VALUE, jstag.value_from_ptr(arr2))
                        arr = arr2
                    }
                    long abase = mem.ptr_to_long(arr) + VA_ARR
                    if flag_has(flags, JS_DEF_PROP_HAS_GET) != 0 { mem.set_long(mem.long_to_ptr(abase), 0, val) }
                    if flag_has(flags, JS_DEF_PROP_HAS_SET) != 0 { mem.set_long(mem.long_to_ptr(abase + 8), 0, setter) }
                }
            }
            pr_done = mem.ptr_to_long(pr)
            found_done = 1
        }
    }

    if found_done == 0 {
        int prop_type = JS_PROP_NORMAL
        if flag_has(flags, JS_DEF_PROP_HAS_GET) != 0 || flag_has(flags, JS_DEF_PROP_HAS_SET) != 0 {
            prop_type = JS_PROP_GETSET
            // build [val, setter] array (GC-root all 4)
            box3 = malloc(64)
            mem.set_long(box3, 0, obj)     mem.set_ptr(box3, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
            mem.set_long(box3, 16, prop)   mem.set_ptr(box3, 24, mem.long_to_ptr(mem.ptr_to_long(box3)))
            mem.set_long(box3, 32, val)    mem.set_ptr(box3, 40, mem.long_to_ptr(mem.ptr_to_long(box3) + 16))
            mem.set_long(box3, 48, setter) mem.set_ptr(box3, 56, mem.long_to_ptr(mem.ptr_to_long(box3) + 32))
            mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box3) + 48))
            arr = js_alloc_value_array(ctx, 0, 2)
            obj = mem.get_long(box3, 0)  prop = mem.get_long(box3, 16)
            val = mem.get_long(box3, 32)  setter = mem.get_long(box3, 48)
            mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(box3, 8))
            free(box3)
            if arr == null { return jstag.JS_EXCEPTION }
            long ab = mem.ptr_to_long(arr) + VA_ARR
            mem.set_long(mem.long_to_ptr(ab), 0, val)
            mem.set_long(mem.long_to_ptr(ab + 8), 0, setter)
            val = jstag.value_from_ptr(arr)
        } else {
            if obj == mem.get_long(ctx, JSCTX_GLOBAL_OBJ) {
                prop_type = JS_PROP_VARREF
                // GC-root obj/prop/val across js_malloc
                box4 = malloc(48)
                mem.set_long(box4, 0, obj)   mem.set_ptr(box4, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
                mem.set_long(box4, 16, prop) mem.set_ptr(box4, 24, mem.long_to_ptr(mem.ptr_to_long(box4)))
                mem.set_long(box4, 32, val)  mem.set_ptr(box4, 40, mem.long_to_ptr(mem.ptr_to_long(box4) + 16))
                mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box4) + 32))
                pv = js_malloc(ctx, SIZEOF_JSVARREF_DETACHED, JS_MTAG_VARREF)
                obj = mem.get_long(box4, 0)  prop = mem.get_long(box4, 16)  val = mem.get_long(box4, 32)
                mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(box4, 8))
                free(box4)
                if pv == null { return jstag.JS_EXCEPTION }
                // is_detached = TRUE (bit 4): js_malloc wrote header=mtag<<1
                long hdr = mem.get_long(pv, 0)
                mem.set_long(pv, 0, hdr | 16)
                mem.set_long(pv, VARREF_VALUE, val)
                val = jstag.value_from_ptr(pv)
            }
        }

        // GC-root val across js_create_property
        box5 = malloc(16)
        mem.set_long(box5, 0, val)
        mem.set_ptr(box5, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, box5)
        pr = js_create_property(ctx, obj, prop)
        val = mem.get_long(box5, 0)
        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(box5, 8))
        free(box5)
        if pr == null { return jstag.JS_EXCEPTION }
        dpi_set_prop_type(pr, prop_type)
        mem.set_long(pr, PROP_VALUE, val)
        pr_done = mem.ptr_to_long(pr)
    }

    if flag_has(flags, JS_DEF_PROP_RET_VAL) != 0 {
        return mem.get_long(mem.long_to_ptr(pr_done), PROP_VALUE)
    }
    return jstag.JS_UNDEFINED
}

extern malloc(n: long) -> ptr
extern free(p: ptr)

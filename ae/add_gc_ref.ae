// JS_AddGCRef ported from mquickjs.c: a public embedder API that links a
// caller-owned JSGCRef into the context's persistent GC-root chain
// (ctx->last_gc_ref), initialises its slot to undefined, and returns a
// pointer to that slot so the embedder can store a value the GC must keep
// alive. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

exports (JS_AddGCRef)


// JSValue *JS_AddGCRef(JSContext *ctx, JSGCRef *ref)
JS_AddGCRef(ctx: ptr, ref: ptr) -> ptr {
    mem.set_ptr(ref, consts.GCREF_PREV, (ctx as *JSContext).last_gc_ref)
    (ctx as *JSContext).last_gc_ref = ref
    mem.set_long(ref, consts.GCREF_VAL, jstag.JS_UNDEFINED)
    return mem.long_to_ptr(mem.ptr_to_long(ref) + consts.GCREF_VAL)
}

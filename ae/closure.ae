// js_closure ported from mquickjs.c: build a closure object for a parsed
// function, capturing each external variable as a JSVarRef from the
// creating frame (an argument, a local, a parent var-ref, or a global).
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts
import ae.getpkg

extern JS_NewObjectProtoClass(ctx: ptr, proto: long, class_id: int, extra_size: int) -> long
extern add_global_var(ctx: ptr, prop: long, define_flag: int) -> long
extern memset(dst: ptr, c: int, n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_closure)

// frame offsets (JSValue units): ARG0=4, FUNC_OBJ=3, FIRST_VARREF=-2, VAR0=-3
const FO_ARG0 = 4
const FO_FUNC_OBJ = 3
const FO_FIRST_VARREF = 0 - 2
const FO_VAR0 = 0 - 3

clo_va_size(arr: long) -> int { long h = mem.get_long(mem.long_to_ptr(arr), 0)  long s = h >> 4  return s }
// fp[i] byte address (fp is a JSValue*)
fpa(fp: ptr, i: int) -> long { return mem.ptr_to_long(fp) + i * 8 }

// JSValue js_closure(JSContext *ctx, JSValue bfunc, JSValue *fp)
js_closure(ctx: ptr, bfunc: long, fp: ptr) -> long {
    b = jstag.value_to_ptr(bfunc)
    long ext_vars_v = mem.get_long(b, consts.FB_EXT_VARS)
    int ext_vars_len = 0
    if ext_vars_v != jstag.JS_NULL { ext_vars_len = clo_va_size(mem.ptr_to_long(jstag.value_to_ptr(ext_vars_v))) / 2 }

    // GC-root bfunc across JS_NewObjectProtoClass
    ref = malloc(16)
    mem.set_long(ref, 0, bfunc)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    long proto = mem.get_long(ctx, consts.JSCTX_CLASS_PROTO + consts.JS_CLASS_CLOSURE * 8)
    long closure = JS_NewObjectProtoClass(ctx, proto, consts.JS_CLASS_CLOSURE, consts.SIZEOF_JSCLOSUREDATA + ext_vars_len * 8)
    bfunc = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if jstag.is_exception(closure) != 0 { return jstag.JS_EXCEPTION }

    p = jstag.value_to_ptr(closure)
    mem.set_long(p, consts.CLOS_FUNC_BYTECODE, bfunc)

    if ext_vars_len > 0 {
        long var_refs_base = mem.ptr_to_long(p) + consts.CLOS_VAR_REFS
        memset(mem.long_to_ptr(var_refs_base), 0, ext_vars_len * 8)
        long pfirst_var_ref = 0
        if fp != null { pfirst_var_ref = fpa(fp, FO_FIRST_VARREF) }

        int i = 0
        int failed = 0
        long failval = jstag.JS_UNDEFINED
        while i < ext_vars_len && failed == 0 {
            b = jstag.value_to_ptr(bfunc)
            long ev = mem.get_long(b, consts.FB_EXT_VARS)
            long evbase = mem.ptr_to_long(jstag.value_to_ptr(ev)) + consts.VA_ARR
            int decl = mem.get_long(mem.long_to_ptr(evbase + (2 * i + 1) * 8), 0) >> 1   // GET_INT
            int var_kind = decl >> 16
            int var_idx = decl & 0xffff

            // GC-root bfunc, closure across getpkg.get_var_ref / add_global_var
            r2 = malloc(32)
            mem.set_long(r2, 0, bfunc)    mem.set_ptr(r2, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
            mem.set_long(r2, 16, closure) mem.set_ptr(r2, 24, mem.long_to_ptr(mem.ptr_to_long(r2)))
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(r2) + 16))

            long val = jstag.JS_UNDEFINED
            if var_kind == consts.JS_VARREF_KIND_ARG {
                val = getpkg.get_var_ref(ctx, mem.long_to_ptr(pfirst_var_ref), mem.long_to_ptr(fpa(fp, FO_ARG0 + var_idx)))
            } else { if var_kind == consts.JS_VARREF_KIND_VAR {
                val = getpkg.get_var_ref(ctx, mem.long_to_ptr(pfirst_var_ref), mem.long_to_ptr(fpa(fp, FO_VAR0 - var_idx)))
            } else { if var_kind == consts.JS_VARREF_KIND_VAR_REF {
                pf = jstag.value_to_ptr(mem.get_long(mem.long_to_ptr(fpa(fp, FO_FUNC_OBJ)), 0))
                val = mem.get_long(pf, consts.CLOS_VAR_REFS + var_idx * 8)
            } else {
                // GLOBAL (eval only)
                long name = mem.get_long(mem.long_to_ptr(evbase + (2 * i) * 8), 0)
                int df = 0
                if var_idx != 0 { df = 1 }
                val = add_global_var(ctx, name, df)
            } } }

            bfunc = mem.get_long(r2, 0)  closure = mem.get_long(r2, 16)
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(r2, 8))
            free(r2)

            if jstag.is_exception(val) != 0 { failed = 1  failval = val }
            else {
                p = jstag.value_to_ptr(closure)
                mem.set_long(p, consts.CLOS_VAR_REFS + i * 8, val)
            }
            i = i + 1
        }
        if failed != 0 { return failval }
    }
    return closure
}

// The OP_add and binary-arithmetic slow paths ported from mquickjs.c.
// js_add_slow coerces both ctx->sp operands to primitives, then either
// concatenates (if either is a string) or adds as numbers;
// js_binary_arith_slow coerces both to numbers and applies sub/mul/div/
// mod/pow. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts

extern JS_ToPrimitive(ctx: ptr, val: long, hint: int) -> long
extern JS_IsString(ctx: ptr, val: long) -> int
extern JS_ToString(ctx: ptr, val: long) -> long
extern JS_ConcatString(ctx: ptr, val1: long, val2: long) -> long
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern js_fmod(x: float, y: float) -> float
extern js_pow(x: float, y: float) -> float
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_add_slow, js_binary_arith_slow)

const HINT_NONE = 1
const OP_mul = opcodes.OP_mul
const OP_div = opcodes.OP_div
const OP_mod = opcodes.OP_mod
const OP_sub = opcodes.OP_sub
const OP_pow = opcodes.OP_pow

sp_at(ctx: ptr, i: int) -> long {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    return mem.get_long(mem.long_to_ptr(sp + i * 8), 0)
}
sp_set(ctx: ptr, i: int, v: long) {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    mem.set_long(mem.long_to_ptr(sp + i * 8), 0, v)
}

// JSValue js_add_slow(JSContext *ctx)
js_add_slow(ctx: ptr) -> long {
    long o1 = JS_ToPrimitive(ctx, sp_at(ctx, 1), HINT_NONE)
    if jstag.is_exception(o1) != 0 { return jstag.JS_EXCEPTION }
    sp_set(ctx, 1, o1)
    long o2 = JS_ToPrimitive(ctx, sp_at(ctx, 0), HINT_NONE)
    if jstag.is_exception(o2) != 0 { return jstag.JS_EXCEPTION }
    sp_set(ctx, 0, o2)
    int s1 = JS_IsString(ctx, o1)
    int s2 = JS_IsString(ctx, o2)
    if s1 != 0 { return add_concat(ctx, o1, o2) }
    if s2 != 0 { return add_concat(ctx, o1, o2) }
    pa = malloc(8)
    pb = malloc(8)
    if JS_ToNumber(ctx, pa, o1) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    if JS_ToNumber(ctx, pb, o2) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    float d = mem.get_float64(pa, 0) + mem.get_float64(pb, 0)
    free(pa)
    free(pb)
    return JS_NewFloat64(ctx, d)
}

add_concat(ctx: ptr, o1: long, o2: long) -> long {
    long a = JS_ToString(ctx, o1)
    if jstag.is_exception(a) != 0 { return jstag.JS_EXCEPTION }
    long b = JS_ToString(ctx, o2)
    if jstag.is_exception(b) != 0 { return jstag.JS_EXCEPTION }
    return JS_ConcatString(ctx, a, b)
}

// JSValue js_binary_arith_slow(JSContext *ctx, OPCodeEnum op)
js_binary_arith_slow(ctx: ptr, op: int) -> long {
    pa = malloc(8)
    pb = malloc(8)
    if JS_ToNumber(ctx, pa, sp_at(ctx, 1)) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    if JS_ToNumber(ctx, pb, sp_at(ctx, 0)) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    float d1 = mem.get_float64(pa, 0)
    float d2 = mem.get_float64(pb, 0)
    free(pa)
    free(pb)
    float r = 0.0
    if op == OP_sub { r = d1 - d2 }
    else if op == OP_mul { r = d1 * d2 }
    else if op == OP_div { r = d1 / d2 }
    else if op == OP_mod { r = js_fmod(d1, d2) }
    else { r = js_pow(d1, d2) }   // OP_pow
    return JS_NewFloat64(ctx, r)
}

// Stack-check, constructor-start, index-coercion and a name-reloc no-op
// ported from mquickjs.c. JS_StackCheck reserves space on the value
// stack (may GC via check_free_mem); js_call_constructor_start makes the
// `this` object for a `new` call from the constructor's prototype;
// JS_ToIndex coerces+range-checks an array index. Provides the bare C
// symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern check_free_mem(ctx: ptr, stack_bottom: ptr, size: int) -> int
extern JS_GetProperty(ctx: ptr, obj: long, prop: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern JS_IsObject(ctx: ptr, val: long) -> int
extern JS_NewObjectProtoClass(ctx: ptr, proto: long, class_id: int, extra_size: int) -> long
extern JS_ToInt32Sat(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (JS_StackCheck, reloc_c_func_name, js_call_constructor_start, JS_ToIndex)


// int JS_StackCheck(JSContext *ctx, uint32_t len)
JS_StackCheck(ctx: ptr, len: int) -> int {
    int l = len + consts.JS_STACK_SLACK
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    long nsb = sp - l * 8
    if check_free_mem(ctx, mem.long_to_ptr(nsb), l * 8) != 0 { return 0 - 1 }
    mem.set_ptr(ctx, consts.JSCTX_STACK_BOTTOM, mem.long_to_ptr(nsb))
    return 0
}

// JSValue reloc_c_func_name(JSContext *ctx, JSValue val) : identity
reloc_c_func_name(ctx: ptr, val: long) -> long {
    return val
}

// JSValue js_call_constructor_start(JSContext *ctx, JSValue func)
js_call_constructor_start(ctx: ptr, fobj: long) -> long {
    long proto = JS_GetProperty(ctx, fobj, js_get_atom(ctx, consts.JS_ATOM_prototype))
    if jstag.is_exception(proto) != 0 { return proto }
    if JS_IsObject(ctx, proto) == 0 {
        proto = mem.get_long(ctx, consts.JSCTX_CLASS_PROTO + consts.JS_CLASS_OBJECT * 8)
    }
    return JS_NewObjectProtoClass(ctx, proto, consts.JS_CLASS_OBJECT, 0)
}

// int JS_ToIndex(JSContext *ctx, uint64_t *plen, JSValue val)
JS_ToIndex(ctx: ptr, plen: ptr, val: long) -> int {
    s = malloc(4)
    if JS_ToInt32Sat(ctx, s, val) != 0 { free(s)  return 0 - 1 }
    int v = mem.get_int(s, 0)
    free(s)
    if v < 0 {
        JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array index")
        return 0 - 1
    }
    if v > consts.JS_SHORTINT_MAX {
        JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array index")
        return 0 - 1
    }
    mem.set_long(plen, 0, v)
    return 0
}

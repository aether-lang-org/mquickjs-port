// Float64 / integer JSValue constructors ported from mquickjs.c.
// js_alloc_float64 boxes a double on the heap; __JS_NewFloat64 picks the
// minus-zero constant / short-float / heap representation; JS_NewFloat64
// and JS_NewInt64/Int32/Uint32 collapse exact short integers to the int
// tag. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_malloc(ctx: ptr, size: int, mtag: int) -> ptr
extern js_to_short_float(d: float) -> long

exports (js_alloc_float64, JS_NewFloat64, JS_NewInt64, JS_NewInt32, JS_NewUint32)

const MINUS_ZERO_BITS = 0x8000000000000000
// Aether has no hex-float literals; supply 2^-127 and 2^128 as IEEE bits.
const F_2_POW_M127_BITS = 0x3800000000000000
const F_2_POW_128_BITS = 0x47f0000000000000

// JS_NewShortInt(val) = JS_TAG_INT + (val<<1) = val<<1 (jstag.TAG_INT==0)
new_short_int(val: long) -> long { return val << 1 }

// JSValue js_alloc_float64(JSContext *ctx, double d)
js_alloc_float64(ctx: ptr, d: float) -> long {
    f = js_malloc(ctx, consts.SIZEOF_JSFLOAT64, consts.JS_MTAG_FLOAT64)
    if f == null { return jstag.JS_EXCEPTION }
    mem.set_float64(f, consts.JSFLOAT64_DVAL, d)
    return jstag.value_from_ptr(f)
}

// static JSValue __JS_NewFloat64(JSContext *ctx, double d)
new_float64_slow(ctx: ptr, d: float) -> long {
    long bits = mem.bits_of_float(d)
    if bits == MINUS_ZERO_BITS { return (ctx as *JSContext).minus_zero }
    // JS_USE_SHORT_FLOAT: false for NaN since the fabs comparisons fail.
    float ad = d
    if ad < 0.0 { ad = 0.0 - ad }
    float lo = mem.float_from_bits(F_2_POW_M127_BITS)
    float hi = mem.float_from_bits(F_2_POW_128_BITS)
    if ad >= lo && ad <= hi { return js_to_short_float(d) }
    return js_alloc_float64(ctx, d)
}

// JSValue JS_NewFloat64(JSContext *ctx, double d)   (non-SOFTFLOAT path)
JS_NewFloat64(ctx: ptr, d: float) -> long {
    if d >= consts.JS_SHORTINT_MIN && d <= consts.JS_SHORTINT_MAX {
        long val = d                      // (int32_t)d truncation toward zero
        float vd = val
        // -0 has no integer form: compare bit patterns to reject it.
        if mem.bits_of_float(d) == mem.bits_of_float(vd) {
            return new_short_int(val)
        }
    }
    return new_float64_slow(ctx, d)
}

// JSValue JS_NewInt64(JSContext *ctx, int64_t val)
JS_NewInt64(ctx: ptr, val: long) -> long {
    if val >= consts.JS_SHORTINT_MIN && val <= consts.JS_SHORTINT_MAX {
        return new_short_int(val)
    }
    float d = val
    return new_float64_slow(ctx, d)
}

// JSValue JS_NewInt32(JSContext *ctx, int32_t val)
JS_NewInt32(ctx: ptr, val: int) -> long {
    long v = val
    return JS_NewInt64(ctx, v)
}

// JSValue JS_NewUint32(JSContext *ctx, uint32_t val)
JS_NewUint32(ctx: ptr, val: int) -> long {
    long v = val & 0xffffffff
    return JS_NewInt64(ctx, v)
}

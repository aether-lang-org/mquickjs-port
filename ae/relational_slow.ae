// The relational-operator slow path ported from mquickjs.c:
// js_relational_slow coerces both ctx->sp operands to primitives
// (HINT_NUMBER), compares as strings if both are strings else as
// numbers, and applies < <= > >=. Provides the bare C symbol; C body
// removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes

extern JS_ToPrimitive(ctx: ptr, val: long, hint: int) -> long
extern JS_IsString(ctx: ptr, val: long) -> int
extern js_string_compare(ctx: ptr, val1: long, val2: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_relational_slow)

const JSCTX_SP = 32
const HINT_NUMBER = 1
const OP_lt = opcodes.OP_lt
const OP_lte = opcodes.OP_lte
const OP_gt = opcodes.OP_gt
const OP_gte = opcodes.OP_gte

sp_at(ctx: ptr, i: int) -> long {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_SP))
    return mem.get_long(mem.long_to_ptr(sp + i * 8), 0)
}
sp_set(ctx: ptr, i: int, v: long) {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_SP))
    mem.set_long(mem.long_to_ptr(sp + i * 8), 0, v)
}

// apply the comparison op to a signed compare-result-or-difference c.
// For strings c is the strcmp sign; for numbers the branches use the raw
// doubles, handled separately.
cmp_op(op: int, c: int) -> int {
    if op == OP_lt { if c < 0 { return 1 } return 0 }
    if op == OP_lte { if c <= 0 { return 1 } return 0 }
    if op == OP_gt { if c > 0 { return 1 } return 0 }
    if c >= 0 { return 1 } return 0   // OP_gte
}

// JSValue js_relational_slow(JSContext *ctx, OPCodeEnum op)
js_relational_slow(ctx: ptr, op: int) -> long {
    long o1 = JS_ToPrimitive(ctx, sp_at(ctx, 1), HINT_NUMBER)
    if jstag.is_exception(o1) != 0 { return jstag.JS_EXCEPTION }
    sp_set(ctx, 1, o1)
    long o2 = JS_ToPrimitive(ctx, sp_at(ctx, 0), HINT_NUMBER)
    if jstag.is_exception(o2) != 0 { return jstag.JS_EXCEPTION }
    sp_set(ctx, 0, o2)

    int res = 0
    if JS_IsString(ctx, o1) != 0 { if JS_IsString(ctx, o2) != 0 {
        int c = js_string_compare(ctx, o1, o2)
        return jstag.new_bool(cmp_op(op, c))
    } }

    pa = malloc(8)
    pb = malloc(8)
    if JS_ToNumber(ctx, pa, o1) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    if JS_ToNumber(ctx, pb, o2) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
    float d1 = mem.get_float64(pa, 0)
    float d2 = mem.get_float64(pb, 0)
    free(pa)
    free(pb)
    // NaN comparisons must yield false: use the direct float comparisons.
    if op == OP_lt { if d1 < d2 { res = 1 } }
    else if op == OP_lte { if d1 <= d2 { res = 1 } }
    else if op == OP_gt { if d1 > d2 { res = 1 } }
    else { if d1 >= d2 { res = 1 } }
    return jstag.new_bool(res)
}

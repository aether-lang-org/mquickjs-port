// put_lvalue ported from mquickjs.c: emit the store sequence for an
// assignment target, given the get-opcode that produced the lvalue and
// how the assigned value should be left on the stack (PutLValueEnum).
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts
import ae.emit

extern cpool_add(s: ptr, val: long) -> int
extern js_get_atom(ctx: ptr, a: int) -> long
extern abort()

exports (put_lvalue)




// void put_lvalue(JSParseState *s, int opcode, int var_idx, JSSourcePos source_pos, PutLValueEnum special)
put_lvalue(s: ptr, opcode: int, var_idx: int, source_pos: int, special: int) {
    if opcode == opcodes.OP_get_loc || opcode == opcodes.OP_get_arg || opcode == opcodes.OP_get_var_ref {
        if special == consts.PUT_LVALUE_KEEP_TOP { emit.emit_op(s, opcodes.OP_dup) }
        int is_repl = mem.get_byte(s, consts.JSPS_IS_REPL)
        if opcode == opcodes.OP_get_var_ref && is_repl != 0 {
            opcode = opcodes.OP_put_var_ref_nocheck
        } else {
            opcode = opcode + 1
        }
        emit.emit_var(s, opcode, var_idx, source_pos)
        return
    }
    if opcode == opcodes.OP_get_field || opcode == opcodes.OP_get_length {
        if special == consts.PUT_LVALUE_KEEP_TOP { emit.emit_op(s, opcodes.OP_insert2) }
        else { if special == consts.PUT_LVALUE_NOKEEP_BOTTOM { emit.emit_op(s, opcodes.OP_swap) }
        else { if special == consts.PUT_LVALUE_NOKEEP_TOP {  }
        else { emit.emit_op(s, opcodes.OP_perm3) } } }
        emit.emit_op_pos(s, opcodes.OP_put_field, source_pos)
        if opcode == opcodes.OP_get_length {
            ctx = mem.get_ptr(s, consts.JSPS_CTX)
            emit.emit_u16(s, cpool_add(s, js_get_atom(ctx, consts.JS_ATOM_length)))
        } else {
            emit.emit_u16(s, var_idx)
        }
        return
    }
    if opcode == opcodes.OP_get_array_el {
        if special == consts.PUT_LVALUE_KEEP_TOP { emit.emit_op(s, opcodes.OP_insert3) }
        else { if special == consts.PUT_LVALUE_NOKEEP_BOTTOM { emit.emit_op(s, opcodes.OP_rot3l) }
        else { if special == consts.PUT_LVALUE_NOKEEP_TOP {  }
        else { emit.emit_op(s, opcodes.OP_perm4) } } }
        emit.emit_op_pos(s, opcodes.OP_put_array_el, source_pos)
        return
    }
    abort()
}

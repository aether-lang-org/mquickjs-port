// reset_parse_state ported from mquickjs.c: re-arm the parser to start
// emitting bytecode for a fresh function at input_pos with cur_func as the
// target bytecode object. Clears the byte_code / pc2line / cpool / local-var
// accumulators and sets the current token to a space so the next lex reads
// the real first token. Provides the bare C symbol; C body removed.

import ae.jstag
import ae.mqtypes

exports (reset_parse_state)

// void reset_parse_state(JSParseState *s, uint32_t input_pos, JSValue cur_func)
reset_parse_state(s: ptr, input_pos: int, cur_func: long) {
    (s as *JSParseState).buf_pos = input_pos
    (s as *JSParseState).tok_val = 32          // ' '

    (s as *JSParseState).cur_func = cur_func
    (s as *JSParseState).byte_code = jstag.JS_NULL
    (s as *JSParseState).byte_code_len = 0
    (s as *JSParseState).last_opcode_pos = 0 - 1

    (s as *JSParseState).pc2line_bit_len = 0
    (s as *JSParseState).pc2line_source_pos = 0

    (s as *JSParseState).cpool_len = 0
    (s as *JSParseState).hoisted_code_len = 0

    (s as *JSParseState).local_vars_len = 0

    (s as *JSParseState).eval_ret_idx = 0 - 1
}

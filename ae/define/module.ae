// define — merged package (auto-assembled from 3 files).

import ae.consts
import ae.emit
import ae.jstag
import ae.mqtypes
import ae.opcodes
import std.mem
import ae.props
import ae.vstore

extern pc2line_put_bits(s: ptr, n: int, bits: int)
extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern js_malloc(ctx: ptr, size: int, mtag: int) -> ptr
extern js_create_property(ctx: ptr, obj: long, prop: long) -> ptr
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern find_ext_var(s: ptr, name: long) -> int
extern add_ext_var(s: ptr, name: long, decl: int) -> int
extern add_var(s: ptr, name: long) -> int

exports (
    define_hoisted_functions, JS_DefinePropertyInternal, find_var, define_var
)

// ===== from define_hoisted_functions.ae =====
// define_hoisted_functions ported from mquickjs.c: finalise a function's
// hoisted inner-function definitions. First append the pc2line length
// marker (byte-aligned + a varint of hoisted_code_len); then, if there is
// hoisted setup code, insert it at the start of the bytecode — for each
// constant-pool entry that is an inner function with a slot, emit an
// opcodes.OP_fclosure followed by the store opcode (put_var_ref/put_arg/put_loc).
// Provides the bare C symbol; C body removed.







dhf_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }
// JSFunctionBytecode arg_count = header bits 7..22 (16 bits)
dhf_arg_count(p: ptr) -> int { return (mem.get_long(p, 0) >> 7) & 0xffff }

// void define_hoisted_functions(JSParseState *s, BOOL is_eval)
define_hoisted_functions(s: ptr, is_eval: int) {
    b = jstag.value_to_ptr(mem.get_long(s, consts.JSPS_CUR_FUNC))

    // add pc2line info
    if mem.get_long(b, consts.FB_PC2LINE) != jstag.JS_NULL {
        // byte align
        int bitlen = mem.get_uint32(s, consts.JSPS_PC2LINE_BIT_LEN)
        int n = (0 - bitlen) & 7
        if n != 0 { pc2line_put_bits(s, n, 0) }

        n = mem.get_uint32(s, consts.JSPS_HOISTED_CODE_LEN)
        int h = 0
        int writing = 1
        while writing != 0 {
            pc2line_put_bits(s, 8, (n & 0x7f) | h)
            n = (n >> 7) & 0x1ffffff
            if n == 0 { writing = 0 }
            else { h = 0x80 }
        }
    }

    int hoisted_len = mem.get_uint32(s, consts.JSPS_HOISTED_CODE_LEN)
    if hoisted_len == 0 { return }
    emit.emit_insert(s, 0, hoisted_len)

    b = jstag.value_to_ptr(mem.get_long(s, consts.JSPS_CUR_FUNC))
    int arg_count = dhf_arg_count(b)

    int saved_bclen = mem.get_uint32(s, consts.JSPS_BYTE_CODE_LEN)
    mem.set_uint32(s, consts.JSPS_BYTE_CODE_LEN, 0)
    long cpool = mem.get_long(b, consts.FB_CPOOL)
    long cpool_base = mem.ptr_to_long(jstag.value_to_ptr(cpool)) + consts.VA_ARR
    int cpool_len = mem.get_uint16(s, consts.JSPS_CPOOL_LEN)

    int i = 0
    while i < cpool_len {
        long val = mem.get_long(mem.long_to_ptr(cpool_base + i * 8), 0)
        if jstag.is_ptr(val) != 0 {
            fb = jstag.value_to_ptr(val)
            if dhf_mtag(fb) == consts.JS_MTAG_FUNCTION_BYTECODE {
                int fac = dhf_arg_count(fb)
                if fac != 0 {
                    int idx = fac - 1
                    int op = opcodes.OP_put_loc
                    if is_eval != 0 {
                        op = opcodes.OP_put_var_ref_nocheck
                    } else { if idx < arg_count {
                        op = opcodes.OP_put_arg
                    } else {
                        idx = idx - arg_count
                        op = opcodes.OP_put_loc
                    } }
                    emit.emit_u8(s, opcodes.OP_fclosure)
                    emit.emit_u16(s, i)
                    emit.emit_u8(s, op)
                    emit.emit_u16(s, idx)
                }
            }
        }
        i = i + 1
    }
    mem.set_uint32(s, consts.JSPS_BYTE_CODE_LEN, saved_bclen)
}

// ===== from define_property_internal.ae =====
// JS_DefinePropertyInternal ported from mquickjs.c: define or redefine an
// own property as a value, a global var-ref, or a getter/setter pair.
// Copies ROM props to RAM, optionally looks up an existing record to
// update in place (rejecting kind changes), and otherwise creates a fresh
// record. Provides the bare C symbol; C body removed.








dpi_prop_type(pr: ptr) -> int { int w = mem.get_int(pr, consts.PROP_HASH_NEXT)  return (w >> 30) & 3 }
dpi_set_prop_type(pr: ptr, pt: int) {
    int w = mem.get_int(pr, consts.PROP_HASH_NEXT)
    long lo = (w & 0xffffffff) & 0x3fffffff
    long ptl = pt
    long nw = lo | (ptl << 30)
    mem.set_int(pr, consts.PROP_HASH_NEXT, nw)
}

dpi_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias  long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
dpi_is_rom(ctx: ptr, pp: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if dpi_ult(pp, ctxl) != 0 { return 1 }
    if dpi_ult(pp, stop) == 0 { return 1 }
    return 0
}

// push a 4-value GC-root box (obj, prop, val, setter) and run props.js_update_props.
// returns the (possibly relocated) values via the box; result int = update ret.
flag_has(flags: int, bit: int) -> int { if (flags & bit) != 0 { return 1 } return 0 }

// JSValue JS_DefinePropertyInternal(JSContext *ctx, JSValue obj, JSValue prop, JSValue val, JSValue setter, int flags)
JS_DefinePropertyInternal(ctx: ptr, obj: long, prop: long, val: long, setter: long, flags: int) -> long {
    // GC-root obj/prop/val/setter across props.js_update_props (4 refs)
    box = malloc(64)
    mem.set_long(box, 0, obj)     mem.set_ptr(box, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_long(box, 16, prop)   mem.set_ptr(box, 24, mem.long_to_ptr(mem.ptr_to_long(box)))
    mem.set_long(box, 32, val)    mem.set_ptr(box, 40, mem.long_to_ptr(mem.ptr_to_long(box) + 16))
    mem.set_long(box, 48, setter) mem.set_ptr(box, 56, mem.long_to_ptr(mem.ptr_to_long(box) + 32))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box) + 48))
    int ret = props.js_update_props(ctx, obj)
    obj = mem.get_long(box, 0)  prop = mem.get_long(box, 16)
    val = mem.get_long(box, 32)  setter = mem.get_long(box, 48)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box, 8))
    free(box)
    if ret != 0 { return jstag.JS_EXCEPTION }

    long pr_done = 0
    int found_done = 0

    if flag_has(flags, consts.JS_DEF_PROP_LOOKUP) != 0 {
        pr = find_own_property(ctx, jstag.value_to_ptr(obj), prop)
        if pr != null {
            if flag_has(flags, consts.JS_DEF_PROP_HAS_VALUE) != 0 {
                int pt = dpi_prop_type(pr)
                if pt == consts.JS_PROP_NORMAL {
                    mem.set_long(pr, consts.PROP_VALUE, val)
                } else { if pt == consts.JS_PROP_VARREF {
                    pv = jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))
                    mem.set_long(pv, consts.VARREF_VALUE, val)
                } else {
                    return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot modify getter/setter/value kind")
                } }
            } else {
                if flag_has(flags, consts.JS_DEF_PROP_HAS_GET) != 0 || flag_has(flags, consts.JS_DEF_PROP_HAS_SET) != 0 {
                    if dpi_prop_type(pr) != consts.JS_PROP_GETSET {
                        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot modify getter/setter/value kind")
                    }
                    long gsv = mem.get_long(pr, consts.PROP_VALUE)
                    arr = jstag.value_to_ptr(gsv)
                    if dpi_is_rom(ctx, mem.ptr_to_long(arr)) != 0 {
                        // move getset array to RAM
                        box2 = malloc(64)
                        mem.set_long(box2, 0, obj)     mem.set_ptr(box2, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                        mem.set_long(box2, 16, prop)   mem.set_ptr(box2, 24, mem.long_to_ptr(mem.ptr_to_long(box2)))
                        mem.set_long(box2, 32, val)    mem.set_ptr(box2, 40, mem.long_to_ptr(mem.ptr_to_long(box2) + 16))
                        mem.set_long(box2, 48, setter) mem.set_ptr(box2, 56, mem.long_to_ptr(mem.ptr_to_long(box2) + 32))
                        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box2) + 48))
                        arr2 = vstore.js_alloc_value_array(ctx, 0, 2)
                        obj = mem.get_long(box2, 0)  prop = mem.get_long(box2, 16)
                        val = mem.get_long(box2, 32)  setter = mem.get_long(box2, 48)
                        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box2, 8))
                        free(box2)
                        if arr2 == null { return jstag.JS_EXCEPTION }
                        pr = find_own_property(ctx, jstag.value_to_ptr(obj), prop)
                        arr = jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))
                        long ab = mem.ptr_to_long(arr2) + consts.VA_ARR
                        long ob = mem.ptr_to_long(arr) + consts.VA_ARR
                        mem.set_long(mem.long_to_ptr(ab), 0, mem.get_long(mem.long_to_ptr(ob), 0))
                        mem.set_long(mem.long_to_ptr(ab + 8), 0, mem.get_long(mem.long_to_ptr(ob + 8), 0))
                        mem.set_long(pr, consts.PROP_VALUE, jstag.value_from_ptr(arr2))
                        arr = arr2
                    }
                    long abase = mem.ptr_to_long(arr) + consts.VA_ARR
                    if flag_has(flags, consts.JS_DEF_PROP_HAS_GET) != 0 { mem.set_long(mem.long_to_ptr(abase), 0, val) }
                    if flag_has(flags, consts.JS_DEF_PROP_HAS_SET) != 0 { mem.set_long(mem.long_to_ptr(abase + 8), 0, setter) }
                }
            }
            pr_done = mem.ptr_to_long(pr)
            found_done = 1
        }
    }

    if found_done == 0 {
        int prop_type = consts.JS_PROP_NORMAL
        if flag_has(flags, consts.JS_DEF_PROP_HAS_GET) != 0 || flag_has(flags, consts.JS_DEF_PROP_HAS_SET) != 0 {
            prop_type = consts.JS_PROP_GETSET
            // build [val, setter] array (GC-root all 4)
            box3 = malloc(64)
            mem.set_long(box3, 0, obj)     mem.set_ptr(box3, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
            mem.set_long(box3, 16, prop)   mem.set_ptr(box3, 24, mem.long_to_ptr(mem.ptr_to_long(box3)))
            mem.set_long(box3, 32, val)    mem.set_ptr(box3, 40, mem.long_to_ptr(mem.ptr_to_long(box3) + 16))
            mem.set_long(box3, 48, setter) mem.set_ptr(box3, 56, mem.long_to_ptr(mem.ptr_to_long(box3) + 32))
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box3) + 48))
            arr = vstore.js_alloc_value_array(ctx, 0, 2)
            obj = mem.get_long(box3, 0)  prop = mem.get_long(box3, 16)
            val = mem.get_long(box3, 32)  setter = mem.get_long(box3, 48)
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box3, 8))
            free(box3)
            if arr == null { return jstag.JS_EXCEPTION }
            long ab = mem.ptr_to_long(arr) + consts.VA_ARR
            mem.set_long(mem.long_to_ptr(ab), 0, val)
            mem.set_long(mem.long_to_ptr(ab + 8), 0, setter)
            val = jstag.value_from_ptr(arr)
        } else {
            if obj == mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ) {
                prop_type = consts.JS_PROP_VARREF
                // GC-root obj/prop/val across js_malloc
                box4 = malloc(48)
                mem.set_long(box4, 0, obj)   mem.set_ptr(box4, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                mem.set_long(box4, 16, prop) mem.set_ptr(box4, 24, mem.long_to_ptr(mem.ptr_to_long(box4)))
                mem.set_long(box4, 32, val)  mem.set_ptr(box4, 40, mem.long_to_ptr(mem.ptr_to_long(box4) + 16))
                mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box4) + 32))
                pv = js_malloc(ctx, consts.SIZEOF_JSVARREF_DETACHED, consts.JS_MTAG_VARREF)
                obj = mem.get_long(box4, 0)  prop = mem.get_long(box4, 16)  val = mem.get_long(box4, 32)
                mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box4, 8))
                free(box4)
                if pv == null { return jstag.JS_EXCEPTION }
                // is_detached = TRUE (bit 4): js_malloc wrote header=mtag<<1
                long hdr = mem.get_long(pv, 0)
                mem.set_long(pv, 0, hdr | 16)
                mem.set_long(pv, consts.VARREF_VALUE, val)
                val = jstag.value_from_ptr(pv)
            }
        }

        // GC-root val across js_create_property
        box5 = malloc(16)
        mem.set_long(box5, 0, val)
        mem.set_ptr(box5, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, box5)
        pr = js_create_property(ctx, obj, prop)
        val = mem.get_long(box5, 0)
        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box5, 8))
        free(box5)
        if pr == null { return jstag.JS_EXCEPTION }
        dpi_set_prop_type(pr, prop_type)
        mem.set_long(pr, consts.PROP_VALUE, val)
        pr_done = mem.ptr_to_long(pr)
    }

    if flag_has(flags, consts.JS_DEF_PROP_RET_VAL) != 0 {
        return mem.get_long(mem.long_to_ptr(pr_done), consts.PROP_VALUE)
    }
    return jstag.JS_UNDEFINED
}

// ===== from define_var.ae =====
// find_var / define_var ported from mquickjs.c: resolve or create a binding
// for `name` in the function currently being parsed (s->cur_func). find_var
// scans the local-variable name array for an exact match. define_var picks
// the binding kind: in eval code every var becomes a global var-ref (created
// or re-declared in ext_vars); otherwise it is an argument, an existing
// local, or a freshly added local. The returned index is relative to the
// kind (args are 0-based; locals are offset past the arguments). Provides
// the bare C symbols; C bodies removed.







dv_short_int(v: int) -> long { return v << 1 }

// int find_var(JSParseState *s, JSValue name)
find_var(s: ptr, name: long) -> int {
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    long vars = (b as *JSFunctionBytecode).vars
    long base = mem.ptr_to_long(jstag.value_to_ptr(vars)) + consts.VA_ARR
    int n = (s as *JSParseState).local_vars_len
    int i = 0
    while i < n {
        if mem.get_long(mem.long_to_ptr(base + i * 8), 0) == name { return i }
        i = i + 1
    }
    return 0 - 1
}

// int define_var(JSParseState *s, JSVarRefKindEnum *pvar_kind, JSValue name)
define_var(s: ptr, pvar_kind: ptr, name: long) -> int {
    int var_kind = 0
    int var_idx = 0

    if mem.get_byte(s, 33) != 0 {     // s->is_eval
        var_idx = find_ext_var(s, name)
        int decl = (consts.JS_VARREF_KIND_GLOBAL << 16) | 1
        if var_idx < 0 {
            var_idx = add_ext_var(s, name, decl)
        } else {
            b = jstag.value_to_ptr((s as *JSParseState).cur_func)
            long arr = (b as *JSFunctionBytecode).ext_vars
            long base = mem.ptr_to_long(jstag.value_to_ptr(arr)) + consts.VA_ARR
            mem.set_long(mem.long_to_ptr(base + (2 * var_idx + 1) * 8), 0, dv_short_int(decl))
        }
        var_kind = consts.JS_VARREF_KIND_VAR_REF
    } else {
        b = jstag.value_to_ptr((s as *JSParseState).cur_func)
        int arg_count = (b as *JSFunctionBytecode).arg_count

        var_idx = find_var(s, name)
        if var_idx >= 0 {
            if var_idx < arg_count {
                var_kind = consts.JS_VARREF_KIND_ARG
            } else {
                var_kind = consts.JS_VARREF_KIND_VAR
                var_idx = var_idx - arg_count
            }
        } else {
            var_idx = add_var(s, name)
            var_kind = consts.JS_VARREF_KIND_VAR
            var_idx = var_idx - arg_count
        }
    }
    mem.set_int(pvar_kind, 0, var_kind)
    return var_idx
}

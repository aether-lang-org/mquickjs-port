// Regexp flag parsing/formatting — self-contained leaves ported from
// mquickjs.c. js_parse_regexp_flags reads a flag string (gimsuy) into
// a bitmask; js_regexp_flags_str renders a bitmask back to chars.
// Provides the bare C symbols; the C bodies are removed.

import std.mem

exports (js_parse_regexp_flags, js_regexp_flags_str)

const LRE_FLAG_GLOBAL = 1       // 1 << 0
const LRE_FLAG_IGNORECASE = 2   // 1 << 1
const LRE_FLAG_MULTILINE = 4    // 1 << 2
const LRE_FLAG_DOTALL = 8       // 1 << 3
const LRE_FLAG_UNICODE = 16     // 1 << 4
const LRE_FLAG_STICKY = 32      // 1 << 5
const RE_FLAG_COUNT = 6

// size_t js_parse_regexp_flags(int *pre_flags, const uint8_t *buf)
// Returns the number of flag chars consumed; stops at the first
// unknown char or a repeated flag.
js_parse_regexp_flags(pre_flags: ptr, buf: ptr) -> long {
    int re_flags = 0
    int i = 0
    int done = 0
    while done == 0 {
        int c = mem.get_byte(buf, i)
        if c == 0 { done = 1 }
        else {
            int mask = 0
            if c == 0x67 { mask = LRE_FLAG_GLOBAL }        // g
            else if c == 0x69 { mask = LRE_FLAG_IGNORECASE } // i
            else if c == 0x6d { mask = LRE_FLAG_MULTILINE }  // m
            else if c == 0x73 { mask = LRE_FLAG_DOTALL }     // s
            else if c == 0x75 { mask = LRE_FLAG_UNICODE }    // u
            else if c == 0x79 { mask = LRE_FLAG_STICKY }     // y
            else { done = 1 }
            if done == 0 {
                if (re_flags & mask) != 0 { done = 1 }
                else {
                    re_flags = re_flags | mask
                    i = i + 1
                }
            }
        }
    }
    mem.set_int(pre_flags, 0, re_flags)
    return i
}

// size_t js_regexp_flags_str(char *buf, int re_flags)
// flag chars in bit order: g i m s u y
js_regexp_flags_str(buf: ptr, re_flags: int) -> long {
    int j = 0
    int i = 0
    while i < RE_FLAG_COUNT {
        if ((re_flags >> i) & 1) != 0 {
            int ch = 0
            if i == 0 { ch = 0x67 }      // g
            else if i == 1 { ch = 0x69 } // i
            else if i == 2 { ch = 0x6d } // m
            else if i == 3 { ch = 0x73 } // s
            else if i == 4 { ch = 0x75 } // u
            else { ch = 0x79 }           // y
            mem.set_byte(buf, j, ch)
            j = j + 1
        }
        i = i + 1
    }
    mem.set_byte(buf, j, 0)
    return j
}

// String.prototype.concat ported from mquickjs.c. Uses the engine's
// StringBuffer API (a 24-byte struct: a GC-ref'd buffer @0, len @16,
// is_ascii @20). The C original stack-allocates it; here it is a 24-byte
// malloc'd slot whose buffer_ref push() registers as a GC root and pop()
// releases before free. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToStringCheckObject(ctx: ptr, val: long) -> long
extern string_buffer_push(ctx: ptr, s: ptr, len: int) -> int
extern string_buffer_concat(ctx: ptr, s: ptr, val2: long) -> int
extern string_buffer_pop(ctx: ptr, s: ptr) -> long

exports (js_string_concat)

// JSValue js_string_concat(ctx, this_val, argc, argv)
js_string_concat(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long r = JS_ToStringCheckObject(ctx, mem.get_long(this_val, 0))
    if jstag.is_exception(r) != 0 { return jstag.JS_EXCEPTION }

    b = malloc(24)
    string_buffer_push(ctx, b, 0)
    // goto-done collapses into a flag: on any concat failure stop early
    // and still pop (which returns the partial/exception value).
    int done = 0
    if string_buffer_concat(ctx, b, r) != 0 { done = 1 }
    if done == 0 {
        int i = 0
        while i < argc {
            long ai = mem.get_long(argv, i * 8)
            if string_buffer_concat(ctx, b, ai) != 0 {
                done = 1
                i = argc
            } else {
                i = i + 1
            }
        }
    }
    long result = string_buffer_pop(ctx, b)
    free(b)
    return result
}

// JS_ToInt32Internal ported from mquickjs.c: coerce a value to a 32-bit
// integer via *pres. Ints pass through; bool/null/undefined use their
// special value; everything else becomes a double (via JS_ToNumber) and
// is reduced: a fast (int)d for small magnitudes, the modulo-2^32 bit
// extraction for larger finite values (non-saturating), or the saturating
// clamp (sat_flag). Returns 0 on success, -1 on exception. Provides the
// bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern js_get_short_float(val: long) -> float
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (JS_ToInt32Internal)

tii_is_short_float(v: long) -> int { if (v & 7) == 5 { return 1 } return 0 }

// reduce a double d (with sat_flag) to a sign-extended int32 (as a long)
tii_reduce(d: float, sat_flag: int) -> long {
    long u = mem.bits_of_float(d)
    long one = 1
    long mant_bit = one << 52
    long mant_mask = mant_bit - 1
    int e = (u >> 52) & 0x7ff
    long ret = 0
    if e <= (1023 + 30) {
        long td = d                              // (int32_t)d truncation
        ret = td & 0xffffffff
    } else {
        if sat_flag == 0 {
            if e <= (1023 + 30 + 53) {
                long v = (u & mant_mask) | mant_bit
                int sh = (e - 1023) - 52 + 32
                v = v << sh
                long vlogical = (v >> 32) & 0xffffffff   // logical: mask to 32 bits
                ret = vlogical
                if (u >> 63) != 0 { ret = (0 - ret) & 0xffffffff }
            } else {
                ret = 0                          // NaN / +inf
            }
        } else {
            if e == 2047 && (u & mant_mask) != 0 {
                ret = 0                          // NaN
            } else {
                if (u >> 63) != 0 { ret = 0x80000000 } else { ret = 0x7fffffff }
            }
        }
    }
    int r32 = ret
    long rl = r32
    return rl
}

// int JS_ToInt32Internal(JSContext *ctx, int *pres, JSValue val, BOOL sat_flag)
JS_ToInt32Internal(ctx: ptr, pres: ptr, val: long, sat_flag: int) -> int {
    long ret = 0
    int got = 0

    if jstag.is_int(val) != 0 {
        int iv = val >> 1
        ret = iv
        got = 1
    } else { if tii_is_short_float(val) != 0 {
        ret = tii_reduce(js_get_short_float(val), sat_flag)
        got = 1
    } else { if jstag.is_ptr(val) == 0 {
        int tag = jstag.get_special_tag(val)
        if tag == jstag.TAG_BOOL || tag == jstag.TAG_NULL || tag == jstag.TAG_UNDEFINED {
            ret = jstag.get_special_value(val)
            got = 1
        }
    } else { } } }

    if got == 0 {
        pd = malloc(8)
        int err = JS_ToNumber(ctx, pd, val)
        float d = mem.get_float64(pd, 0)
        free(pd)
        if err != 0 { mem.set_int(pres, 0, 0)  return 0 - 1 }
        ret = tii_reduce(d, sat_flag)
    }

    mem.set_int(pres, 0, ret)
    return 0
}

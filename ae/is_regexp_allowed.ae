// is_regexp_allowed ported from mquickjs.c: decide whether a '/' beginning
// the next token starts a regexp literal or is a division operator, based on
// the previous token. After a value-producing token (literal, identifier,
// ++/--, ')', ']', and the keywords this/null/true/false plus the statement
// keywords that can be followed by '(') a '/' is division; otherwise a
// regexp is allowed. Provides the bare C symbol; C body removed.

import ae.consts
exports (is_regexp_allowed)

const TOK_DEC = 132
const TOK_INC = 133

// BOOL is_regexp_allowed(int tok)
is_regexp_allowed(tok: int) -> int {
    if tok == consts.TOK_NUMBER { return 0 }
    if tok == consts.TOK_STRING { return 0 }
    if tok == consts.TOK_REGEXP { return 0 }
    if tok == TOK_DEC { return 0 }
    if tok == TOK_INC { return 0 }
    if tok == consts.TOK_NULL { return 0 }
    if tok == consts.TOK_FALSE { return 0 }
    if tok == consts.TOK_TRUE { return 0 }
    if tok == consts.TOK_THIS { return 0 }
    if tok == consts.TOK_IF { return 0 }
    if tok == consts.TOK_WHILE { return 0 }
    if tok == consts.TOK_FOR { return 0 }
    if tok == consts.TOK_DO { return 0 }
    if tok == consts.TOK_CASE { return 0 }
    if tok == consts.TOK_CATCH { return 0 }
    if tok == consts.TOK_RPAREN { return 0 }
    if tok == consts.TOK_RBRACKET { return 0 }
    if tok == consts.TOK_IDENT { return 0 }
    return 1
}

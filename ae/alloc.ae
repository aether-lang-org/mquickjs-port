// Bump-allocator free ported from mquickjs.c: js_free only reclaims the
// most-recently-allocated block (the heap is a bump pointer). If the
// block ends exactly at heap_free, rewind heap_free to its start.
// Provides the bare C symbol; C body removed.

import std.mem
import ae.mqtypes
import ae.consts
import ae.jstag
import ae.gc

extern set_free_block(p: ptr, size: int)
extern check_free_mem(ctx: ptr, stack_bottom: ptr, size: int) -> int
extern memset(dst: ptr, c: int, n: long) -> ptr

exports (js_free, js_shrink, js_malloc, js_mallocz)


// void js_free(JSContext *ctx, void *ptr)
js_free(ctx: ptr, ptr_: ptr) {
    if ptr_ == null { return }
    long end = mem.ptr_to_long(ptr_) + gc.get_mblock_size(ptr_)
    long heap_free = mem.ptr_to_long((ctx as *JSContext).heap_free)
    if end == heap_free {
        (ctx as *JSContext).heap_free = ptr_
    }
}

// void *js_shrink(JSContext *ctx, void *ptr, uint32_t new_size)
// ptr != NULL; new_size <= current block size.
js_shrink(ctx: ptr, ptr_: ptr, new_size: int) -> ptr {
    int ns = (new_size + (jstag.JSW - 1)) & (0 - jstag.JSW)   // round up to jstag.JSW
    if ns == 0 {
        js_free(ctx, ptr_)
        return null
    }
    int old_size = gc.get_mblock_size(ptr_)
    int diff = old_size - ns
    if diff == 0 { return ptr_ }
    set_free_block(mem.long_to_ptr(mem.ptr_to_long(ptr_) + ns), diff)
    return ptr_
}

// void *js_malloc(JSContext *ctx, uint32_t size, int mtag)
js_malloc(ctx: ptr, size: int, mtag: int) -> ptr {
    if size == 0 { return null }
    int sz = (size + (jstag.JSW - 1)) & (0 - jstag.JSW)   // round up to jstag.JSW
    if check_free_mem(ctx, (ctx as *JSContext).stack_bottom, sz) != 0 { return null }
    long hf = mem.ptr_to_long((ctx as *JSContext).heap_free)
    p = mem.long_to_ptr(hf)
    (ctx as *JSContext).heap_free = mem.long_to_ptr(hf + sz)
    // p->mtag = mtag; p->gc_mark = 0; p->dummy = 0  => header word = mtag<<1
    long hdr = mtag
    mem.set_long(p, 0, hdr << 1)
    return p
}

// void *js_mallocz(JSContext *ctx, uint32_t size, int mtag)
js_mallocz(ctx: ptr, size: int, mtag: int) -> ptr {
    p = js_malloc(ctx, size, mtag)
    if p == null { return null }
    if size > 4 {
        // zero from offset 4 (past the gc-header u32) to the end
        memset(mem.long_to_ptr(mem.ptr_to_long(p) + 4), 0, size - 4)
    }
    return p
}

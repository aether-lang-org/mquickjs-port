// range_sort_cmp / range_sort_swap / add_interval_intersect ported from
// mquickjs.c. The first two are the comparison and swap callbacks used by
// rqsort_idx to order the regexp character-range table (8-byte records: two
// u32s, sorted by the first). add_interval_intersect emits the intersection
// of [start,end) with [start1,end1) (and, when offset != 0, the offset copy)
// as one or two u32 pairs into the regexp bytecode — used by case-folding.
// Provide the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern emit_u32(s: ptr, val: int)

exports (range_sort_cmp, range_sort_swap, add_interval_intersect)

// int range_sort_cmp(size_t i1, size_t i2, void *opaque)
range_sort_cmp(i1: long, i2: long, opaque: ptr) -> int {
    long tab = mem.ptr_to_long(opaque)
    int v1 = mem.get_uint32(mem.long_to_ptr(tab + 8 * i1), 0)
    int v2 = mem.get_uint32(mem.long_to_ptr(tab + 8 * i2), 0)
    return v1 - v2
}

// void range_sort_swap(size_t i1, size_t i2, void *opaque)
range_sort_swap(i1: long, i2: long, opaque: ptr) -> int {
    long tab = mem.ptr_to_long(opaque)
    long a = tab + 8 * i1
    long b = tab + 8 * i2
    long tmp = mem.get_long(mem.long_to_ptr(a), 0)
    mem.set_long(mem.long_to_ptr(a), 0, mem.get_long(mem.long_to_ptr(b), 0))
    mem.set_long(mem.long_to_ptr(b), 0, tmp)
    return 0
}

// unsigned max/min on 32-bit values (treat as uint via masking to 33 bits)
riu_max(a: int, b: int) -> int {
    long ua = a & 0xffffffff
    long ub = b & 0xffffffff
    if ua > ub { return a }
    return b
}
riu_min(a: int, b: int) -> int {
    long ua = a & 0xffffffff
    long ub = b & 0xffffffff
    if ua < ub { return a }
    return b
}

// void add_interval_intersect(JSParseState *s, uint32_t start, uint32_t end,
//                             uint32_t start1, uint32_t end1, int offset)
add_interval_intersect(s: ptr, start: int, end: int, start1: int, end1: int, offset: int) {
    start = riu_max(start, start1)
    end = riu_min(end, end1)
    long us = start & 0xffffffff
    long ue = end & 0xffffffff
    if us < ue {
        emit_u32(s, start)
        emit_u32(s, end)
        if offset != 0 {
            emit_u32(s, start + offset)
            emit_u32(s, end + offset)
        }
    }
}

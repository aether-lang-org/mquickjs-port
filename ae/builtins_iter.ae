// Array iteration builtins ported from mquickjs.c: js_array_every,
// multiplexed by `special` into every/some/forEach/map/filter. Drives
// the VM (JS_PushArg + JS_Call) per element. The C JS_PUSH_VALUE/
// JS_POP_VALUE macros are modeled here with explicit JSGCRef slots
// (16 bytes: val@0, prev@8) chained through ctx->top_gc_ref (JSContext
// overlay). Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_IsFunction(ctx: ptr, val: long) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern JS_NewArray(ctx: ptr, initial_len: int) -> long
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_Call(ctx: ptr, call_flags: int) -> long
extern JS_ToBool(ctx: ptr, val: long) -> int
extern JS_SetPropertyUint32(ctx: ptr, this_obj: long, idx: int, val: long) -> long
extern js_get_array(ctx: ptr, obj: long) -> ptr
extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr
extern js_array_sort_cmp(i1: long, i2: long, opaque: ptr) -> int
extern js_array_sort_swap(i1: long, i2: long, opaque: ptr) -> int
extern rqsort_idx(nmemb: long, cmp: ptr, swap: ptr, opaque: ptr)
extern js_free(ctx: ptr, p: ptr)

exports (js_array_every, js_array_reduce, js_array_sort)

const SPECIAL_EVERY = 0
const SPECIAL_SOME = 1
const SPECIAL_FOREACH = 2
const SPECIAL_MAP = 3
const SPECIAL_FILTER = 4
const SPECIAL_REDUCE = 0
const SPECIAL_REDUCERIGHT = 1

// JSGCRef field offsets

// ctx->top_gc_ref accessor (JSContext overlay)
ctx_top_gc_ref(ctx: ptr) -> ptr {
    return (ctx as *JSContext).top_gc_ref
}
ctx_set_top_gc_ref(ctx: ptr, v: ptr) {
    (ctx as *JSContext).top_gc_ref = v
}

// JS_PUSH_VALUE(ctx, ref, v): ref.prev = top; top = ref; ref.val = v
gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, consts.GCREF_PREV, ctx_top_gc_ref(ctx))
    ctx_set_top_gc_ref(ctx, ref)
    mem.set_long(ref, consts.GCREF_VAL, v)
}
// JS_POP_VALUE(ctx, ref) -> ref.val ; top = ref.prev
gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, consts.GCREF_VAL)
    ctx_set_top_gc_ref(ctx, mem.get_ptr(ref, consts.GCREF_PREV))
    return v
}

array_len_of(p: ptr) -> int {
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    return mem.get_uint32(mem.long_to_ptr(u), 8)
}
array_tab_of(p: ptr) -> long {
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    return mem.get_long(mem.long_to_ptr(u), 0)
}

// JSValue js_array_every(ctx, this_val, argc, argv, special)
js_array_every(ctx: ptr, this_val: ptr, argc: int, argv: ptr, special: int) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int len = array_len_of(p)

    long pfunc = mem.get_long(argv, 0)
    long pthis = jstag.JS_UNDEFINED
    if argc > 1 { pthis = mem.get_long(argv, 8) }

    if JS_IsFunction(ctx, pfunc) == 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }

    long ret = jstag.JS_UNDEFINED
    if special == SPECIAL_EVERY { ret = jstag.JS_TRUE }
    else if special == SPECIAL_SOME { ret = jstag.JS_FALSE }
    else if special == SPECIAL_MAP {
        ret = JS_NewArray(ctx, len)
        if jstag.is_exception(ret) != 0 { return jstag.JS_EXCEPTION }
    } else if special == SPECIAL_FILTER {
        ret = JS_NewArray(ctx, 0)
        if jstag.is_exception(ret) != 0 { return jstag.JS_EXCEPTION }
    }

    int n = 0
    ret_ref = malloc(16)
    val_ref = malloc(16)
    gc_push(ctx, ret_ref, ret)

    int k = 0
    int err = 0
    while k < len {
        if JS_StackCheck(ctx, 5) != 0 { err = 1  k = len }
        else {
            // re-fetch (function calls may resize the array)
            p = jstag.value_to_ptr(mem.get_long(this_val, 0))
            int cur_len = array_len_of(p)
            if k >= cur_len { k = len }
            else {
                long tab = array_tab_of(p)
                arr = jstag.value_to_ptr(tab)
                long val = mem.get_long(arr, 8 + k * 8)

                JS_PushArg(ctx, mem.get_long(this_val, 0))
                JS_PushArg(ctx, jstag.new_short_int(k))
                JS_PushArg(ctx, val)         // arg0
                JS_PushArg(ctx, pfunc)       // func
                JS_PushArg(ctx, pthis)       // this
                gc_push(ctx, val_ref, val)
                long res = JS_Call(ctx, 3)
                long val2 = gc_pop(ctx, val_ref)

                if jstag.is_exception(res) != 0 {
                    mem.set_long(ret_ref, consts.GCREF_VAL, jstag.JS_EXCEPTION)
                    err = 1
                    k = len
                } else if special == SPECIAL_EVERY {
                    if JS_ToBool(ctx, res) == 0 {
                        mem.set_long(ret_ref, consts.GCREF_VAL, jstag.JS_FALSE)
                        k = len
                    } else { k = k + 1 }
                } else if special == SPECIAL_SOME {
                    if JS_ToBool(ctx, res) != 0 {
                        mem.set_long(ret_ref, consts.GCREF_VAL, jstag.JS_TRUE)
                        k = len
                    } else { k = k + 1 }
                } else if special == SPECIAL_MAP {
                    long rv = mem.get_long(ret_ref, consts.GCREF_VAL)
                    long sr = JS_SetPropertyUint32(ctx, rv, k, res)
                    if jstag.is_exception(sr) != 0 { mem.set_long(ret_ref, consts.GCREF_VAL, jstag.JS_EXCEPTION)  err = 1  k = len }
                    else { k = k + 1 }
                } else if special == SPECIAL_FILTER {
                    if JS_ToBool(ctx, res) != 0 {
                        long rv = mem.get_long(ret_ref, consts.GCREF_VAL)
                        long sr = JS_SetPropertyUint32(ctx, rv, n, val2)
                        n = n + 1
                        if jstag.is_exception(sr) != 0 { mem.set_long(ret_ref, consts.GCREF_VAL, jstag.JS_EXCEPTION)  err = 1  k = len }
                        else { k = k + 1 }
                    } else { k = k + 1 }
                } else {
                    k = k + 1   // forEach
                }
            }
        }
    }

    long final_ret = gc_pop(ctx, ret_ref)
    free(val_ref)
    free(ret_ref)
    return final_ret
}

// JSValue js_array_reduce(ctx, this_val, argc, argv, special)
// special: 0 = reduce, 1 = reduceRight
js_array_reduce(ctx: ptr, this_val: ptr, argc: int, argv: ptr, special: int) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int len = array_len_of(p)
    long pfunc = mem.get_long(argv, 0)
    if JS_IsFunction(ctx, pfunc) == 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }

    int k = 0
    long acc = jstag.JS_UNDEFINED
    if argc > 1 {
        acc = mem.get_long(argv, 8)
    } else {
        if len == 0 {
            return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "empty array")
        }
        int k1 = k
        if special == SPECIAL_REDUCERIGHT { k1 = len - k - 1 }
        long tab = array_tab_of(p)
        arr = jstag.value_to_ptr(tab)
        acc = mem.get_long(arr, 8 + k1 * 8)
        k = 1
    }

    acc_ref = malloc(16)
    int err = 0
    while k < len {
        gc_push(ctx, acc_ref, acc)
        int rc = JS_StackCheck(ctx, 6)
        acc = gc_pop(ctx, acc_ref)
        if rc != 0 { err = 1  k = len }
        else {
            int k1 = k
            if special == SPECIAL_REDUCERIGHT { k1 = len - k - 1 }
            p = jstag.value_to_ptr(mem.get_long(this_val, 0))
            int cur_len = array_len_of(p)
            if k1 >= cur_len { k = len }
            else {
                long tab = array_tab_of(p)
                arr = jstag.value_to_ptr(tab)
                long el = mem.get_long(arr, 8 + k1 * 8)
                JS_PushArg(ctx, mem.get_long(this_val, 0))
                JS_PushArg(ctx, jstag.new_short_int(k1))
                JS_PushArg(ctx, el)
                JS_PushArg(ctx, acc)      // arg0
                JS_PushArg(ctx, pfunc)    // func
                JS_PushArg(ctx, jstag.JS_UNDEFINED)  // this
                acc = JS_Call(ctx, 4)
                if jstag.is_exception(acc) != 0 { err = 1  k = len }
                else { k = k + 1 }
            }
        }
    }
    free(acc_ref)
    if err != 0 { return jstag.JS_EXCEPTION }
    return acc
}

// JSValue js_array_sort(ctx, this_val, argc, argv)
// Builds a temp (value, original-index) pair array, sorts it with
// rqsort_idx using the C cmp/swap callbacks (addresses via `as fn`),
// then writes the sorted values back. JSArraySortContext (32 bytes):
// ctx@0, exception(int)@8, parr(ptr)@16, pfunc(ptr)@24.
js_array_sort(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long pfunc = mem.get_long(argv, 0)
    int has_func = 1
    if jstag.is_undefined(pfunc) != 0 {
        has_func = 0
    } else {
        if JS_IsFunction(ctx, pfunc) == 0 {
            return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
        }
    }
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int len = array_len_of(p)

    // temp array of len*2 JSValues (value, index pairs)
    tab = js_alloc_value_array(ctx, 0, len * 2)
    if tab == null { return jstag.JS_EXCEPTION }

    // re-fetch source
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    arr = jstag.value_to_ptr(array_tab_of(p))
    long arr_tail = mem.ptr_to_long(arr) + 8
    long tab_tail = mem.ptr_to_long(tab) + 8
    int n = 0
    int i = 0
    while i < len {
        long el = mem.get_long(mem.long_to_ptr(arr_tail + i * 8), 0)
        if jstag.is_undefined(el) == 0 {
            mem.set_long(mem.long_to_ptr(tab_tail + (2 * n) * 8), 0, el)
            mem.set_long(mem.long_to_ptr(tab_tail + (2 * n + 1) * 8), 0, jstag.new_short_int(i))
            n = n + 1
        }
        i = i + 1
    }

    long tab_val = jstag.value_from_ptr(tab)

    // GC-root the temp array; build the sort context. parr -> the
    // ref's val (so callbacks see the current tab pointer); pfunc slot
    // holds the comparator (or a slot containing JS_UNDEFINED -> null).
    tab_ref = malloc(16)
    gc_push(ctx, tab_ref, tab_val)

    sctx = malloc(32)
    mem.set_ptr(sctx, 0, ctx)               // ctx
    mem.set_int(sctx, 8, 0)                 // exception = FALSE
    mem.set_ptr(sctx, 16, mem.long_to_ptr(mem.ptr_to_long(tab_ref) + consts.GCREF_VAL))  // parr
    pfunc_slot = malloc(8)
    if has_func != 0 {
        mem.set_long(pfunc_slot, 0, pfunc)
        mem.set_ptr(sctx, 24, pfunc_slot)   // pfunc -> &pfunc
    } else {
        mem.set_ptr(sctx, 24, null)         // pfunc = NULL
    }

    cmp_addr = js_array_sort_cmp as fn(long, long, ptr) -> int
    swap_addr = js_array_sort_swap as fn(long, long, ptr) -> int
    rqsort_idx(n, cmp_addr, swap_addr, sctx)

    long tv2 = gc_pop(ctx, tab_ref)
    tab = jstag.value_to_ptr(tv2)
    int exc = mem.get_int(sctx, 8)
    free(pfunc_slot)
    free(sctx)
    free(tab_ref)
    if exc != 0 {
        js_free(ctx, tab)
        return jstag.JS_EXCEPTION
    }

    // write sorted values back
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    int cur_len = array_len_of(p)
    if cur_len < len { len = cur_len }
    arr = jstag.value_to_ptr(array_tab_of(p))
    arr_tail = mem.ptr_to_long(arr) + 8
    tab_tail = mem.ptr_to_long(tab) + 8
    i = 0
    while i < len {
        long v = mem.get_long(mem.long_to_ptr(tab_tail + (2 * i) * 8), 0)
        mem.set_long(mem.long_to_ptr(arr_tail + i * 8), 0, v)
        i = i + 1
    }
    js_free(ctx, tab)
    return mem.get_long(this_val, 0)
}

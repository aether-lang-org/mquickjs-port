// stdlib — merged package (auto-assembled from 2 files).

import ae.consts
import ae.define
import ae.jstag
import ae.mqtypes
import std.mem

extern JS_IsObject(ctx: ptr, val: long) -> int
extern JS_NewObjectProtoClass(ctx: ptr, proto: long, class_id: int, extra_size: int) -> long
extern js_new_c_function_proto(ctx: ptr, func_idx: int, proto: long, has_params: int, params: long) -> long
extern JS_NewObject(ctx: ptr) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (
    stdlib_init, stdlib_init_class
)

// ===== from stdlib_init.ae =====
// stdlib_init ported from mquickjs.c: install the standard library on the
// global object. The ROM table is a flat (name, value) JSValueArray; each
// value is either a class descriptor (materialised via stdlib_init_class),
// JS_NULL (meaning the global object itself), or a plain value, and is
// defined as a global property. Provides the bare C symbol; C body removed.






si_va_size(arr: ptr) -> int { long h = mem.get_long(arr, 0)  long s = h >> 4  return s }

// void stdlib_init(JSContext *ctx, const JSValueArray *arr)
stdlib_init(ctx: ptr, arr: ptr) {
    long base = mem.ptr_to_long(arr) + consts.VA_ARR
    int size = si_va_size(arr)
    long global_obj = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ)
    int i = 0
    while i < size {
        long name = mem.get_long(mem.long_to_ptr(base + i * 8), 0)
        long val = mem.get_long(mem.long_to_ptr(base + (i + 1) * 8), 0)
        if JS_IsObject(ctx, val) != 0 {
            val = stdlib_init_class(ctx, jstag.value_to_ptr(val))
        } else {
            if val == jstag.JS_NULL { val = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ) }
        }
        // re-read global_obj (DefineProperty may move nothing, but be safe)
        global_obj = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ)
        define.JS_DefinePropertyInternal(ctx, global_obj, name, val, jstag.JS_NULL, consts.JS_DEF_PROP_HAS_VALUE)
        i = i + 2
    }
}

// ===== from stdlib_init_class.ae =====
// stdlib_init_class ported from mquickjs.c: materialise one ROM class
// descriptor into a live constructor (or plain object), recursively
// initialising its parent class, creating the prototype object (linking
// to the parent prototype) and the C-function constructor, and attaching
// the ROM property tables. Memoised via ctx->class_obj. Provides the bare
// C symbol; C body removed.





// JSROMClass: props@8, ctor_idx@16(i32), proto_props@24, parent_class@32

// ctx->c_function_table[idx].magic
cft_magic(ctx: ptr, idx: int) -> int {
    long base = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_C_FUNCTION_TABLE))
    return mem.get_int16(mem.long_to_ptr(base + idx * consts.CFT_STRIDE), consts.CFD_MAGIC)
}
// ctx->class_obj[id]
class_obj_get(ctx: ptr, id: int) -> long {
    long base = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_CLASS_OBJ))
    return mem.get_long(mem.long_to_ptr(base + id * 8), 0)
}
class_obj_set(ctx: ptr, id: int, v: long) {
    long base = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_CLASS_OBJ))
    mem.set_long(mem.long_to_ptr(base + id * 8), 0, v)
}
// ctx->class_proto[id]
class_proto_get(ctx: ptr, id: int) -> long { return mem.get_long(ctx, consts.JSCTX_CLASS_PROTO + id * 8) }
class_proto_set(ctx: ptr, id: int, v: long) { mem.set_long(ctx, consts.JSCTX_CLASS_PROTO + id * 8, v) }

// JSValue stdlib_init_class(JSContext *ctx, const JSROMClass *class_def)
stdlib_init_class(ctx: ptr, class_def: ptr) -> long {
    int ctor_idx = mem.get_int(class_def, consts.RC_CTOR_IDX)
    long obj = 0

    if ctor_idx >= 0 {
        int class_id = cft_magic(ctx, ctor_idx)
        obj = class_obj_get(ctx, class_id)
        if jstag.is_null(obj) == 0 { return obj }   // already defined

        long parent_class = jstag.JS_NULL
        long parent_proto = 0
        long pcv = mem.get_long(class_def, consts.RC_PARENT_CLASS)
        if jstag.is_null(pcv) == 0 {
            pcd = jstag.value_to_ptr(pcv)
            parent_class = stdlib_init_class(ctx, pcd)
            int pcid = cft_magic(ctx, mem.get_int(pcd, consts.RC_CTOR_IDX))
            parent_proto = class_proto_get(ctx, pcid)
        } else {
            parent_class = jstag.JS_NULL
            parent_proto = class_proto_get(ctx, consts.JS_CLASS_OBJECT)
        }

        long proto = class_proto_get(ctx, class_id)
        if jstag.is_null(proto) != 0 {
            // GC-root parent_class across JS_NewObjectProtoClass
            ref = malloc(16)
            mem.set_long(ref, 0, parent_class)
            mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
            proto = JS_NewObjectProtoClass(ctx, parent_proto, consts.JS_CLASS_OBJECT, 0)
            parent_class = mem.get_long(ref, 0)
            mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
            free(ref)
            class_proto_set(ctx, class_id, proto)
        }
        pp = jstag.value_to_ptr(proto)
        long proto_props = mem.get_long(class_def, consts.RC_PROTO_PROPS)
        if jstag.is_null(proto_props) == 0 { mem.set_long(pp, consts.JSOBJ_PROPS, proto_props) }

        if jstag.is_null(parent_class) != 0 { parent_class = class_proto_get(ctx, consts.JS_CLASS_CLOSURE) }
        obj = js_new_c_function_proto(ctx, ctor_idx, parent_class, 0, jstag.JS_NULL)
        class_obj_set(ctx, class_id, obj)
    } else {
        obj = JS_NewObject(ctx)
    }

    p = jstag.value_to_ptr(obj)
    long props = mem.get_long(class_def, consts.RC_PROPS)
    if jstag.is_null(props) == 0 { mem.set_long(p, consts.JSOBJ_PROPS, props) }
    return obj
}

// put_var / set_eval_ret_undefined ported from mquickjs.c. put_var emits
// the store opcode matching a variable's reference kind; set_eval_ret_
// undefined stores `undefined` into the REPL result slot when one exists.
// Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts

extern emit_op(s: ptr, op: int)
extern emit_var(s: ptr, opcode: int, var_idx: int, source_pos: int)

exports (put_var, set_eval_ret_undefined)


// void put_var(JSParseState *s, JSVarRefKindEnum var_kind, int var_idx, JSSourcePos source_pos)
put_var(s: ptr, var_kind: int, var_idx: int, source_pos: int) {
    int opcode = opcodes.OP_put_var_ref_nocheck
    if var_kind == consts.JS_VARREF_KIND_ARG { opcode = opcodes.OP_put_arg }
    else { if var_kind == consts.JS_VARREF_KIND_VAR { opcode = opcodes.OP_put_loc } }
    emit_var(s, opcode, var_idx, source_pos)
}

// void set_eval_ret_undefined(JSParseState *s)
set_eval_ret_undefined(s: ptr) {
    int idx = (s as *JSParseState).eval_ret_idx
    if idx >= 0 {
        emit_op(s, opcodes.OP_undefined)
        int sp = (s as *JSParseState).pc2line_source_pos
        emit_var(s, opcodes.OP_put_loc, idx, sp)
    }
}

// js_string_convert_pos ported from mquickjs.c: convert between UTF-8 and
// UTF-16 positions in a (possibly non-ASCII) string, using a small
// per-context position cache to start the scan near the target. ASCII
// strings convert by a simple scale. Provides the bare C symbol; C body
// removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern get_string_ptr(ctx: ptr, buf: ptr, val: long) -> ptr
extern is_valid_len4_utf8(buf: ptr) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_string_convert_pos)

const POS_TYPE_UTF8 = 0
const POS_TYPE_UTF16 = 1
const INT32_MAX = 0x7fffffff
// JSContext: string_pos_cache_counter@54(u8), string_pos_cache[]@176
// (16 bytes each: str@0, str_pos[utf8]@8(u32), str_pos[utf16]@12(u32))
const SPC_STR = 0
const SPC_UTF8 = 8
const SPC_UTF16 = 12

scp_min(a: int, b: int) -> int { if a < b { return a } return b }
scp_str_len(p: ptr) -> int { return mem.get_long(p, 0) >> 7 }
scp_is_ascii(p: ptr) -> int { return (mem.get_long(p, 0) >> 5) & 1 }
scp_utf8_char_len(c: int) -> int {
    if c < 0x80 { return 1 }
    if c < 0xc0 { return 1 }
    if c < 0xe0 { return 2 }
    if c < 0xf0 { return 3 }
    if c < 0xf8 { return 4 }
    return 1
}
// cache entry address for index k
ce_addr(ctx: ptr, k: int) -> long { return mem.ptr_to_long(ctx) + consts.JSCTX_SPC + k * 16 }

// uint32_t js_string_convert_pos(JSContext *ctx, JSValue val, uint32_t pos, StringPosTypeEnum pos_type)
js_string_convert_pos(ctx: ptr, val: long, pos: int, pos_type: int) -> int {
    scratch = malloc(24)
    p = get_string_ptr(ctx, scratch, val)
    int len = scp_str_len(p)
    long pbuf = mem.ptr_to_long(p) + consts.STR_BUF

    if scp_is_ascii(p) != 0 {
        free(scratch)
        if pos_type == POS_TYPE_UTF8 { return scp_min(len, pos / 2) }
        return scp_min(len, pos) * 2
    }

    int has_surrogate = 0
    if pos_type == POS_TYPE_UTF8 {
        has_surrogate = pos & 1
        pos = (pos >> 1) & 0x7fffffff
    }

    long ce = 0       // cache entry address, 0 = none
    int i = 0
    int j = 0
    int do_uncached = 0

    if len < consts.JS_STRING_POS_CACHE_MIN_LEN {
        j = 0
        i = 0
        do_uncached = 1
    } else {
        int d_min = pos
        int ce_idx = 0
        while ce_idx < consts.JS_STRING_POS_CACHE_SIZE {
            long ce1 = ce_addr(ctx, ce_idx)
            if mem.get_long(mem.long_to_ptr(ce1 + SPC_STR), 0) == val {
                int dpos = mem.get_uint32(mem.long_to_ptr(ce1 + SPC_UTF8 + pos_type * 4), 0)
                int d = dpos - pos
                if dpos < pos { d = pos - dpos }
                if d < d_min { d_min = d  ce = ce1 }
            }
            ce_idx = ce_idx + 1
        }
        if ce == 0 {
            int cnt = mem.get_byte(ctx, consts.JSCTX_SPC_COUNTER)
            ce = ce_addr(ctx, cnt)
            cnt = cnt + 1
            if cnt == consts.JS_STRING_POS_CACHE_SIZE { cnt = 0 }
            mem.set_byte(ctx, consts.JSCTX_SPC_COUNTER, cnt)
            mem.set_long(mem.long_to_ptr(ce + SPC_STR), 0, val)
            mem.set_uint32(mem.long_to_ptr(ce + SPC_UTF8), 0, 0)
            mem.set_uint32(mem.long_to_ptr(ce + SPC_UTF16), 0, 0)
        }
        i = mem.get_uint32(mem.long_to_ptr(ce + SPC_UTF8), 0)
        j = mem.get_uint32(mem.long_to_ptr(ce + SPC_UTF16), 0)
        if mem.get_uint32(mem.long_to_ptr(ce + SPC_UTF8 + pos_type * 4), 0) <= pos {
            do_uncached = 1
        }
    }

    int surrogate_flag = 0
    if do_uncached != 0 {
        // forward scan
        int limit = INT32_MAX
        int scanlen = len
        if pos_type == POS_TYPE_UTF8 { scanlen = pos } else { limit = pos }
        int looping = 1
        while looping != 0 {
            if i >= scanlen { looping = 0 }
            else { if j == limit { looping = 0 }
            else {
                int b0 = mem.get_byte(mem.long_to_ptr(pbuf + i), 0)
                int clen = scp_utf8_char_len(b0)
                if clen == 4 && is_valid_len4_utf8(mem.long_to_ptr(pbuf + i)) != 0 {
                    if (j + 1) == limit { surrogate_flag = 1  looping = 0 }
                    else { j = j + 2  i = i + clen }
                } else {
                    j = j + 1
                    i = i + clen
                }
            } }
        }
    } else {
        // backward scan
        int limit = pos
        int start = 0
        if pos_type == POS_TYPE_UTF8 { start = pos  limit = INT32_MAX }
        int looping = 1
        while looping != 0 {
            if i > start {
                int i0 = i
                i = i - 1
                int cont = 1
                while cont != 0 {
                    int bb = mem.get_byte(mem.long_to_ptr(pbuf + i), 0)
                    if (bb & 0xc0) == 0x80 { i = i - 1 } else { cont = 0 }
                }
                int clen = i0 - i
                if clen == 4 && is_valid_len4_utf8(mem.long_to_ptr(pbuf + i)) != 0 {
                    j = j - 2
                    if (j + 1) == limit { surrogate_flag = 1  looping = 0 }
                } else {
                    j = j - 1
                }
                if looping != 0 { if j == limit { looping = 0 } }
            } else { looping = 0 }
        }
    }

    if ce != 0 {
        mem.set_uint32(mem.long_to_ptr(ce + SPC_UTF8), 0, i)
        mem.set_uint32(mem.long_to_ptr(ce + SPC_UTF16), 0, j)
    }
    free(scratch)
    if pos_type == POS_TYPE_UTF8 { return j + has_surrogate }
    return i * 2 + surrogate_flag
}

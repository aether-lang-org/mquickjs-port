// pexpr — merged package (auto-assembled from 5 files).

import ae.consts
import ae.define
import ae.emit
import ae.getpkg
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.put
import std.mem
import ae.stackalloc

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern next_token(s: ptr)
extern js_parse_expect(s: ptr, ch: int)
extern new_label(s: ptr) -> long
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern find_ext_var(s: ptr, name: long) -> int
extern add_ext_var(s: ptr, name: long, decl: int) -> int
extern get_ext_var_name(s: ptr, var_idx: int) -> long
extern cpool_add(s: ptr, val: long) -> int
extern js_parse_property_name(s: ptr, pname: ptr) -> int
extern js_parse_function_decl(s: ptr, func_type: int, name: long)
extern js_parse_regexp(s: ptr, re_flags: int) -> long
extern js_parse_call(s: ptr, func_idx: int, param: int)

exports (
    js_parse_logical_and_or, js_parse_cond_expr, js_parse_assign_expr, js_parse_expr_comma, js_parse_expr_binary,
    js_parse_unary, js_parse_postfix_expr, js_parse_expr2, js_parse_expr, js_parse_assign_expr2,
    js_parse_expr_paren, min_int
)

// ===== from parse_assign.ae =====
// The upper expression ladder ported from mquickjs.c:
// js_parse_logical_and_or, js_parse_cond_expr, js_parse_assign_expr,
// js_parse_expr_comma. These are co-routine-style parse functions
// driven by js_parse_call: each takes (s, st, parse_flags) and
// returns an encoded st|(func<<8)|(param<<16) at every sub-call
// point so the driver can resume it. The C goto-after-return machinery
// (PARSE_START/PARSE_CALL) is re-expressed as a switch on `st` with
// saved locals popped on re-entry. Provides the bare C symbols.











// token.val @8, token.source_pos @12, dropped_result @37, last_opcode_pos @92
tok_val(s: ptr) -> int { return mem.get_int(s, 8) }
tok_source_pos(s: ptr) -> int { return mem.get_uint32(s, 12) }
set_dropped(s: ptr, v: int) { mem.set_byte(s, 37, v) }
get_dropped(s: ptr) -> int { return mem.get_byte(s, 37) }

push_int(s: ptr, v: int) { stackalloc.js_parse_push_val(s, jstag.new_short_int(v)) }
pop_int(s: ptr) -> int { return jstag.get_int(stackalloc.js_parse_pop_val(s)) }

// encode a PARSE_CALL: st | (fn << 8) | (param << 16)
enc(cur_state: int, fn: int, param: int) -> int {
    return cur_state | (fn << 8) | (param << 16)
}

may_drop_result(s: ptr, parse_flags: int) -> int {
    if (parse_flags & consts.PF_DROP) == 0 { return 0 }
    int v = tok_val(s)
    if v == 59 { return 1 }   // ';'
    if v == 41 { return 1 }   // ')'
    if v == 44 { return 1 }   // ','
    return 0
}

// int js_parse_logical_and_or(JSParseState *s, int st, int parse_flags)
js_parse_logical_and_or(s: ptr, st: int, parse_flags: int) -> int {
    long label1 = jstag.JS_NULL
    int level = 0
    int op = 0

    if st == consts.PARSE_STATE_INIT {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 0 {
            // PARSE_CALL(s, 0, js_parse_expr_binary, (pf & ~MASK) | (8<<SHIFT))
            return enc(0, consts.PARSE_FUNC_expr_binary, (parse_flags & (0 - 1 - consts.PF_LEVEL_MASK)) | (8 << consts.PF_LEVEL_SHIFT))
        }
        // PARSE_CALL_SAVE1(s, 1, logical_and_or, pf - (1<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    if st == 0 {
        return consts.PARSE_STATE_RET
    }

    if st == 1 {
        parse_flags = pop_int(s)
    } else {
        // st == 2: resume inside the for-loop after the recursive call.
        // SAVE1 pushed parse_flags last (after PUSH_VAL label1), so pop
        // parse_flags first, then label1.
        parse_flags = pop_int(s)
        label1 = stackalloc.js_parse_pop_val(s)
    }

    if st == 1 {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 1 { op = consts.TOK_LAND } else { op = consts.TOK_LOR }
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
        if tok_val(s) != op { return consts.PARSE_STATE_RET }
        label1 = new_label(s)
        // enter loop body
        next_token(s)
        emit.emit_op(s, opcodes.OP_dup)
        int g = opcodes.OP_if_true
        if op == consts.TOK_LAND { g = opcodes.OP_if_false }
        label1 = emit_goto_val(s, g, label1)
        emit.emit_op(s, opcodes.OP_drop)
        stackalloc.js_parse_push_val(s, label1)
        push_int(s, parse_flags)
        return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    // st == 2 loop continuation
    int looping = 1
    while looping != 0 {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 1 { op = consts.TOK_LAND } else { op = consts.TOK_LOR }
        if tok_val(s) != op { looping = 0 }
        else {
            next_token(s)
            emit.emit_op(s, opcodes.OP_dup)
            int g = opcodes.OP_if_true
            if op == consts.TOK_LAND { g = opcodes.OP_if_false }
            label1 = emit_goto_val(s, g, label1)
            emit.emit_op(s, opcodes.OP_drop)
            stackalloc.js_parse_push_val(s, label1)
            push_int(s, parse_flags)
            return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
        }
    }
    label1 = emit_label_val(s, label1)
    return consts.PARSE_STATE_RET
}

// emit.emit_goto / emit.emit_label take JSValue* and may mutate the label
// (backpatch-chain head / resolved flag). Return the updated value.
emit_goto_val(s: ptr, opcode: int, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit.emit_goto(s, opcode, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}
emit_label_val(s: ptr, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit.emit_label(s, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}

// int js_parse_cond_expr(JSParseState *s, int st, int parse_flags)
js_parse_cond_expr(s: ptr, st: int, parse_flags: int) -> int {
    long label1 = jstag.JS_NULL
    long label2 = jstag.JS_NULL

    if st == consts.PARSE_STATE_INIT {
        // PARSE_CALL_SAVE1(s, 2, logical_and_or, pf | (2<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags | (2 << consts.PF_LEVEL_SHIFT))
    }

    if st == 2 {
        parse_flags = pop_int(s)
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
        if tok_val(s) != 63 { return consts.PARSE_STATE_RET }   // '?'
        next_token(s)
        label1 = new_label(s)
        label1 = emit_goto_val(s, opcodes.OP_if_false, label1)
        stackalloc.js_parse_push_val(s, label1)
        push_int(s, parse_flags)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    if st == 0 {
        parse_flags = pop_int(s)
        label1 = stackalloc.js_parse_pop_val(s)
        label2 = new_label(s)
        label2 = emit_goto_val(s, opcodes.OP_goto, label2)
        js_parse_expect(s, 58)   // ':'
        label1 = emit_label_val(s, label1)
        stackalloc.js_parse_push_val(s, label2)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    // st == 1
    parse_flags = pop_int(s)
    label2 = stackalloc.js_parse_pop_val(s)
    label2 = emit_label_val(s, label2)
    return consts.PARSE_STATE_RET
}

// int js_parse_assign_expr(JSParseState *s, int st, int parse_flags)
js_parse_assign_expr(s: ptr, st: int, parse_flags: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        // PARSE_CALL_SAVE1(s, 1, cond_expr, parse_flags, parse_flags)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_cond_expr, parse_flags)
    }

    if st == 1 {
        parse_flags = pop_int(s)
        int op = tok_val(s)
        int is_assign = 0
        if op == 61 { is_assign = 1 }                          // '='
        if op >= consts.TOK_MUL_ASSIGN { if op <= consts.TOK_OR_ASSIGN { is_assign = 1 } }
        if is_assign == 0 { return consts.PARSE_STATE_RET }

        int op_source_pos = tok_source_pos(s)
        next_token(s)
        lv = malloc(12)
        int keep = 1
        if op == 61 { keep = 0 }
        getpkg.get_lvalue(s, lv, mem.long_to_ptr(mem.ptr_to_long(lv) + 4), mem.long_to_ptr(mem.ptr_to_long(lv) + 8), keep)
        int opcode = mem.get_int(lv, 0)
        int var_idx = mem.get_int(lv, 4)
        int source_pos = mem.get_uint32(lv, 8)
        free(lv)

        // PARSE_CALL_SAVE6(s, 0, assign_expr, pf & ~consts.PF_DROP,
        //   op, opcode, var_idx, parse_flags, op_source_pos, source_pos)
        push_int(s, op)
        push_int(s, opcode)
        push_int(s, var_idx)
        push_int(s, parse_flags)
        push_int(s, op_source_pos)
        push_int(s, source_pos)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags & (0 - 1 - consts.PF_DROP))
    }

    // st == 0: restore 6 saved ints (reverse push order)
    int source_pos = pop_int(s)
    int op_source_pos = pop_int(s)
    parse_flags = pop_int(s)
    int var_idx = pop_int(s)
    int opcode = pop_int(s)
    int op = pop_int(s)

    if op != 61 {   // '='
        emit.emit_op_pos(s, assign_opcode(op), op_source_pos)
    }
    int special = consts.PUT_LVALUE_KEEP_TOP
    if may_drop_result(s, parse_flags) != 0 {
        special = consts.PUT_LVALUE_NOKEEP_TOP
        set_dropped(s, 1)
    }
    put.put_lvalue(s, opcode, var_idx, source_pos, special)
    return consts.PARSE_STATE_RET
}

// assign_opcodes[op - consts.TOK_MUL_ASSIGN]:
//   mul div mod add sub shl sar shr and xor or pow
assign_opcode(op: int) -> int {
    int i = op - consts.TOK_MUL_ASSIGN
    if i == 0 { return 71 }    // opcodes.OP_mul
    if i == 1 { return 72 }    // opcodes.OP_div
    if i == 2 { return 73 }    // opcodes.OP_mod
    if i == 3 { return 74 }    // opcodes.OP_add
    if i == 4 { return 75 }    // opcodes.OP_sub
    if i == 5 { return 77 }    // opcodes.OP_shl
    if i == 6 { return 78 }    // opcodes.OP_sar
    if i == 7 { return 79 }    // opcodes.OP_shr
    if i == 8 { return 90 }    // opcodes.OP_and
    if i == 9 { return 91 }    // opcodes.OP_xor
    if i == 10 { return 92 }   // opcodes.OP_or
    return 76                  // opcodes.OP_pow
}

// int js_parse_expr_comma(JSParseState *s, int st, int parse_flags)
js_parse_expr_comma(s: ptr, st: int, parse_flags: int) -> int {
    int comma = 0

    if st == consts.PARSE_STATE_INIT {
        set_dropped(s, 0)
        // PARSE_CALL_SAVE2(s, 0, assign_expr, parse_flags, comma, parse_flags)
        push_int(s, comma)
        push_int(s, parse_flags)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    // st == 0
    parse_flags = pop_int(s)
    comma = pop_int(s)

    int looping = 1
    while looping != 0 {
        if comma != 0 {
            mem.set_int(s, 92, 0 - 1)   // s->last_opcode_pos = -1
        }
        if tok_val(s) != 44 { looping = 0 }   // ','
        else {
            comma = 1
            if get_dropped(s) == 0 { emit.emit_op(s, opcodes.OP_drop) }
            next_token(s)
            set_dropped(s, 0)
            push_int(s, comma)
            push_int(s, parse_flags)
            return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
        }
    }
    if (parse_flags & consts.PF_DROP) != 0 {
        if get_dropped(s) == 0 { emit.emit_op(s, opcodes.OP_drop) }
    }
    return consts.PARSE_STATE_RET
}

// ===== from parse_binary.ae =====
// The binary-operator precedence climber ported from mquickjs.c:
// js_parse_expr_binary. A resumable parse function driven by
// js_parse_call: one PF_LEVEL per binary precedence band (1=* / %,
// 2=+ -, 3=shifts, 4=relational, 5=equality, 6=&, 7=^, 8=|). At each
// level it parses the next-tighter level, then folds left while the
// current token matches an operator at this level. The C goto-after-
// return state machine becomes a switch on the entry state with locals
// saved on / restored from the parser value stack. Provides the bare C
// symbol; C body removed.













// opcode for (level, op) or -1 if the token is not an operator here.
binary_opcode(level: int, op: int, parse_flags: int) -> int {
    if level == 1 {
        if op == 42 { return opcodes.OP_mul }    // '*'
        if op == 47 { return opcodes.OP_div }    // '/'
        if op == 37 { return opcodes.OP_mod }    // '%'
        return 0 - 1
    }
    if level == 2 {
        if op == 43 { return opcodes.OP_add }    // '+'
        if op == 45 { return opcodes.OP_sub }    // '-'
        return 0 - 1
    }
    if level == 3 {
        if op == consts.TOK_SHL { return opcodes.OP_shl }
        if op == consts.TOK_SAR { return opcodes.OP_sar }
        if op == consts.TOK_SHR { return opcodes.OP_shr }
        return 0 - 1
    }
    if level == 4 {
        if op == 60 { return opcodes.OP_lt }     // '<'
        if op == 62 { return opcodes.OP_gt }     // '>'
        if op == consts.TOK_LTE { return opcodes.OP_lte }
        if op == consts.TOK_GTE { return opcodes.OP_gte }
        if op == consts.TOK_INSTANCEOF { return opcodes.OP_instanceof }
        if op == consts.TOK_IN {
            if (parse_flags & consts.PF_NO_IN) == 0 { return opcodes.OP_in }
            return 0 - 1
        }
        return 0 - 1
    }
    if level == 5 {
        if op == consts.TOK_EQ { return opcodes.OP_eq }
        if op == consts.TOK_NEQ { return opcodes.OP_neq }
        if op == consts.TOK_STRICT_EQ { return opcodes.OP_strict_eq }
        if op == consts.TOK_STRICT_NEQ { return opcodes.OP_strict_neq }
        return 0 - 1
    }
    if level == 6 {
        if op == 38 { return opcodes.OP_and }    // '&'
        return 0 - 1
    }
    if level == 7 {
        if op == 94 { return opcodes.OP_xor }    // '^'
        return 0 - 1
    }
    if level == 8 {
        if op == 124 { return opcodes.OP_or }    // '|'
        return 0 - 1
    }
    return 0 - 1
}

// int js_parse_expr_binary(JSParseState *s, int state, int parse_flags)
js_parse_expr_binary(s: ptr, st: int, parse_flags: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        int level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 0 {
            return enc(0, consts.PARSE_FUNC_unary, parse_flags)
        }
        // PARSE_CALL_SAVE1(s, 1, expr_binary, pf - (1<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_expr_binary, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    if st == 0 {
        return consts.PARSE_STATE_RET
    }

    if st == 1 {
        parse_flags = pop_int(s)
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
    } else {
        // st == 2: resume after the recursive fold call. SAVE3 pushed
        // parse_flags, opcode, op_source_pos; pop in reverse.
        int op_source_pos = pop_int(s)
        int opcode = pop_int(s)
        parse_flags = pop_int(s)
        emit.emit_op_pos(s, opcode, op_source_pos)
    }

    int looping = 1
    while looping != 0 {
        int op = tok_val(s)
        int op_source_pos = tok_source_pos(s)
        int level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        int opcode = binary_opcode(level, op, parse_flags)
        if opcode < 0 { looping = 0 }
        else {
            next_token(s)
            push_int(s, parse_flags)
            push_int(s, opcode)
            push_int(s, op_source_pos)
            return enc(2, consts.PARSE_FUNC_expr_binary, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
        }
    }
    return consts.PARSE_STATE_RET
}

// ===== from parse_unary.ae =====
// The unary-operator parser ported from mquickjs.c: js_parse_unary.
// Handles prefix + - ! ~ (with a numeric-literal fast path), void,
// prefix ++/--, typeof (with the getpkg.get_var_ref -> _nocheck patch),
// delete, and the ** (exponentiation) tail after a postfix expression.
// A resumable parse function driven by js_parse_call: the C
// goto-after-return state machine becomes a switch on the entry state
// with locals saved on / restored from the parser value stack. On the
// INIT entry it dispatches on the current token; on every resume entry
// it dispatches on the saved state. Provides the bare C symbol.








const TOK_DEC = 144
const TOK_INC = 145



tok_d(s: ptr) -> float { return mem.get_float64(s, 16) }   // token.u.d
last_opcode_pos(s: ptr) -> int { return mem.get_int(s, 92) }




// byte_code value -> JSByteArray buf (ptr + 8), mirrors get_byte_code.
bc_buf(s: ptr) -> long {
    long bc = (s as *JSParseState).byte_code
    arr = jstag.value_to_ptr(bc)
    return mem.ptr_to_long(arr) + 8
}

// int js_parse_unary(JSParseState *s, int state, int parse_flags)
js_parse_unary(s: ptr, st: int, parse_flags: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        int t = tok_val(s)
        if t == 43 { return init_prefix(s, t) }    // '+'
        if t == 45 { return init_prefix(s, t) }    // '-'
        if t == 33 { return init_prefix(s, t) }    // '!'
        if t == 126 { return init_prefix(s, t) }   // '~'
        if t == consts.TOK_VOID {
            next_token(s)
            return enc(1, consts.PARSE_FUNC_unary, 0)
        }
        if t == TOK_DEC { return init_incdec(s, t, parse_flags) }
        if t == TOK_INC { return init_incdec(s, t, parse_flags) }
        if t == consts.TOK_TYPEOF {
            next_token(s)
            return enc(3, consts.PARSE_FUNC_unary, 0)
        }
        if t == consts.TOK_DELETE {
            next_token(s)
            return enc(4, consts.PARSE_FUNC_unary, 0)
        }
        // default: postfix expr, then maybe **
        return enc(5, consts.PARSE_FUNC_postfix_expr, parse_flags | consts.PF_ACCEPT_LPAREN)
    }

    if st == 0 {
        // resume of +/-/!/~ : SAVE2 pushed op, op_source_pos
        int op_source_pos = pop_int(s)
        int op = pop_int(s)
        if op == 45 { emit.emit_op_pos(s, opcodes.OP_neg, op_source_pos) }
        else if op == 43 { emit.emit_op_pos(s, opcodes.OP_plus, op_source_pos) }
        else if op == 33 { emit.emit_op_pos(s, opcodes.OP_lnot, op_source_pos) }
        else { emit.emit_op_pos(s, opcodes.OP_not, op_source_pos) }
        return consts.PARSE_STATE_RET
    }

    if st == 1 {
        // resume of void
        emit.emit_op(s, opcodes.OP_drop)
        emit.emit_op(s, opcodes.OP_undefined)
        return consts.PARSE_STATE_RET
    }

    if st == 2 {
        // resume of ++/-- : SAVE3 pushed op, parse_flags, op_source_pos
        int op_source_pos = pop_int(s)
        parse_flags = pop_int(s)
        int op = pop_int(s)
        lv = malloc(12)
        getpkg.get_lvalue(s, lv, mem.long_to_ptr(mem.ptr_to_long(lv) + 4), mem.long_to_ptr(mem.ptr_to_long(lv) + 8), 1)
        int opcode = mem.get_int(lv, 0)
        int var_idx = mem.get_int(lv, 4)
        int source_pos = mem.get_uint32(lv, 8)
        free(lv)
        emit.emit_op_pos(s, opcodes.OP_dec + op - TOK_DEC, op_source_pos)
        int special = consts.PUT_LVALUE_KEEP_TOP
        if may_drop_result(s, parse_flags) != 0 {
            special = consts.PUT_LVALUE_NOKEEP_TOP
            set_dropped(s, 1)
        }
        put.put_lvalue(s, opcode, var_idx, source_pos, special)
        return consts.PARSE_STATE_RET
    }

    if st == 3 {
        // resume of typeof : patch getpkg.get_var_ref -> nocheck
        if emit.get_prev_opcode(s) == opcodes.OP_get_var_ref {
            long base = bc_buf(s)
            mem.set_byte(mem.long_to_ptr(base + last_opcode_pos(s)), 0, opcodes.OP_get_var_ref_nocheck)
        }
        emit.emit_op(s, opcodes.OP_typeof)
        return consts.PARSE_STATE_RET
    }

    if st == 4 {
        // resume of delete
        emit.js_emit_delete(s)
        return consts.PARSE_STATE_RET
    }

    if st == 5 {
        // resume of default (postfix): maybe ** tail
        if tok_val(s) == consts.TOK_POW {
            int op_source_pos = tok_source_pos(s)
            next_token(s)
            push_int(s, op_source_pos)
            return enc(6, consts.PARSE_FUNC_unary, 0)
        }
        return consts.PARSE_STATE_RET
    }

    // st == 6: resume of ** right operand
    int op_source_pos = pop_int(s)
    emit.emit_op_pos(s, opcodes.OP_pow, op_source_pos)
    return consts.PARSE_STATE_RET
}

// +/-/!/~ : numeric fast path or recurse into unary.
init_prefix(s: ptr, op: int) -> int {
    int op_source_pos = tok_source_pos(s)
    next_token(s)
    if tok_val(s) == consts.TOK_NUMBER {
        if op == 45 {   // '-'
            // true IEEE negation (flip sign bit) so -0.0 stays negative;
            // 0.0 - d would coalesce negative zero to +0.0.
            long signbit = 1
            signbit = signbit << 63
            long bits = mem.bits_of_float(tok_d(s)) ^ signbit
            float d = mem.float_from_bits(bits)
            emit.js_emit_push_number(s, d)
            next_token(s)
            return consts.PARSE_STATE_RET
        }
        if op == 43 {   // '+'
            emit.js_emit_push_number(s, tok_d(s))
            next_token(s)
            return consts.PARSE_STATE_RET
        }
    }
    // PARSE_CALL_SAVE2(s, 0, unary, 0, op, op_source_pos)
    push_int(s, op)
    push_int(s, op_source_pos)
    return enc(0, consts.PARSE_FUNC_unary, 0)
}

// ++/-- prefix.
init_incdec(s: ptr, op: int, parse_flags: int) -> int {
    int op_source_pos = tok_source_pos(s)
    next_token(s)
    // PARSE_CALL_SAVE3(s, 2, unary, 0, op, parse_flags, op_source_pos)
    push_int(s, op)
    push_int(s, parse_flags)
    push_int(s, op_source_pos)
    return enc(2, consts.PARSE_FUNC_unary, 0)
}

// ===== from parse_postfix.ae =====
// The postfix/primary-expression parser ported from mquickjs.c:
// js_parse_postfix_expr. Parses a primary expression (number, string,
// regexp, parenthesised expr, function expr, null/this/true/false,
// identifier, object literal, array literal, new) and then a trailing
// chain of calls, .field, [index] and postfix ++/--. A resumable parse
// function driven by js_parse_call: the C goto-after-return state
// machine becomes an INIT entry that dispatches on the current token
// and seven resume entries that dispatch on the saved state, with
// locals saved on / restored from the parser value stack. The
// synchronous sub-parsers (js_parse_regexp, js_parse_function_decl,
// js_parse_property_name) stay C and are called directly. Provides the
// bare C symbol; C body removed.















tok_re_flags(s: ptr) -> int { return mem.get_uint32(s, 16) }
tok_re_end_pos(s: ptr) -> int { return mem.get_uint32(s, 20) }
tok_value(s: ptr) -> long { return mem.get_long(s, 24) }
ps_ctx(s: ptr) -> ptr { return (s as *JSParseState).ctx }
got_lf(s: ptr) -> int { return mem.get_byte(s, 32) }
byte_code_len(s: ptr) -> int { return mem.get_uint32(s, 88) }
pc2line_source_pos(s: ptr) -> int { return mem.get_uint32(s, 108) }



min_int(a: int, b: int) -> int { if a < b { return a } return b }



// read/write a uint16 in the bytecode buffer at byte offset `pos`.
bc_get_u16(s: ptr, pos: int) -> int {
    return mem.get_uint16(mem.long_to_ptr(bc_buf(s) + pos), 0)
}
bc_set_u16(s: ptr, pos: int, v: int) {
    mem.set_uint16(mem.long_to_ptr(bc_buf(s) + pos), 0, v)
}
bc_get_byte(s: ptr, pos: int) -> int {
    return mem.get_byte(mem.long_to_ptr(bc_buf(s) + pos), 0)
}
bc_set_byte(s: ptr, pos: int, v: int) {
    mem.set_byte(mem.long_to_ptr(bc_buf(s) + pos), 0, v)
}

atom(s: ptr, a: int) -> long { return js_get_atom(ps_ctx(s), a) }

// emit an identifier primary (consts.TOK_IDENT case).
emit_ident(s: ptr) {
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    int arg_count = (b as *JSFunctionBytecode).arg_count
    long name = tok_value(s)
    int var_idx = define.find_var(s, name)
    int opcode = opcodes.OP_get_var_ref
    if var_idx >= 0 {
        if var_idx < arg_count { opcode = opcodes.OP_get_arg }
        else { opcode = opcodes.OP_get_loc  var_idx = var_idx - arg_count }
    } else {
        var_idx = find_ext_var(s, name)
        if var_idx < 0 {
            var_idx = add_ext_var(s, name, consts.JS_VARREF_KIND_GLOBAL << 16)
        }
        opcode = opcodes.OP_get_var_ref
    }
    emit.emit_var(s, opcode, var_idx, tok_source_pos(s))
    next_token(s)
}

// the regexp primary (consts.TOK_REGEXP case): re-point the parser at the
// pattern and run js_parse_regexp, restoring buf/byte_code afterwards.
emit_regexp(s: ptr) {
    emit.js_emit_push_const(s, tok_value(s))   // regexp source
    int saved_buf_pos = mem.get_uint32(s, 64)
    int saved_buf_len = mem.get_uint32(s, 68)
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    // b->byte_code = s->byte_code
    mem.set_long(b, 16, (s as *JSParseState).byte_code)
    int saved_byte_code_len = byte_code_len(s)

    mem.set_uint32(s, 64, tok_source_pos(s) + 1)   // buf_pos = source_pos+1
    mem.set_uint32(s, 68, tok_re_end_pos(s))       // buf_len = re_end_pos
    long byte_code = js_parse_regexp(s, tok_re_flags(s))

    mem.set_uint32(s, 64, saved_buf_pos)
    mem.set_uint32(s, 68, saved_buf_len)
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    // s->byte_code = b->byte_code
    (s as *JSParseState).byte_code = mem.get_long(b, 16)
    mem.set_uint32(s, 88, saved_byte_code_len)

    emit.js_emit_push_const(s, byte_code)
    emit.emit_op(s, opcodes.OP_regexp)
    next_token(s)
}

// int js_parse_postfix_expr(JSParseState *s, int state, int parse_flags)
js_parse_postfix_expr(s: ptr, st: int, parse_flags: int) -> int {
    int is_new = 0

    if st == consts.PARSE_STATE_INIT {
        int r = parse_primary(s, parse_flags)
        if r != consts.PARSE_STATE_RET { return r }
        // primary done synchronously -> enter postfix loop
        return postfix_loop(s, parse_flags, 0)
    }

    if st == 0 {
        // resume of '(' expr ')'
        parse_flags = pop_int(s)
        js_parse_expect(s, 41)   // ')'
        return postfix_loop(s, parse_flags, 0)
    }

    if st == 1 {
        // resume inside object-literal loop after a field value.
        // SAVE4 pushed prop_idx, parse_flags, has_proto, count_pos.
        int count_pos = pop_int(s)
        int has_proto = pop_int(s)
        parse_flags = pop_int(s)
        int prop_idx = pop_int(s)
        if prop_idx >= 0 {
            emit.emit_op(s, opcodes.OP_define_field)
            emit.emit_u16(s, prop_idx)
        } else {
            emit.emit_op(s, opcodes.OP_set_proto)
        }
        // tail of the loop body: trailing comma then continue
        int r = consts.PARSE_STATE_RET
        if tok_val(s) != 44 {   // ','
            js_parse_expect(s, 125)   // '}'
        } else {
            next_token(s)
            r = object_loop(s, parse_flags, has_proto, count_pos)
        }
        if r != consts.PARSE_STATE_RET { return r }
        return postfix_loop(s, parse_flags, 0)
    }

    if st == 2 {
        // resume inside stack-array loop. SAVE2 pushed idx, parse_flags.
        parse_flags = pop_int(s)
        int idx = pop_int(s)
        idx = idx + 1
        int r = array_continue_after_elem(s, parse_flags, idx)
        if r != consts.PARSE_STATE_RET { return r }
        return postfix_loop(s, parse_flags, 0)
    }

    if st == 3 {
        // resume inside overflow-array loop. SAVE2 pushed idx, parse_flags.
        parse_flags = pop_int(s)
        int idx = pop_int(s)
        emit.emit_op(s, opcodes.OP_put_array_el)
        idx = idx + 1
        if tok_val(s) == 44 { next_token(s) }   // trailing comma
        int r = array_loop_overflow(s, parse_flags, idx)
        if r != consts.PARSE_STATE_RET { return r }
        return postfix_loop(s, parse_flags, 0)
    }

    if st == 4 {
        // resume of `new` callee. SAVE1 pushed parse_flags.
        parse_flags = pop_int(s)
        if tok_val(s) != 40 {   // not '('
            emit.emit_op_param(s, opcodes.OP_call_constructor, 0, tok_source_pos(s))
            return postfix_loop(s, parse_flags, 0)
        }
        // is_new = TRUE; break -> enter postfix loop with is_new set
        return postfix_loop(s, parse_flags, 1)
    }

    if st == 5 {
        // resume inside call-args loop. SAVE5 pushed parse_flags,
        // arg_count, opcode, is_new, op_source_pos.
        int op_source_pos = pop_int(s)
        is_new = pop_int(s)
        int opcode = pop_int(s)
        int arg_count = pop_int(s)
        parse_flags = pop_int(s)
        int r = call_args_loop(s, parse_flags, arg_count, opcode, is_new, op_source_pos)
        if r != consts.PARSE_STATE_RET { return r }
        return postfix_loop(s, parse_flags, 0)
    }

    // st == 6: resume of [index]. SAVE3 pushed parse_flags, is_new, op_source_pos.
    int op_source_pos = pop_int(s)
    is_new = pop_int(s)
    parse_flags = pop_int(s)
    js_parse_expect(s, 93)   // ']'
    emit.emit_op_pos(s, opcodes.OP_get_array_el, op_source_pos)
    return postfix_loop(s, parse_flags, is_new)
}

// Parse the primary expression. Returns consts.PARSE_STATE_RET if it completed
// synchronously (caller then runs the postfix loop), or an enc() if it
// issued a sub-call (the matching resume state finishes it).
parse_primary(s: ptr, parse_flags: int) -> int {
    int t = tok_val(s)
    if t == consts.TOK_NUMBER {
        emit.js_emit_push_number(s, tok_d(s))
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_STRING {
        emit.js_emit_push_const(s, tok_value(s))
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_REGEXP {
        emit_regexp(s)
        return consts.PARSE_STATE_RET
    }
    if t == 40 {   // '('
        next_token(s)
        push_int(s, parse_flags)
        return enc(0, consts.PARSE_FUNC_expr_comma, 0)
    }
    if t == consts.TOK_FUNCTION {
        js_parse_function_decl(s, consts.JS_PARSE_FUNC_EXPR, jstag.JS_NULL)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_NULL {
        emit.emit_op(s, opcodes.OP_null)
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_THIS {
        emit.emit_op(s, opcodes.OP_push_this)
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_FALSE {
        emit.emit_op(s, opcodes.OP_push_false)
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_TRUE {
        emit.emit_op(s, opcodes.OP_push_false + 1)
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_IDENT {
        emit_ident(s)
        return consts.PARSE_STATE_RET
    }
    if t == 123 {   // '{'
        next_token(s)
        emit.emit_op(s, opcodes.OP_object)
        int count_pos = byte_code_len(s)
        emit.emit_u16(s, 0)
        return object_loop(s, parse_flags, 0, count_pos)
    }
    if t == 91 {   // '['
        next_token(s)
        return array_loop_stack(s, parse_flags, 0)
    }
    if t == consts.TOK_NEW {
        next_token(s)
        if tok_val(s) == 46 {   // '.'
            next_token(s)
            int ok = 0
            if tok_val(s) == consts.TOK_IDENT { if tok_value(s) == atom(s, consts.JS_ATOM_target) { ok = 1 } }
            if ok == 0 { js_parse_error(s, "expecting target") }
            next_token(s)
            emit.emit_op(s, opcodes.OP_new_target)
            return consts.PARSE_STATE_RET
        }
        // PARSE_CALL_SAVE1(s, 4, postfix_expr, 0, parse_flags)
        push_int(s, parse_flags)
        return enc(4, consts.PARSE_FUNC_postfix_expr, 0)
    }
    js_parse_error(s, "unexpected character in expression")
    return consts.PARSE_STATE_RET
}

// object-literal loop body. Returns RET when the '}' is consumed, or an
// enc() when a field value sub-call is issued (resumed at state 1).
object_loop(s: ptr, parse_flags: int, has_proto: int, count_pos: int) -> int {
    while tok_val(s) != 125 {   // '}'
        nslot = malloc(8)
        int prop_type = js_parse_property_name(s, nslot)
        long name = mem.get_long(nslot, 0)
        free(nslot)
        int prop_idx = 0 - 1
        if prop_type == consts.PARSE_PROP_FIELD {
            if name == atom(s, consts.JS_ATOM___proto__) {
                if has_proto != 0 { js_parse_error(s, "duplicate __proto__ property name") }
                has_proto = 1
                prop_idx = 0 - 1
            } else {
                prop_idx = cpool_add(s, name)
                int count = bc_get_u16(s, count_pos)
                bc_set_u16(s, count_pos, min_int(count + 1, 0xffff))
            }
        } else {
            prop_idx = cpool_add(s, name)
            int count = bc_get_u16(s, count_pos)
            bc_set_u16(s, count_pos, min_int(count + 1, 0xffff))
        }
        if prop_type == consts.PARSE_PROP_FIELD {
            js_parse_expect(s, 58)   // ':'
            // PARSE_CALL_SAVE4(s, 1, assign_expr, 0, prop_idx, parse_flags, has_proto, count_pos)
            push_int(s, prop_idx)
            push_int(s, parse_flags)
            push_int(s, has_proto)
            push_int(s, count_pos)
            return enc(1, consts.PARSE_FUNC_assign_expr, 0)
        }
        // getter/setter/method
        js_parse_function_decl(s, consts.JS_PARSE_FUNC_METHOD, name)
        if prop_type == consts.PARSE_PROP_METHOD { emit.emit_op(s, opcodes.OP_define_field) }
        else if prop_type == consts.PARSE_PROP_GET { emit.emit_op(s, opcodes.OP_define_getter) }
        else { emit.emit_op(s, opcodes.OP_define_setter) }
        emit.emit_u16(s, prop_idx)
        if tok_val(s) != 44 { break }   // ','
        next_token(s)
    }
    js_parse_expect(s, 125)   // '}'
    return consts.PARSE_STATE_RET
}

// stack-array loop: elements 0..31 collected then opcodes.OP_array_from.
array_loop_stack(s: ptr, parse_flags: int, idx: int) -> int {
    while tok_val(s) != 93 {   // ']'
        if idx >= 32 { return array_after_stack(s, parse_flags, idx) }
        // PARSE_CALL_SAVE2(s, 2, assign_expr, 0, idx, parse_flags)
        push_int(s, idx)
        push_int(s, parse_flags)
        return enc(2, consts.PARSE_FUNC_assign_expr, 0)
    }
    return array_after_stack(s, parse_flags, idx)
}

// after collecting up-to-32 stack elements; handles trailing comma then
// continues into overflow handling.
array_continue_after_elem(s: ptr, parse_flags: int, idx: int) -> int {
    if tok_val(s) == 44 {   // ','
        next_token(s)
        return array_loop_stack(s, parse_flags, idx)
    }
    if tok_val(s) != 93 {   // not ']' -> goto done (expect ']' will error)
        js_parse_expect(s, 93)
        return consts.PARSE_STATE_RET
    }
    return array_loop_stack(s, parse_flags, idx)
}

array_after_stack(s: ptr, parse_flags: int, idx: int) -> int {
    emit.emit_op_param(s, opcodes.OP_array_from, idx, pc2line_source_pos(s))
    return array_loop_overflow(s, parse_flags, idx)
}

// overflow-array loop: elements 32.. appended with opcodes.OP_put_array_el.
array_loop_overflow(s: ptr, parse_flags: int, idx: int) -> int {
    while tok_val(s) != 93 {   // ']'
        if idx >= consts.JS_SHORTINT_MAX { js_parse_error(s, "too many elements") }
        emit.emit_op(s, opcodes.OP_dup)
        emit.emit_push_short_int(s, idx)
        // PARSE_CALL_SAVE2(s, 3, assign_expr, 0, idx, parse_flags)
        push_int(s, idx)
        push_int(s, parse_flags)
        return enc(3, consts.PARSE_FUNC_assign_expr, 0)
    }
    js_parse_expect(s, 93)   // ']'
    return consts.PARSE_STATE_RET
}

// call-arguments loop. Returns RET once the call op is emitted.
call_args_loop(s: ptr, parse_flags: int, arg_count: int, opcode: int, is_new: int, op_source_pos: int) -> int {
    int looping = 1
    while looping != 0 {
        if tok_val(s) == 41 { looping = 0 }   // ')'
        else {
            js_parse_expect(s, 44)   // ','
            if arg_count >= consts.JS_MAX_ARGC { js_parse_error(s, "too many call arguments") }
            arg_count = arg_count + 1
            push_int(s, parse_flags)
            push_int(s, arg_count)
            push_int(s, opcode)
            push_int(s, is_new)
            push_int(s, op_source_pos)
            return enc(5, consts.PARSE_FUNC_assign_expr, 0)
        }
    }
    next_token(s)
    if opcode == opcodes.OP_get_field { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
    else if opcode == opcodes.OP_get_length { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
    else if opcode == opcodes.OP_get_array_el { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
    else {
        if is_new != 0 { emit.emit_op_param(s, opcodes.OP_call_constructor, arg_count, op_source_pos) }
        else { emit.emit_op_param(s, opcodes.OP_call, arg_count, op_source_pos) }
    }
    return consts.PARSE_STATE_RET
}

// the trailing postfix chain: calls, .field, [index], ++/--.
postfix_loop(s: ptr, parse_flags: int, is_new: int) -> int {
    int looping = 1
    while looping != 0 {
        int t = tok_val(s)
        if t == 40 {   // '('
            if (parse_flags & consts.PF_ACCEPT_LPAREN) == 0 { looping = 0 }
            else {
                int op_source_pos = tok_source_pos(s)
                next_token(s)
                int opcode = opcodes.OP_invalid
                if is_new == 0 {
                    opcode = emit.get_prev_opcode(s)
                    if opcode == opcodes.OP_get_field { bc_set_byte(s, last_opcode_pos(s), opcodes.OP_get_field2)  opcode = opcodes.OP_get_field }
                    else if opcode == opcodes.OP_get_length { bc_set_byte(s, last_opcode_pos(s), opcodes.OP_get_length2)  opcode = opcodes.OP_get_length }
                    else if opcode == opcodes.OP_get_array_el { bc_set_byte(s, last_opcode_pos(s), opcodes.OP_get_array_el2)  opcode = opcodes.OP_get_array_el }
                    else if opcode == opcodes.OP_get_var_ref {
                        int var_idx = bc_get_u16(s, last_opcode_pos(s) + 1)
                        if get_ext_var_name(s, var_idx) == atom(s, consts.JS_ATOM_eval) {
                            js_parse_error(s, "direct eval is not supported. Use (1,eval) instead for indirect eval")
                        }
                        opcode = opcodes.OP_invalid
                    } else { opcode = opcodes.OP_invalid }
                }
                int arg_count = 0
                if tok_val(s) != 41 {   // not ')'
                    if arg_count >= consts.JS_MAX_ARGC { js_parse_error(s, "too many call arguments") }
                    arg_count = 1
                    push_int(s, parse_flags)
                    push_int(s, arg_count)
                    push_int(s, opcode)
                    push_int(s, is_new)
                    push_int(s, op_source_pos)
                    return enc(5, consts.PARSE_FUNC_assign_expr, 0)
                }
                next_token(s)
                if opcode == opcodes.OP_get_field { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
                else if opcode == opcodes.OP_get_length { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
                else if opcode == opcodes.OP_get_array_el { emit.emit_op_param(s, opcodes.OP_call_method, arg_count, op_source_pos) }
                else {
                    if is_new != 0 { emit.emit_op_param(s, opcodes.OP_call_constructor, arg_count, op_source_pos) }
                    else { emit.emit_op_param(s, opcodes.OP_call, arg_count, op_source_pos) }
                }
                is_new = 0
            }
        } else if t == 46 {   // '.'
            int op_source_pos = tok_source_pos(s)
            next_token(s)
            int ok = 0
            if tok_val(s) == consts.TOK_IDENT { ok = 1 }
            if tok_val(s) >= consts.TOK_FIRST_KEYWORD { ok = 1 }
            if ok == 0 { js_parse_error(s, "expecting field name") }
            long v = tok_value(s)
            if v == atom(s, consts.JS_ATOM_NaN) {
                emit.js_emit_push_const(s, v)
                emit.emit_op_pos(s, opcodes.OP_get_array_el, op_source_pos)
            } else if v == atom(s, consts.JS_ATOM_Infinity) {
                emit.js_emit_push_const(s, v)
                emit.emit_op_pos(s, opcodes.OP_get_array_el, op_source_pos)
            } else if v == atom(s, consts.JS_ATOM_length) {
                emit.emit_op_pos(s, opcodes.OP_get_length, op_source_pos)
            } else {
                int prop_idx = cpool_add(s, v)
                emit.emit_op_pos(s, opcodes.OP_get_field, op_source_pos)
                emit.emit_u16(s, prop_idx)
            }
            next_token(s)
        } else if t == 91 {   // '['
            int op_source_pos = tok_source_pos(s)
            next_token(s)
            // PARSE_CALL_SAVE3(s, 6, expr_comma, 0, parse_flags, is_new, op_source_pos)
            push_int(s, parse_flags)
            push_int(s, is_new)
            push_int(s, op_source_pos)
            return enc(6, consts.PARSE_FUNC_expr_comma, 0)
        } else if postfix_incdec_match(s, t) != 0 {
            int op = t
            int op_source_pos = tok_source_pos(s)
            next_token(s)
            lv = malloc(12)
            getpkg.get_lvalue(s, lv, mem.long_to_ptr(mem.ptr_to_long(lv) + 4), mem.long_to_ptr(mem.ptr_to_long(lv) + 8), 1)
            int opcode = mem.get_int(lv, 0)
            int var_idx = mem.get_int(lv, 4)
            int source_pos = mem.get_uint32(lv, 8)
            free(lv)
            if may_drop_result(s, parse_flags) != 0 {
                set_dropped(s, 1)
                emit.emit_op_pos(s, opcodes.OP_dec + op - TOK_DEC, op_source_pos)
                put.put_lvalue(s, opcode, var_idx, source_pos, consts.PUT_LVALUE_NOKEEP_TOP)
            } else {
                emit.emit_op_pos(s, opcodes.OP_post_dec + op - TOK_DEC, op_source_pos)
                put.put_lvalue(s, opcode, var_idx, source_pos, consts.PUT_LVALUE_KEEP_SECOND)
            }
        } else {
            looping = 0
        }
    }
    return consts.PARSE_STATE_RET
}

// postfix ++/-- match: not preceded by a line feed.
postfix_incdec_match(s: ptr, t: int) -> int {
    if got_lf(s) != 0 { return 0 }
    if t == TOK_DEC { return 1 }
    if t == TOK_INC { return 1 }
    return 0
}

// ===== from parse_expr_wrap.ae =====
// Thin expression-parser entry wrappers ported from mquickjs.c. Each
// invokes the parser-resume driver (js_parse_call, still C) for a given
// entry function. Provides the bare C symbols; C bodies removed.





// void js_parse_expr2(JSParseState *s, int parse_flags)
js_parse_expr2(s: ptr, parse_flags: int) {
    js_parse_call(s, consts.PARSE_FUNC_expr_comma, parse_flags)
}

// void js_parse_expr(JSParseState *s)
js_parse_expr(s: ptr) {
    js_parse_expr2(s, 0)
}

// void js_parse_assign_expr2(JSParseState *s, int parse_flags)
js_parse_assign_expr2(s: ptr, parse_flags: int) {
    js_parse_call(s, consts.PARSE_FUNC_assign_expr, parse_flags)
}

// void js_parse_expr_paren(JSParseState *s)
js_parse_expr_paren(s: ptr) {
    js_parse_expect(s, 40)   // '('
    js_parse_expr(s)
    js_parse_expect(s, 41)   // ')'
}

// js_parse_json: the JSON.parse entry. Resets the input position, runs the
// JSON value parser, skips trailing whitespace, and errors on any leftover
// input. The parsed value is returned via s->token.value. Provides the bare C
// symbol; C body removed.

import std.mem
import ae.mqtypes
import ae.consts

extern js_parse_call(s: ptr, func_idx: int, param: int) -> int
extern skip_spaces(p1: ptr) -> int
extern js_parse_error(s: ptr, fmt: ptr, ...)

exports (js_parse_json)

const PARSE_FUNC_js_parse_json_value = 9

// JSValue js_parse_json(JSParseState *s)
js_parse_json(s: ptr) -> long {
    (s as *JSParseState).buf_pos = 0
    js_parse_call(s, PARSE_FUNC_js_parse_json_value, 0)
    long src = mem.ptr_to_long(mem.get_ptr(s, consts.JSPS_SOURCE_BUF))
    int bp = (s as *JSParseState).buf_pos
    bp = bp + skip_spaces(mem.long_to_ptr(src + bp))
    (s as *JSParseState).buf_pos = bp
    if bp != (s as *JSParseState).buf_len {
        js_parse_error(s, "unexpected character")
    }
    return (s as *JSParseState).tok_value
}

// js_alloc_function_bytecode ported from mquickjs.c: allocate a zeroed
// JSFunctionBytecode and initialise its JSValue fields to JS_NULL (which
// is not the zero word, so the explicit writes matter). Provides the
// bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_mallocz(ctx: ptr, size: int, mtag: int) -> ptr

exports (js_alloc_function_bytecode)

// field offsets

// JSFunctionBytecode *js_alloc_function_bytecode(JSContext *ctx)
js_alloc_function_bytecode(ctx: ptr) -> ptr {
    b = js_mallocz(ctx, consts.SIZEOF_JSFUNCTIONBYTECODE, consts.JS_MTAG_FUNCTION_BYTECODE)
    if b == null { return null }
    mem.set_long(b, consts.FB_FUNC_NAME, jstag.JS_NULL)
    mem.set_long(b, consts.FB_BYTE_CODE, jstag.JS_NULL)
    mem.set_long(b, consts.FB_CPOOL, jstag.JS_NULL)
    mem.set_long(b, consts.FB_VARS, jstag.JS_NULL)
    mem.set_long(b, consts.FB_EXT_VARS, jstag.JS_NULL)
    mem.set_long(b, consts.FB_FILENAME, jstag.JS_NULL)
    mem.set_long(b, consts.FB_PC2LINE, jstag.JS_NULL)
    return b
}

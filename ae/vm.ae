// The bytecode interpreter ported from mquickjs.c: JS_Call. The engine's
// central dispatch loop — ~112 opcodes wired together with ~30 goto
// labels (the call/return/exception machinery and the field/array/
// arithmetic fast+slow paths). Aether has no goto, so the whole thing is
// one function: an outer `while(1)` over an integer `block` selector
// where each C `goto LABEL` becomes `block = BLK_*; continue`. The
// throw-and-unwind epilogue that the C reaches via `goto exception` from
// many call sites is funnelled through a single `pending` flag checked
// once per loop. Slow-path / call helpers stay C. Provides js_call_ae;
// a C shim (js_call_c default, VM_AE env selects this) forwards JS_Call.
//
// JSValue ints are tagged value<<1 (tag bit 0 = 0); the raw word equals
// 2*value, so int fast-paths operate on raw words. Frame layout (JSValue
// units from fp): SAVED_FP=0 CALL_FLAGS=1 THIS_OBJ=2 FUNC_OBJ=3 ARG0=4
// CUR_PC=-1 FIRST_VARREF=-2 VAR0=-3. *--sp pushes (sp grows down).

import std.mem
import ae.jstag
import ae.mqtypes

extern js_reverse_val(sp: ptr, n: int)
extern js_closure(ctx: ptr, val: long, fp: ptr) -> long
extern JS_StackCheck(ctx: ptr, n: int) -> int
extern JS_ToBool(ctx: ptr, val: long) -> int
extern JS_Throw(ctx: ptr, val: long) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern JS_NewObjectPrealloc(ctx: ptr, n: int) -> long
extern JS_NewObjectClass(ctx: ptr, class_id: int, extra: int) -> long
extern JS_NewArray(ctx: ptr, n: int) -> long
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern js_call_constructor_start(ctx: ptr, func_obj: long) -> long
extern find_own_property_inlined(ctx: ptr, p: ptr, prop: long) -> ptr
extern JS_GetPropertyInternal(ctx: ptr, obj: long, prop: long, throw_ref: int) -> long
extern JS_SetPropertyInternal(ctx: ptr, obj: long, prop: long, val: long, throw_flag: int) -> long
extern JS_ToPropertyKey(ctx: ptr, val: long) -> long
extern JS_DefinePropertyValue(ctx: ptr, obj: long, prop: long, val: long) -> long
extern JS_DefinePropertyGetSet(ctx: ptr, obj: long, prop: long, getter: long, setter: long, flags: int) -> long
extern js_set_prototype_internal(ctx: ptr, obj: long, proto: long) -> long
extern JS_DeleteProperty(ctx: ptr, obj: long, prop: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern js_string_utf8_to_utf16_pos(ctx: ptr, obj: long, pos: int) -> int
extern js_add_slow(ctx: ptr) -> long
extern js_binary_arith_slow(ctx: ptr, op: int) -> long
extern js_binary_logic_slow(ctx: ptr, op: int) -> long
extern js_unary_arith_slow(ctx: ptr, op: int) -> long
extern js_not_slow(ctx: ptr) -> long
extern js_post_inc_slow(ctx: ptr, op: int) -> long
extern js_relational_slow(ctx: ptr, op: int) -> long
extern js_eq_slow(ctx: ptr, neg: int) -> long
extern js_strict_eq_slow(ctx: ptr, neg: int) -> long
extern js_operator_in(ctx: ptr) -> long
extern js_operator_instanceof(ctx: ptr) -> long
extern js_operator_typeof(ctx: ptr, val: long) -> long
extern js_for_of_start(ctx: ptr, is_in: int) -> long
extern js_for_of_next(ctx: ptr) -> long
extern js_alloc_float64(ctx: ptr, d: float) -> long
extern js_to_short_float(d: float) -> long

            block = 0  continue
        }
        if opcode == OP_lnot {
            int res = JS_ToBool(ctx, slot(sp, 0))
            if res != 0 { set_slot(sp, 0, jstag.JS_FALSE) } else { set_slot(sp, 0, jstag.JS_TRUE) }
            block = 0  continue
        }

        // ---- arithmetic / bitwise / compare ----
        if opcode == OP_add {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                long r = sx32(op1) + sx32(op2)
                if r < INT32_MIN { block = 200  continue }
                if r > 0x7fffffff { block = 200  continue }
                set_slot(sp, 1, r & 0xffffffff)
            } else if v_both_short_float(op1, op2) != 0 {
                dr = js_get_short_float(op1) + js_get_short_float(op2)
                sp = sp + 8  block = 210  continue
            } else { block = 200  continue }
            sp = sp + 8  block = 0  continue
        }
        if opcode == OP_sub {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                long r = sx32(op1) - sx32(op2)
                if r < INT32_MIN { block = 201  continue }
                if r > 0x7fffffff { block = 201  continue }
                set_slot(sp, 1, r & 0xffffffff)
            } else if v_both_short_float(op1, op2) != 0 {
                dr = js_get_short_float(op1) - js_get_short_float(op2)
                sp = sp + 8  block = 210  continue
            } else { block = 201  continue }
            sp = sp + 8  block = 0  continue
        }
        if opcode == OP_mul {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                long v1 = sx32(op1)  long v2 = sx32(op2) / 2
                long r = v1 * v2
                if sx32(r & 0xffffffff) != r {
                    dr = r2d(r / 2)  sp = sp + 8  block = 210  continue
                }
                if r == 0 { if (v1 | v2) < 0 { set_slot(sp, 1, ctx_minus_zero(ctx)) } else { set_slot(sp, 1, r & 0xffffffff) } }
                else { set_slot(sp, 1, r & 0xffffffff) }
            } else if v_both_short_float(op1, op2) != 0 {
                dr = js_get_short_float(op1) * js_get_short_float(op2)
                sp = sp + 8  block = 210  continue
            } else { block = 201  continue }
            sp = sp + 8  block = 0  continue
        }
        if opcode == OP_div {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                int v1 = v_get_int(op1)  int v2 = v_get_int(op2)
                ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
                val = JS_NewFloat64(ctx, i2d(v1) / i2d(v2))
                if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
                set_slot(sp, 1, val)  sp = sp + 8  block = 0  continue
            } else { block = 201  continue }
        }
        if opcode == OP_mod {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                int v1 = v_get_int(op1)  int v2 = v_get_int(op2)
                if v1 < 0 { block = 201  continue }
                if v2 <= 0 { block = 201  continue }
                set_slot(sp, 1, new_short_int(v1 - (v1 / v2) * v2))  sp = sp + 8  block = 0  continue
            } else { block = 201  continue }
        }
        if opcode == OP_pow { block = 201  continue }
        if opcode == OP_plus {
            long op1 = slot(sp, 0)
            int ok = 0
            if v_is_int(op1) != 0 { ok = 1 } else if v_is_short_float(op1) != 0 { ok = 1 }
            else if v_is_ptr(op1) != 0 { if obj_mtag(v_to_ptr(op1)) == 2 { ok = 1 } }
            if ok == 0 { block = 220  continue }
            block = 0  continue
        }
        if opcode == OP_neg {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 {
                // operate on the RAW tagged word (= 2*value), as the C does
                long v1 = sx32(op1)
                if v1 == 0 { set_slot(sp, 0, ctx_minus_zero(ctx)) }
                else if v1 == INT32_MIN { dr = 0.0 - i2d(SHORTINT_MIN)  block = 210  continue }
                else { set_slot(sp, 0, (0 - v1) & 0xffffffff) }
                block = 0  continue
            }
            if v_is_short_float(op1) != 0 { dr = 0.0 - js_get_short_float(op1)  block = 210  continue }
            block = 220  continue
        }
        if opcode == OP_inc {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 {
                int v1 = v_get_int(op1)
                if v1 == SHORTINT_MAX { block = 220  continue }
                set_slot(sp, 0, new_short_int(v1 + 1))  block = 0  continue
            }
            block = 220  continue
        }
        if opcode == OP_dec {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 {
                int v1 = v_get_int(op1)
                if v1 == SHORTINT_MIN { block = 220  continue }
                set_slot(sp, 0, new_short_int(v1 - 1))  block = 0  continue
            }
            block = 220  continue
        }
        if opcode == OP_post_inc {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 {
                int v1 = v_get_int(op1) + 1
                if v1 < SHORTINT_MIN { block = 230  continue }
                if v1 > SHORTINT_MAX { block = 230  continue }
                val = new_short_int(v1)  sp = sp - 8  set_slot(sp, 0, val)  block = 0  continue
            }
            block = 230  continue
        }
        if opcode == OP_post_dec {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 {
                int v1 = v_get_int(op1) - 1
                if v1 < SHORTINT_MIN { block = 230  continue }
                if v1 > SHORTINT_MAX { block = 230  continue }
                val = new_short_int(v1)  sp = sp - 8  set_slot(sp, 0, val)  block = 0  continue
            }
            block = 230  continue
        }
        if opcode == OP_not {
            long op1 = slot(sp, 0)
            if v_is_int(op1) != 0 { long m = 0 - 2  set_slot(sp, 0, (0 - 1 - op1) & m)  block = 0  continue }
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = js_not_slow(ctx)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 0, val)  block = 0  continue
        }
        if opcode == OP_shl {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                int r = v_get_int(op1) << (v_get_int(op2) & 0x1f)
                if r < SHORTINT_MIN { dr = i2d(r)  sp = sp + 8  block = 210  continue }
                if r > SHORTINT_MAX { dr = i2d(r)  sp = sp + 8  block = 210  continue }
                set_slot(sp, 1, new_short_int(r))  sp = sp + 8  block = 0  continue
            }
            block = 240  continue
        }
        if opcode == OP_shr {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                int r = lshr32(v_get_int(op1), v_get_int(op2) & 0x1f)
                if r < 0 { dr = u2d(r)  sp = sp + 8  block = 210  continue }
                if r > SHORTINT_MAX { dr = u2d(r)  sp = sp + 8  block = 210  continue }
                set_slot(sp, 1, new_short_int(r))  sp = sp + 8  block = 0  continue
            }
            block = 240  continue
        }
        if opcode == OP_sar {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 {
                long m = 0 - 2
                set_slot(sp, 1, (sx32(op1) >> (v_get_int(op2) & 0x1f)) & m)  sp = sp + 8  block = 0  continue
            }
            block = 240  continue
        }
        if opcode == OP_and {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 { set_slot(sp, 1, op1 & op2)  sp = sp + 8  block = 0  continue }
            block = 240  continue
        }
        if opcode == OP_or {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 { set_slot(sp, 1, op1 | op2)  sp = sp + 8  block = 0  continue }
            block = 240  continue
        }
        if opcode == OP_xor {
            long op1 = slot(sp, 1)  long op2 = slot(sp, 0)
            if v_both_int(op1, op2) != 0 { set_slot(sp, 1, op1 ^ op2)  sp = sp + 8  block = 0  continue }
            block = 240  continue
        }
        if opcode == OP_lt { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) < v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 250  continue }
        if opcode == OP_lte { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) <= v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 250  continue }
        if opcode == OP_gt { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) > v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 250  continue }
        if opcode == OP_gte { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) >= v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 250  continue }
        if opcode == OP_eq { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) == v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 251  continue }
        if opcode == OP_neq { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) != v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 252  continue }
        if opcode == OP_strict_eq { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) == v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 253  continue }
        if opcode == OP_strict_neq { long o1 = slot(sp, 1)  long o2 = slot(sp, 0)  if v_both_int(o1, o2) != 0 { set_slot(sp, 1, new_bool(b2i(v_get_int(o1) != v_get_int(o2))))  sp = sp + 8  block = 0  continue }  block = 254  continue }
        if opcode == OP_in {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_operator_in(ctx)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 1, val)  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_instanceof {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_operator_instanceof(ctx)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 1, val)  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_typeof {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_operator_typeof(ctx, slot(sp, 0))
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 0, val)  block = 0  continue
        }
        if opcode == OP_delete {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = JS_DeleteProperty(ctx, slot(sp, 1), slot(sp, 0))
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 1, val)  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_for_in_start {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_for_of_start(ctx, 1)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 0, val)  block = 0  continue
        }
        if opcode == OP_for_of_start {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_for_of_start(ctx, 0)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            set_slot(sp, 0, val)  block = 0  continue
        }
        if opcode == OP_for_of_next {
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_for_of_next(ctx)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            sp = sp - 16  block = 0  continue
        }

        // ---- field / array get/put + define/set_proto ----
        if opcode == OP_get_field { gf_prop = va_get(fb_cpool(b), pc_u16(pc))  gf_obj = slot(sp, 0)  block = 300  continue }
        if opcode == OP_get_field2 { sp = sp - 8  set_slot(sp, 0, slot(sp, 1))  gf_prop = va_get(fb_cpool(b), pc_u16(pc))  gf_obj = slot(sp, 0)  block = 300  continue }
        if opcode == OP_get_length { gf_obj = slot(sp, 0)  block = 310  continue }
        if opcode == OP_get_length2 { sp = sp - 8  set_slot(sp, 0, slot(sp, 1))  gf_obj = slot(sp, 0)  block = 310  continue }
        if opcode == OP_get_array_el { gf_prop = slot(sp, 0)  sp = sp + 8  gf_obj = slot(sp, 0)  block = 320  continue }
        if opcode == OP_get_array_el2 { gf_prop = slot(sp, 0)  set_slot(sp, 0, slot(sp, 1))  gf_obj = slot(sp, 0)  block = 320  continue }
        if opcode == OP_put_field {
            long prop = va_get(fb_cpool(b), pc_u16(pc))  long obj = slot(sp, 1)
            if v_is_ptr(obj) != 0 {
                long p = v_to_ptr(obj)
                if obj_mtag(p) == MTAG_OBJECT {
                    pr = find_own_property_inlined(ctx, mem.long_to_ptr(p), prop)
                    if pr != null { if prop_type(pr) == PROP_NORMAL {
                        prop_set_value(pr, slot(sp, 0))  sp = sp + 16  pc = pc + 2  block = 0  continue
                    } }
                }
            }
            long pv2 = slot(sp, 0)  sp = sp + 8
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = JS_SetPropertyInternal(ctx, slot(sp, 0), prop, pv2, 1)
            if v_is_exc_or_tail(val) != 0 { sp = ctx_sp(ctx)  block = BLK_EXCEPTION  continue }
            sp = sp + 8  pc = pc + 2  block = 0  continue
        }
        if opcode == OP_put_array_el {
            long obj = slot(sp, 2)  long prop = slot(sp, 1)
            if v_is_ptr(obj) != 0 { if v_is_int(prop) != 0 {
                long p = v_to_ptr(obj)
                if obj_mtag(p) == MTAG_OBJECT { if obj_class_id(p) == CLASS_ARRAY {
                    int idx = v_get_int(prop)  long tab = obj_array_tab(p)  int alen = obj_array_len(p)
                    if idx >= alen {
                        if idx == alen { if tab != jstag.JS_NULL { if idx < va_size(tab) {
                            va_set(tab, idx, slot(sp, 0))  obj_array_set_len(p, idx + 1)  sp = sp + 24  block = 0  continue
                        } } }
                    } else { va_set(tab, idx, slot(sp, 0))  sp = sp + 24  block = 0  continue }
                } }
            } }
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            set_slot(sp, 1, JS_ToPropertyKey(ctx, slot(sp, 1)))
            if v_is_exception(slot(sp, 1)) != 0 { val = slot(sp, 1)  block = BLK_EXCEPTION  continue }
            long pv3 = slot(sp, 0)  sp = sp + 8  long pk = slot(sp, 0)  sp = sp + 8
            ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = JS_SetPropertyInternal(ctx, slot(sp, 0), pk, pv3, 1)
            if v_is_exc_or_tail(val) != 0 { sp = ctx_sp(ctx)  block = BLK_EXCEPTION  continue }
            sp = sp + 8  block = 0  continue
        }
        if opcode == OP_define_field {
            long prop = va_get(fb_cpool(b), pc_u16(pc))  ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = JS_DefinePropertyValue(ctx, slot(sp, 1), prop, slot(sp, 0))
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            pc = pc + 2  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_define_getter {
            long prop = va_get(fb_cpool(b), pc_u16(pc))  ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = JS_DefinePropertyGetSet(ctx, slot(sp, 1), prop, slot(sp, 0), jstag.JS_UNDEFINED, JS_DEF_PROP_HAS_GET)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            pc = pc + 2  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_define_setter {
            long prop = va_get(fb_cpool(b), pc_u16(pc))  ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
            val = JS_DefinePropertyGetSet(ctx, slot(sp, 1), prop, jstag.JS_UNDEFINED, slot(sp, 0), JS_DEF_PROP_HAS_SET)
            if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            pc = pc + 2  sp = sp + 8  block = 0  continue
        }
        if opcode == OP_set_proto {
            int isobj = JS_IsObject(ctx, slot(sp, 0))
            int isnull = 0  if slot(sp, 0) == jstag.JS_NULL { isnull = 1 }
            if isobj != 0 { isnull = isnull }
            if isobj != 0 {
                ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_set_prototype_internal(ctx, slot(sp, 1), slot(sp, 0))
                if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            } else if isnull != 0 {
                ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)  val = js_set_prototype_internal(ctx, slot(sp, 1), slot(sp, 0))
                if v_is_exception(val) != 0 { block = BLK_EXCEPTION  continue }
            }
            sp = sp + 8  block = 0  continue
        }

        // any opcode not matched above (should be none): raise with the
        // opcode number so it can be identified.
        ctx_set_sp(ctx, sp)  ctx_set_fp(ctx, fp)
        val = JS_ThrowError(ctx, JS_CLASS_INTERNAL_ERROR, "ae-vm: unported opcode %d", opcode)
        block = BLK_EXCEPTION  continue
    }
    free(scratch)
    return val
}


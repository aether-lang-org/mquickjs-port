extern __js_poll_interrupt(ctx: ptr) -> long
extern set_free_block(p: ptr, size: int)
extern memmove(dst: ptr, src: ptr, n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)

extern vm_call_cfunc_generic(fnptr: long, ctx: ptr, this_ptr: ptr, flags: int, argv: ptr) -> long
extern vm_call_cfunc_magic(fnptr: long, ctx: ptr, this_ptr: ptr, flags: int, argv: ptr, magic: int) -> long
extern vm_call_cfunc_params(fnptr: long, ctx: ptr, this_ptr: ptr, flags: int, argv: ptr, params: long) -> long
extern vm_call_cfunc_f_f(fnptr: long, d: float) -> float
extern vm_to_number(ctx: ptr, pd: ptr, val: long) -> int

// find_atom ported from mquickjs.c: binary-search a sorted unique-string
// table for val, comparing by js_string_compare. On a hit, return the
// stored JSValue and write its index to *pidx; on a miss, write the
// insertion index and return JS_NULL. Provides the bare C symbol; C body
// removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern js_string_compare(ctx: ptr, val1: long, val2: long) -> int

exports (find_atom)

const VA_ARR = 8

// JSValue find_atom(JSContext *ctx, int *pidx, const JSValueArray *arr, int len, JSValue val)
find_atom(ctx: ptr, pidx: ptr, arr: ptr, len: int, val: long) -> long {
    long base = mem.ptr_to_long(arr) + VA_ARR
    int a = 0
    int b = len - 1
    while a <= b {
        int m = (a + b) >> 1
        long val1 = mem.get_long(mem.long_to_ptr(base + m * 8), 0)
        int r = js_string_compare(ctx, val, val1)
        if r == 0 {
            mem.set_int(pidx, 0, m)
            return val1
        }
        if r < 0 { b = m - 1 }
        else { a = m + 1 }
    }
    mem.set_int(pidx, 0, a)
    return jstag.JS_NULL
}

// JS_NewArray ported from mquickjs.c: a fresh array object, optionally
// backed by a value array of the given length (GC-rooted across the
// allocation). Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern JS_NewObjectClass(ctx: ptr, class_id: int, extra_size: int) -> long
extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr

exports (JS_NewArray)

const JS_CLASS_ARRAY = 1
const SIZEOF_JSARRAYDATA = 16
const JSCTX_TOP_GC_REF = 80
const JSOBJ_ARRAY_TAB = 24
const JSOBJ_ARRAY_LEN = 32

extern malloc(n: long) -> ptr
extern free(p: ptr)

// JSValue JS_NewArray(JSContext *ctx, int initial_len)
JS_NewArray(ctx: ptr, initial_len: int) -> long {
    long val = JS_NewObjectClass(ctx, JS_CLASS_ARRAY, SIZEOF_JSARRAYDATA)
    if jstag.is_exception(val) != 0 { return val }
    p = jstag.value_to_ptr(val)
    mem.set_long(p, JSOBJ_ARRAY_TAB, jstag.JS_NULL)
    mem.set_uint32(p, JSOBJ_ARRAY_LEN, 0)
    if initial_len > 0 {
        // GC-root val across js_alloc_value_array (which may GC).
        ref = malloc(16)
        mem.set_ptr(ref, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, ref)
        mem.set_long(ref, 0, val)

        arr = js_alloc_value_array(ctx, 0, initial_len)

        val = mem.get_long(ref, 0)
        mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
        free(ref)

        if arr == null { return jstag.JS_EXCEPTION }
        p = jstag.value_to_ptr(val)
        mem.set_long(p, JSOBJ_ARRAY_TAB, jstag.value_from_ptr(arr))
        mem.set_uint32(p, JSOBJ_ARRAY_LEN, initial_len)
    }
    return val
}

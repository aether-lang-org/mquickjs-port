// Shared bytecode opcode constants. The values mirror the OP_* enum
// generated from mquickjs_opcode.h (DUMP_BYTECODE off). Importing this module
// (`import ae.opcodes`) and referring to e.g. opcodes.OP_get_loc lets the
// codegen and parser modules drop their per-file duplicate const blocks.
// Verified against a C probe over the opcode table.

exports (
    OP_invalid, OP_push_value, OP_push_const, OP_fclosure, OP_undefined,
    OP_this_func, OP_arguments, OP_drop, OP_nip, OP_dup, OP_dup2,
    OP_insert2, OP_insert3, OP_perm3, OP_perm4, OP_swap, OP_rot3l,
    OP_return, OP_return_undef, OP_throw, OP_ret, OP_goto, OP_gosub,
    OP_if_false, OP_if_true, OP_delete,
    OP_get_field, OP_get_field2, OP_put_field,
    OP_get_array_el, OP_put_array_el, OP_get_length, OP_get_length2,
    OP_get_loc, OP_get_loc0, OP_get_loc8, OP_put_loc, OP_put_loc0, OP_put_loc8,
    OP_get_arg, OP_get_arg0, OP_put_arg, OP_put_arg0,
    OP_get_var_ref, OP_put_var_ref, OP_get_var_ref_nocheck, OP_put_var_ref_nocheck,
    OP_push_0, OP_push_i8, OP_push_i16,
    OP_null, OP_push_this, OP_push_false, OP_object, OP_new_target,
    OP_regexp, OP_array_from, OP_call, OP_call_constructor, OP_call_method,
    OP_catch, OP_define_field, OP_define_getter, OP_define_setter, OP_set_proto,
    OP_for_in_start, OP_for_of_start, OP_for_of_next, OP_get_array_el2,
    OP_neg, OP_plus, OP_dec, OP_post_dec, OP_not, OP_lnot, OP_typeof,
    OP_pow, OP_strict_eq
)

const OP_invalid = 0
const OP_push_value = 1
const OP_push_const = 2
const OP_fclosure = 3
const OP_undefined = 4
const OP_this_func = 10

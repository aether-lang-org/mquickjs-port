// External-variable (closure capture) lookups + adds ported from
// mquickjs.c. The ext_vars JSValueArray holds (name, kind/idx) pairs per
// slot. get_ext_var_name returns the name for a slot; find_func_ext_var
// scans a function's ext_vars for a name; find_ext_var does so for the
// current function; add_func_ext_var/add_ext_var append a new (name, decl)
// pair, growing the array. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_resize_value_array(ctx: ptr, val: long, new_size: int) -> long
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern js_parse_error_mem(s: ptr)
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (get_ext_var_name, find_func_ext_var, find_ext_var, add_func_ext_var, add_ext_var)

// JSFunctionBytecode: ext_vars @40 (JSValue), ext_vars_len @50 (u16)

// arr->arr[i] (8-byte JSValues @ offset 8)
va_get(arrval: long, i: int) -> long {
    long base = mem.ptr_to_long(jstag.value_to_ptr(arrval)) + consts.VA_ARR
    return mem.get_long(mem.long_to_ptr(base + i * 8), 0)
}

// JSValue get_ext_var_name(JSParseState *s, int var_idx)
get_ext_var_name(s: ptr, var_idx: int) -> long {
    long cur_func = mem.get_long(s, consts.JSPS_CUR_FUNC)
    b = jstag.value_to_ptr(cur_func)
    long ext_vars = mem.get_long(b, consts.FB_EXT_VARS)
    return va_get(ext_vars, 2 * var_idx)
}

// int find_func_ext_var(JSParseState *s, JSValue func, JSValue name)
find_func_ext_var(s: ptr, fobj: long, name: long) -> int {
    b = jstag.value_to_ptr(fobj)
    long ext_vars = mem.get_long(b, consts.FB_EXT_VARS)
    int n = mem.get_uint16(b, consts.FB_EXT_VARS_LEN)
    int i = 0
    while i < n {
        if va_get(ext_vars, 2 * i) == name { return i }
        i = i + 1
    }
    return 0 - 1
}

// int find_ext_var(JSParseState *s, JSValue name)
find_ext_var(s: ptr, name: long) -> int {
    long cur_func = mem.get_long(s, consts.JSPS_CUR_FUNC)
    return find_func_ext_var(s, cur_func, name)
}

max_int(a: int, b: int) -> int { if a > b { return a } return b }

// arr->arr[i] = v
va_set(arrval: long, i: int, v: long) {
    long base = mem.ptr_to_long(jstag.value_to_ptr(arrval)) + consts.VA_ARR
    mem.set_long(mem.long_to_ptr(base + i * 8), 0, v)
}

// int add_func_ext_var(JSParseState *s, JSValue func, JSValue name, int decl)
add_func_ext_var(s: ptr, fobj: long, name: long, decl: int) -> int {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)
    b = jstag.value_to_ptr(fobj)
    int len = mem.get_uint16(b, consts.FB_EXT_VARS_LEN)
    if len >= consts.JS_MAX_LOCAL_VARS { js_parse_error(s, "too many variable references") }

    // GC-root func then name across js_resize_value_array
    ref = malloc(32)
    mem.set_long(ref, 0, fobj)                                  // func ref val
    mem.set_ptr(ref, 8, (ctx as *JSContext).top_gc_ref)
    mem.set_long(ref, 16, name)                                 // name ref val
    mem.set_ptr(ref, 24, mem.long_to_ptr(mem.ptr_to_long(ref))) // name.prev = &func ref
    (ctx as *JSContext).top_gc_ref = mem.long_to_ptr(mem.ptr_to_long(ref) + 16)

    int newsz = max_int(len + 1, 2) * 2
    long new_ext_vars = js_resize_value_array(ctx, mem.get_long(b, consts.FB_EXT_VARS), newsz)

    name = mem.get_long(ref, 16)
    fobj = mem.get_long(ref, 0)
    (ctx as *JSContext).top_gc_ref = mem.get_ptr(ref, 8)
    free(ref)

    if jstag.is_exception(new_ext_vars) != 0 { js_parse_error_mem(s) }

    b = jstag.value_to_ptr(fobj)
    mem.set_long(b, consts.FB_EXT_VARS, new_ext_vars)
    va_set(new_ext_vars, 2 * len, name)
    long declv = decl
    va_set(new_ext_vars, 2 * len + 1, declv << 1)              // JS_NewShortInt(decl)
    mem.set_uint16(b, consts.FB_EXT_VARS_LEN, len + 1)
    return len
}

// int add_ext_var(JSParseState *s, JSValue name, int decl)
add_ext_var(s: ptr, name: long, decl: int) -> int {
    long cur_func = mem.get_long(s, consts.JSPS_CUR_FUNC)
    return add_func_ext_var(s, cur_func, name, decl)
}

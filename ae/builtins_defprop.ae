// Object.defineProperty ported from mquickjs.c. Reads value/get/set
// from the descriptor, validates, and delegates to
// JS_DefinePropertyInternal. GC-roots the value and getter across the
// descriptor reads. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_IsObject(ctx: ptr, val: long) -> int
extern JS_IsFunction(ctx: ptr, val: long) -> int
extern JS_ToPropertyKey(ctx: ptr, val: long) -> long
extern JS_HasProperty(ctx: ptr, obj: long, prop: long) -> int
extern JS_GetProperty(ctx: ptr, obj: long, prop: long) -> long
extern JS_DefinePropertyInternal(ctx: ptr, obj: long, prop: long, val: long, setter: long, flags: int) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern JS_ThrowTypeErrorNotAnObject(ctx: ptr) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (js_object_defineProperty)

const JS_CLASS_TYPE_ERROR = 14
const JS_ATOM_value = 124
const JS_ATOM_get = 126
const JS_ATOM_set = 128
const JS_DEF_PROP_LOOKUP = 1
const JS_DEF_PROP_HAS_VALUE = 4
const JS_DEF_PROP_HAS_GET = 8
const JS_DEF_PROP_HAS_SET = 16
const GCREF_VAL = 0
const GCREF_PREV = 8

ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, GCREF_PREV, ctx_top(ctx))
    ctx_set_top(ctx, ref)
    mem.set_long(ref, GCREF_VAL, v)
}
gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, GCREF_VAL)
    ctx_set_top(ctx, mem.get_ptr(ref, GCREF_PREV))
    return v
}

// JSValue js_object_defineProperty(ctx, this_val, argc, argv)
js_object_defineProperty(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long obj = mem.get_long(argv, 0)
    if JS_IsObject(ctx, obj) == 0 {
        return JS_ThrowTypeErrorNotAnObject(ctx)
    }
    long prop = JS_ToPropertyKey(ctx, mem.get_long(argv, 8))
    mem.set_long(argv, 8, prop)
    if jstag.is_exception(prop) != 0 { return jstag.JS_EXCEPTION }
    long desc = mem.get_long(argv, 16)

    long val = jstag.JS_UNDEFINED
    long getter = jstag.JS_UNDEFINED
    long setter = jstag.JS_UNDEFINED
    int flags = 0

    val_ref = malloc(16)
    getter_ref = malloc(16)
    int bad = 0
    int exc = 0

    if JS_HasProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_value)) != 0 {
        flags = flags | JS_DEF_PROP_HAS_VALUE
        val = JS_GetProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_value))
        if jstag.is_exception(val) != 0 { exc = 1 }
    }
    if exc == 0 {
        if JS_HasProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_get)) != 0 {
            flags = flags | JS_DEF_PROP_HAS_GET
            gc_push(ctx, val_ref, val)
            getter = JS_GetProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_get))
            val = gc_pop(ctx, val_ref)
            if jstag.is_exception(getter) != 0 { exc = 1 }
            else if jstag.is_undefined(getter) == 0 {
                if JS_IsFunction(ctx, getter) == 0 { bad = 1 }
            }
        }
    }
    if exc == 0 {
        if bad == 0 {
            if JS_HasProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_set)) != 0 {
                flags = flags | JS_DEF_PROP_HAS_SET
                gc_push(ctx, val_ref, val)
                gc_push(ctx, getter_ref, getter)
                setter = JS_GetProperty(ctx, desc, js_get_atom(ctx, JS_ATOM_set))
                getter = gc_pop(ctx, getter_ref)
                val = gc_pop(ctx, val_ref)
                if jstag.is_exception(setter) != 0 { exc = 1 }
                else if jstag.is_undefined(setter) == 0 {
                    if JS_IsFunction(ctx, setter) == 0 { bad = 1 }
                }
            }
        }
    }
    free(getter_ref)
    free(val_ref)

    if exc != 0 { return jstag.JS_EXCEPTION }
    if bad != 0 { return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "invalid getter or setter") }

    if (flags & (JS_DEF_PROP_HAS_GET | JS_DEF_PROP_HAS_SET)) != 0 {
        if (flags & JS_DEF_PROP_HAS_VALUE) != 0 {
            return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "cannot have both value and get/set")
        }
        val = getter
    }
    long r = JS_DefinePropertyInternal(ctx, obj, prop, val, setter, flags | JS_DEF_PROP_LOOKUP)
    if jstag.is_exception(r) != 0 { return r }
    return obj
}

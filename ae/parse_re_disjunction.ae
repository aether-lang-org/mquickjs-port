// The regexp disjunction parser ported from mquickjs.c:
// re_parse_disjunction parses `alternative ( '|' alternative )*`,
// inserting a REOP_split_next_first before each subsequent alternative
// and a REOP_goto after it. A resumable parse function driven by
// js_parse_call: the two PARSE_CALL points into re_parse_alternative
// become states 0 and 1, with locals saved on / restored from the
// parser value stack. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.reopcodes
import ae.consts

extern js_parse_push_val(s: ptr, val: long)
extern js_parse_pop_val(s: ptr) -> long
extern emit_insert(s: ptr, pos: int, n: int)
extern re_emit_op_u32(s: ptr, op: int, val: int) -> int

exports (re_parse_disjunction)

const PARSE_FUNC_re_parse_alternative = 10

const REOP_goto = reopcodes.REOP_goto
const REOP_split_next_first = reopcodes.REOP_split_next_first

byte_code_len(s: ptr) -> int { return mem.get_uint32(s, 88) }
source_byte(s: ptr, pos: int) -> int {
    return mem.get_byte((s as *JSParseState).source_buf, pos)
}
buf_pos(s: ptr) -> int { return mem.get_uint32(s, 64) }
set_buf_pos(s: ptr, v: int) { mem.set_uint32(s, 64, v) }

// regexp bytecode buffer: byte_code value -> JSByteArray buf (ptr + 8).
re_buf(s: ptr) -> long {
    arr = jstag.value_to_ptr((s as *JSParseState).byte_code)
    return mem.ptr_to_long(arr) + 8
}
re_set_byte(s: ptr, pos: int, v: int) { mem.set_byte(mem.long_to_ptr(re_buf(s) + pos), 0, v) }
re_put_u32(s: ptr, pos: int, v: int) { mem.set_uint32(mem.long_to_ptr(re_buf(s) + pos), 0, v) }

push_int(s: ptr, v: int) { js_parse_push_val(s, jstag.new_short_int(v)) }
pop_int(s: ptr) -> int { return jstag.get_int(js_parse_pop_val(s)) }

enc(cur_state: int, fn: int, param: int) -> int {
    return cur_state | (fn << 8) | (param << 16)
}

// int re_parse_disjunction(JSParseState *s, int state, int dummy_param)
re_parse_disjunction(s: ptr, st: int, dummy_param: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        int start = byte_code_len(s)
        // PARSE_CALL_SAVE1(s, 0, re_parse_alternative, 0, start)
        push_int(s, start)
        return enc(0, PARSE_FUNC_re_parse_alternative, 0)
    }

    if st == 0 {
        int start = pop_int(s)
        return disj_loop(s, start)
    }

    // st == 1
    int pos = pop_int(s)
    int start = pop_int(s)
    // patch the goto
    int len = byte_code_len(s) - (pos + 4)
    re_put_u32(s, pos, len)
    return disj_loop(s, start)
}

disj_loop(s: ptr, start: int) -> int {
    while source_byte(s, buf_pos(s)) == 124 {   // '|'
        set_buf_pos(s, buf_pos(s) + 1)
        int len = byte_code_len(s) - start
        // insert a split before the first alternative
        emit_insert(s, start, 5)
        re_set_byte(s, start, REOP_split_next_first)
        re_put_u32(s, start + 1, len + 5)
        int pos = re_emit_op_u32(s, REOP_goto, 0)
        // PARSE_CALL_SAVE2(s, 1, re_parse_alternative, 0, start, pos)
        push_int(s, start)
        push_int(s, pos)
        return enc(1, PARSE_FUNC_re_parse_alternative, 0)
    }
    return consts.PARSE_STATE_RET
}

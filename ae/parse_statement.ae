// The statement parser ported from mquickjs.c: js_parse_statement.
// Handles labels, blocks, return/throw/var/if/while/do/for(in/of/c)/
// break/continue/switch/try-catch-finally/empty and expression
// statements. A resumable parse function driven by js_parse_call with
// twelve sub-call states; the C goto-after-return machinery becomes an
// INIT entry that dispatches on the current token and resume entries
// keyed on the saved state, with locals saved on / restored from the
// parser value stack. Break/continue scopes (BlockEnv) live on the
// engine value stack and are pushed/popped by C helpers; their fields
// are read here through the top_break offset. Provides the bare C
// symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts

extern js_parse_push_val(s: ptr, val: long)
extern js_parse_pop_val(s: ptr) -> long
extern next_token(s: ptr)
extern js_parse_expect(s: ptr, ch: int)
extern js_parse_expect1(s: ptr, ch: int)
extern js_parse_expect_semi(s: ptr)
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern emit_op(s: ptr, op: int)
extern emit_op_pos(s: ptr, op: int, source_pos: int)
extern emit_u16(s: ptr, val: int)
extern emit_var(s: ptr, opcode: int, var_idx: int, source_pos: int)
extern emit_goto(s: ptr, opcode: int, plabel: ptr)
extern emit_label(s: ptr, plabel: ptr)
extern emit_label_pos(s: ptr, plabel: ptr, pos: int)
extern emit_return(s: ptr, hasval: int, source_pos: int)
extern emit_break(s: ptr, label_name: long, is_cont: int)
extern new_label(s: ptr) -> long
extern label_is_none(label: long) -> int
extern is_label(s: ptr) -> int
extern push_break_entry(s: ptr, label_name: long, label_break: long, label_cont: long, drop_count: int) -> ptr
extern pop_break_entry(s: ptr)
extern js_parse_skip_parens_token(s: ptr) -> int
extern js_skip_expr(s: ptr)
extern js_parse_get_pos(s: ptr, sp: ptr)
extern js_parse_seek_token(s: ptr, sp: ptr)
extern js_parse_expr(s: ptr)
extern js_parse_expr2(s: ptr, parse_flags: int)
extern js_parse_expr_paren(s: ptr)
extern js_parse_assign_expr2(s: ptr, parse_flags: int)
extern js_parse_var(s: ptr, in_accepted: int)
extern define_var(s: ptr, pvar_kind: ptr, name: long) -> int
extern put_var(s: ptr, var_kind: int, var_idx: int, source_pos: int)
extern get_lvalue(s: ptr, popcode: ptr, pvar_idx: ptr, psource_pos: ptr, keep: int)
extern put_lvalue(s: ptr, opcode: int, var_idx: int, source_pos: int, special: int)
extern set_eval_ret_undefined(s: ptr)
extern add_var(s: ptr, name: long) -> int
extern find_var(s: ptr, name: long) -> int
extern find_ext_var(s: ptr, name: long) -> int
extern js_get_atom(ctx: ptr, a: int) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_parse_statement)









// BlockEnv fields (JSValues, 8 bytes each): prev@0 label_name@8
// label_break@16 label_cont@24 label_finally@32 drop_count@40.

tok_val(s: ptr) -> int { return mem.get_int(s, 8) }
tok_source_pos(s: ptr) -> int { return mem.get_uint32(s, 12) }
tok_value(s: ptr) -> long { return mem.get_long(s, 24) }
ps_ctx(s: ptr) -> ptr { return (s as *JSParseState).ctx }
got_lf(s: ptr) -> int { return mem.get_byte(s, 32) }
is_eval(s: ptr) -> int { return mem.get_byte(s, 33) }
byte_code_len(s: ptr) -> int { return mem.get_uint32(s, 88) }
pc2line_source_pos(s: ptr) -> int { return mem.get_uint32(s, 108) }
eval_ret_idx(s: ptr) -> int { return mem.get_int(s, 124) }
top_break(s: ptr) -> long { return mem.get_long(s, 128) }

push_int(s: ptr, v: int) { js_parse_push_val(s, jstag.new_short_int(v)) }
pop_int(s: ptr) -> int { return jstag.get_int(js_parse_pop_val(s)) }

enc(cur_state: int, fn: int, param: int) -> int {
    return cur_state | (fn << 8) | (param << 16)
}

atom(s: ptr, a: int) -> long { return js_get_atom(ps_ctx(s), a) }

LABEL_NONE() -> long { return jstag.new_short_int(consts.LABEL_NONE_INT) }

// current top_break BlockEnv pointer = ctx + JS_VALUE_GET_INT(top_break)
be_ptr(s: ptr) -> ptr {
    long off = jstag.get_int(top_break(s))
    return mem.long_to_ptr(mem.ptr_to_long(ps_ctx(s)) + off)
}
be_field(s: ptr, field: int) -> long { return mem.get_long(be_ptr(s), field) }
be_set_field(s: ptr, field: int, v: long) { mem.set_long(be_ptr(s), field, v) }

// emit_goto / emit_label via a malloc'd JSValue* slot; return updated label.
emit_goto_val(s: ptr, opcode: int, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit_goto(s, opcode, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}
emit_label_val(s: ptr, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit_label(s, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}
// emit_label on a BlockEnv field (write the resolved label back in place).
emit_label_be(s: ptr, field: int) {
    slot = malloc(8)
    mem.set_long(slot, 0, be_field(s, field))
    emit_label(s, slot)
    be_set_field(s, field, mem.get_long(slot, 0))
    free(slot)
}
emit_goto_be(s: ptr, opcode: int, field: int) {
    slot = malloc(8)
    mem.set_long(slot, 0, be_field(s, field))
    emit_goto(s, opcode, slot)
    be_set_field(s, field, mem.get_long(slot, 0))
    free(slot)
}
emit_label_pos_val(s: ptr, label: long, pos: int) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit_label_pos(s, slot, pos)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}

// int js_parse_statement(JSParseState *s, int state, int dummy_param)
js_parse_statement(s: ptr, st: int, dummy_param: int) -> int {
    if st == consts.PARSE_STATE_INIT { return stmt_init(s) }
    if st == 11 { return resume_labelled(s) }
    if st == 0 { return consts.PARSE_STATE_RET }               // block
    if st == 1 { return resume_if_then(s) }
    if st == 2 { return resume_if_else(s) }
    if st == 3 { return resume_while(s) }
    if st == 4 { return resume_do(s) }
    if st == 5 { return resume_for_inof(s) }
    if st == 6 { return resume_for_c(s) }
    if st == 7 { return resume_switch_stmt(s) }
    if st == 8 { return resume_try_block(s) }
    if st == 9 { return resume_catch_block(s) }
    return resume_finally_block(s)                       // st == 10
}

// ---- INIT: label handling, then dispatch on the statement keyword ----
stmt_init(s: ptr) -> int {
    long label_name = LABEL_NONE()
    if is_label(s) != 0 {
        label_name = tok_value(s)
        next_token(s)
        js_parse_expect(s, 58)   // ':'
        // duplicate label check
        long tv = top_break(s)
        while jstag.is_null(tv) == 0 {
            top = mem.long_to_ptr(mem.ptr_to_long(ps_ctx(s)) + jstag.get_int(tv))
            if mem.get_long(top, consts.BE_LABEL_NAME) == label_name {
                js_parse_error(s, "duplicate label name")
            }
            tv = mem.get_long(top, consts.BE_PREV)
        }
        int tv2 = tok_val(s)
        if tv2 != consts.TOK_FOR { if tv2 != consts.TOK_DO { if tv2 != consts.TOK_WHILE {
            // labelled regular statement
            push_break_entry(s, label_name, new_label(s), LABEL_NONE(), 0)
            return enc(11, consts.PARSE_FUNC_statement, 0)
        } } }
    }
    return stmt_dispatch(s, label_name)
}

resume_labelled(s: ptr) -> int {
    emit_label_be(s, consts.BE_LABEL_BREAK)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

stmt_dispatch(s: ptr, label_name: long) -> int {
    int t = tok_val(s)
    if t == 123 {   // '{'
        return enc(0, consts.PARSE_FUNC_block, 0)
    }
    if t == consts.TOK_RETURN {
        if is_eval(s) != 0 { js_parse_error(s, "return not in a function") }
        int op_source_pos = tok_source_pos(s)
        next_token(s)
        int has_val = 0
        int tv = tok_val(s)
        if tv != 59 { if tv != 125 { if got_lf(s) == 0 {
            js_parse_expr(s)
            has_val = 1
        } } }
        emit_return(s, has_val, op_source_pos)
        js_parse_expect_semi(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_THROW {
        int op_source_pos = tok_source_pos(s)
        next_token(s)
        if got_lf(s) != 0 { js_parse_error(s, "line terminator not allowed after throw") }
        js_parse_expr(s)
        emit_op_pos(s, opcodes.OP_throw, op_source_pos)
        js_parse_expect_semi(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_VAR {
        next_token(s)
        js_parse_var(s, 1)
        js_parse_expect_semi(s)
        return consts.PARSE_STATE_RET
    }
    if t == consts.TOK_IF {
        next_token(s)
        set_eval_ret_undefined(s)
        js_parse_expr_paren(s)
        long label1 = new_label(s)
        label1 = emit_goto_val(s, opcodes.OP_if_false, label1)
        js_parse_push_val(s, label1)
        return enc(1, consts.PARSE_FUNC_statement, 0)
    }
    if t == consts.TOK_WHILE { return stmt_while(s, label_name) }
    if t == consts.TOK_DO { return stmt_do(s, label_name) }
    if t == consts.TOK_FOR { return stmt_for(s, label_name) }
    if t == consts.TOK_BREAK { return stmt_break_cont(s, 0) }
    if t == consts.TOK_CONTINUE { return stmt_break_cont(s, 1) }
    if t == consts.TOK_SWITCH { return stmt_switch(s, label_name) }
    if t == consts.TOK_TRY { return stmt_try(s) }
    if t == 59 {   // ';' empty statement
        next_token(s)
        return consts.PARSE_STATE_RET
    }
    // default: expression statement
    if eval_ret_idx(s) >= 0 {
        js_parse_expr(s)
        emit_var(s, opcodes.OP_put_loc, eval_ret_idx(s), pc2line_source_pos(s))
    } else {
        js_parse_expr2(s, consts.PF_DROP)
    }
    js_parse_expect_semi(s)
    return consts.PARSE_STATE_RET
}

resume_if_then(s: ptr) -> int {
    long label1 = js_parse_pop_val(s)
    if tok_val(s) == consts.TOK_ELSE {
        next_token(s)
        long label2 = new_label(s)
        label2 = emit_goto_val(s, opcodes.OP_goto, label2)
        label1 = emit_label_val(s, label1)
        js_parse_push_val(s, label2)
        return enc(2, consts.PARSE_FUNC_statement, 0)
    }
    label1 = emit_label_val(s, label1)
    return consts.PARSE_STATE_RET
}

resume_if_else(s: ptr) -> int {
    long label2 = js_parse_pop_val(s)
    label2 = emit_label_val(s, label2)
    return consts.PARSE_STATE_RET
}

// ---- while ----
stmt_while(s: ptr, label_name: long) -> int {
    push_break_entry(s, label_name, new_label(s), new_label(s), 0)
    next_token(s)
    set_eval_ret_undefined(s)
    emit_label_be(s, consts.BE_LABEL_CONT)
    js_parse_expr_paren(s)
    emit_goto_be(s, opcodes.OP_if_false, consts.BE_LABEL_BREAK)
    return enc(3, consts.PARSE_FUNC_statement, 0)
}
resume_while(s: ptr) -> int {
    emit_goto_be(s, opcodes.OP_goto, consts.BE_LABEL_CONT)
    emit_label_be(s, consts.BE_LABEL_BREAK)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

// ---- do-while ----
stmt_do(s: ptr, label_name: long) -> int {
    push_break_entry(s, label_name, new_label(s), new_label(s), 0)
    long label1 = new_label(s)
    next_token(s)
    set_eval_ret_undefined(s)
    label1 = emit_label_val(s, label1)
    js_parse_push_val(s, label1)
    return enc(4, consts.PARSE_FUNC_statement, 0)
}
resume_do(s: ptr) -> int {
    long label1 = js_parse_pop_val(s)
    emit_label_be(s, consts.BE_LABEL_CONT)
    js_parse_expect(s, consts.TOK_WHILE)
    js_parse_expr_paren(s)
    if tok_val(s) == 59 { next_token(s) }   // ';'
    label1 = emit_goto_val(s, opcodes.OP_if_true, label1)
    emit_label_be(s, consts.BE_LABEL_BREAK)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

// ---- for (in/of and C-style) ----
stmt_for(s: ptr, label_name: long) -> int {
    push_break_entry(s, label_name, new_label(s), new_label(s), 0)
    next_token(s)
    set_eval_ret_undefined(s)
    js_parse_expect1(s, 40)   // '('
    int bits = js_parse_skip_parens_token(s)
    next_token(s)
    if (bits & consts.SKIP_HAS_SEMI) == 0 { return for_inof_head(s) }
    return for_c_head(s)
}

// for-in / for-of head: emit setup, then PARSE_CALL(5) on the body.
for_inof_head(s: ptr) -> int {
    be_set_field(s, consts.BE_DROP_COUNT, jstag.new_short_int(1))
    long label_expr = new_label(s)
    long label_body = new_label(s)
    long label_next = new_label(s)
    label_expr = emit_goto_val(s, opcodes.OP_goto, label_expr)
    label_next = emit_label_val(s, label_next)

    int opcode = 0
    if tok_val(s) == consts.TOK_VAR {
        next_token(s)
        vk = malloc(4)
        int var_idx = define_var(s, vk, tok_value(s))
        int var_kind = mem.get_int(vk, 0)
        free(vk)
        put_var(s, var_kind, var_idx, pc2line_source_pos(s))
        next_token(s)
    } else {
        js_parse_assign_expr2(s, consts.PF_NO_IN)
        lv = malloc(12)
        get_lvalue(s, lv, mem.long_to_ptr(mem.ptr_to_long(lv) + 4), mem.long_to_ptr(mem.ptr_to_long(lv) + 8), 0)
        int opcode2 = mem.get_int(lv, 0)
        int var_idx = mem.get_int(lv, 4)
        int source_pos = mem.get_uint32(lv, 8)
        free(lv)
        put_lvalue(s, opcode2, var_idx, source_pos, consts.PUT_LVALUE_NOKEEP_BOTTOM)
    }
    label_body = emit_goto_val(s, opcodes.OP_goto, label_body)

    if tok_val(s) == consts.TOK_IN { opcode = opcodes.OP_for_in_start }
    else if tok_val(s) == consts.TOK_IDENT {
        if tok_value(s) == atom(s, consts.JS_ATOM_of) { opcode = opcodes.OP_for_of_start }
        else { js_parse_error(s, "expected 'of' or 'in' in for control expression") }
    } else { js_parse_error(s, "expected 'of' or 'in' in for control expression") }
    next_token(s)

    label_expr = emit_label_val(s, label_expr)
    js_parse_expr(s)
    emit_op(s, opcode)
    emit_goto_be(s, opcodes.OP_goto, consts.BE_LABEL_CONT)
    js_parse_expect(s, 41)   // ')'
    label_body = emit_label_val(s, label_body)

    js_parse_push_val(s, label_next)
    return enc(5, consts.PARSE_FUNC_statement, 0)
}
resume_for_inof(s: ptr) -> int {
    long label_next = js_parse_pop_val(s)
    emit_label_be(s, consts.BE_LABEL_CONT)
    emit_op(s, opcodes.OP_for_of_next)
    label_next = emit_goto_val(s, opcodes.OP_if_false, label_next)
    emit_op(s, opcodes.OP_drop)
    emit_label_be(s, consts.BE_LABEL_BREAK)
    emit_op(s, opcodes.OP_drop)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

// C-style for: init; test; update.
for_c_head(s: ptr) -> int {
    if tok_val(s) != 59 {   // ';'
        if tok_val(s) == consts.TOK_VAR {
            next_token(s)
            js_parse_var(s, 0)
        } else {
            js_parse_expr2(s, consts.PF_NO_IN | consts.PF_DROP)
        }
    }
    js_parse_expect(s, 59)   // ';'
    long label_test = new_label(s)
    label_test = emit_label_val(s, label_test)
    if tok_val(s) != 59 {   // ';'
        js_parse_expr(s)
        emit_goto_be(s, opcodes.OP_if_false, consts.BE_LABEL_BREAK)
    }
    js_parse_expect(s, 59)   // ';'

    int expr3_source_pos = 0 - 1
    int expr3_flags = 0
    if tok_val(s) != 41 {   // ')'
        pp = malloc(8)
        js_parse_get_pos(s, pp)
        int g_lf = mem.get_byte(pp, 0)
        int g_re = mem.get_byte(pp, 1)
        expr3_flags = g_lf | (g_re << 1)
        expr3_source_pos = mem.get_uint32(pp, 4)
        free(pp)
        js_skip_expr(s)
    }
    js_parse_expect(s, 41)   // ')'

    js_parse_push_val(s, label_test)
    push_int(s, expr3_flags)
    push_int(s, expr3_source_pos)
    return enc(6, consts.PARSE_FUNC_statement, 0)
}
resume_for_c(s: ptr) -> int {
    int expr3_source_pos = pop_int(s)
    int expr3_flags = pop_int(s)
    long label_test = js_parse_pop_val(s)

    emit_label_be(s, consts.BE_LABEL_CONT)

    if expr3_source_pos != (0 - 1) {
        // parse the third expression after the statement, then seek back
        endp = malloc(8)
        js_parse_get_pos(s, endp)
        ep = malloc(8)
        mem.set_byte(ep, 0, expr3_flags & 1)
        mem.set_byte(ep, 1, expr3_flags >> 1)
        mem.set_uint32(ep, 4, expr3_source_pos)
        js_parse_seek_token(s, ep)
        free(ep)
        js_parse_expr2(s, consts.PF_DROP)
        js_parse_seek_token(s, endp)
        free(endp)
    }
    label_test = emit_goto_val(s, opcodes.OP_goto, label_test)
    emit_label_be(s, consts.BE_LABEL_BREAK)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

// ---- break / continue ----
stmt_break_cont(s: ptr, is_cont: int) -> int {
    next_token(s)
    long label_name = LABEL_NONE()
    int has_name = 0
    if got_lf(s) == 0 { if tok_val(s) == consts.TOK_IDENT { label_name = tok_value(s)  has_name = 1 } }
    if has_name == 0 { label_name = jstag.JS_NULL }
    emit_break(s, label_name, is_cont)
    if jstag.is_null(label_name) == 0 { next_token(s) }
    js_parse_expect_semi(s)
    return consts.PARSE_STATE_RET
}

// ---- switch ----
stmt_switch(s: ptr, label_name: long) -> int {
    push_break_entry(s, label_name, new_label(s), LABEL_NONE(), 1)
    next_token(s)
    set_eval_ret_undefined(s)
    js_parse_expr_paren(s)
    js_parse_expect(s, 123)   // '{'
    // default_label_pos = -1, label_case = LABEL_NONE
    js_parse_push_val(s, LABEL_NONE())   // label_case
    push_int(s, 0 - 1)                    // default_label_pos
    return switch_loop(s)
}

// switch body loop. State is carried on the value stack:
// [label_case(val), default_label_pos(int)] sit below the resume token.
switch_loop(s: ptr) -> int {
    int default_label_pos = pop_int(s)
    long label_case = js_parse_pop_val(s)

    while tok_val(s) != 125 {   // '}'
        int t = tok_val(s)
        if t == consts.TOK_CASE {
            long label1 = LABEL_NONE()
            if label_is_none(label_case) == 0 {
                label1 = new_label(s)
                label1 = emit_goto_val(s, opcodes.OP_goto, label1)
                label_case = emit_label_val(s, label_case)
                label_case = LABEL_NONE()
            }
            int seq = 1
            while seq != 0 {
                next_token(s)
                emit_op(s, opcodes.OP_dup)
                js_parse_expr(s)
                js_parse_expect(s, 58)   // ':'
                emit_op(s, opcodes.OP_strict_eq)
                if tok_val(s) == consts.TOK_CASE {
                    if label_is_none(label1) != 0 { label1 = new_label(s) }
                    label1 = emit_goto_val(s, opcodes.OP_if_true, label1)
                } else {
                    label_case = new_label(s)
                    label_case = emit_goto_val(s, opcodes.OP_if_false, label_case)
                    if label_is_none(label1) == 0 { label1 = emit_label_val(s, label1) }
                    seq = 0
                }
            }
        } else if t == consts.TOK_DEFAULT {
            next_token(s)
            js_parse_expect(s, 58)   // ':'
            if default_label_pos >= 0 { js_parse_error(s, "duplicate default") }
            if label_is_none(label_case) != 0 {
                label_case = new_label(s)
                label_case = emit_goto_val(s, opcodes.OP_goto, label_case)
            }
            default_label_pos = byte_code_len(s)
        } else {
            if label_is_none(label_case) != 0 { js_parse_error(s, "invalid switch statement") }
            // PARSE_PUSH_VAL(label_case); PARSE_CALL_SAVE1(7, statement, 0, default_label_pos)
            js_parse_push_val(s, label_case)
            push_int(s, default_label_pos)
            return enc(7, consts.PARSE_FUNC_statement, 0)
        }
    }
    return switch_end(s, label_case, default_label_pos)
}
resume_switch_stmt(s: ptr) -> int {
    int default_label_pos = pop_int(s)
    long label_case = js_parse_pop_val(s)
    // re-push loop state and continue
    js_parse_push_val(s, label_case)
    push_int(s, default_label_pos)
    return switch_loop(s)
}
switch_end(s: ptr, label_case: long, default_label_pos: int) -> int {
    js_parse_expect(s, 125)   // '}'
    if default_label_pos >= 0 {
        label_case = emit_label_pos_val(s, label_case, default_label_pos)
    } else if label_is_none(label_case) == 0 {
        label_case = emit_label_val(s, label_case)
    }
    emit_label_be(s, consts.BE_LABEL_BREAK)
    emit_op(s, opcodes.OP_drop)
    pop_break_entry(s)
    return consts.PARSE_STATE_RET
}

// ---- try / catch / finally ----
stmt_try(s: ptr) -> int {
    set_eval_ret_undefined(s)
    next_token(s)
    long label_catch = new_label(s)
    long label_finally = new_label(s)
    label_catch = emit_goto_val(s, opcodes.OP_catch, label_catch)
    be = push_break_entry(s, jstag.JS_NULL, LABEL_NONE(), LABEL_NONE(), 1)
    mem.set_long(be, consts.BE_LABEL_FINALLY, label_finally)
    js_parse_push_val(s, label_catch)
    return enc(8, consts.PARSE_FUNC_block, 0)
}
resume_try_block(s: ptr) -> int {
    long label_catch = js_parse_pop_val(s)
    long label_finally = be_field(s, consts.BE_LABEL_FINALLY)
    pop_break_entry(s)
    emit_op(s, opcodes.OP_drop)
    emit_op(s, opcodes.OP_undefined)
    label_finally = emit_goto_val(s, opcodes.OP_gosub, label_finally)
    emit_op(s, opcodes.OP_drop)
    long label_end = new_label(s)
    label_end = emit_goto_val(s, opcodes.OP_goto, label_end)

    if tok_val(s) == consts.TOK_CATCH {
        long label_catch2 = new_label(s)
        next_token(s)
        js_parse_expect(s, 40)   // '('
        if tok_val(s) != consts.TOK_IDENT { js_parse_error(s, "identifier expected") }
        long name = tok_value(s)
        if find_var(s, name) >= 0 { js_parse_error(s, "catch variable already exists") }
        if find_ext_var(s, name) >= 0 { js_parse_error(s, "catch variable already exists") }
        int var_idx = add_var(s, name)
        next_token(s)
        js_parse_expect(s, 41)   // ')'
        label_catch = emit_label_val(s, label_catch)
        b = jstag.value_to_ptr((s as *JSParseState).cur_func)
        int arg_count = (b as *JSFunctionBytecode).arg_count
        emit_var(s, opcodes.OP_put_loc, var_idx - arg_count, pc2line_source_pos(s))
        label_catch2 = emit_goto_val(s, opcodes.OP_catch, label_catch2)
        be = push_break_entry(s, jstag.JS_NULL, LABEL_NONE(), LABEL_NONE(), 1)
        mem.set_long(be, consts.BE_LABEL_FINALLY, label_finally)
        js_parse_push_val(s, label_end)
        js_parse_push_val(s, label_catch2)
        return enc(9, consts.PARSE_FUNC_block, 0)
    }
    if tok_val(s) == consts.TOK_FINALLY {
        label_catch = emit_label_val(s, label_catch)
        label_finally = emit_goto_val(s, opcodes.OP_gosub, label_finally)
        emit_op(s, opcodes.OP_throw)
        return try_finally_tail(s, label_finally, label_end)
    }
    js_parse_error(s, "expecting catch or finally")
    return consts.PARSE_STATE_RET
}
resume_catch_block(s: ptr) -> int {
    long label_catch2 = js_parse_pop_val(s)
    long label_end = js_parse_pop_val(s)
    long label_finally = be_field(s, consts.BE_LABEL_FINALLY)
    pop_break_entry(s)
    emit_op(s, opcodes.OP_drop)
    emit_op(s, opcodes.OP_undefined)
    label_finally = emit_goto_val(s, opcodes.OP_gosub, label_finally)
    emit_op(s, opcodes.OP_drop)
    label_end = emit_goto_val(s, opcodes.OP_goto, label_end)
    label_catch2 = emit_label_val(s, label_catch2)
    label_finally = emit_goto_val(s, opcodes.OP_gosub, label_finally)
    emit_op(s, opcodes.OP_throw)
    return try_finally_tail(s, label_finally, label_end)
}
// shared tail: emit the finally label, optionally parse the finally block.
try_finally_tail(s: ptr, label_finally: long, label_end: long) -> int {
    label_finally = emit_label_val(s, label_finally)
    if tok_val(s) == consts.TOK_FINALLY {
        next_token(s)
        push_break_entry(s, jstag.JS_NULL, LABEL_NONE(), LABEL_NONE(), 2)
        js_parse_push_val(s, label_end)
        return enc(10, consts.PARSE_FUNC_block, 0)
    }
    emit_op(s, opcodes.OP_ret)
    label_end = emit_label_val(s, label_end)
    return consts.PARSE_STATE_RET
}
resume_finally_block(s: ptr) -> int {
    long label_end = js_parse_pop_val(s)
    pop_break_entry(s)
    emit_op(s, opcodes.OP_ret)
    label_end = emit_label_val(s, label_end)
    return consts.PARSE_STATE_RET
}

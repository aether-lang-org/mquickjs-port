// readline utility — line editing logic.
// Copyright (c) 2003-2025 Fabrice Bellard, Charlie Gordon
//
// Port of readline.c. Terminal line editing, UTF-8, escape sequences,
// command history. The OS/terminal I/O glue stays C (readline_tty.c):
// this module drives it through the non-variadic term_put_* primitives
// (the upstream variadic term_printf cannot be called across the ABI).

import std.mem

const IS_NORM = 0
const IS_ESC = 1
const IS_CSI = 2

const READLINE_RET_EXIT = -1
const READLINE_RET_NOT_HANDLED = 0
const READLINE_RET_HANDLED = 1
const READLINE_RET_ACCEPTED = 2

const UTF8_CHAR_LEN_MAX = 4
const COLOR_NONE = 0

extern __utf8_get(buf: ptr, plen: ptr) -> int
extern __unicode_to_utf8(buf: ptr, c: int) -> long
extern term_put_str(s: ptr)
extern term_put_buf(s: ptr, len: int)
extern term_put_char(c: int)
extern term_put_csi(n: int, code: int)
extern term_put_color(color: int)
extern term_call_get_color(fn: ptr, plen: ptr, buf: ptr, pos: int, buf_len: int) -> int
extern term_flush()
extern isspace(c: int) -> int
extern strlen(s: ptr) -> int
extern memcpy(dst: ptr, src: ptr, len: int) -> ptr
extern memmove(dst: ptr, src: ptr, len: int) -> ptr
extern memcmp(a: ptr, b: ptr, len: int) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

// ReadlineState offsets (probed against the C struct, sizeof 112).
const RS_CMD_BUF_INDEX = 0
const RS_CMD_BUF_LEN = 4
const RS_UTF8_VAL = 8
const RS_CMD_UPDATED = 12
const RS_UTF8_STATE = 13
const RS_ESC_STATE = 14
const RS_ESC_PARAM = 16
const RS_ESC_PARAM1 = 20
const RS_ESC_PARAM2 = 24
const RS_CURSOR_X = 28
const RS_CURSOR_POS = 32
const RS_HIST_ENTRY = 36
const RS_HISTORY_SIZE = 40
const RS_IS_PASSWORD = 44
const RS_PROMPT = 48
const RS_TERM_WIDTH = 56
const RS_CMD_BUF_SIZE = 60
const RS_KILL_BUF_LEN = 64
const RS_CMD_BUF = 72
const RS_KILL_BUF = 80
const RS_HISTORY_BUF_SIZE = 88
const RS_HISTORY = 96
const RS_GET_COLOR = 104

exports (
    readline_handle_byte,
    readline_start,
    READLINE_RET_EXIT,
    READLINE_RET_NOT_HANDLED,
    READLINE_RET_HANDLED,
    READLINE_RET_ACCEPTED,
)

// utf8_get(p, &len): ASCII fast path inline, else __utf8_get. Returns the
// codepoint and writes the byte length into the caller's malloc'd slot.
utf8_get_len(base: long, slot: ptr) -> int {
    p = mem.long_to_ptr(base)
    int c = mem.get_byte(p, 0)
    if c < 0x80 {
        mem.set_long(slot, 0, 1)
        return c
    }
    return __utf8_get(p, slot)
}

char_width(c: int) -> int {
    if c < 0x100 {
        return 1
    } else if (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xFF01 && c <= 0xFF5E) || (c >= 0x1F600 && c <= 0x1F64F) {
        return 2
    }
    return 1
}

move_cursor(s: ptr, delta: int) {
    if delta > 0 {
        while delta != 0 {
            int cursor_x = mem.get_int(s, RS_CURSOR_X)
            int term_width = mem.get_int(s, RS_TERM_WIDTH)
            if cursor_x == (term_width - 1) {
                term_put_str("\r\n")
                mem.set_int(s, RS_CURSOR_X, 0)
                delta = delta - 1
            } else {
                int l = term_width - 1 - cursor_x
                if l > delta { l = delta }
                term_put_csi(l, 67) // 'C' right
                delta = delta - l
                mem.set_int(s, RS_CURSOR_X, cursor_x + l)
            }
        }
    } else if delta < 0 {
        delta = -delta
        while delta != 0 {
            int cursor_x = mem.get_int(s, RS_CURSOR_X)
            int term_width = mem.get_int(s, RS_TERM_WIDTH)
            if cursor_x == 0 {
                term_put_csi(1, 65) // 'A' up
                term_put_csi(term_width - 1, 67) // 'C' right
                delta = delta - 1
                mem.set_int(s, RS_CURSOR_X, term_width - 1)
            } else {
                int l = delta
                if l > cursor_x { l = cursor_x }
                term_put_csi(l, 68) // 'D' left
                delta = delta - l
                mem.set_int(s, RS_CURSOR_X, cursor_x - l)
            }
        }
    }
}

term_kill_region(s: ptr, to: int, kill: int) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)
    kill_buf = mem.get_ptr(s, RS_KILL_BUF)

    int start = cmd_buf_index
    int end = cmd_buf_index
    if to < start { start = to }
    else { end = to }
    if end > cmd_buf_len { end = cmd_buf_len }

    if start < end {
        int len = end - start
        if kill != 0 {
            memcpy(kill_buf, cmd_buf + start, len)
            mem.set_int(s, RS_KILL_BUF_LEN, len)
        }
        memmove(cmd_buf + start, cmd_buf + end, cmd_buf_len - end)
        mem.set_int(s, RS_CMD_BUF_LEN, cmd_buf_len - len)
        mem.set_int(s, RS_CMD_BUF_INDEX, start)
        mem.set_byte(s, RS_CMD_UPDATED, 1)
    }
}

term_insert_region(s: ptr, data: ptr, len: int) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    int cmd_buf_size = mem.get_int(s, RS_CMD_BUF_SIZE)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    if cmd_buf_index + len < cmd_buf_size {
        int nchars = cmd_buf_len - cmd_buf_index
        if nchars > 0 {
            memmove(cmd_buf + cmd_buf_index + len, cmd_buf + cmd_buf_index, nchars)
        }
        memcpy(cmd_buf + cmd_buf_index, data, len)
        mem.set_int(s, RS_CMD_BUF_LEN, cmd_buf_len + len)
        mem.set_int(s, RS_CMD_BUF_INDEX, cmd_buf_index + len)
        mem.set_byte(s, RS_CMD_UPDATED, 1)
    }
}

term_insert_char(s: ptr, ch: int) {
    buf = malloc(UTF8_CHAR_LEN_MAX + 1)
    // unicode_to_utf8: ASCII fast path inline, else __unicode_to_utf8.
    int len = 0
    if ch < 0x80 {
        mem.set_byte(buf, 0, ch)
        len = 1
    } else {
        len = __unicode_to_utf8(buf, ch)
    }
    term_insert_region(s, buf, len)
    free(buf)
}

is_utf8_ext(c: int) -> int {
    if c >= 0x80 && c < 0xc0 { return 1 }
    return 0
}

term_backward_char(s: ptr) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    if cmd_buf_index > 0 {
        cmd_buf_index = cmd_buf_index - 1
        while cmd_buf_index > 0 && is_utf8_ext(mem.get_byte(cmd_buf, cmd_buf_index)) != 0 {
            cmd_buf_index = cmd_buf_index - 1
        }
    }
    mem.set_int(s, RS_CMD_BUF_INDEX, cmd_buf_index)
}

term_forward_char(s: ptr) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    if cmd_buf_index < cmd_buf_len {
        slot = malloc(8)
        utf8_get_len(mem.ptr_to_long(cmd_buf) + cmd_buf_index, slot)
        cmd_buf_index = cmd_buf_index + mem.get_long(slot, 0)
        free(slot)
    }
    mem.set_int(s, RS_CMD_BUF_INDEX, cmd_buf_index)
}

term_delete_char(s: ptr) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    if cmd_buf_index < cmd_buf_len {
        slot = malloc(8)
        utf8_get_len(mem.ptr_to_long(cmd_buf) + cmd_buf_index, slot)
        int c_len = mem.get_long(slot, 0)
        free(slot)
        term_kill_region(s, cmd_buf_index + c_len, 0)
    }
}

term_backspace(s: ptr) {
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    if cmd_buf_index > 0 {
        term_backward_char(s)
        term_delete_char(s)
    }
}

skip_word_backward(s: ptr) -> int {
    int pos = mem.get_int(s, RS_CMD_BUF_INDEX)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    while pos > 0 && isspace(mem.get_byte(cmd_buf, pos - 1)) != 0 {
        pos = pos - 1
    }
    while pos > 0 && isspace(mem.get_byte(cmd_buf, pos - 1)) == 0 {
        pos = pos - 1
    }
    return pos
}

skip_word_forward(s: ptr) -> int {
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)
    int pos = mem.get_int(s, RS_CMD_BUF_INDEX)

    while pos < cmd_buf_len && isspace(mem.get_byte(cmd_buf, pos)) != 0 {
        pos = pos + 1
    }
    while pos < cmd_buf_len && isspace(mem.get_byte(cmd_buf, pos)) == 0 {
        pos = pos + 1
    }
    return pos
}

term_skip_word_backward(s: ptr) {
    mem.set_int(s, RS_CMD_BUF_INDEX, skip_word_backward(s))
}

term_skip_word_forward(s: ptr) {
    mem.set_int(s, RS_CMD_BUF_INDEX, skip_word_forward(s))
}

term_yank(s: ptr) {
    int kill_buf_len = mem.get_int(s, RS_KILL_BUF_LEN)
    kill_buf = mem.get_ptr(s, RS_KILL_BUF)
    term_insert_region(s, kill_buf, kill_buf_len)
}

term_kill_word(s: ptr) {
    term_kill_region(s, skip_word_forward(s), 1)
}

term_kill_word_backward(s: ptr) {
    term_kill_region(s, skip_word_backward(s), 1)
}

term_bol(s: ptr) {
    mem.set_int(s, RS_CMD_BUF_INDEX, 0)
}

term_eol(s: ptr) {
    mem.set_int(s, RS_CMD_BUF_INDEX, mem.get_int(s, RS_CMD_BUF_LEN))
}

update_cmdline_from_history(s: ptr) {
    int hist_entry = mem.get_int(s, RS_HIST_ENTRY)
    history = mem.get_ptr(s, RS_HISTORY)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    int hist_entry_size = strlen(history + hist_entry)
    memcpy(cmd_buf, history + hist_entry, hist_entry_size)
    mem.set_int(s, RS_CMD_BUF_LEN, hist_entry_size)
    mem.set_int(s, RS_CMD_BUF_INDEX, hist_entry_size)
    mem.set_byte(s, RS_CMD_UPDATED, 1)
}

term_up_char(s: ptr) {
    int hist_entry = mem.get_int(s, RS_HIST_ENTRY)
    int history_size = mem.get_int(s, RS_HISTORY_SIZE)
    history = mem.get_ptr(s, RS_HISTORY)

    if hist_entry == -1 {
        hist_entry = history_size
    }
    if hist_entry == 0 {
        return
    }

    int idx = hist_entry - 1
    while idx > 0 && mem.get_byte(history, idx - 1) != 0 {
        idx = idx - 1
    }
    mem.set_int(s, RS_HIST_ENTRY, idx)
    update_cmdline_from_history(s)
}

term_down_char(s: ptr) {
    int hist_entry = mem.get_int(s, RS_HIST_ENTRY)
    int history_size = mem.get_int(s, RS_HISTORY_SIZE)
    history = mem.get_ptr(s, RS_HISTORY)

    if hist_entry == -1 {
        return
    }

    int hist_entry_size = strlen(history + hist_entry) + 1
    if hist_entry + hist_entry_size < history_size {
        mem.set_int(s, RS_HIST_ENTRY, hist_entry + hist_entry_size)
        update_cmdline_from_history(s)
    } else {
        mem.set_int(s, RS_HIST_ENTRY, -1)
        mem.set_int(s, RS_CMD_BUF_INDEX, mem.get_int(s, RS_CMD_BUF_LEN))
    }
}

term_hist_add(s: ptr, cmdline: ptr) {
    if mem.get_byte(cmdline, 0) == 0 {
        return
    }

    int cmdline_size = strlen(cmdline) + 1
    int hist_entry = mem.get_int(s, RS_HIST_ENTRY)
    int history_size = mem.get_int(s, RS_HISTORY_SIZE)
    int history_buf_size = mem.get_int(s, RS_HISTORY_BUF_SIZE)
    history = mem.get_ptr(s, RS_HISTORY)

    // Locate an identical entry to remove (so the new one moves to the end).
    int found = 0
    int idx = 0
    int entry_size = 0

    if hist_entry != -1 {
        int he_size = strlen(history + hist_entry) + 1
        if he_size == cmdline_size && memcmp(history + hist_entry, cmdline, cmdline_size) == 0 {
            found = 1
            idx = hist_entry
            entry_size = he_size
        }
    }

    if found == 0 {
        idx = 0
        while idx < history_size {
            int he_size = strlen(history + idx) + 1
            if he_size == cmdline_size && memcmp(history + idx, cmdline, cmdline_size) == 0 {
                found = 1
                entry_size = he_size
                break
            }
            idx = idx + he_size
        }
    }

    if found != 0 {
        memmove(history + idx, history + idx + entry_size, history_size - (idx + entry_size))
        history_size = history_size - entry_size
        mem.set_int(s, RS_HISTORY_SIZE, history_size)
    }

    if cmdline_size <= history_buf_size {
        while history_size + cmdline_size > history_buf_size {
            int first_size = strlen(history) + 1
            memmove(history, history + first_size, history_size - first_size)
            history_size = history_size - first_size
        }
        memcpy(history + history_size, cmdline, cmdline_size)
        history_size = history_size + cmdline_size
        mem.set_int(s, RS_HISTORY_SIZE, history_size)
    }
    mem.set_int(s, RS_HIST_ENTRY, -1)
}

term_show_prompt(s: ptr) {
    prompt = mem.get_ptr(s, RS_PROMPT)
    int term_width = mem.get_int(s, RS_TERM_WIDTH)

    term_put_str(prompt)
    term_flush()

    int prompt_len = strlen(prompt)
    mem.set_int(s, RS_CURSOR_X, prompt_len % term_width)
    mem.set_int(s, RS_CURSOR_POS, 0)
    mem.set_int(s, RS_ESC_STATE, IS_NORM)
    mem.set_byte(s, RS_UTF8_STATE, 0)
    mem.set_int(s, RS_CMD_BUF_INDEX, 0)
    mem.set_int(s, RS_CMD_BUF_LEN, 0)
}

term_update(s: ptr) {
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    int cmd_buf_index = mem.get_int(s, RS_CMD_BUF_INDEX)
    int cmd_updated = mem.get_byte(s, RS_CMD_UPDATED)
    int is_password = mem.get_byte(s, RS_IS_PASSWORD)
    int term_width = mem.get_int(s, RS_TERM_WIDTH)
    int cursor_x = mem.get_int(s, RS_CURSOR_X)
    int cursor_pos = mem.get_int(s, RS_CURSOR_POS)

    int new_cursor_pos = 0
    slot = malloc(8)

    if cmd_updated != 0 {
        move_cursor(s, -cursor_pos)
        cursor_pos = 0
        // move_cursor left the terminal column in RS_CURSOR_X; track it.
        cursor_x = mem.get_int(s, RS_CURSOR_X)

        get_color = mem.get_ptr(s, RS_GET_COLOR)
        int last_color = COLOR_NONE
        int color_len = 0
        len_slot = malloc(8)

        mem.set_byte(cmd_buf, cmd_buf_len, 0) // trailing NUL eases colorization

        int i = 0
        while i < cmd_buf_len {
            if i == cmd_buf_index {
                new_cursor_pos = cursor_pos
            }

            int c = utf8_get_len(mem.ptr_to_long(cmd_buf) + i, slot)
            int c_len = mem.get_long(slot, 0)

            int len = 0
            if is_password != 0 {
                len = 1
            } else {
                len = char_width(c)
            }

            // A wide char that does not fit wraps to the next line by
            // padding the remaining columns with spaces.
            if cursor_x + len > term_width && i > 0 {
                while cursor_x < term_width {
                    term_put_char(32) // ' '
                    cursor_x = cursor_x + 1
                    cursor_pos = cursor_pos + 1
                }
                cursor_x = 0
            }

            cursor_pos = cursor_pos + len
            cursor_x = cursor_x + len
            if cursor_x >= term_width {
                cursor_x = 0
            }

            // Syntax-colorize runs of characters via the get_color callback.
            if is_password == 0 && get_color != null {
                if color_len == 0 {
                    int new_color = term_call_get_color(get_color, len_slot, cmd_buf, i, cmd_buf_len)
                    color_len = mem.get_int(len_slot, 0)
                    if new_color != last_color {
                        last_color = new_color
                        term_put_color(COLOR_NONE) // reset previous color
                        term_put_color(last_color)
                    }
                }
                color_len = color_len - 1
            }

            if is_password != 0 {
                term_put_char(42) // '*'
            } else {
                term_put_buf(cmd_buf + i, c_len)
            }
            i = i + c_len
        }

        if last_color != COLOR_NONE {
            term_put_color(COLOR_NONE)
        }
        free(len_slot)

        if i == cmd_buf_index {
            new_cursor_pos = cursor_pos
        }

        if cursor_x == 0 {
            // show the cursor on the next line
            term_put_char(32)  // ' '
            term_put_char(8)   // backspace
        }
        // remove the trailing characters
        term_put_csi(1, 74) // 'J' erase to end
        mem.set_byte(s, RS_CMD_UPDATED, 0)
    } else {
        // recompute the cursor position without redisplaying
        int calc_x = (cursor_x - cursor_pos) % term_width
        if calc_x < 0 { calc_x = calc_x + term_width }

        new_cursor_pos = 0
        int i = 0
        while i < cmd_buf_index {
            int c = utf8_get_len(mem.ptr_to_long(cmd_buf) + i, slot)
            int c_len = mem.get_long(slot, 0)
            if is_password != 0 { c = 42 }
            int len = char_width(c)

            if calc_x + len > term_width && i > 0 {
                new_cursor_pos = new_cursor_pos + (term_width - calc_x)
                calc_x = 0
            }
            new_cursor_pos = new_cursor_pos + len
            calc_x = calc_x + len
            if calc_x >= term_width { calc_x = 0 }
            i = i + c_len
        }
    }

    free(slot)
    // Sync the tracked terminal column back to the struct: the redraw loop
    // (and the cursor-only branch's calc) updated the local copy, but
    // move_cursor reads/writes RS_CURSOR_X directly.
    mem.set_int(s, RS_CURSOR_X, cursor_x)
    move_cursor(s, new_cursor_pos - cursor_pos)
    mem.set_int(s, RS_CURSOR_POS, new_cursor_pos)
    term_flush()
}

handle_norm(s: ptr, ch: int) -> int {
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)

    if ch == 1 {            // ^A
        term_bol(s)
    } else if ch == 4 {     // ^D
        if cmd_buf_len == 0 {
            term_put_str("^D\n")
            return READLINE_RET_EXIT
        }
        term_delete_char(s)
    } else if ch == 5 {     // ^E
        term_eol(s)
    } else if ch == 9 {     // TAB (completion: not yet wired)
    } else if ch == 10 || ch == 13 {
        mem.set_byte(cmd_buf, cmd_buf_len, 0)
        if mem.get_byte(s, RS_IS_PASSWORD) == 0 {
            term_hist_add(s, cmd_buf)
        }
        mem.set_int(s, RS_CMD_BUF_INDEX, cmd_buf_len)
        return READLINE_RET_ACCEPTED
    } else if ch == 11 {    // ^K
        term_kill_region(s, cmd_buf_len, 1)
    } else if ch == 21 {    // ^U
        term_kill_region(s, 0, 1)
    } else if ch == 23 {    // ^W
        term_kill_word_backward(s)
    } else if ch == 25 {    // ^Y
        term_yank(s)
    } else if ch == 27 {    // ESC
        mem.set_int(s, RS_ESC_STATE, IS_ESC)
    } else if ch == 127 || ch == 8 { // DEL / ^H
        term_backspace(s)
    } else if ch == 155 {   // 0x9B
        mem.set_int(s, RS_ESC_STATE, IS_CSI)
    } else {
        if ch >= 32 {
            term_insert_char(s, ch)
        } else {
            return 0
        }
    }
    return READLINE_RET_HANDLED
}

handle_esc(s: ptr, ch: int) -> int {
    int cmd_buf_len = mem.get_int(s, RS_CMD_BUF_LEN)
    cmd_buf = mem.get_ptr(s, RS_CMD_BUF)
    mem.set_int(s, RS_ESC_STATE, IS_NORM)

    if ch == 91 || ch == 79 {   // '[' or 'O'
        mem.set_int(s, RS_ESC_STATE, IS_CSI)
        mem.set_int(s, RS_ESC_PARAM2, 0)
        mem.set_int(s, RS_ESC_PARAM1, 0)
        mem.set_int(s, RS_ESC_PARAM, 0)
    } else if ch == 13 {        // ESC+RET
        mem.set_byte(cmd_buf, cmd_buf_len, 0)
        if mem.get_byte(s, RS_IS_PASSWORD) == 0 {
            term_hist_add(s, cmd_buf)
        }
        mem.set_int(s, RS_CMD_BUF_INDEX, cmd_buf_len)
    } else if ch == 8 || ch == 127 {
        term_kill_word_backward(s)
    } else if ch == 98 {        // 'b'
        term_skip_word_backward(s)
    } else if ch == 100 {       // 'd'
        term_kill_word(s)
    } else if ch == 102 {       // 'f'
        term_skip_word_forward(s)
    } else {
        return 0
    }
    return READLINE_RET_HANDLED
}

handle_csi(s: ptr, ch: int) -> int {
    mem.set_int(s, RS_ESC_STATE, IS_NORM)
    int esc_param = mem.get_int(s, RS_ESC_PARAM)

    if ch == 65 {           // 'A' up
        term_up_char(s)
    } else if ch == 66 || ch == 69 { // 'B' / 'E' down
        term_down_char(s)
    } else if ch == 68 {    // 'D' left
        term_backward_char(s)
    } else if ch == 67 {    // 'C' right
        term_forward_char(s)
    } else if ch == 70 {    // 'F' end
        term_eol(s)
    } else if ch == 72 {    // 'H' home
        term_bol(s)
    } else if ch == 59 {    // ';' param separator
        mem.set_int(s, RS_ESC_PARAM2, mem.get_int(s, RS_ESC_PARAM1))
        mem.set_int(s, RS_ESC_PARAM1, esc_param)
        mem.set_int(s, RS_ESC_PARAM, 0)
        mem.set_int(s, RS_ESC_STATE, IS_CSI)
    } else if ch >= 48 && ch <= 57 { // '0'..'9'
        mem.set_int(s, RS_ESC_PARAM, esc_param * 10 + (ch - 48))
        mem.set_int(s, RS_ESC_STATE, IS_CSI)
    } else if ch == 126 {   // '~'
        if esc_param == 1 {
            term_bol(s)
        } else if esc_param == 3 {
            term_delete_char(s)
        } else if esc_param == 4 {
            term_eol(s)
        } else {
            return READLINE_RET_NOT_HANDLED
        }
    } else {
        return READLINE_RET_NOT_HANDLED
    }
    return READLINE_RET_HANDLED
}

readline_handle_char(s: ptr, ch: int) -> int {
    int ret = READLINE_RET_HANDLED
    int esc_state = mem.get_int(s, RS_ESC_STATE)

    if esc_state == IS_NORM {
        ret = handle_norm(s, ch)
    } else if esc_state == IS_ESC {
        ret = handle_esc(s, ch)
    } else {
        ret = handle_csi(s, ch)
    }

    if ret == READLINE_RET_EXIT || ret == READLINE_RET_NOT_HANDLED {
        return ret
    }

    term_update(s)
    if ret == READLINE_RET_ACCEPTED {
        term_put_char(10) // '\n'
    }
    return ret
}

readline_handle_byte(s: ptr, c: int) -> int {
    if c >= 0xc0 && c < 0xf8 {
        int extra = 0
        if c >= 0xe0 { extra = extra + 1 }
        if c >= 0xf0 { extra = extra + 1 }
        int utf8_state = 1 + extra
        mem.set_byte(s, RS_UTF8_STATE, utf8_state)
        mem.set_int(s, RS_UTF8_VAL, c & ((1 << (6 - utf8_state)) - 1))
        return READLINE_RET_HANDLED
    }

    int utf8_state = mem.get_byte(s, RS_UTF8_STATE)
    if utf8_state != 0 {
        if c >= 0x80 && c < 0xc0 {
            int utf8_val = (mem.get_int(s, RS_UTF8_VAL) << 6) | (c & 0x3F)
            mem.set_int(s, RS_UTF8_VAL, utf8_val)
            utf8_state = utf8_state - 1
            mem.set_byte(s, RS_UTF8_STATE, utf8_state)
            if utf8_state != 0 {
                return READLINE_RET_HANDLED
            }
            c = utf8_val
        }
        mem.set_byte(s, RS_UTF8_STATE, 0)
    }

    return readline_handle_char(s, c)
}

readline_start(s: ptr, prompt: ptr, is_password: int) {
    mem.set_ptr(s, RS_PROMPT, prompt)
    mem.set_byte(s, RS_IS_PASSWORD, is_password)
    mem.set_int(s, RS_HIST_ENTRY, -1)
    mem.set_int(s, RS_CMD_BUF_INDEX, 0)
    mem.set_int(s, RS_CMD_BUF_LEN, 0)
    term_show_prompt(s)
}

// Object builtins ported from mquickjs.c: Object(), getPrototypeOf,
// hasOwnProperty. They read the JSObject overlay (proto @8, class_id,
// union variants) and call property helpers. Provides the bare C
// symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern JS_IsObject(ctx: ptr, val: long) -> int
extern JS_NewObject(ctx: ptr) -> long
extern JS_ToPropertyKey(ctx: ptr, val: long) -> long
extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern JS_ThrowTypeErrorNotAnObject(ctx: ptr) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern js_set_prototype_internal(ctx: ptr, obj: long, proto: long) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_NewArray(ctx: ptr, initial_len: int) -> long
extern JS_ToString(ctx: ptr, val: long) -> long
extern string_buffer_push(ctx: ptr, s: ptr, len: int) -> int
extern string_buffer_puts(ctx: ptr, s: ptr, str: ptr) -> int
extern string_buffer_pop(ctx: ptr, s: ptr) -> long

exports (js_object_constructor, js_object_getPrototypeOf, js_object_hasOwnProperty, js_object_setPrototypeOf, js_object_keys, js_object_toString)


argv_get(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// JSValue js_object_constructor(ctx, this_val, argc, argv)
js_object_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int a = argc & (0 - 1 - consts.FRAME_CF_CTOR)   // argc &= ~consts.FRAME_CF_CTOR
    if a <= 0 {
        return JS_NewObject(ctx)
    }
    return argv_get(argv, 0)
}

// JSValue js_object_getPrototypeOf(ctx, this_val, argc, argv)
js_object_getPrototypeOf(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long a0 = argv_get(argv, 0)
    if JS_IsObject(ctx, a0) == 0 {
        return JS_ThrowTypeErrorNotAnObject(ctx)
    }
    p = jstag.value_to_ptr(a0)
    return (p as *JSObject).proto
}

// JSValue js_object_hasOwnProperty(ctx, this_val, argc, argv)
js_object_hasOwnProperty(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if jstag.is_null(tv) != 0 { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot convert to object") }
    if jstag.is_undefined(tv) != 0 { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot convert to object") }
    if JS_IsObject(ctx, tv) == 0 { return jstag.JS_FALSE }

    long prop = JS_ToPropertyKey(ctx, argv_get(argv, 0))
    p = jstag.value_to_ptr(tv)
    int cid = (p as *JSObject).class_id

    int is_array_like = 0
    int array_len = 0
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    up = mem.long_to_ptr(u)
    if cid == consts.JS_CLASS_ARRAY {
        // JSArrayData: tab@0, len@8
        array_len = mem.get_uint32(up, 8)
        is_array_like = 1
    } else if cid >= consts.JS_CLASS_UINT8C_ARRAY {
        if cid <= consts.JS_CLASS_FLOAT64_ARRAY {
            // JSTypedArray: buffer@0, len@8
            array_len = mem.get_uint32(up, 8)
            is_array_like = 1
        }
    }
    if is_array_like != 0 {
        if jstag.is_int(prop) != 0 {
            int idx = jstag.get_int(prop)
            int inb = 0
            if idx >= 0 {
                if idx < array_len { inb = 1 }
            }
            return jstag.new_bool(inb)
        }
    }
    pr = find_own_property(ctx, p, prop)
    if pr != null { return jstag.new_bool(1) }
    return jstag.new_bool(0)
}

// JSValue js_object_setPrototypeOf(ctx, this_val, argc, argv)
js_object_setPrototypeOf(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long obj = argv_get(argv, 0)
    if JS_IsObject(ctx, obj) == 0 {
        return JS_ThrowTypeErrorNotAnObject(ctx)
    }
    long proto = argv_get(argv, 1)
    if proto != jstag.JS_NULL {
        if JS_IsObject(ctx, proto) == 0 {
            return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a prototype")
        }
    }
    long r = js_set_prototype_internal(ctx, obj, proto)
    if jstag.is_exception(r) != 0 { return jstag.JS_EXCEPTION }
    return obj
}

// --- js_object_keys ------------------------------------------------
ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, consts.GCREF_PREV, ctx_top(ctx))
    ctx_set_top(ctx, ref)
    mem.set_long(ref, consts.GCREF_VAL, v)
}
gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, consts.GCREF_VAL)
    ctx_set_top(ctx, mem.get_ptr(ref, consts.GCREF_PREV))
    return v
}

// store str into ret_array's tab at element `pos`
ret_store(ret: long, pos: int, str: long) {
    pret = jstag.value_to_ptr(ret)
    long u = mem.ptr_to_long(pret) + consts.OFFSETOF_JSOBJECT_U
    long tab = mem.get_long(mem.long_to_ptr(u), 0)
    arr = jstag.value_to_ptr(tab)
    mem.set_long(arr, 8 + pos * 8, str)
}

// JSValue js_object_keys(ctx, this_val, argc, argv)
js_object_keys(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long a0 = argv_get(argv, 0)
    if JS_IsObject(ctx, a0) == 0 {
        return JS_ThrowTypeErrorNotAnObject(ctx)
    }
    p = jstag.value_to_ptr(a0)
    int cid = (p as *JSObject).class_id
    int array_len = 0
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    if cid == consts.JS_CLASS_ARRAY {
        array_len = mem.get_uint32(mem.long_to_ptr(u), 8)
    } else if cid >= consts.JS_CLASS_UINT8C_ARRAY {
        if cid <= consts.JS_CLASS_FLOAT64_ARRAY {
            array_len = mem.get_uint32(mem.long_to_ptr(u), 8)
        }
    }

    long props = mem.get_long(p, consts.JSOBJ_PROPS_OFF)
    arr = jstag.value_to_ptr(props)
    // arr->arr[0] = prop_count, arr->arr[1] = hash_mask (as short ints)
    int prop_count = jstag.get_int(mem.get_long(arr, 8))
    int hash_mask = jstag.get_int(mem.get_long(arr, 8 + 8))

    int alloc_size = array_len + prop_count
    long ret = JS_NewArray(ctx, alloc_size)
    if jstag.is_exception(ret) != 0 { return jstag.JS_EXCEPTION }

    ret_ref = malloc(16)
    gc_push(ctx, ret_ref, ret)

    int pos = 0
    int err = 0
    int i = 0
    while i < array_len {
        // ret is rooted via ret_ref for the whole function.
        long str = JS_ToString(ctx, jstag.new_short_int(i))
        if jstag.is_exception(str) != 0 { err = 1  i = array_len }
        else {
            ret_store(mem.get_long(ret_ref, consts.GCREF_VAL), pos, str)
            pos = pos + 1
            i = i + 1
        }
    }

    if err == 0 {
        int ii = 0
        int j = 0
        while j < prop_count {
            // re-fetch p (may have moved)
            p = jstag.value_to_ptr(argv_get(argv, 0))
            long props2 = mem.get_long(p, consts.JSOBJ_PROPS_OFF)
            arr2 = jstag.value_to_ptr(props2)
            // pr = &arr->arr[2 + hash_mask + 1 + 3*ii]; JSProperty.key @ +0
            int base_idx = 2 + hash_mask + 1 + 3 * ii
            long key = mem.get_long(arr2, 8 + base_idx * 8)
            if key != jstag.JS_UNINITIALIZED {
                long str = JS_ToString(ctx, key)
                if jstag.is_exception(str) != 0 { err = 1  j = prop_count }
                else {
                    ret_store(mem.get_long(ret_ref, consts.GCREF_VAL), pos, str)
                    pos = pos + 1
                    j = j + 1
                }
            }
            ii = ii + 1
        }
    }

    long final_ret = gc_pop(ctx, ret_ref)
    free(ret_ref)
    if err != 0 { return jstag.JS_EXCEPTION }
    // set ret->u.array.len = pos
    pret = jstag.value_to_ptr(final_ret)
    long ru = mem.ptr_to_long(pret) + consts.OFFSETOF_JSOBJECT_U
    mem.set_uint32(mem.long_to_ptr(ru), 8, pos)
    return final_ret
}

// JSValue js_object_toString(ctx, this_val, argc, argv)
// builds "[object <tag>]" — not fully spec-compliant, matches upstream.
js_object_toString(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long v = mem.get_long(this_val, 0)
    cls = ""   // determined below; passed to puts as a C string literal
    // int or short-float -> Number
    int is_num_prim = 0
    if jstag.is_int(v) != 0 { is_num_prim = 1 }
    else if (v & 7) == 5 { is_num_prim = 1 }   // short-float tag

    b = malloc(24)
    string_buffer_push(ctx, b, 0)
    string_buffer_puts(ctx, b, "[object ")

    if is_num_prim != 0 {
        string_buffer_puts(ctx, b, "Number")
    } else if jstag.is_ptr(v) == 0 {
        long st = jstag.get_special_tag(v)
        if st == jstag.TAG_NULL { string_buffer_puts(ctx, b, "Null") }
        else if st == jstag.TAG_UNDEFINED { string_buffer_puts(ctx, b, "Undefined") }
        else if st == jstag.TAG_SHORT_FUNC { string_buffer_puts(ctx, b, "Function") }
        else if st == jstag.TAG_BOOL { string_buffer_puts(ctx, b, "Boolean") }
        else if st == jstag.TAG_STRING_CHAR { string_buffer_puts(ctx, b, "String") }
        else { string_buffer_puts(ctx, b, "Object") }
    } else {
        p = jstag.value_to_ptr(v)
        int mtag = (p as *JSString).mtag
        if mtag == consts.MTAG_OBJECT {
            int cid = (p as *JSObject).class_id
            if cid == consts.JS_CLASS_ARRAY { string_buffer_puts(ctx, b, "Array") }
            else if cid == consts.JS_CLASS_ERROR { string_buffer_puts(ctx, b, "Error") }
            else if cid == consts.JS_CLASS_CLOSURE { string_buffer_puts(ctx, b, "Function") }
            else if cid == consts.JS_CLASS_C_FUNCTION { string_buffer_puts(ctx, b, "Function") }
            else { string_buffer_puts(ctx, b, "Object") }
        } else if mtag == consts.MTAG_STRING { string_buffer_puts(ctx, b, "String") }
        else if mtag == consts.MTAG_FLOAT64 { string_buffer_puts(ctx, b, "Number") }
        else { string_buffer_puts(ctx, b, "Object") }
    }
    string_buffer_puts(ctx, b, "]")
    long result = string_buffer_pop(ctx, b)
    free(b)
    return result
}

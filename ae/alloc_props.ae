// js_alloc_props ported from mquickjs.c: allocate a property array sized
// for n properties. Layout: [prop_count, hash_mask, hash_table[hash_size],
// JSProperty records (3 JSValues each)]. The hash table is zeroed, every
// property key is set to JS_UNINITIALIZED, and the last record's hash_next
// links to the first-free index (as a doubled/half-word index, matching
// find_own_property_inlined). Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern get_prop_hash_size_log2(prop_count: int) -> int
extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr

exports (js_alloc_props)

const VA_ARR = 8
// JSProperty: key@0, value@8, (hash_next:30|prop_type:2)@16; stride 24 bytes

ap_short_int(v: long) -> long { return v << 1 }

// JSValueArray *js_alloc_props(JSContext *ctx, int n)
js_alloc_props(ctx: ptr, n: int) -> ptr {
    int hash_size_log2 = get_prop_hash_size_log2(n)
    int hash_mask = (1 << hash_size_log2) - 1
    int first_free = 2 + hash_mask + 1
    int size = first_free + 3 * n
    arr = js_alloc_value_array(ctx, 0, size)
    if arr == null { return null }

    long base = mem.ptr_to_long(arr) + VA_ARR
    mem.set_long(mem.long_to_ptr(base), 0, ap_short_int(0))           // arr[0] = prop_count 0
    long hm = hash_mask
    mem.set_long(mem.long_to_ptr(base + 8), 0, ap_short_int(hm))      // arr[1] = hash_mask
    int i = 0
    while i <= hash_mask {
        mem.set_long(mem.long_to_ptr(base + (2 + i) * 8), 0, 0)       // hash table = 0
        i = i + 1
    }
    // property records: key = JS_UNINITIALIZED
    long pr = 0
    i = 0
    while i < n {
        long pridx = 2 + hash_mask + 1 + 3 * i
        pr = base + pridx * 8
        mem.set_long(mem.long_to_ptr(pr + consts.PROP_KEY), 0, jstag.JS_UNINITIALIZED)
        i = i + 1
    }
    // last property's hash_next = first_free << 1 (when n>0)
    if n > 0 {
        long ff = first_free
        mem.set_int(mem.long_to_ptr(pr + consts.PROP_HASH_NEXT), 0, ff << 1)
    }
    return arr
}

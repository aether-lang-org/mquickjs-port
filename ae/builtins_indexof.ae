// String.prototype.indexOf / lastIndexOf, ported from mquickjs.c
// (one function multiplexed by the lastIndexOf flag). Brute-force
// UTF-16 codepoint scan. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToStringCheckObject(ctx: ptr, val: long) -> long
extern JS_ToString(ctx: ptr, val: long) -> long
extern js_string_len(ctx: ptr, val: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToInt32Clamp(ctx: ptr, pres: ptr, val: long, min: int, max: int, min_offset: int) -> int
extern string_getcp(ctx: ptr, str: long, utf16_pos: int, is_codepoint: int) -> int

exports (js_string_indexOf)


f_isnan(d: float) -> int {
    long bits = mem.bits_of_float(d)
    if (bits & consts.EXP_MASK) == consts.EXP_MASK {
        if (bits & consts.MANT_MASK) != 0 { return 1 }
    }
    return 0
}

sgetc(ctx: ptr, str: long, pos: int) -> int {
    return string_getcp(ctx, str, pos, 0)
}

// JSValue js_string_indexOf(ctx, this_val, argc, argv, lastIndexOf)
js_string_indexOf(ctx: ptr, this_val: ptr, argc: int, argv: ptr, lastIndexOf: int) -> long {
    long s = JS_ToStringCheckObject(ctx, mem.get_long(this_val, 0))
    mem.set_long(this_val, 0, s)
    if jstag.is_exception(s) != 0 { return jstag.JS_EXCEPTION }

    long needle = JS_ToString(ctx, mem.get_long(argv, 0))
    mem.set_long(argv, 0, needle)
    if jstag.is_exception(needle) != 0 { return jstag.JS_EXCEPTION }

    int len = js_string_len(ctx, s)
    int v_len = js_string_len(ctx, needle)

    int start = 0
    int stop = 0
    int inc = 1
    slot = malloc(8)

    if lastIndexOf != 0 {
        int pos = len - v_len
        if argc > 1 {
            if JS_ToNumber(ctx, slot, mem.get_long(argv, 8)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
            float d = mem.get_float64(slot, 0)
            if f_isnan(d) == 0 {
                if d <= 0.0 { pos = 0 }
                else {
                    int di = d
                    if di < pos { pos = di }
                }
            }
        }
        start = pos
        stop = 0
        inc = 0 - 1
    } else {
        int pos = 0
        if argc > 1 {
            if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 8), 0, len, 0) != 0 { free(slot)  return jstag.JS_EXCEPTION }
            pos = mem.get_int(slot, 0)
        }
        start = pos
        stop = len - v_len
        inc = 1
    }
    free(slot)

    int ret = 0 - 1
    int can_scan = 0
    if len >= v_len {
        if (inc * (stop - start)) >= 0 { can_scan = 1 }
    }
    if can_scan != 0 {
        int i = start
        int searching = 1
        while searching != 0 {
            int j = 0
            int matched = 1
            while j < v_len {
                if sgetc(ctx, s, i + j) != sgetc(ctx, needle, j) {
                    matched = 0
                    break
                }
                j = j + 1
            }
            if matched != 0 {
                ret = i
                searching = 0
            } else {
                if i == stop { searching = 0 }
                else { i = i + inc }
            }
        }
    }
    return jstag.new_short_int(ret)
}

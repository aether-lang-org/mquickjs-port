// Assorted self-contained engine helpers ported from mquickjs.c. Each
// is a pure function over scalars / raw buffers with no engine state.
// Provides the same bare C ABI symbols; the C bodies are removed.

import std.mem
import ae.jstag
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (
    is_ascii_string, skip_spaces, js_reverse_val,
    js_fmin, js_fmax,
    lre_get_capture_count, lre_get_alloc_count, lre_get_flags,
    parse_digits, unicode_is_space_non_ascii, label_is_none,
    get_line_col, get_line_col_delta, range_compress
)

// regexp bytecode header offsets (RE_HEADER_*)
const RE_HEADER_FLAGS = 0
const RE_HEADER_CAPTURE_COUNT = 2
const RE_HEADER_REGISTER_COUNT = 3


// BOOL is_ascii_string(const char *buf, size_t len)
is_ascii_string(buf: ptr, len: long) -> int {
    long i = 0
    while i < len {
        if mem.get_byte(buf, i) > 0x7f { return 0 }
        i = i + 1
    }
    return 1
}

// int skip_spaces(const char *p1) — counts leading JS whitespace
skip_spaces(p1: ptr) -> int {
    int i = 0
    while 1 == 1 {
        int c = mem.get_byte(p1, i)
        int is_ws = 0
        if c >= 0x09 {
            if c <= 0x0d { is_ws = 1 }
        }
        if c == 0x20 { is_ws = 1 }
        if is_ws == 0 { break }
        i = i + 1
    }
    return i
}

// void js_reverse_val(JSValue *tab, int n) — reverse a JSValue array
js_reverse_val(tab: ptr, n: int) {
    int i = 0
    int half = n / 2
    while i < half {
        long a = mem.get_long(tab, i * 8)
        long b = mem.get_long(tab, (n - 1 - i) * 8)
        mem.set_long(tab, i * 8, b)
        mem.set_long(tab, (n - 1 - i) * 8, a)
        i = i + 1
    }
}

// double js_fmin(double a, double b) — min with -0/+0 sign handling.
// precondition: a, b not NaN.
js_fmin(a: float, b: float) -> float {
    if a == 0.0 {
        if b == 0.0 {
            long ba = mem.bits_of_float(a)
            long bb = mem.bits_of_float(b)
            return mem.float_from_bits(ba | bb)
        }
    }
    if a <= b { return a }
    return b
}

// double js_fmax(double a, double b)
js_fmax(a: float, b: float) -> float {
    if a == 0.0 {
        if b == 0.0 {
            long ba = mem.bits_of_float(a)
            long bb = mem.bits_of_float(b)
            return mem.float_from_bits(ba & bb)
        }
    }
    if a >= b { return a }
    return b
}

// int lre_get_capture_count(const uint8_t *bc_buf)
lre_get_capture_count(bc_buf: ptr) -> int {
    return mem.get_byte(bc_buf, RE_HEADER_CAPTURE_COUNT)
}

// int lre_get_alloc_count(const uint8_t *bc_buf)
lre_get_alloc_count(bc_buf: ptr) -> int {
    int cap = mem.get_byte(bc_buf, RE_HEADER_CAPTURE_COUNT)
    int reg = mem.get_byte(bc_buf, RE_HEADER_REGISTER_COUNT)
    return cap * 2 + reg
}

// int lre_get_flags(const uint8_t *bc_buf) — get_u16 == native 16-bit
lre_get_flags(bc_buf: ptr) -> int {
    return mem.get_uint16(bc_buf, RE_HEADER_FLAGS)
}

// int parse_digits(const uint8_t **pp) — read decimal run, clamp at
// consts.JS_SHORTINT_MAX, advance *pp.
parse_digits(pp: ptr) -> int {
    p = mem.get_ptr(pp, 0)
    long v = 0
    int i = 0
    while 1 == 1 {
        int c = mem.get_byte(p, i)
        if c < 0x30 { break }
        if c > 0x39 { break }
        v = v * 10 + (c - 0x30)
        if v >= consts.JS_SHORTINT_MAX { v = consts.JS_SHORTINT_MAX }
        i = i + 1
    }
    mem.set_ptr(pp, 0, mem.long_to_ptr(mem.ptr_to_long(p) + i))
    return v
}

// BOOL unicode_is_space_non_ascii(uint32_t c)
unicode_is_space_non_ascii(c: int) -> int {
    long cc = c & 0xffffffff
    if cc == 0x00A0 { return 1 }
    if cc == 0x1680 { return 1 }
    if cc >= 0x2000 {
        if cc <= 0x200A { return 1 }
    }
    if cc >= 0x2028 {
        if cc <= 0x2029 { return 1 }
    }
    if cc == 0x202F { return 1 }
    if cc == 0x205F { return 1 }
    if cc == 0x3000 { return 1 }
    if cc == 0xFEFF { return 1 }
    return 0
}

// BOOL label_is_none(JSValue label) — JS_VALUE_GET_INT(label) < 0
label_is_none(label: long) -> int {
    if jstag.get_int(label) < 0 { return 1 }
    return 0
}

// int get_line_col(int *pcol_num, const uint8_t *buf, size_t len)
// counts newlines (line) and codepoints since last newline (col); a
// UTF-8 continuation byte (0x80..0xbf) does not advance the column.
get_line_col(pcol_num: ptr, buf: ptr, len: long) -> int {
    int line_num = 0
    int col_num = 0
    long i = 0
    while i < len {
        int c = mem.get_byte(buf, i)
        if c == 10 {
            line_num = line_num + 1
            col_num = 0
        } else if c < 0x80 {
            col_num = col_num + 1
        } else if c >= 0xc0 {
            col_num = col_num + 1
        }
        i = i + 1
    }
    mem.set_int(pcol_num, 0, col_num)
    return line_num
}

// int get_line_col_delta(int *pcol_num, const uint8_t *buf, int pos1, int pos2)
get_line_col_delta(pcol_num: ptr, buf: ptr, pos1: int, pos2: int) -> int {
    int line_num = 0
    int col_num = 0
    slot = malloc(8)
    if pos2 >= pos1 {
        src = mem.long_to_ptr(mem.ptr_to_long(buf) + pos1)
        line_num = get_line_col(slot, src, pos2 - pos1)
        col_num = mem.get_int(slot, 0)
    } else {
        src = mem.long_to_ptr(mem.ptr_to_long(buf) + pos2)
        line_num = get_line_col(slot, src, pos1 - pos2)
        col_num = mem.get_int(slot, 0)
        line_num = 0 - line_num
        col_num = 0 - col_num
        if line_num != 0 {
            // recompute absolute column from the previous newline
            col_num = 0
            int i = pos2 - 1
            int looping = 1
            while looping != 0 {
                if i < 0 { looping = 0 }
                else {
                    int c = mem.get_byte(buf, i)
                    if c == 10 { looping = 0 }
                    else {
                        if c < 0x80 { col_num = col_num + 1 }
                        else if c >= 0xc0 { col_num = col_num + 1 }
                        i = i - 1
                    }
                }
            }
        }
    }
    free(slot)
    mem.set_int(pcol_num, 0, col_num)
    return line_num
}

// int range_compress(uint8_t *tab, int len) — merge/compact sorted
// [start,end) interval pairs (8 bytes each: two native u32) in place,
// returns the new count.
range_compress(tab: ptr, len: int) -> int {
    int i = 0
    int j = 0
    while i < len {
        long start = mem.get_uint32(tab, 8 * i) & 0xffffffff
        long endv = mem.get_uint32(tab, 8 * i + 4) & 0xffffffff
        int do_copy = 0
        if start == endv {
            // empty interval: remove
        } else if (i + 1) < len {
            long start2 = mem.get_uint32(tab, 8 * i + 8) & 0xffffffff
            long end2 = mem.get_uint32(tab, 8 * i + 12) & 0xffffffff
            if endv < start2 {
                do_copy = 1
            } else {
                // union of the intervals into the next slot
                mem.set_uint32(tab, 8 * i + 8, start)
                long me = endv
                if end2 > me { me = end2 }
                mem.set_uint32(tab, 8 * i + 12, me)
            }
        } else {
            do_copy = 1
        }
        if do_copy != 0 {
            mem.set_uint32(tab, 8 * j, start)
            mem.set_uint32(tab, 8 * j + 4, endv)
            j = j + 1
        }
        i = i + 1
    }
    return j
}

// String.prototype.repeat ported from mquickjs.c. Uses get_string_ptr
// (fills a 16-byte JSStringCharBuf scratch, returns a JSString* whose
// .len is the byte length) and the StringBuffer API. Provides the bare
// C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_IsString(ctx: ptr, val: long) -> int
extern JS_ToInt32Sat(ctx: ptr, pres: ptr, val: long) -> int
extern get_string_ptr(ctx: ptr, buf: ptr, val: long) -> ptr
extern string_buffer_push(ctx: ptr, s: ptr, len: int) -> int
extern string_buffer_concat_str(ctx: ptr, s: ptr, val2: long) -> int
extern string_buffer_pop(ctx: ptr, s: ptr) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (js_string_repeat)

const JS_CLASS_TYPE_ERROR = 14
const JS_CLASS_RANGE_ERROR = 11
const JS_STRING_LEN_MAX = 0x7ffffffe

// JSValue js_string_repeat(ctx, this_val, argc, argv)
js_string_repeat(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if JS_IsString(ctx, tv) == 0 {
        return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "not a string")
    }
    slot = malloc(8)
    if JS_ToInt32Sat(ctx, slot, mem.get_long(argv, 0)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int n = mem.get_int(slot, 0)
    free(slot)

    scratch = malloc(16)   // JSStringCharBuf
    p = get_string_ptr(ctx, scratch, tv)
    long plen = (p as *JSString).len

    long total = n
    total = total * plen   // 64-bit, like the C (int64_t)n * p->len
    if n < 0 {
        free(scratch)
        return JS_ThrowError(ctx, JS_CLASS_RANGE_ERROR, "invalid repeat count")
    }
    if total > JS_STRING_LEN_MAX {
        free(scratch)
        return JS_ThrowError(ctx, JS_CLASS_RANGE_ERROR, "invalid repeat count")
    }
    if plen == 0 {
        free(scratch)
        return tv
    }
    if n == 1 {
        free(scratch)
        return tv
    }
    free(scratch)

    b = malloc(24)   // StringBuffer
    if string_buffer_push(ctx, b, total) != 0 { free(b)  return jstag.JS_EXCEPTION }
    int i = n
    while i > 0 {
        string_buffer_concat_str(ctx, b, tv)
        i = i - 1
    }
    long result = string_buffer_pop(ctx, b)
    free(b)
    return result
}

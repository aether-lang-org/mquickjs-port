// Regexp-literal scanner ported from mquickjs.c. js_parse_regexp_token
// scans /.../flags, allocating a JSString for the source and setting the
// token (val/value/u.regexp.re_flags/re_end_pos). Provides the bare C
// symbol; C body removed.
//
// Token fields (into JSParseState): val@8, u.re_flags@16, u.re_end_pos@20,
// value@24. JSString: is_ascii bit 5 of the header, buf @ offset 8.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.jshelpers   // is_ascii_string
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern js_parse_error_mem(s: ptr)
extern __unicode_from_utf8(p: ptr, max_len: long, plen: ptr) -> int
extern js_parse_regexp_flags(pre_flags: ptr, buf: ptr) -> long
extern js_alloc_string(ctx: ptr, buf_len: int) -> ptr
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr

exports (js_parse_regexp_token)


// is_ident_next: letter / _ / $ / digit
ident_next(c: int) -> int {
    if c >= 0x61 { if c <= 0x7a { return 1 } }
    if c >= 0x41 { if c <= 0x5a { return 1 } }
    if c == 0x5f { return 1 }
    if c == 0x24 { return 1 }
    if c >= 0x30 { if c <= 0x39 { return 1 } }
    return 0
}

// unicode_from_utf8 with ascii fast path; writes len to clen_slot.
ufu(buf: ptr, pos: long, clen_slot: ptr) -> int {
    p = mem.long_to_ptr(mem.ptr_to_long(buf) + pos)
    int b0 = mem.get_byte(p, 0)
    if b0 < 0x80 {
        mem.set_long(clen_slot, 0, 1)
        return b0
    }
    return __unicode_from_utf8(p, consts.UTF8_CHAR_LEN_MAX, clen_slot)
}

// void js_parse_regexp_token(JSParseState *s, uint32_t *ppos)
js_parse_regexp_token(s: ptr, ppos: ptr) {
    ctx = (s as *JSParseState).ctx
    buf = (s as *JSParseState).source_buf
    long pos = mem.get_uint32(ppos, 0) & 0xffffffff
    long start_pos = pos
    int in_class = 0
    clen = malloc(8)

    int looping = 1
    while looping != 0 {
        int c = ufu(buf, pos, clen)
        if c == (0 - 1) { js_parse_error(s, "invalid UTF-8 sequence") }
        pos = pos + mem.get_long(clen, 0)
        if c == 0 { js_parse_error(s, "unexpected line terminator in regexp") }
        else if c == 10 { js_parse_error(s, "unexpected line terminator in regexp") }
        else if c == 13 { js_parse_error(s, "unexpected line terminator in regexp") }
        else if c == 47 {   // '/'
            if in_class == 0 { looping = 0 }
        } else if c == 91 { in_class = 1 }   // '['
        else if c == 93 { in_class = 0 }     // ']'
        else if c == 92 {   // backslash
            int c2 = ufu(buf, pos, clen)
            if c2 == (0 - 1) { js_parse_error(s, "invalid UTF-8 sequence") }
            if c2 == 0 { js_parse_error(s, "unexpected line terminator in regexp") }
            else if c2 == 10 { js_parse_error(s, "unexpected line terminator in regexp") }
            else if c2 == 13 { js_parse_error(s, "unexpected line terminator in regexp") }
            pos = pos + mem.get_long(clen, 0)
        }
    }
    long end_pos = pos - 1

    fslot = malloc(8)
    long fclen = js_parse_regexp_flags(fslot, mem.long_to_ptr(mem.ptr_to_long(buf) + pos))
    int re_flags = mem.get_int(fslot, 0)
    free(fslot)
    pos = pos + fclen
    if ident_next(mem.get_byte(buf, pos)) != 0 {
        js_parse_error(s, "invalid regular expression flags")
    }
    free(clen)

    int srclen = end_pos - start_pos
    p = js_alloc_string(ctx, srclen)
    if p == null { js_parse_error_mem(s) }
    src = mem.long_to_ptr(mem.ptr_to_long(buf) + start_pos)
    int asc = jshelpers.is_ascii_string(src, srclen)
    (p as *JSString).is_ascii = asc
    // memcpy(p->buf, src, srclen); p->buf @ offset 8
    memcpy(mem.long_to_ptr(mem.ptr_to_long(p) + 8), src, srclen)

    mem.set_uint32(ppos, 0, pos)
    mem.set_int(s, 8, consts.TOK_REGEXP)                      // token.val
    mem.set_long(s, 24, jstag.value_from_ptr(p))       // token.value
    mem.set_uint32(s, 16, re_flags)                    // token.u.regexp.re_flags
    mem.set_uint32(s, 20, end_pos)                     // token.u.regexp.re_end_pos
}

// C string / UTF-8 utilities — ported from cutils.c. These present
// the same bare C ABI symbols the engine links against (pstrcpy,
// __unicode_to_utf8, ...), so deleting cutils.c from the build and
// linking this module's --emit=lib object is a drop-in replacement.
//
// All buffer access goes through std.mem since a bare ptr cannot be
// indexed in Aether source. size_t out-params are plain ptr slots
// the caller owns (the C callers pass real &len), written via
// mem.set_long.

import std.mem

extern strlen(s: ptr) -> long
extern memcmp(a: ptr, b: ptr, n: long) -> int

exports (
    pstrcpy, pstrcat, strstart, has_suffix,
    __unicode_to_utf8, __unicode_from_utf8, __utf8_get
)

// void pstrcpy(char *buf, int buf_size, const char *str)
pstrcpy(buf: ptr, buf_size: int, str: ptr) {
    if buf_size <= 0 { return }
    int qi = 0
    int si = 0
    int limit = buf_size - 1
    while 1 == 1 {
        int c = mem.get_byte(str, si)
        si = si + 1
        if c == 0 { break }
        if qi >= limit { break }
        mem.set_byte(buf, qi, c)
        qi = qi + 1
    }
    mem.set_byte(buf, qi, 0)
}

// char *pstrcat(char *buf, int buf_size, const char *s)
pstrcat(buf: ptr, buf_size: int, s: ptr) -> ptr {
    int len = strlen(buf)
    if len < buf_size {
        pstrcpy(mem.long_to_ptr(mem.ptr_to_long(buf) + len), buf_size - len, s)
    }
    return buf
}

// int strstart(const char *str, const char *val, const char **ptr)
strstart(str: ptr, val: ptr, pptr: ptr) -> int {
    int pi = 0
    int qi = 0
    while 1 == 1 {
        int qc = mem.get_byte(val, qi)
        if qc == 0 { break }
        int pc = mem.get_byte(str, pi)
        if pc != qc { return 0 }
        pi = pi + 1
        qi = qi + 1
    }
    if pptr != null {
        mem.set_ptr(pptr, 0, mem.long_to_ptr(mem.ptr_to_long(str) + pi))
    }
    return 1
}

// int has_suffix(const char *str, const char *suffix)
has_suffix(str: ptr, suffix: ptr) -> int {
    int len = strlen(str)
    int slen = strlen(suffix)
    if len >= slen {
        tail = mem.long_to_ptr(mem.ptr_to_long(str) + (len - slen))
        if memcmp(tail, suffix, slen) == 0 { return 1 }
    }
    return 0
}

// size_t __unicode_to_utf8(uint8_t *buf, unsigned int c)
__unicode_to_utf8(buf: ptr, c: int) -> long {
    long cc = c & 0xffffffff
    int qi = 0
    if cc < 0x800 {
        mem.set_byte(buf, qi, ((cc >> 6) | 0xc0))
        qi = qi + 1
    } else {
        if cc < 0x10000 {
            mem.set_byte(buf, qi, ((cc >> 12) | 0xe0))
            qi = qi + 1
        } else {
            if cc < 0x00200000 {
                mem.set_byte(buf, qi, ((cc >> 18) | 0xf0))
                qi = qi + 1
            } else {
                return 0
            }
            mem.set_byte(buf, qi, (((cc >> 12) & 0x3f) | 0x80))
            qi = qi + 1
        }
        mem.set_byte(buf, qi, (((cc >> 6) & 0x3f) | 0x80))
        qi = qi + 1
    }
    mem.set_byte(buf, qi, ((cc & 0x3f) | 0x80))
    qi = qi + 1
    return qi
}

// int __unicode_from_utf8(const uint8_t *p, size_t max_len, size_t *plen)
__unicode_from_utf8(p: ptr, max_len: long, plen: ptr) -> int {
    long len = 1
    int c = mem.get_byte(p, 0)
    int is_fail = 0
    int result = 0
    if c < 0xc0 {
        is_fail = 1
    } else if c < 0xe0 {
        if max_len < 2 { is_fail = 1 }
        else if (mem.get_byte(p, 1) & 0xc0) != 0x80 { is_fail = 1 }
        else {
            c = ((mem.get_byte(p, 0) & 0x1f) << 6) | (mem.get_byte(p, 1) & 0x3f)
            len = 2
            if c < 0x80 { is_fail = 1 }
        }
    } else if c < 0xf0 {
        if max_len < 2 { is_fail = 1 }
        else if (mem.get_byte(p, 1) & 0xc0) != 0x80 { is_fail = 1 }
        else if max_len < 3 { len = 2  is_fail = 1 }
        else if (mem.get_byte(p, 2) & 0xc0) != 0x80 { len = 2  is_fail = 1 }
        else {
            c = ((mem.get_byte(p, 0) & 0x0f) << 12) | ((mem.get_byte(p, 1) & 0x3f) << 6) | (mem.get_byte(p, 2) & 0x3f)
            len = 3
            if c < 0x800 { is_fail = 1 }
        }
    } else if c < 0xf8 {
        if max_len < 2 { is_fail = 1 }
        else if (mem.get_byte(p, 1) & 0xc0) != 0x80 { is_fail = 1 }
        else if max_len < 3 { len = 2  is_fail = 1 }
        else if (mem.get_byte(p, 2) & 0xc0) != 0x80 { len = 2  is_fail = 1 }
        else if max_len < 4 { len = 3  is_fail = 1 }
        else if (mem.get_byte(p, 3) & 0xc0) != 0x80 { len = 3  is_fail = 1 }
        else {
            c = ((mem.get_byte(p, 0) & 0x07) << 18) | ((mem.get_byte(p, 1) & 0x3f) << 12) | ((mem.get_byte(p, 2) & 0x3f) << 6) | (mem.get_byte(p, 3) & 0x3f)
            len = 4
            // We explicitly accept surrogate pairs
            if c < 0x10000 { is_fail = 1 }
            else if c > 0x10ffff { is_fail = 1 }
        }
    } else {
        is_fail = 1
    }
    if is_fail != 0 {
        mem.set_long(plen, 0, len)
        return 0 - 1
    }
    mem.set_long(plen, 0, len)
    return c
}

// int __utf8_get(const uint8_t *p, size_t *plen)
__utf8_get(p: ptr, plen: ptr) -> int {
    long len = 1
    int c = mem.get_byte(p, 0)
    if c < 0xc0 {
        len = 1
    } else if c < 0xe0 {
        c = ((mem.get_byte(p, 0) & 0x1f) << 6) | (mem.get_byte(p, 1) & 0x3f)
        len = 2
    } else if c < 0xf0 {
        c = ((mem.get_byte(p, 0) & 0x0f) << 12) | ((mem.get_byte(p, 1) & 0x3f) << 6) | (mem.get_byte(p, 2) & 0x3f)
        len = 3
    } else if c < 0xf8 {
        c = ((mem.get_byte(p, 0) & 0x07) << 18) | ((mem.get_byte(p, 1) & 0x3f) << 12) | ((mem.get_byte(p, 2) & 0x3f) << 6) | (mem.get_byte(p, 3) & 0x3f)
        len = 4
    } else {
        len = 1
    }
    mem.set_long(plen, 0, len)
    return c
}

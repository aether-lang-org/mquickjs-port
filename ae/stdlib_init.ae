// stdlib_init ported from mquickjs.c: install the standard library on the
// global object. The ROM table is a flat (name, value) JSValueArray; each
// value is either a class descriptor (materialised via stdlib_init_class),
// JS_NULL (meaning the global object itself), or a plain value, and is
// defined as a global property. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern JS_IsObject(ctx: ptr, val: long) -> int
extern stdlib_init_class(ctx: ptr, class_def: ptr) -> long
extern JS_DefinePropertyInternal(ctx: ptr, obj: long, prop: long, val: long, getset: long, flags: int) -> long

exports (stdlib_init)

const JS_DEF_PROP_HAS_VALUE = 4
const VA_ARR = 8

si_va_size(arr: ptr) -> int { long h = mem.get_long(arr, 0)  long s = h >> 4  return s }

// void stdlib_init(JSContext *ctx, const JSValueArray *arr)
stdlib_init(ctx: ptr, arr: ptr) {
    long base = mem.ptr_to_long(arr) + VA_ARR
    int size = si_va_size(arr)
    long global_obj = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ)
    int i = 0
    while i < size {
        long name = mem.get_long(mem.long_to_ptr(base + i * 8), 0)
        long val = mem.get_long(mem.long_to_ptr(base + (i + 1) * 8), 0)
        if JS_IsObject(ctx, val) != 0 {
            val = stdlib_init_class(ctx, jstag.value_to_ptr(val))
        } else {
            if val == jstag.JS_NULL { val = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ) }
        }
        // re-read global_obj (DefineProperty may move nothing, but be safe)
        global_obj = mem.get_long(ctx, consts.JSCTX_GLOBAL_OBJ)
        JS_DefinePropertyInternal(ctx, global_obj, name, val, jstag.JS_NULL, JS_DEF_PROP_HAS_VALUE)
        i = i + 2
    }
}

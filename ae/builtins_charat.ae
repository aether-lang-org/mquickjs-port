// String.prototype char-access builtins ported from mquickjs.c:
// charAt / charCodeAt / codePointAt (one function, multiplexed by
// magic). Provides the bare C symbol js_string_charAt; C body removed.

import std.mem
import ae.jstag

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToStringCheckObject(ctx: ptr, val: long) -> long
extern JS_ToInt32Sat(ctx: ptr, pres: ptr, val: long) -> int
extern string_getcp(ctx: ptr, str: long, utf16_pos: int, is_codepoint: int) -> int
extern js_get_atom(ctx: ptr, a: int) -> long
extern JS_NewFloat64(ctx: ptr, d: float) -> long

exports (js_string_charAt)

const MAGIC_CHARAT = 1
const MAGIC_CHARCODEAT = 2
const MAGIC_CODEPOINTAT = 3
const JS_ATOM_empty = 97       // guarded in ae/layout_guard.c
const TAG_STRING_CHAR = 27
const NAN_BITS = 0x7ff8000000000000

// JS_NewStringChar(c) = JS_VALUE_MAKE_SPECIAL(JS_TAG_STRING_CHAR, c)
new_string_char(c: int) -> long {
    long lc = c & 0xffffffff
    return jstag.make_special(TAG_STRING_CHAR, lc)
}

// JSValue js_string_charAt(ctx, this_val, argc, argv, magic)
js_string_charAt(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long {
    long s = JS_ToStringCheckObject(ctx, mem.get_long(this_val, 0))
    mem.set_long(this_val, 0, s)
    if jstag.is_exception(s) != 0 { return jstag.JS_EXCEPTION }

    slot = malloc(8)
    if JS_ToInt32Sat(ctx, slot, mem.get_long(argv, 0)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int idx = mem.get_int(slot, 0)
    free(slot)

    int c = 0 - 1
    if idx >= 0 {
        int is_cp = 0
        if magic == MAGIC_CODEPOINTAT { is_cp = 1 }
        c = string_getcp(ctx, s, idx, is_cp)
    }

    if c == (0 - 1) {
        if magic == MAGIC_CHARCODEAT {
            return JS_NewFloat64(ctx, mem.float_from_bits(NAN_BITS))
        }
        if magic == MAGIC_CHARAT {
            return js_get_atom(ctx, JS_ATOM_empty)
        }
        return jstag.JS_UNDEFINED
    }
    if magic == MAGIC_CHARCODEAT { return jstag.new_short_int(c) }
    if magic == MAGIC_CODEPOINTAT { return jstag.new_short_int(c) }
    return new_string_char(c)
}

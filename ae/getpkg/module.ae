// getpkg — merged package (auto-assembled from 5 files).

import ae.consts
import ae.emit
import ae.jstag
import ae.mqtypes
import ae.opcodes
import std.mem

extern js_parse_escape(buf: ptr, plen: ptr) -> int
extern __unicode_from_utf8(p: ptr, max_len: long, plen: ptr) -> int
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_throw_prop_access_error(ctx: ptr, kind: int, prop: long) -> long
extern js_string_charAt(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long
extern JS_IsNumericProperty(ctx: ptr, val: long) -> int
extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern get_special_prop(ctx: ptr, val: long) -> long
extern JS_NewInt32(ctx: ptr, val: int) -> long
extern JS_NewUint32(ctx: ptr, val: int) -> long
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_Call(ctx: ptr, call_flags: int) -> long

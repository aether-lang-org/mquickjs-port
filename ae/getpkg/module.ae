exports (
    get_class_atom, get_lvalue, JS_GetPropertyInternal, get_string_ptr, get_var_ref
)

// ===== from get_class_atom.ae =====
// get_class_atom ported from mquickjs.c: read one atom of a regexp
// pattern (inside or outside a character class) from the source buffer,
// returning the code point — or a class-range marker (>= consts.CLASS_RANGE_BASE)
// for \d \D \s \S \w \W. Handles backslash escapes, \cX control chars and
// the unicode-mode validity rules. Provides the bare C symbol; C body
// removed.






// is_unicode = re_flags_bits bit 4
gca_is_unicode(s: ptr) -> int { return (mem.get_byte(s, consts.JSPS_RE_FLAGS_BITS) >> 4) & 1 }

// unicode_from_utf8(p): ASCII fast path, else __unicode_from_utf8. Writes
// the byte length to *plen and returns the code point (or -1).
gca_uc_from_utf8(p: long, plen: ptr) -> int {
    int b0 = mem.get_byte(mem.long_to_ptr(p), 0) & 0xff
    if b0 < 0x80 { mem.set_long(plen, 0, 1)  return b0 }
    return __unicode_from_utf8(mem.long_to_ptr(p), consts.UTF8_CHAR_LEN_MAX, plen)
}

is_az(c: int) -> int { if c >= 97 { if c <= 122 { return 1 } } return 0 }
is_AZ(c: int) -> int { if c >= 65 { if c <= 90 { return 1 } } return 0 }
is_09(c: int) -> int { if c >= 48 { if c <= 57 { return 1 } } return 0 }

// int get_class_atom(JSParseState *s, BOOL inclass)
get_class_atom(s: ptr, inclass: int) -> int {
    long source_buf = mem.ptr_to_long(mem.get_ptr(s, consts.JSPS_SOURCE_BUF))
    int buf_pos = mem.get_uint32(s, consts.JSPS_BUF_POS)
    long p = source_buf + buf_pos
    int c = mem.get_byte(mem.long_to_ptr(p), 0) & 0xff

    plen = malloc(8)

    if c == 92 {                                 // '\\'
        p = p + 1
        c = mem.get_byte(mem.long_to_ptr(p), 0) & 0xff
        p = p + 1
        if c == 100 { c = consts.CLASS_RANGE_BASE + 0 }            // d
        else { if c == 68 { c = consts.CLASS_RANGE_BASE + 1 }      // D
        else { if c == 115 { c = consts.CLASS_RANGE_BASE + 2 }     // s
        else { if c == 83 { c = consts.CLASS_RANGE_BASE + 3 }      // S
        else { if c == 119 { c = consts.CLASS_RANGE_BASE + 4 }     // w
        else { if c == 87 { c = consts.CLASS_RANGE_BASE + 5 }      // W
        else { if c == 99 {                                 // 'c' control char
            int c2 = mem.get_byte(mem.long_to_ptr(p), 0) & 0xff
            int allow = 0
            if is_az(c2) != 0 || is_AZ(c2) != 0 { allow = 1 }
            else { if (is_09(c2) != 0 || c2 == 95) && inclass != 0 && gca_is_unicode(s) == 0 { allow = 1 } }
            if allow != 0 {
                c = c2 & 0x1f
                p = p + 1
            } else { if gca_is_unicode(s) != 0 {
                mem.set_uint32(s, consts.JSPS_BUF_POS, p - source_buf)
                js_parse_error(s, "invalid escape sequence in regular expression")
            } else {
                p = p - 1
                c = 92                                       // '\\'
            } }
        } else { if c == 45 {                                // '-'
            if inclass == 0 && gca_is_unicode(s) != 0 {
                mem.set_uint32(s, consts.JSPS_BUF_POS, p - source_buf)
                js_parse_error(s, "invalid escape sequence in regular expression")
            }
        } else { if gca_is_special_escape(c) != 0 {
            // always valid to escape these (^ $ \ . * + ? ( ) [ ] { } | /)
        } else {
            // generic escape via js_parse_escape
            p = p - 1
            int ret = js_parse_escape(mem.long_to_ptr(p), plen)
            if ret < 0 {
                if gca_is_unicode(s) != 0 {
                    mem.set_uint32(s, consts.JSPS_BUF_POS, p - source_buf)
                    js_parse_error(s, "invalid escape sequence in regular expression")
                } else {
                    // normal_char path below; fall through by re-reading
                    free(plen)
                    return gca_normal_char(s, source_buf, p)
                }
            }
            p = p + mem.get_long(plen, 0)
            c = ret
        } } } } } } } } }
    } else { if c == 0 || c == 47 {              // '\0' or '/'
        if (p - source_buf) >= mem.get_uint32(s, consts.JSPS_BUF_LEN) {
            js_parse_error(s, "unexpected end")
        }
        free(plen)
        return gca_normal_char(s, source_buf, p)
    } else {
        free(plen)
        return gca_normal_char(s, source_buf, p)
    } }

    free(plen)
    mem.set_uint32(s, consts.JSPS_BUF_POS, p - source_buf)
    return c
}

gca_is_special_escape(c: int) -> int {
    if c == 94 { return 1 }    // ^
    if c == 36 { return 1 }    // $
    if c == 92 { return 1 }    // backslash
    if c == 46 { return 1 }    // .
    if c == 42 { return 1 }    // *
    if c == 43 { return 1 }    // +
    if c == 63 { return 1 }    // ?
    if c == 40 { return 1 }    // (
    if c == 41 { return 1 }    // )
    if c == 91 { return 1 }    // [
    if c == 93 { return 1 }    // ]
    if c == 123 { return 1 }   // {
    if c == 125 { return 1 }   // }
    if c == 124 { return 1 }   // |
    if c == 47 { return 1 }    // /
    return 0
}

// normal_char: decode one UTF-8 char at p, advance buf_pos, return code point
gca_normal_char(s: ptr, source_buf: long, p: long) -> int {
    plen = malloc(8)
    int ret = gca_uc_from_utf8(p, plen)
    if ret < 0 { js_parse_error(s, "malformed unicode char") }
    p = p + mem.get_long(plen, 0)
    free(plen)
    mem.set_uint32(s, consts.JSPS_BUF_POS, p - source_buf)
    return ret
}

// ===== from get_lvalue.ae =====
// get_lvalue ported from mquickjs.c: at an assignment target, inspect the
// just-emitted "get" opcode to classify the lvalue (local/arg/var-ref/
// field/length/array-el), extract its operand, remove that opcode, and —
// if keep is set — re-emit a variant that leaves the object/key on the
// stack for the subsequent store. Returns the resolved opcode, var index
// and source position via the out-params. Provides the bare C symbol.







// byte_code buffer base + last_opcode_pos + 1
glv_operand_addr(s: ptr) -> long {
    long bc = mem.get_long(s, consts.JSPS_BYTE_CODE)
    long base = mem.ptr_to_long(jstag.value_to_ptr(bc)) + consts.BA_BUF
    int pos = mem.get_int(s, consts.JSPS_LAST_OPCODE_POS)
    return base + pos + 1
}

// void get_lvalue(JSParseState *s, int *popcode, int *pvar_idx, JSSourcePos *psource_pos, BOOL keep)
get_lvalue(s: ptr, popcode: ptr, pvar_idx: ptr, psource_pos: ptr, keep: int) {
    int opcode = emit.get_prev_opcode(s)
    int var_idx = 0

    if opcode >= opcodes.OP_get_loc0 && opcode <= opcodes.OP_get_loc0 + 3 {
        var_idx = opcode - opcodes.OP_get_loc0
        opcode = opcodes.OP_get_loc
    } else { if opcode >= opcodes.OP_get_arg0 && opcode <= opcodes.OP_get_arg0 + 3 {
        var_idx = opcode - opcodes.OP_get_arg0
        opcode = opcodes.OP_get_arg
    } else { if opcode == opcodes.OP_get_loc8 {
        var_idx = mem.get_byte(mem.long_to_ptr(glv_operand_addr(s)), 0) & 0xff
        opcode = opcodes.OP_get_loc
    } else { if opcode == opcodes.OP_get_loc || opcode == opcodes.OP_get_arg || opcode == opcodes.OP_get_var_ref || opcode == opcodes.OP_get_field {
        var_idx = mem.get_uint16(mem.long_to_ptr(glv_operand_addr(s)), 0)
    } else { if opcode == opcodes.OP_get_array_el || opcode == opcodes.OP_get_length {
        var_idx = 0 - 1
    } else {
        js_parse_error(s, "invalid lvalue")
    } } } } }

    int source_pos = mem.get_uint32(s, consts.JSPS_PC2LINE_SOURCE_POS)

    emit.remove_last_op(s)

    if keep != 0 {
        if opcode == opcodes.OP_get_loc || opcode == opcodes.OP_get_arg || opcode == opcodes.OP_get_var_ref {
            emit.emit_var(s, opcode, var_idx, source_pos)
        } else { if opcode == opcodes.OP_get_field {
            emit.emit_op_pos(s, opcodes.OP_get_field2, source_pos)
            emit.emit_u16(s, var_idx)
        } else { if opcode == opcodes.OP_get_length {
            emit.emit_op_pos(s, opcodes.OP_get_length2, source_pos)
        } else { if opcode == opcodes.OP_get_array_el {
            emit.emit_op(s, opcodes.OP_dup2)
            emit.emit_op_pos(s, opcodes.OP_get_array_el, source_pos)
        } else { } } } }
    }

    mem.set_int(popcode, 0, opcode)
    mem.set_int(pvar_idx, 0, var_idx)
    mem.set_uint32(psource_pos, 0, source_pos)
}

// ===== from get_property_internal.ae =====
// JS_GetPropertyInternal ported from mquickjs.c: the core property read.
// Resolves the receiver to an object (or the appropriate primitive
// prototype), fast-paths array and typed-array element reads, then walks
// the prototype chain doing own-property lookups, handling normal /
// var-ref / special / getter property kinds (with optional tail call).
// The va_list-coupled TypeError messages are raised by the C shim
// js_throw_prop_access_error. Provides the bare C symbol; C body removed.









gpi_is_short_float(v: long) -> int { if (v & 7) == 5 { return 1 } return 0 }
gpi_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }
gpi_class_id(p: ptr) -> int { return (mem.get_long(p, 0) >> 4) & 0xff }
gpi_short_int(v: long) -> long { return v << 1 }
proto_ptr(ctx: ptr, class_id: int) -> ptr {
    long pv = mem.get_long(ctx, consts.JSCTX_CLASS_PROTO + class_id * 8)
    return jstag.value_to_ptr(pv)
}
prop_type_of(pr: ptr) -> int {
    return mqtypes.js_prop_type(pr)
}

// JSValue JS_GetPropertyInternal(JSContext *ctx, JSValue obj, JSValue prop, BOOL allow_tail_call)
JS_GetPropertyInternal(ctx: ptr, obj: long, prop: long, allow_tail_call: int) -> long {
    p = mem.long_to_ptr(0)
    int want_string_proto = 0

    if jstag.is_ptr(obj) == 0 {
        if jstag.is_int(obj) != 0 || gpi_is_short_float(obj) != 0 {
            p = proto_ptr(ctx, consts.JS_CLASS_NUMBER)
        } else {
            int tag = jstag.get_special_tag(obj)
            if tag == jstag.TAG_BOOL { p = proto_ptr(ctx, consts.JS_CLASS_BOOLEAN) }
            else { if tag == jstag.TAG_SHORT_FUNC { p = proto_ptr(ctx, consts.JS_CLASS_CLOSURE) }
            else { if tag == jstag.TAG_STRING_CHAR { want_string_proto = 1 }
            else { if tag == jstag.TAG_NULL { return js_throw_prop_access_error(ctx, 0, prop) }
            else { if tag == jstag.TAG_UNDEFINED { return js_throw_prop_access_error(ctx, 1, prop) }
            else { return js_throw_prop_access_error(ctx, 2, prop) } } } } }
        }
    } else {
        p = jstag.value_to_ptr(obj)
    }

    if want_string_proto == 0 && gpi_mtag(p) != consts.JS_MTAG_OBJECT {
        int mt = gpi_mtag(p)
        if mt == consts.JS_MTAG_FLOAT64 { p = proto_ptr(ctx, consts.JS_CLASS_NUMBER) }
        else { if mt == consts.JS_MTAG_STRING { want_string_proto = 1 }
        else { return js_throw_prop_access_error(ctx, 2, prop) } }
    }

    if want_string_proto != 0 {
        // string receiver: try indexed char access first
        if jstag.is_int(prop) != 0 {
            objslot = malloc(8)
            propslot = malloc(8)
            mem.set_long(objslot, 0, obj)
            mem.set_long(propslot, 0, prop)
            long ret = js_string_charAt(ctx, objslot, 1, propslot, 0)
            free(objslot)
            free(propslot)
            if jstag.is_undefined(ret) == 0 { return ret }
        }
        p = proto_ptr(ctx, consts.JS_CLASS_STRING)
    }

    // prototype-chain walk
    int searching = 1
    while searching != 0 {
        int cid = gpi_class_id(p)
        if cid == consts.JS_CLASS_ARRAY {
            if jstag.is_int(prop) != 0 {
                int idx = prop >> 1
                int alen = mem.get_uint32(p, consts.JSOBJ_ARRAY_LEN)
                if idx >= 0 && idx < alen {
                    long tab = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(p, consts.JSOBJ_ARRAY_TAB))) + consts.VA_ARR
                    return mem.get_long(mem.long_to_ptr(tab + idx * 8), 0)
                }
            } else {
                if JS_IsNumericProperty(ctx, prop) != 0 { return jstag.JS_UNDEFINED }
            }
        } else {
            if cid >= consts.JS_CLASS_UINT8C_ARRAY && cid <= consts.JS_CLASS_FLOAT64_ARRAY {
                if jstag.is_int(prop) != 0 {
                    int idx = prop >> 1
                    int talen = mem.get_uint32(p, consts.JSOBJ_TA_LEN)
                    if idx >= 0 && idx < talen {
                        int off = mem.get_uint32(p, consts.JSOBJ_TA_OFFSET)
                        idx = idx + off
                        pbuf = jstag.value_to_ptr(mem.get_long(p, consts.JSOBJ_TA_BUFFER))
                        arr = jstag.value_to_ptr(mem.get_long(pbuf, consts.JSOBJ_AB_BYTEBUF))
                        long b = mem.ptr_to_long(arr) + consts.BA_BUF
                        return ta_read(b, idx, cid, ctx)
                    }
                } else {
                    if JS_IsNumericProperty(ctx, prop) != 0 { return jstag.JS_UNDEFINED }
                }
            }
        }

        pr = find_own_property(ctx, p, prop)
        if pr != null {
            int pt = prop_type_of(pr)
            if pt == consts.JS_PROP_NORMAL {
                return mem.get_long(pr, consts.PROP_VALUE)
            }
            if pt == consts.JS_PROP_VARREF {
                pv = jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))
                return mem.get_long(pv, consts.VARREF_VALUE)   // always detached
            }
            if pt == consts.JS_PROP_SPECIAL {
                return get_special_prop(ctx, mem.get_long(pr, consts.PROP_VALUE))
            }
            // getter/setter: value is a 2-element JSValueArray [getter, setter]
            long gsarr = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))) + consts.VA_ARR
            long getter = mem.get_long(mem.long_to_ptr(gsarr), 0)
            if getter == jstag.JS_UNDEFINED { return jstag.JS_UNDEFINED }
            return invoke_getter(ctx, getter, obj, allow_tail_call)
        }

        // look in the prototype
        long proto = mem.get_long(p, consts.JSOBJ_PROTO)
        if proto == jstag.JS_NULL { searching = 0 }
        else { p = jstag.value_to_ptr(proto) }
    }
    return jstag.JS_UNDEFINED
}

// read a typed-array element at byte buffer base b, element index idx, class cid
ta_read(b: long, idx: int, cid: int, ctx: ptr) -> long {
    if cid == consts.JS_CLASS_UINT8C_ARRAY || cid == consts.JS_CLASS_UINT8_ARRAY {
        long v = mem.get_byte(mem.long_to_ptr(b + idx), 0) & 0xff
        return gpi_short_int(v)
    }
    if cid == consts.JS_CLASS_INT8_ARRAY {
        int v8 = mem.get_byte(mem.long_to_ptr(b + idx), 0)
        // sign-extend 8-bit
        int s = (v8 << 24) >> 24
        long sl = s
        return gpi_short_int(sl)
    }
    if cid == consts.JS_CLASS_INT16_ARRAY {
        int v = mem.get_int16(mem.long_to_ptr(b + idx * 2), 0)
        long sl = v
        return gpi_short_int(sl)
    }
    if cid == consts.JS_CLASS_UINT16_ARRAY {
        long v = mem.get_uint16(mem.long_to_ptr(b + idx * 2), 0) & 0xffff
        return gpi_short_int(v)
    }
    if cid == consts.JS_CLASS_INT32_ARRAY {
        int v = mem.get_int(mem.long_to_ptr(b + idx * 4), 0)
        return JS_NewInt32(ctx, v)
    }
    if cid == consts.JS_CLASS_UINT32_ARRAY {
        int v = mem.get_uint32(mem.long_to_ptr(b + idx * 4), 0)
        return JS_NewUint32(ctx, v)
    }
    if cid == consts.JS_CLASS_FLOAT32_ARRAY {
        float f = mem.get_float32(mem.long_to_ptr(b + idx * 4), 0)
        return JS_NewFloat64(ctx, f)
    }
    // FLOAT64
    float d = mem.get_float64(mem.long_to_ptr(b + idx * 8), 0)
    return JS_NewFloat64(ctx, d)
}

// invoke a getter (non-tail-call path); tail-call path adjusts the VM stack
invoke_getter(ctx: ptr, getter: long, obj: long, allow_tail_call: int) -> long {
    if allow_tail_call != 0 {
        // ctx->sp[-1] = ctx->sp[0]; ctx->sp[0] = getter; ctx->sp--
        long sp = mem.ptr_to_long(mem.get_ptr(ctx, 32))
        mem.set_long(mem.long_to_ptr(sp - 8), 0, mem.get_long(mem.long_to_ptr(sp), 0))
        mem.set_long(mem.long_to_ptr(sp), 0, getter)
        mem.set_ptr(ctx, 32, mem.long_to_ptr(sp - 8))
        return jstag.make_special(jstag.TAG_EXCEPTION, 1)   // JS_NewTailCall(0)=make_special(EXCEPTION,1+0)
    }
    // GC-root getter, obj across stack check
    ref = malloc(32)
    mem.set_long(ref, 0, getter)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, 80))
    mem.set_long(ref, 16, obj)
    mem.set_ptr(ref, 24, mem.long_to_ptr(mem.ptr_to_long(ref)))
    mem.set_ptr(ctx, 80, mem.long_to_ptr(mem.ptr_to_long(ref) + 16))
    int err = JS_StackCheck(ctx, 2)
    getter = mem.get_long(ref, 0)
    obj = mem.get_long(ref, 16)
    mem.set_ptr(ctx, 80, mem.get_ptr(ref, 8))
    free(ref)
    if err != 0 { return jstag.JS_EXCEPTION }
    JS_PushArg(ctx, getter)
    JS_PushArg(ctx, obj)
    return JS_Call(ctx, 0)
}

// ===== from get_string_ptr.ae =====
// get_string_ptr ported from mquickjs.c: resolve a string JSValue to a
// JSString*. A heap string returns its pointer directly; a STRING_CHAR
// special is materialised into the caller-provided scratch buffer (an
// 8-byte JSString header followed by up to 5 UTF-8 bytes). Provides the
// bare C symbol; C body removed.






// JSString *get_string_ptr(JSContext *ctx, JSStringCharBuf *buf, JSValue val)
get_string_ptr(ctx: ptr, buf: ptr, val: long) -> ptr {
    if jstag.get_special_tag(val) == jstag.TAG_STRING_CHAR {
        // Materialise into the scratch JSString: header @0, bytes @8.
        int is_ascii = 0
        if jstag.get_special_value(val) <= 0x7f { is_ascii = 1 }
        int len = get_short_string(mem.long_to_ptr(mem.ptr_to_long(buf) + consts.STR_BUF), val)
        // header: gc_mark 0, mtag=STRING (b1-3), is_unique 0 (b4),
        // is_ascii (b5), is_numeric 0 (b6), len (b7+)
        long ia = is_ascii
        long ll = len
        long mtag_bits = consts.JS_MTAG_STRING << 1
        long ascii_bits = ia << 5
        long len_bits = ll << 7
        long h = mtag_bits | ascii_bits
        h = h | len_bits
        mem.set_long(buf, 0, h)
        return buf
    }
    return jstag.value_to_ptr(val)
}

// ===== from get_var_ref.ae =====
// get_var_ref ported from mquickjs.c: find or create a JSVarRef for a
// captured variable slot. Searches the function's first-var-ref chain for
// one already pointing at *pval (u.pvalue), else allocates a fresh,
// non-detached JSVarRef and prepends it. Provides the bare C symbol; C
// body removed.





// JSVarRef (not detached): u.next @8, u.pvalue @16. is_detached = header bit 4.

// JSValue get_var_ref(JSContext *ctx, JSValue *pfirst_var_ref, JSValue *pval)
get_var_ref(ctx: ptr, pfirst_var_ref: ptr, pval: ptr) -> long {
    long pvall = mem.ptr_to_long(pval)
    long val = mem.get_long(pfirst_var_ref, 0)
    int searching = 1
    while searching != 0 {
        if val == jstag.JS_NULL { searching = 0 }
        else {
            p = jstag.value_to_ptr(val)
            // p->u.pvalue == pval ?
            if mem.get_long(p, consts.VR_PVALUE) == pvall { return val }
            val = mem.get_long(p, consts.VR_NEXT)   // p->u.next
        }
    }

    p = js_malloc(ctx, consts.SIZEOF_JSVARREF, consts.JS_MTAG_VARREF)
    if p == null { return jstag.JS_EXCEPTION }
    // is_detached = FALSE: js_malloc already wrote header = mtag<<1, so bit4=0.
    mem.set_long(p, consts.VR_PVALUE, pvall)                       // p->u.pvalue = pval
    mem.set_long(p, consts.VR_NEXT, mem.get_long(pfirst_var_ref, 0)) // p->u.next = *pfirst_var_ref
    val = jstag.value_from_ptr(p)
    mem.set_long(pfirst_var_ref, 0, val)                    // *pfirst_var_ref = val
    return val
}

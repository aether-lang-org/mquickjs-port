// Small string helpers ported from mquickjs.c: JS_NewString (strlen +
// JS_NewStringLen) and js_string_len (UTF-16 length of a string value,
// handling the inline single-char STRING_CHAR special). Provides the
// bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern strlen(s: ptr) -> long
extern JS_NewStringLen(ctx: ptr, buf: ptr, len: long) -> long
extern js_string_utf8_to_utf16_pos(ctx: ptr, obj: long, pos: int) -> int

exports (JS_NewString, js_string_len)

const TAG_STRING_CHAR = 27

// JSValue JS_NewString(JSContext *ctx, const char *buf)
JS_NewString(ctx: ptr, buf: ptr) -> long {
    return JS_NewStringLen(ctx, buf, strlen(buf))
}

// int js_string_len(JSContext *ctx, JSValue val)
js_string_len(ctx: ptr, val: long) -> int {
    if (val & 0x1f) == TAG_STRING_CHAR {
        if (val >> 5) >= 0x10000 { return 2 }
        return 1
    }
    p = jstag.value_to_ptr(val)
    int hdr0 = mem.get_byte(p, 0)
    int is_ascii = (hdr0 >> 5) & 1
    int slen = mem.get_long(p, 0) >> 7        // JSString.len (bits 7..63)
    if is_ascii != 0 { return slen }
    return js_string_utf8_to_utf16_pos(ctx, val, slen * 2)
}

// gc — merged package (auto-assembled from 4 files).

import ae.consts
import ae.jstag
import ae.mqtypes
import std.mem
import ae.props
import ae.ptrhelp

extern set_free_block(p: ptr, size: int)
extern vm_call_finalizer(fnptr: long, ctx: ptr, opaque: ptr)
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern memmove(dst: ptr, src: ptr, n: long) -> ptr

exports (
    gc_mark_all, gc_compact_heap, get_mblock_size, mtag_has_references, gc_thread_pointer, gc_update_threaded_pointers, gc_thread_block
)

// ===== from gc_mark.ae =====
// GC mark-and-sweep pass ported from mquickjs.c. gc_mark sets a block's
// mark bit and pushes its references onto a worklist that lives in the
// free space between heap_free and the value stack; gc_mark_flush drains
// the worklist, scanning each block's reference slots by class/mtag;
// gc_mark_all marks from all roots (stack, GC refs, class table, parser),
// then updates the weak unique-string table and position cache and sweeps
// the heap (running finalizers, merging free blocks). Provides the bare C
// symbols; C bodies removed.






// context offsets

// GCMarkState (malloc'd): ctx@0, gsp@8, gs_bottom@16, gs_top@24, overflow@32

// object union / struct field offsets
const USER_OPAQUE = 24
// string pos cache entry: str@0 (16 bytes each)

// header helpers
hdr_gc_mark(p: long) -> int { return mem.get_long(mem.long_to_ptr(p), 0) & 1 }
hdr_set_mark(p: long, v: int) {
    long h = mem.get_long(mem.long_to_ptr(p), 0)
    if v != 0 { mem.set_long(mem.long_to_ptr(p), 0, h | 1) }
    else { long mask = (0 - 1) ^ 1  mem.set_long(mem.long_to_ptr(p), 0, h & mask) }
}
hdr_mtag(p: long) -> int { return (mem.get_long(mem.long_to_ptr(p), 0) >> 1) & 7 }
hdr_class_id(p: long) -> int { return (mem.get_long(mem.long_to_ptr(p), 0) >> 4) & 0xff }
hdr_extra_size(p: long) -> int { return mem.get_long(mem.long_to_ptr(p), 0) >> 12 }
gm_va_size(p: long) -> int { return mem.get_long(mem.long_to_ptr(p), 0) >> 4 }

// JS_IS_ROM_PTR via unsigned bias
gm_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias  long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
gm_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if gm_ult(p, ctxl) != 0 { return 1 }
    if gm_ult(p, stop) == 0 { return 1 }
    return 0
}

// push a JSValue onto the worklist (gsp grows downward)
gm_push(s: ptr, v: long) {
    long gsp = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GSP)) - 8
    mem.set_long(mem.long_to_ptr(gsp), 0, v)
    mem.set_ptr(s, consts.MS_GSP, mem.long_to_ptr(gsp))
}
gm_avail(s: ptr) -> long {
    long gsp = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GSP))
    long bot = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GS_BOTTOM))
    return (gsp - bot) / 8
}

// gc_mark(s, val): set mark bit, push references
gc_mark(s: ptr, val: long) {
    if jstag.is_ptr(val) == 0 { return }
    long p = mem.ptr_to_long(jstag.value_to_ptr(val))
    ctx = mem.get_ptr(s, consts.MS_CTX)
    if gm_is_rom(ctx, p) != 0 { return }
    if hdr_gc_mark(p) != 0 { return }
    hdr_set_mark(p, 1)
    int mtag = hdr_mtag(p)
    if mtag_has_references(mtag) != 0 {
        if mtag == consts.JS_MTAG_VALUE_ARRAY {
            if gm_avail(s) < 2 { mem.set_int(s, consts.MS_OVERFLOW, 1) }
            else { gm_push(s, 0)  gm_push(s, val) }
        } else {
            if gm_avail(s) < 1 { mem.set_int(s, consts.MS_OVERFLOW, 1) }
            else { gm_push(s, val) }
        }
    }
}

// drain the worklist
gc_mark_flush(s: ptr) {
    int running = 1
    while running != 0 {
        long gsp = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GSP))
        long gstop = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GS_TOP))
        if gsp >= gstop { running = 0 }
        else {
            long val = mem.get_long(mem.long_to_ptr(gsp), 0)
            mem.set_ptr(s, consts.MS_GSP, mem.long_to_ptr(gsp + 8))   // gsp++
            long p = mem.ptr_to_long(jstag.value_to_ptr(val))
            int mtag = hdr_mtag(p)
            if mtag == consts.JS_MTAG_OBJECT { gm_scan_object(s, p) }
            else { if mtag == consts.JS_MTAG_VALUE_ARRAY { gm_scan_value_array(s, val, p) }
            else { if mtag == consts.JS_MTAG_VARREF { gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.VARREF_VALUE), 0)) }
            else { if mtag == consts.JS_MTAG_FUNCTION_BYTECODE { gm_scan_bytecode(s, p) }
            else { } } } }
        }
    }
}

gm_scan_object(s: ptr, p: long) {
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.JSOBJ_PROTO), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.JSOBJ_PROPS), 0))
    int cid = hdr_class_id(p)
    if cid == consts.JS_CLASS_CLOSURE {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.CLOS_FUNC_BYTECODE), 0))
        int n = hdr_extra_size(p) - 1
        int i = 0
        while i < n { gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.CLOS_VAR_REFS + i * 8), 0))  i = i + 1 }
    } else { if cid == consts.JS_CLASS_C_FUNCTION {
        if hdr_extra_size(p) > 1 { gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.CFUNC_PARAMS), 0)) }
    } else { if cid == consts.JS_CLASS_ARRAY {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.ARR_TAB), 0))
    } else { if cid == consts.JS_CLASS_ERROR {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.ERR_MESSAGE), 0))
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.ERR_STACK), 0))
    } else { if cid == consts.JS_CLASS_ARRAY_BUFFER {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.AB_BYTEBUF), 0))
    } else { if cid >= consts.JS_CLASS_UINT8C_ARRAY && cid <= consts.JS_CLASS_FLOAT64_ARRAY {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.TA_BUFFER), 0))
    } else { if cid == consts.JS_CLASS_REGEXP {
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.RE_SOURCE), 0))
        gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.RE_BYTE_CODE), 0))
    } else { } } } } } } }
}

gm_scan_value_array(s: ptr, val: long, p: long) {
    // pos was pushed just above val; pop it
    long gsp = mem.ptr_to_long(mem.get_ptr(s, consts.MS_GSP))
    int pos = mem.get_long(mem.long_to_ptr(gsp), 0)
    mem.set_ptr(s, consts.MS_GSP, mem.long_to_ptr(gsp + 8))
    int size = gm_va_size(p)
    long base = p + consts.VA_ARR
    // skip non-pointer slots
    int scanning = 1
    while scanning != 0 {
        if pos < size {
            long el = mem.get_long(mem.long_to_ptr(base + pos * 8), 0)
            if jstag.is_ptr(el) == 0 { pos = pos + 1 } else { scanning = 0 }
        } else { scanning = 0 }
    }
    if pos < size {
        if (pos + 1) < size {
            // re-enqueue (pos+1, val) so remaining elements are scanned
            gm_push(s, pos + 1)
            gm_push(s, val)
        }
        gc_mark(s, mem.get_long(mem.long_to_ptr(base + pos * 8), 0))
    }
}

gm_scan_bytecode(s: ptr, p: long) {
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_FUNC_NAME), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_BYTE_CODE), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_CPOOL), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_VARS), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_EXT_VARS), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_FILENAME), 0))
    gc_mark(s, mem.get_long(mem.long_to_ptr(p + consts.FB_PC2LINE), 0))
}

gc_mark_root(s: ptr, val: long) {
    gc_mark(s, val)
    gc_mark_flush(s)
}

gm_is_marked(val: long) -> int {
    if jstag.is_ptr(val) == 0 { return 0 }
    return hdr_gc_mark(mem.ptr_to_long(jstag.value_to_ptr(val)))
}

// void gc_mark_all(JSContext *ctx, BOOL keep_atoms)
gc_mark_all(ctx: ptr, keep_atoms: int) {
    s = malloc(40)
    mem.set_ptr(s, consts.MS_CTX, ctx)
    mem.set_int(s, consts.MS_OVERFLOW, 0)
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    mem.set_ptr(s, consts.MS_GS_TOP, mem.long_to_ptr(sp))
    mem.set_ptr(s, consts.MS_GSP, mem.long_to_ptr(sp))
    mem.set_ptr(s, consts.MS_GS_BOTTOM, mem.get_ptr(ctx, consts.JSCTX_HEAP_FREE))

    // keep RAM atoms if requested
    long atom_table = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_ATOM_TABLE))
    long heap_base = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_BASE))
    if atom_table == heap_base && keep_atoms != 0 {
        long bp = atom_table
        long endp = atom_table + consts.JS_ATOM_END * 8
        while bp < endp {
            gc_mark_root(s, jstag.value_from_ptr(mem.long_to_ptr(bp)))
            bp = bp + get_mblock_size(mem.long_to_ptr(bp))
        }
    }

    // class table: &current_exception .. class_proto + 2*class_count
    int class_count = mem.get_uint16(ctx, consts.JSCTX_CLASS_COUNT)
    long sp_end = mem.ptr_to_long(ctx) + consts.JSCTX_CLASS_PROTO + 2 * class_count * 8
    long spp = mem.ptr_to_long(ctx) + consts.JSCTX_CURRENT_EXCEPTION
    while spp < sp_end {
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(spp), 0))
        spp = spp + 8
    }

    // value stack: sp .. stack_top
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    spp = sp
    while spp < stop {
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(spp), 0))
        spp = spp + 8
    }

    // GC ref chains
    long ref = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    while ref != 0 {
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ref), 0))
        ref = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(ref), 8))
    }
    ref = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_LAST_GC_REF))
    while ref != 0 {
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ref), 0))
        ref = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(ref), 8))
    }

    // parser state: source_str@40, filename_str@48, token.value@24,
    // cur_func@72, byte_code@80
    long ps = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_PARSE_STATE))
    if ps != 0 {
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ps + 40), 0))
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ps + 48), 0))
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ps + 24), 0))
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ps + 72), 0))
        gc_mark_root(s, mem.get_long(mem.long_to_ptr(ps + 80), 0))
    }

    // overflow rescan
    int ov = mem.get_int(s, consts.MS_OVERFLOW)
    while ov != 0 {
        mem.set_int(s, consts.MS_OVERFLOW, 0)
        long bp = heap_base
        long hf = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_FREE))
        while bp < hf {
            int size = get_mblock_size(mem.long_to_ptr(bp))
            if hdr_gc_mark(bp) != 0 && mtag_has_references(hdr_mtag(bp)) != 0 {
                if hdr_mtag(bp) == consts.JS_MTAG_VALUE_ARRAY { gm_push(s, 0) }
                gm_push(s, jstag.value_from_ptr(mem.long_to_ptr(bp)))
                gc_mark_flush(s)
            }
            bp = bp + size
        }
        ov = mem.get_int(s, consts.MS_OVERFLOW)
    }

    gm_update_unique_strings(ctx)
    gm_update_pos_cache(ctx)
    gm_sweep(ctx)
    free(s)
}

gm_update_unique_strings(ctx: ptr) {
    long usv = mem.get_long(ctx, consts.JSCTX_UNIQUE_STRINGS)
    if jstag.is_null(usv) != 0 { return }
    arr = jstag.value_to_ptr(usv)
    long base = mem.ptr_to_long(arr) + consts.VA_ARR
    int size = gm_va_size(mem.ptr_to_long(arr))
    int i = 0
    int j = 0
    while i < size {
        long e = mem.get_long(mem.long_to_ptr(base + i * 8), 0)
        if gm_is_marked(e) != 0 {
            mem.set_long(mem.long_to_ptr(base + j * 8), 0, e)
            j = j + 1
        }
        i = i + 1
    }
    mem.set_int(ctx, consts.JSCTX_UNIQUE_STRINGS_LEN, j)
    if j > 0 {
        hdr_set_mark(mem.ptr_to_long(arr), 1)
        if j < size {
            set_free_block(mem.long_to_ptr(base + j * 8), (size - j) * 8)
            // arr->size = j: header = (hdr & 0xf) | (j << 4)
            long h = mem.get_long(arr, 0)
            long lo = h & 0xf
            long jl = j
            mem.set_long(arr, 0, lo | (jl << 4))
        }
    } else {
        hdr_set_mark(mem.ptr_to_long(arr), 0)
        mem.set_long(ctx, consts.JSCTX_UNIQUE_STRINGS, jstag.JS_NULL)
    }
}

gm_update_pos_cache(ctx: ptr) {
    int i = 0
    while i < consts.JS_STRING_POS_CACHE_SIZE {
        long ce = mem.ptr_to_long(ctx) + consts.JSCTX_STRING_POS_CACHE + i * 16
        long str = mem.get_long(mem.long_to_ptr(ce + consts.SPC_STR), 0)
        if gm_is_marked(str) == 0 { mem.set_long(mem.long_to_ptr(ce + consts.SPC_STR), 0, jstag.JS_NULL) }
        i = i + 1
    }
}

gm_sweep(ctx: ptr) {
    long bp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_BASE))
    long hf = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_FREE))
    long finalizer_table = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_C_FINALIZER_TABLE))
    while bp < hf {
        int size = get_mblock_size(mem.long_to_ptr(bp))
        if hdr_gc_mark(bp) != 0 {
            hdr_set_mark(bp, 0)
        } else {
            // unmarked: run user finalizer if applicable, then free + coalesce
            if hdr_mtag(bp) == consts.JS_MTAG_OBJECT {
                int cid = hdr_class_id(bp)
                if cid >= consts.JS_CLASS_USER {
                    long fn = mem.get_long(mem.long_to_ptr(finalizer_table + (cid - consts.JS_CLASS_USER) * 8), 0)
                    if fn != 0 {
                        opaque = mem.get_ptr(mem.long_to_ptr(bp + USER_OPAQUE), 0)
                        vm_call_finalizer(fn, ctx, opaque)
                    }
                }
            }
            // merge consecutive unmarked free blocks
            long bp1 = bp + size
            int running = 1
            while running != 0 {
                if bp1 < hf && hdr_gc_mark(bp1) == 0 { bp1 = bp1 + get_mblock_size(mem.long_to_ptr(bp1)) }
                else { running = 0 }
            }
            size = bp1 - bp
            set_free_block(mem.long_to_ptr(bp), size)
        }
        bp = bp + size
    }
}

// ===== from gc_compact.ae =====
// GC heap compaction (Jonkers threading algorithm) ported from mquickjs.c.
// gc_compact_heap threads every external and internal pointer, then makes
// two passes over the heap: pass 1 unthreads pointers to each block and
// re-threads the block's own pointers; pass 2 unthreads again and slides
// live blocks down to remove the gaps; finally it fixes the parser source
// pointer and rehashes object property tables. gc_thread_block threads a
// block's reference fields (via the already-ported gc_thread_pointer);
// gc_update_threaded_pointers walks a threaded chain and points it at the
// block's new address. Provides the bare C symbols; C bodies removed.








gco_mtag(bp: long) -> int { return (mem.get_long(mem.long_to_ptr(bp), 0) >> 1) & 7 }
gco_class_id(bp: long) -> int { return (mem.get_long(mem.long_to_ptr(bp), 0) >> 4) & 0xff }
gco_extra_size(bp: long) -> int { return mem.get_long(mem.long_to_ptr(bp), 0) >> 12 }
gco_va_size(bp: long) -> int { return mem.get_long(mem.long_to_ptr(bp), 0) >> 4 }

// thread one field at byte address fa: gc_thread_pointer(ctx, (JSValue*)fa)
tp(ctx: ptr, fa: long) { gc_thread_pointer(ctx, mem.long_to_ptr(fa)) }

// void gc_update_threaded_pointers(JSContext *ctx, void *ptr, void *new_ptr)
gc_update_threaded_pointers(ctx: ptr, bp: ptr, np: ptr) {
    long val = mem.get_long(bp, 0)             // *(JSValue*)ptr
    if jstag.is_ptr(val) == 0 { return }
    long newval = jstag.value_from_ptr(np)
    int walking = 1
    while walking != 0 {
        long pv = mem.ptr_to_long(jstag.value_to_ptr(val))   // js_value_to_pval
        val = mem.get_long(mem.long_to_ptr(pv), 0)           // val = *pv
        mem.set_long(mem.long_to_ptr(pv), 0, newval)         // *pv = new_ptr
        if jstag.is_ptr(val) == 0 { walking = 0 }
    }
    mem.set_long(bp, 0, val)                   // *(JSValue*)ptr = val
}

// void gc_thread_block(JSContext *ctx, void *ptr)
gc_thread_block(ctx: ptr, bp: ptr) {
    long b = mem.ptr_to_long(bp)
    int mtag = gco_mtag(b)
    if mtag == consts.JS_MTAG_OBJECT {
        tp(ctx, b + consts.JSOBJ_PROTO)
        tp(ctx, b + consts.JSOBJ_PROPS)
        int cid = gco_class_id(b)
        if cid == consts.JS_CLASS_CLOSURE {
            tp(ctx, b + consts.CLOS_FUNC_BYTECODE)
            int n = gco_extra_size(b) - 1
            int i = 0
            while i < n { tp(ctx, b + consts.CLOS_VAR_REFS + i * 8)  i = i + 1 }
        } else { if cid == consts.JS_CLASS_C_FUNCTION {
            if gco_extra_size(b) > 1 { tp(ctx, b + consts.CFUNC_PARAMS) }
        } else { if cid == consts.JS_CLASS_ARRAY {
            tp(ctx, b + consts.ARR_TAB)
        } else { if cid == consts.JS_CLASS_ERROR {
            tp(ctx, b + consts.ERR_MESSAGE)
            tp(ctx, b + consts.ERR_STACK)
        } else { if cid == consts.JS_CLASS_ARRAY_BUFFER {
            tp(ctx, b + consts.AB_BYTEBUF)
        } else { if cid >= consts.JS_CLASS_UINT8C_ARRAY && cid <= consts.JS_CLASS_FLOAT64_ARRAY {
            tp(ctx, b + consts.TA_BUFFER)
        } else { if cid == consts.JS_CLASS_REGEXP {
            tp(ctx, b + consts.RE_SOURCE)
            tp(ctx, b + consts.RE_BYTE_CODE)
        } else { } } } } } } }
    } else { if mtag == consts.JS_MTAG_VALUE_ARRAY {
        int size = gco_va_size(b)
        long base = b + consts.VA_ARR
        int i = 0
        while i < size { tp(ctx, base + i * 8)  i = i + 1 }
    } else { if mtag == consts.JS_MTAG_VARREF {
        tp(ctx, b + consts.VARREF_VALUE)
    } else { if mtag == consts.JS_MTAG_FUNCTION_BYTECODE {
        tp(ctx, b + consts.FB_FUNC_NAME)
        tp(ctx, b + consts.FB_BYTE_CODE)
        tp(ctx, b + consts.FB_CPOOL)
        tp(ctx, b + consts.FB_VARS)
        tp(ctx, b + consts.FB_EXT_VARS)
        tp(ctx, b + consts.FB_FILENAME)
        tp(ctx, b + consts.FB_PC2LINE)
    } else { } } } }
}

// void gc_compact_heap(JSContext *ctx)
gc_compact_heap(ctx: ptr) {
    long ctxl = mem.ptr_to_long(ctx)

    // thread external pointers: &unique_strings .. class_proto+2*class_count
    int class_count = mem.get_uint16(ctx, consts.JSCTX_CLASS_COUNT)
    long sp_end = ctxl + consts.JSCTX_CLASS_PROTO + 2 * class_count * 8
    long spp = ctxl + consts.JSCTX_UNIQUE_STRINGS
    while spp < sp_end { tp(ctx, spp)  spp = spp + 8 }

    // string pos cache .str fields
    int i = 0
    while i < consts.JS_STRING_POS_CACHE_SIZE { tp(ctx, ctxl + consts.JSCTX_STRING_POS_CACHE + i * 16)  i = i + 1 }

    // value stack
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    spp = sp
    while spp < stop { tp(ctx, spp)  spp = spp + 8 }

    // GC ref chains
    long ref = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    while ref != 0 { tp(ctx, ref)  ref = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(ref), 8)) }
    ref = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_LAST_GC_REF))
    while ref != 0 { tp(ctx, ref)  ref = mem.ptr_to_long(mem.get_ptr(mem.long_to_ptr(ref), 8)) }

    // parser
    long ps = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_PARSE_STATE))
    if ps != 0 {
        tp(ctx, ps + 40)   // source_str
        tp(ctx, ps + 48)   // filename_str
        tp(ctx, ps + 24)   // token.value
        tp(ctx, ps + 72)   // cur_func
        tp(ctx, ps + 80)   // byte_code
    }

    long heap_base = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_BASE))
    long heap_free = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_FREE))

    // pass 1: thread pointers + update previous
    long np = heap_base
    long bp = heap_base
    while bp < heap_free {
        gc_update_threaded_pointers(ctx, mem.long_to_ptr(bp), mem.long_to_ptr(np))
        int size = get_mblock_size(mem.long_to_ptr(bp))
        if gco_mtag(bp) != consts.JS_MTAG_FREE {
            gc_thread_block(ctx, mem.long_to_ptr(bp))
            np = np + size
        }
        bp = bp + size
    }

    // pass 2: update threaded pointers + move blocks
    np = heap_base
    bp = heap_base
    while bp < heap_free {
        gc_update_threaded_pointers(ctx, mem.long_to_ptr(bp), mem.long_to_ptr(np))
        int size = get_mblock_size(mem.long_to_ptr(bp))
        if gco_mtag(bp) != consts.JS_MTAG_FREE {
            if np != bp { memmove(mem.long_to_ptr(np), mem.long_to_ptr(bp), size) }
            np = np + size
        }
        bp = bp + size
    }
    mem.set_ptr(ctx, consts.JSCTX_HEAP_FREE, mem.long_to_ptr(np))

    // update parser source_buf
    if ps != 0 {
        long ss = mem.get_long(mem.long_to_ptr(ps + 40), 0)
        if jstag.is_ptr(ss) != 0 {
            sp_ptr = jstag.value_to_ptr(ss)
            mem.set_ptr(mem.long_to_ptr(ps + 56), 0, mem.long_to_ptr(mem.ptr_to_long(sp_ptr) + consts.STR_BUF))
        }
    }

    // rehash object properties
    long hf = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_HEAP_FREE))
    bp = heap_base
    while bp < hf {
        int size = get_mblock_size(mem.long_to_ptr(bp))
        if gco_mtag(bp) == consts.JS_MTAG_OBJECT {
            props.js_rehash_props(ctx, mem.long_to_ptr(bp), 1)
        }
        bp = bp + size
    }
}

// ===== from gc_size.ae =====
// GC memory-block sizing — get_mblock_size returns the byte size of
// any heap block from its mtag header and type-specific length field.
// Ported from mquickjs.c; exercises the mqtypes overlays directly.
// Provides the bare C symbols get_mblock_size and mtag_has_references.




// int get_mblock_size(const void *ptr)
get_mblock_size(p: ptr) -> int {
    int mtag = (p as *JSString).mtag
    int size = 0
    if mtag == consts.MTAG_OBJECT {
        // offsetof(JSObject,u) + extra_size * jstag.JSW
        long extra = (p as *JSObject).extra_size
        size = consts.OFFSETOF_JSOBJECT_U + extra * consts.JSWORD_SIZE
    } else if mtag == consts.MTAG_FLOAT64 {
        size = consts.SIZEOF_JSFLOAT64
    } else if mtag == consts.MTAG_STRING {
        // sizeof(JSString) + ((len + jstag.JSW) & ~(jstag.JSW-1))
        long len = (p as *JSString).len
        size = consts.SIZEOF_JSSTRING + ((len + consts.JSWORD_SIZE) & (0 - consts.JSWORD_SIZE))
    } else if mtag == consts.MTAG_BYTE_ARRAY {
        // sizeof(JSByteArray) + ((size + jstag.JSW-1) & ~(jstag.JSW-1))
        long bsz = (p as *JSByteArray).size
        size = consts.SIZEOF_JSBYTEARRAY + ((bsz + (consts.JSWORD_SIZE - 1)) & (0 - consts.JSWORD_SIZE))
    } else if mtag == consts.MTAG_VALUE_ARRAY {
        // sizeof(JSValueArray) + size * sizeof(JSValue)
        long vsz = (p as *JSValueArray).size
        size = consts.SIZEOF_JSVALUEARRAY + vsz * consts.JSWORD_SIZE
    } else if mtag == consts.MTAG_FREE {
        // sizeof(JSFreeBlock) + size * sizeof(JSWord); JSFreeBlock
        // stores its size in the same bitfield slot as JSByteArray.size
        long fsz = (p as *JSByteArray).size
        size = consts.SIZEOF_JSFREEBLOCK + fsz * consts.JSWORD_SIZE
    } else if mtag == consts.MTAG_VARREF {
        size = consts.SIZEOF_JSVARREF
        int detached = (p as *JSVarRef).is_detached
        if detached != 0 {
            size = size - consts.JSWORD_SIZE   // -= sizeof(JSValue)
        }
    } else if mtag == consts.MTAG_FUNCTION_BYTECODE {
        size = consts.SIZEOF_JSFUNCTIONBYTECODE
    } else {
        size = 0
    }
    return size
}

// BOOL mtag_has_references(int mtag)
mtag_has_references(mtag: int) -> int {
    if mtag == consts.MTAG_OBJECT { return 1 }
    if mtag == consts.MTAG_VALUE_ARRAY { return 1 }
    if mtag == consts.MTAG_VARREF { return 1 }
    if mtag == consts.MTAG_FUNCTION_BYTECODE { return 1 }
    return 0
}

// ===== from gc_thread_pointer.ae =====
// gc_thread_pointer ported from mquickjs.c: the pointer-threading step of
// the compacting GC. For a heap (non-ROM) pointer slot *pval, swap the
// slot's value with the target block's header and leave a threaded
// back-pointer (tagged pval) in the target so the block can later be
// relocated and all referrers fixed up. Provides the bare C symbol.





// JS_IS_ROM_PTR(ctx,ptr) = ptr < ctx || ptr >= ctx->stack_top, UNSIGNED.
// Aether longs are signed; bias by 2^63 for an unsigned compare.
gtp_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
gtp_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if gtp_ult(p, ctxl) != 0 { return 1 }
    if gtp_ult(p, stop) == 0 { return 1 }    // p >= stop
    return 0
}

// void gc_thread_pointer(JSContext *ctx, JSValue *pval)
gc_thread_pointer(ctx: ptr, pval: ptr) {
    long val = mem.get_long(pval, 0)            // *pval
    if jstag.is_ptr(val) == 0 { return }
    tgt = jstag.value_to_ptr(val)               // JS_VALUE_TO_PTR(val)
    if gtp_is_rom(ctx, mem.ptr_to_long(tgt)) != 0 { return }
    // *pval = *ptr ; *ptr = ptrhelp.js_value_from_pval(ctx, pval)
    mem.set_long(pval, 0, mem.get_long(tgt, 0))
    mem.set_long(tgt, 0, jstag.value_from_ptr(pval))
}

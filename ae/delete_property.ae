// JS_DeleteProperty ported from mquickjs.c: remove an own property from
// an object. Coerces the key, walks the hash chain to find the record,
// copies ROM props to RAM first if needed, unlinks the record, marks it
// uninitialised, rewinds the free-list, and compacts the array if it is
// now under half full. Always returns JS_TRUE (delete cannot fail here).
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern JS_ToPropertyKey(ctx: ptr, val: long) -> long
extern js_update_props(ctx: ptr, obj: long) -> int
extern get_first_free(arr: ptr) -> int
extern js_compact_props(ctx: ptr, p: ptr)
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (JS_DeleteProperty)

const JS_MTAG_OBJECT = 1
const JSOBJ_PROPS = 16
const VA_ARR = 8
// JSProperty: key@0, value@8, (hash_next:30|prop_type:2)@16
const PROP_KEY = 0
const PROP_VALUE = 8
const PROP_HASH_NEXT = 16

dp_short_int(v: long) -> long { return v << 1 }
dp_va_size(arr: long) -> int { long h = mem.get_long(mem.long_to_ptr(arr), 0)  long s = h >> 4  return s }
dp_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }
dp_hash(prop: long) -> long { long q = prop / 8  long r = prop % 8  return q ^ r }

dp_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
dp_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if dp_ult(p, ctxl) != 0 { return 1 }
    if dp_ult(p, stop) == 0 { return 1 }
    return 0
}

ag(base: long, i: long) -> long { return mem.get_long(mem.long_to_ptr(base + i * 8), 0) }
as_(base: long, i: long, v: long) { mem.set_long(mem.long_to_ptr(base + i * 8), 0, v) }
// JSProperty.hash_next (30 bits)
hn_get(pr: long) -> long { int w = mem.get_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0)  return (w & 0xffffffff) & 0x3fffffff }
hn_set(pr: long, hn: long) {
    int oldw = mem.get_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0)
    long ptype = (oldw & 0xffffffff) & 0xc0000000
    long w = (hn & 0x3fffffff) | ptype
    mem.set_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0, w)
}

// JSValue JS_DeleteProperty(JSContext *ctx, JSValue this_obj, JSValue prop)
JS_DeleteProperty(ctx: ptr, this_obj: long, prop: long) -> long {
    // GC-root this_obj across JS_ToPropertyKey
    ref = malloc(16)
    mem.set_long(ref, 0, this_obj)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    prop = JS_ToPropertyKey(ctx, prop)
    this_obj = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if jstag.is_exception(prop) != 0 { return prop }

    if jstag.is_ptr(this_obj) == 0 { return jstag.JS_TRUE }
    p = jstag.value_to_ptr(this_obj)
    if dp_mtag(p) != JS_MTAG_OBJECT { return jstag.JS_TRUE }

    long arrv = mem.get_long(p, JSOBJ_PROPS)
    long base = mem.ptr_to_long(jstag.value_to_ptr(arrv)) + VA_ARR
    int hash_mask = ag(base, 1) >> 1
    long h = dp_hash(prop) & hash_mask
    int idx = ag(base, 2 + h) >> 1            // JS_VALUE_GET_INT
    int last_idx = 0 - 1

    int searching = 1
    while searching != 0 {
        if idx == 0 { searching = 0 }
        else {
            long pr = base + idx * 8
            if mem.get_long(mem.long_to_ptr(pr + PROP_KEY), 0) == prop {
                // found
                if dp_is_rom(ctx, mem.ptr_to_long(jstag.value_to_ptr(arrv))) != 0 {
                    ref2 = malloc(16)
                    mem.set_long(ref2, 0, this_obj)
                    mem.set_ptr(ref2, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref2)
                    int ret = js_update_props(ctx, this_obj)
                    this_obj = mem.get_long(ref2, 0)
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref2, 8))
                    free(ref2)
                    if ret != 0 { return jstag.JS_EXCEPTION }
                    p = jstag.value_to_ptr(this_obj)
                    arrv = mem.get_long(p, JSOBJ_PROPS)
                    base = mem.ptr_to_long(jstag.value_to_ptr(arrv)) + VA_ARR
                    pr = base + idx * 8
                }
                // unlink from the hash chain
                long prhn = hn_get(pr)
                if last_idx >= 0 {
                    long lpr = base + last_idx * 8
                    hn_set(lpr, prhn)
                } else {
                    // arr[2+h] = pr->hash_next (a raw value): store as a
                    // short int holding the same 2*idx chain value.
                    as_(base, 2 + h, prhn)
                }
                int first_free = get_first_free(jstag.value_to_ptr(arrv))
                int prop_count = ag(base, 0) >> 1
                long pcm1 = prop_count - 1
                as_(base, 0, dp_short_int(pcm1))
                // pr->prop_type = NORMAL (clear bits 30-31); key/value reset
                int wn = mem.get_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0)
                long cleared = (wn & 0xffffffff) & 0x3fffffff
                mem.set_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0, cleared)
                mem.set_long(mem.long_to_ptr(pr + PROP_KEY), 0, jstag.JS_UNINITIALIZED)
                mem.set_long(mem.long_to_ptr(pr + PROP_VALUE), 0, jstag.JS_UNDEFINED)

                // rewind first_free over trailing deleted records
                int rewinding = 1
                while rewinding != 0 {
                    if first_free > 2 + hash_mask + 1 {
                        long pr1 = base + (first_free - 3) * 8
                        if mem.get_long(mem.long_to_ptr(pr1 + PROP_KEY), 0) != jstag.JS_UNINITIALIZED {
                            rewinding = 0
                        } else {
                            first_free = first_free - 3
                        }
                    } else { rewinding = 0 }
                }

                int size = dp_va_size(mem.ptr_to_long(jstag.value_to_ptr(arrv)))
                if first_free < size {
                    long lastpr = base + (size - 3) * 8
                    long ffl = first_free
                    hn_set(lastpr, ffl << 1)
                }

                // compact if now under half full
                if (2 + hash_mask + 1 + 3 * prop_count) < size / 2 {
                    js_compact_props(ctx, p)
                }
                return jstag.JS_TRUE
            }
            last_idx = idx
            idx = hn_get(pr) >> 1
        }
    }
    return jstag.JS_TRUE
}

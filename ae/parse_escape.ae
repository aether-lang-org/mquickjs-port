// js_parse_escape — decode a JS string escape sequence (the char(s)
// after a backslash), ported from mquickjs.c. Returns the codepoint,
// -1 on a malformed \x/\u/\0, or -2 on an unknown escape; writes the
// consumed length to *plen. Self-contained over a raw buffer.

import std.mem

exports (js_parse_escape)

// from_hex(c): hex digit value, or -1.
from_hex_(c: int) -> int {
    if c >= 0x30 {
        if c <= 0x39 { return c - 0x30 }       // 0-9
    }
    if c >= 0x61 {
        if c <= 0x66 { return c - 0x61 + 10 }   // a-f
    }
    if c >= 0x41 {
        if c <= 0x46 { return c - 0x41 + 10 }   // A-F
    }
    return 0 - 1
}

is_num_(c: int) -> int {
    if c >= 0x30 {
        if c <= 0x39 { return 1 }
    }
    return 0
}

// int js_parse_escape(const uint8_t *buf, size_t *plen)
js_parse_escape(buf: ptr, plen: ptr) -> int {
    int i = 0
    int c = mem.get_byte(buf, i)
    i = i + 1

    if c == 0x62 { c = 8 }          // \b
    else if c == 0x66 { c = 12 }    // \f
    else if c == 0x6e { c = 10 }    // \n
    else if c == 0x72 { c = 13 }    // \r
    else if c == 0x74 { c = 9 }     // \t
    else if c == 0x76 { c = 11 }    // \v
    else if c == 0x27 { c = c }     // \'
    else if c == 0x22 { c = c }     // \"
    else if c == 0x5c { c = c }     // backslash
    else if c == 0x78 {             // \xHH
        int h0 = from_hex_(mem.get_byte(buf, i))
        i = i + 1
        if h0 < 0 { return 0 - 1 }
        int h1 = from_hex_(mem.get_byte(buf, i))
        i = i + 1
        if h1 < 0 { return 0 - 1 }
        c = (h0 << 4) | h1
    } else if c == 0x75 {           // \uHHHH or \u{...}
        if mem.get_byte(buf, i) == 0x7b {   // '{'
            i = i + 1
            c = 0
            int loop = 1
            while loop != 0 {
                int h = from_hex_(mem.get_byte(buf, i))
                i = i + 1
                if h < 0 { return 0 - 1 }
                c = (c << 4) | h
                if c > 0x10FFFF { return 0 - 1 }
                if mem.get_byte(buf, i) == 0x7d { loop = 0 }   // '}'
            }
            i = i + 1
        } else {
            c = 0
            int k = 0
            while k < 4 {
                int h = from_hex_(mem.get_byte(buf, i))
                i = i + 1
                if h < 0 { return 0 - 1 }
                c = (c << 4) | h
                k = k + 1
            }
        }
    } else if c == 0x30 {           // \0
        c = c - 0x30
        if c != 0 { return 0 - 1 }
        if is_num_(mem.get_byte(buf, i)) != 0 { return 0 - 1 }
    } else {
        return 0 - 2
    }
    mem.set_long(plen, 0, i)
    return c
}

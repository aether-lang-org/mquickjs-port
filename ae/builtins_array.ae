// Array accessor builtins ported from mquickjs.c: js_get_array (fetch
// an Array object) and the length getter/setter. The JSArrayData union
// (tab@0, len@8) sits at JSObject offset 24. Provides the bare C
// symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.jshelpers   // js_reverse_val
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_get_object_class(ctx: ptr, val: long, class_id: int) -> ptr
extern JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int
extern js_array_resize(ctx: ptr, this_val: ptr, new_len: int) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern js_resize_value_array(ctx: ptr, val: long, new_size: int) -> long
extern memmove(dst: ptr, src: ptr, n: long) -> ptr
extern JS_ToInt32Clamp(ctx: ptr, pres: ptr, val: long, mn: int, mx: int, min_offset: int) -> int
extern js_strict_eq(ctx: ptr, op1: long, op2: long) -> int
extern js_array_join(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long
extern JS_NewArray(ctx: ptr, initial_len: int) -> long
extern JS_IsNumber(ctx: ptr, val: long) -> int

exports (js_get_array, js_array_get_length, js_array_set_length, js_array_pop, js_array_push, js_array_shift, js_array_reverse, js_array_indexOf, js_array_toString, js_array_slice, js_array_constructor, js_array_concat, js_array_splice)


argv_get(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// JSObject *js_get_array(JSContext *ctx, JSValue obj)
js_get_array(ctx: ptr, obj: long) -> ptr {
    p = js_get_object_class(ctx, obj, consts.JS_CLASS_ARRAY)
    if p == null {
        JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not an array")
        return null
    }
    return p
}

// array length lives in JSArrayData.len at union offset +8.
array_len_of(p: ptr) -> int {
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    return mem.get_uint32(mem.long_to_ptr(u), 8)
}

array_tab_of(p: ptr) -> long {
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    return mem.get_long(mem.long_to_ptr(u), 0)
}

// JSValue js_array_get_length(ctx, this_val, argc, argv)
js_array_get_length(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    return jstag.new_short_int(array_len_of(p))
}

// JSValue js_array_set_length(ctx, this_val, argc, argv)
js_array_set_length(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if js_get_array(ctx, tv) == null { return jstag.JS_EXCEPTION }
    slot = malloc(8)
    if JS_ToInt32(ctx, slot, argv_get(argv, 0)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int new_len = mem.get_int(slot, 0)
    free(slot)
    if js_array_resize(ctx, this_val, new_len) != 0 { return jstag.JS_EXCEPTION }
    return jstag.JS_UNDEFINED
}

// JSValue js_array_pop(ctx, this_val, argc, argv)
js_array_pop(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int len = mem.get_uint32(up, 8)   // array.len
    if len > 0 {
        long tab = mem.get_long(up, 0)         // array.tab (JSValueArray)
        arr = jstag.value_to_ptr(tab)
        int new_len = len - 1
        mem.set_uint32(up, 8, new_len)         // --array.len
        // arr->arr[new_len]: JSValueArray tail at offset 8
        return mem.get_long(arr, 8 + new_len * 8)
    }
    return jstag.JS_UNDEFINED
}

// JSValue js_array_push(ctx, this_val, argc, argv, is_unshift)
js_array_push(ctx: ptr, this_val: ptr, argc: int, argv: ptr, is_unshift: int) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int from = mem.get_uint32(up, 8)        // array.len
    int new_len = from + argc
    if new_len > consts.JS_SHORTINT_MAX {
        return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length")
    }
    long old_tab = mem.get_long(up, 0)      // array.tab
    long new_tab = js_resize_value_array(ctx, old_tab, new_len)
    if jstag.is_exception(new_tab) != 0 { return jstag.JS_EXCEPTION }

    // re-fetch p (resize may have moved memory)
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    mem.set_long(up, 0, new_tab)
    mem.set_uint32(up, 8, new_len)
    arr = jstag.value_to_ptr(new_tab)
    // arr->arr tail at offset 8
    int base = from
    if is_unshift != 0 {
        if argc > 0 {
            // memmove(arr+argc, arr, from*8)
            dst = mem.long_to_ptr(mem.ptr_to_long(arr) + 8 + argc * 8)
            src = mem.long_to_ptr(mem.ptr_to_long(arr) + 8)
            memmove(dst, src, from * 8)
            base = 0
        }
    }
    int i = 0
    while i < argc {
        long v = mem.get_long(argv, i * 8)
        mem.set_long(arr, 8 + (base + i) * 8, v)
        i = i + 1
    }
    return jstag.new_short_int(new_len)
}

// JSValue js_array_shift(ctx, this_val, argc, argv)
js_array_shift(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int len = mem.get_uint32(up, 8)
    if len > 0 {
        long tab = mem.get_long(up, 0)
        arr = jstag.value_to_ptr(tab)
        long ret = mem.get_long(arr, 8)            // arr->arr[0]
        int new_len = len - 1
        mem.set_uint32(up, 8, new_len)
        // memmove(arr->arr, arr->arr+1, new_len*8)
        dst = mem.long_to_ptr(mem.ptr_to_long(arr) + 8)
        src = mem.long_to_ptr(mem.ptr_to_long(arr) + 8 + 8)
        memmove(dst, src, new_len * 8)
        return ret
    }
    return jstag.JS_UNDEFINED
}

// JSValue js_array_reverse(ctx, this_val, argc, argv)
js_array_reverse(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int len = mem.get_uint32(up, 8)
    long tab = mem.get_long(up, 0)
    arr = jstag.value_to_ptr(tab)
    // js_reverse_val(arr->arr, len): tail at offset 8
    tail = mem.long_to_ptr(mem.ptr_to_long(arr) + 8)
    jshelpers.js_reverse_val(tail, len)
    return tv
}

// JSValue js_array_indexOf(ctx, this_val, argc, argv, is_lastIndexOf)
js_array_indexOf(ctx: ptr, this_val: ptr, argc: int, argv: ptr, is_lastIndexOf: int) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int len = mem.get_uint32(up, 8)
    int n = 0
    if is_lastIndexOf != 0 { n = len - 1 }
    if argc > 1 {
        slot = malloc(8)
        if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 8), 0 - is_lastIndexOf, len - is_lastIndexOf, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        n = mem.get_int(slot, 0)
        free(slot)
    }
    // re-fetch (array may have been modified by coercion)
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    len = mem.get_uint32(up, 8)
    arr = jstag.value_to_ptr(mem.get_long(up, 0))
    tail = mem.ptr_to_long(arr) + 8
    long target = mem.get_long(argv, 0)
    int res = 0 - 1
    if is_lastIndexOf != 0 {
        if n > (len - 1) { n = len - 1 }
        while n >= 0 {
            long el = mem.get_long(mem.long_to_ptr(tail + n * 8), 0)
            if js_strict_eq(ctx, target, el) != 0 { res = n  n = 0 - 1 }
            else { n = n - 1 }
        }
    } else {
        while n < len {
            long el = mem.get_long(mem.long_to_ptr(tail + n * 8), 0)
            if js_strict_eq(ctx, target, el) != 0 { res = n  n = len }
            else { n = n + 1 }
        }
    }
    return jstag.new_short_int(res)
}

// JSValue js_array_toString(ctx, this_val, argc, argv) -> join(this,0,null)
js_array_toString(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    return js_array_join(ctx, this_val, 0, null)
}

// JSValue js_array_slice(ctx, this_val, argc, argv)
js_array_slice(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    int len = mem.get_uint32(up, 8)

    slot = malloc(8)
    if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 0), 0, len, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int start = mem.get_int(slot, 0)
    int final = len
    long a1 = mem.get_long(argv, 8)
    if jstag.is_undefined(a1) == 0 {
        if JS_ToInt32Clamp(ctx, slot, a1, 0, len, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        final = mem.get_int(slot, 0)
    }
    free(slot)

    // re-fetch (array may have changed during coercion)
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    len = mem.get_uint32(up, 8)
    if final > len { final = len }

    int count = final - start
    if count < 0 { count = 0 }
    long obj = JS_NewArray(ctx, count)
    if jstag.is_exception(obj) != 0 { return jstag.JS_EXCEPTION }

    // re-fetch source again (JS_NewArray may have moved memory)
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    arr = jstag.value_to_ptr(mem.get_long(up, 0))
    src_tail = mem.ptr_to_long(arr) + 8

    p1 = jstag.value_to_ptr(obj)
    up1 = mem.long_to_ptr(mem.ptr_to_long(p1) + consts.OFFSETOF_JSOBJECT_U)
    arr1 = jstag.value_to_ptr(mem.get_long(up1, 0))
    dst_tail = mem.ptr_to_long(arr1) + 8

    int k = start
    while k < final {
        long el = mem.get_long(mem.long_to_ptr(src_tail + k * 8), 0)
        mem.set_long(mem.long_to_ptr(dst_tail + (k - start) * 8), 0, el)
        k = k + 1
    }
    return obj
}

// JSValue js_array_constructor(ctx, this_val, argc, argv)
js_array_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int a = argc & (0 - 1 - consts.FRAME_CF_CTOR)   // argc &= ~consts.FRAME_CF_CTOR
    int len = 0
    int has_init = 0
    if a == 1 {
        if JS_IsNumber(ctx, mem.get_long(argv, 0)) != 0 {
            slot = malloc(8)
            if JS_ToInt32(ctx, slot, mem.get_long(argv, 0)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
            len = mem.get_int(slot, 0)
            free(slot)
        } else { len = a  has_init = 1 }
    } else { len = a  has_init = 1 }

    if len < 0 { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR_C, "invalid array length") }
    if len > consts.JS_SHORTINT_MAX { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR_C, "invalid array length") }
    long obj = JS_NewArray(ctx, len)
    if jstag.is_exception(obj) != 0 { return obj }
    p = jstag.value_to_ptr(obj)
    up = mem.long_to_ptr(mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U)
    mem.set_uint32(up, 8, len)
    if has_init != 0 {
        arr = jstag.value_to_ptr(mem.get_long(up, 0))
        long tail = mem.ptr_to_long(arr) + 8
        int i = 0
        while i < a {
            mem.set_long(mem.long_to_ptr(tail + i * 8), 0, mem.get_long(argv, i * 8))
            i = i + 1
        }
    }
    return obj
}

// element count of an Array object (or -1 if not an Array)
arr_len_or_neg(ctx: ptr, val: long) -> int {
    p = js_get_object_class(ctx, val, consts.JS_CLASS_ARRAY)
    if p == null { return 0 - 1 }
    long u = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    return mem.get_uint32(mem.long_to_ptr(u), 8)
}

// JSValue js_array_concat(ctx, this_val, argc, argv)
js_array_concat(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    long len64 = array_len_of(p)
    int i = 0
    while i < argc {
        int al = arr_len_or_neg(ctx, mem.get_long(argv, i * 8))
        if al >= 0 { len64 = len64 + al } else { len64 = len64 + 1 }
        i = i + 1
    }
    if len64 > consts.JS_SHORTINT_MAX { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "Array too long") }
    int len = len64
    long obj = JS_NewArray(ctx, len)
    if jstag.is_exception(obj) != 0 { return obj }
    pobj = jstag.value_to_ptr(obj)
    long uo = mem.ptr_to_long(pobj) + consts.OFFSETOF_JSOBJECT_U
    arr = jstag.value_to_ptr(mem.get_long(mem.long_to_ptr(uo), 0))
    long dst_tail = mem.ptr_to_long(arr) + 8

    int pos = 0
    int k = 0 - 1
    while k < argc {
        long val = mem.get_long(this_val, 0)
        if k != (0 - 1) { val = mem.get_long(argv, k * 8) }
        src_p = js_get_object_class(ctx, val, consts.JS_CLASS_ARRAY)
        if src_p != null {
            long us = mem.ptr_to_long(src_p) + consts.OFFSETOF_JSOBJECT_U
            int slen = mem.get_uint32(mem.long_to_ptr(us), 8)
            arr1 = jstag.value_to_ptr(mem.get_long(mem.long_to_ptr(us), 0))
            long src_tail = mem.ptr_to_long(arr1) + 8
            int j = 0
            while j < slen {
                long el = mem.get_long(mem.long_to_ptr(src_tail + j * 8), 0)
                mem.set_long(mem.long_to_ptr(dst_tail + (pos + j) * 8), 0, el)
                j = j + 1
            }
            pos = pos + slen
        } else {
            mem.set_long(mem.long_to_ptr(dst_tail + pos * 8), 0, val)
            pos = pos + 1
        }
        k = k + 1
    }
    return obj
}

// GC-root helpers (see builtins_iter)
spl_ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
spl_ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
spl_gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, consts.GCREF_PREV, spl_ctx_top(ctx))
    spl_ctx_set_top(ctx, ref)
    mem.set_long(ref, consts.GCREF_VAL, v)
}
spl_gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, consts.GCREF_VAL)
    spl_ctx_set_top(ctx, mem.get_ptr(ref, consts.GCREF_PREV))
    return v
}

// JSValue js_array_splice(ctx, this_val, argc, argv)
js_array_splice(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int len = array_len_of(p)

    slot = malloc(8)
    if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 0), 0, len, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int start = mem.get_int(slot, 0)

    int item_count = 0
    int del_count = 0
    if argc == 0 {
        item_count = 0  del_count = 0
    } else if argc == 1 {
        item_count = 0  del_count = len - start
    } else {
        item_count = argc - 2
        if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 8), 0, len - start, 0) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        del_count = mem.get_int(slot, 0)
    }
    free(slot)
    int new_len = len + item_count - del_count

    long obj = JS_NewArray(ctx, del_count)
    if jstag.is_exception(obj) != 0 { return obj }
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    if array_len_of(p) != len {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "array length was modified")
    }
    arr = jstag.value_to_ptr(array_tab_of(p))
    long src_tail = mem.ptr_to_long(arr) + 8
    p1 = jstag.value_to_ptr(obj)
    arr1 = jstag.value_to_ptr(array_tab_of(p1))
    long del_tail = mem.ptr_to_long(arr1) + 8

    int i = 0
    while i < del_count {
        long el = mem.get_long(mem.long_to_ptr(src_tail + (start + i) * 8), 0)
        mem.set_long(mem.long_to_ptr(del_tail + i * 8), 0, el)
        i = i + 1
    }

    int err = 0
    if item_count != del_count {
        if del_count > item_count {
            // memmove down before shrink
            dst = mem.long_to_ptr(src_tail + (start + item_count) * 8)
            srcp = mem.long_to_ptr(src_tail + (start + del_count) * 8)
            memmove(dst, srcp, (len - (start + del_count)) * 8)
        }
        obj_ref = malloc(16)
        spl_gc_push(ctx, obj_ref, obj)
        int rc = js_array_resize(ctx, this_val, new_len)
        obj = spl_gc_pop(ctx, obj_ref)
        free(obj_ref)
        if rc != 0 { err = 1 }
        else {
            p = jstag.value_to_ptr(mem.get_long(this_val, 0))
            arr = jstag.value_to_ptr(array_tab_of(p))
            src_tail = mem.ptr_to_long(arr) + 8
            if del_count < item_count {
                // memmove up after grow
                dst = mem.long_to_ptr(src_tail + (start + item_count) * 8)
                srcp = mem.long_to_ptr(src_tail + (start + del_count) * 8)
                memmove(dst, srcp, (len - (start + del_count)) * 8)
            }
        }
    }
    if err != 0 { return jstag.JS_EXCEPTION }

    int k = 0
    while k < item_count {
        mem.set_long(mem.long_to_ptr(src_tail + (start + k) * 8), 0, mem.get_long(argv, (2 + k) * 8))
        k = k + 1
    }
    return obj
}

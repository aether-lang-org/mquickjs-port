// js_alloc_string ported from mquickjs.c: allocate an uninitialised
// JSString of buf_len bytes (plus the trailing NUL), with is_unique/
// is_ascii/is_numeric cleared and len set. Provides the bare C symbol.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_malloc(ctx: ptr, size: int, mtag: int) -> ptr
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (js_alloc_string)

const JS_STRING_LEN_MAX = 0x7ffffffe
const STR_BUF = 8

// JSString *js_alloc_string(JSContext *ctx, uint32_t buf_len)
js_alloc_string(ctx: ptr, buf_len: int) -> ptr {
    long blen = buf_len & 0xffffffff
    if blen > JS_STRING_LEN_MAX {
        JS_ThrowError(ctx, consts.JS_CLASS_INTERNAL_ERROR, "string too long")
        return null
    }
    p = js_malloc(ctx, consts.SIZEOF_JSSTRING + buf_len + 1, consts.JS_MTAG_STRING)
    if p == null { return null }
    // js_malloc wrote header = mtag<<1 (gc_mark/is_unique/is_ascii/
    // is_numeric all 0); set len (b7+).
    long lenbits = blen << 7
    long hdr = mem.get_long(p, 0)
    long h = hdr | lenbits
    mem.set_long(p, 0, h)
    // p->buf[buf_len] = '\0'
    mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(p) + STR_BUF + buf_len), 0, 0)
    return p
}

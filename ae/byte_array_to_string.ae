// js_byte_array_to_string ported from mquickjs.c: reinterpret a (zero
// terminated) byte array as a string in place. Empty -> the interned
// empty atom; a single whole UTF-8 char -> the inline STRING_CHAR
// special; otherwise shrink the byte array to len+1 and rewrite its
// header word as a JSString. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_get_atom(ctx: ptr, a: int) -> long
extern __utf8_get(p: ptr, plen: ptr) -> int
extern js_shrink_byte_array(ctx: ptr, pval: ptr, new_size: int)
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_byte_array_to_string)

const JS_TAG_STRING_CHAR = 27

utf8_char_len(c: int) -> int {
    if c < 0x80 { return 1 }
    if c < 0xc0 { return 1 }
    if c < 0xe0 { return 2 }
    if c < 0xf0 { return 3 }
    if c < 0xf8 { return 4 }
    return 1
}

new_string_char(c: int) -> long { long cl = c & 0xffffffff  return (cl << 5) | JS_TAG_STRING_CHAR }

// JSValue js_byte_array_to_string(JSContext *ctx, JSValue val, int len, BOOL is_ascii)
js_byte_array_to_string(ctx: ptr, val: long, len: int, is_ascii: int) -> long {
    arr = jstag.value_to_ptr(val)
    long bufp = mem.ptr_to_long(arr) + consts.BA_BUF

    if len == 0 { return js_get_atom(ctx, consts.JS_ATOM_empty) }

    int b0 = mem.get_byte(mem.long_to_ptr(bufp), 0)
    if utf8_char_len(b0) == len {
        // utf8_get(arr->buf): ASCII fast path inline, else __utf8_get.
        int c = b0
        if b0 >= 0x80 {
            cl = malloc(8)
            c = __utf8_get(mem.long_to_ptr(bufp), cl)
            free(cl)
        }
        return new_string_char(c)
    }

    // val may move (js_shrink_byte_array does not alloc, but takes &val).
    ref = malloc(16)
    mem.set_long(ref, 0, val)
    js_shrink_byte_array(ctx, ref, len + 1)
    val = mem.get_long(ref, 0)
    free(ref)

    p = jstag.value_to_ptr(val)
    // Rewrite header word: preserve gc_mark (b0); mtag=STRING (b1-3),
    // is_unique=0 (b4), is_ascii (b5), is_numeric=0 (b6), len (b7+).
    long h = mem.get_long(p, 0) & 1
    long ll = len & 0xffffffff
    long ia = 0
    if is_ascii != 0 { ia = 1 }
    h = h | (consts.JS_MTAG_STRING << 1) | (ia << 5) | (ll << 7)
    mem.set_long(p, 0, h)
    return val
}

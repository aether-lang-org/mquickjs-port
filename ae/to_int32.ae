// Integer-coercion wrappers ported from mquickjs.c. JS_ToInt32 /
// JS_ToUint32 / JS_ToInt32Sat delegate to JS_ToInt32Internal (un-staticed,
// kept C); JS_ToInt32Clamp adds the min/max clamping with the min_offset
// wrap. Provides the bare C symbols; C bodies removed.

import std.mem

extern JS_ToInt32Internal(ctx: ptr, pres: ptr, val: long, sat_flag: int) -> int

exports (JS_ToInt32, JS_ToUint32, JS_ToInt32Sat, JS_ToInt32Clamp)

// int JS_ToInt32(JSContext *ctx, int *pres, JSValue val)
JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int {
    return JS_ToInt32Internal(ctx, pres, val, 0)
}

// int JS_ToUint32(JSContext *ctx, uint32_t *pres, JSValue val)
JS_ToUint32(ctx: ptr, pres: ptr, val: long) -> int {
    return JS_ToInt32Internal(ctx, pres, val, 0)
}

// int JS_ToInt32Sat(JSContext *ctx, int *pres, JSValue val)
JS_ToInt32Sat(ctx: ptr, pres: ptr, val: long) -> int {
    return JS_ToInt32Internal(ctx, pres, val, 1)
}

// int JS_ToInt32Clamp(JSContext *ctx, int *pres, JSValue val, int min, int max, int min_offset)
JS_ToInt32Clamp(ctx: ptr, pres: ptr, val: long, mn: int, mx: int, min_offset: int) -> int {
    int res = JS_ToInt32Sat(ctx, pres, val)
    if res == 0 {
        int v = mem.get_int(pres, 0)
        if v < mn {
            v = v + min_offset
            if v < mn { v = mn }
        } else {
            if v > mx { v = mx }
        }
        mem.set_int(pres, 0, v)
    }
    return res
}

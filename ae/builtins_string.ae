// String builtins ported from mquickjs.c: String.prototype.toString
// and the .length getter. Both validate the receiver is a string and
// either return it or its length. Provides the bare C symbols; C
// bodies removed.

import std.mem
import ae.jstag

extern JS_IsString(ctx: ptr, val: long) -> int
extern js_string_len(ctx: ptr, val: long) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (js_string_toString, js_string_get_length)

const JS_CLASS_TYPE_ERROR = 14

// JSValue js_string_toString(ctx, this_val, argc, argv)
js_string_toString(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if JS_IsString(ctx, tv) == 0 {
        return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "not a string")
    }
    return tv
}

// JSValue js_string_get_length(ctx, this_val, argc, argv)
js_string_get_length(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if JS_IsString(ctx, tv) == 0 {
        return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "not a string")
    }
    int len = js_string_len(ctx, tv)
    return jstag.new_short_int(len)
}

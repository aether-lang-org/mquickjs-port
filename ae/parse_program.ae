// js_parse_source_element / js_parse_program ported from mquickjs.c.
// js_parse_source_element parses one top-level item (a function
// declaration or a statement); js_parse_program drives the whole program
// — set up the hidden return-value var, parse each element, emit the
// final return, define hoisted functions, and attach the bytecode.
// Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts
import ae.emit
import ae.define

extern js_parse_function_decl(s: ptr, func_type: int, name: long)
extern js_parse_call(s: ptr, func_idx: int, param: int)
extern next_token(s: ptr)
extern add_var(s: ptr, name: long) -> int
extern js_get_atom(ctx: ptr, a: int) -> long

exports (js_parse_source_element, js_parse_program)


const TOK_VAL = 8

pp_tok_val(s: ptr) -> int { return mem.get_int(s, TOK_VAL) }

// void js_parse_source_element(JSParseState *s)
js_parse_source_element(s: ptr) {
    if pp_tok_val(s) == consts.TOK_FUNCTION {
        js_parse_function_decl(s, consts.JS_PARSE_FUNC_STATEMENT, jstag.JS_NULL)
    } else {
        js_parse_call(s, consts.PARSE_FUNC_js_parse_statement, 0)
    }
}

// void js_parse_program(JSParseState *s)
js_parse_program(s: ptr) {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)
    next_token(s)

    // hidden variable for the return value
    if mem.get_byte(s, consts.JSPS_HAS_RETVAL) != 0 {
        int idx = add_var(s, js_get_atom(ctx, consts.JS_ATOM__ret_))
        mem.set_int(s, consts.JSPS_EVAL_RET_IDX, idx)
    }

    while pp_tok_val(s) != consts.TOK_EOF {
        js_parse_source_element(s)
    }

    int eval_ret_idx = mem.get_int(s, consts.JSPS_EVAL_RET_IDX)
    if eval_ret_idx >= 0 {
        int sp = mem.get_uint32(s, consts.JSPS_PC2LINE_SOURCE_POS)
        emit.emit_var(s, opcodes.OP_get_loc, eval_ret_idx, sp)
        emit.emit_op(s, opcodes.OP_return)
    } else {
        emit.emit_op(s, opcodes.OP_return_undef)
    }

    define.define_hoisted_functions(s, 1)

    // save the bytecode to the function
    b = jstag.value_to_ptr(mem.get_long(s, consts.JSPS_CUR_FUNC))
    mem.set_long(b, consts.FB_BYTE_CODE, mem.get_long(s, consts.JSPS_BYTE_CODE))
}

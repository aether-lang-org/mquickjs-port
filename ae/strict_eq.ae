// Strict equality + length helper ported from mquickjs.c. js_strict_eq
// implements === (numbers compare by value with NaN unequal; strings by
// bytes; everything else by identity). js_get_length32 reads obj.length
// and coerces to uint32. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.consts

extern JS_IsNumber(ctx: ptr, val: long) -> int
extern JS_IsString(ctx: ptr, val: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern js_string_eq(ctx: ptr, val1: long, val2: long) -> int
extern JS_GetProperty(ctx: ptr, obj: long, prop: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern JS_ToUint32(ctx: ptr, pres: ptr, val: long) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_strict_eq, js_get_length32)


// BOOL js_strict_eq(JSContext *ctx, JSValue op1, JSValue op2)
js_strict_eq(ctx: ptr, op1: long, op2: long) -> int {
    if JS_IsNumber(ctx, op1) != 0 {
        if JS_IsNumber(ctx, op2) == 0 { return 0 }
        pa = malloc(8)
        pb = malloc(8)
        JS_ToNumber(ctx, pa, op1)   // cannot fail (both numbers)
        JS_ToNumber(ctx, pb, op2)
        float d1 = mem.get_float64(pa, 0)
        float d2 = mem.get_float64(pb, 0)
        free(pa)
        free(pb)
        if d1 == d2 { return 1 }   // NaN != NaN -> false
        return 0
    }
    if JS_IsString(ctx, op1) != 0 {
        if JS_IsString(ctx, op2) == 0 { return 0 }
        return js_string_eq(ctx, op1, op2)
    }
    // special value or object: identity
    if op1 == op2 { return 1 }
    return 0
}

// int js_get_length32(JSContext *ctx, uint32_t *pres, JSValue obj)
js_get_length32(ctx: ptr, pres: ptr, obj: long) -> int {
    long len_val = JS_GetProperty(ctx, obj, js_get_atom(ctx, consts.JS_ATOM_length))
    if jstag.is_exception(len_val) != 0 {
        mem.set_uint32(pres, 0, 0)
        return 0 - 1
    }
    return JS_ToUint32(ctx, pres, len_val)
}

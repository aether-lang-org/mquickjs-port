// setprop — merged package (auto-assembled from 2 files).

import ae.consts
import ae.define
import ae.jstag
import ae.mqtypes
import std.mem

extern js_throw_prop_access_error(ctx: ptr, kind: int, prop: long) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern JS_IsNumericProperty(ctx: ptr, val: long) -> int
extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern js_resize_value_array(ctx: ptr, val: long, new_size: int) -> long
extern js_update_props(ctx: ptr, obj: long) -> int
extern JS_ToUint8Clamp(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_Call(ctx: ptr, call_flags: int) -> long
extern JS_ThrowTypeErrorNotAnObject(ctx: ptr) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (
    JS_SetPropertyInternal, js_set_prototype_internal
)

// ===== from set_property_internal.ae =====
// JS_SetPropertyInternal ported from mquickjs.c: the core property write.
// Resolves the receiver, fast-paths array append and typed-array element
// stores (with the appropriate numeric coercion), finds an existing own
// property to overwrite (copying ROM->RAM as needed), invokes a setter
// found on the prototype chain (VM tail-call or direct call), or finally
// defines a new own property. va_list-coupled TypeErrors go through the C
// shim js_throw_prop_access_error. Provides the bare C symbol.










spi_is_short_float(v: long) -> int { if (v & 7) == 5 { return 1 } return 0 }
spi_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }
spi_class_id(p: ptr) -> int { return (mem.get_long(p, 0) >> 4) & 0xff }
spi_proto(ctx: ptr, cid: int) -> ptr {
    return jstag.value_to_ptr(mem.get_long(ctx, consts.JSCTX_CLASS_PROTO + cid * 8))
}
spi_prop_type(pr: ptr) -> int { int w = mem.get_int(pr, consts.PROP_HASH_NEXT)  return (w >> 30) & 3 }

spi_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
spi_is_rom(ctx: ptr, pp: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if spi_ult(pp, ctxl) != 0 { return 1 }
    if spi_ult(pp, stop) == 0 { return 1 }
    return 0
}

spi_invalid_subscript(ctx: ptr) -> long {
    return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "invalid array subscript")
}

// invoke a setter found on the prototype chain
spi_call_setter(ctx: ptr, setter: long, this_obj: long, val: long, allow_tail_call: int) -> long {
    if allow_tail_call != 0 {
        long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP))
        // sp[-2]=sp[0]; sp[-1]=setter; sp[0]=val; sp-=2
        mem.set_long(mem.long_to_ptr(sp - 16), 0, mem.get_long(mem.long_to_ptr(sp), 0))
        mem.set_long(mem.long_to_ptr(sp - 8), 0, setter)
        mem.set_long(mem.long_to_ptr(sp), 0, val)
        mem.set_ptr(ctx, consts.JSCTX_SP, mem.long_to_ptr(sp - 16))
        long code = consts.JS_EX_CALL + (1 + consts.FRAME_CF_POP_RET)
        return jstag.make_special(jstag.TAG_EXCEPTION, code)
    }
    // GC-root val, setter, this_obj across stack check (3 refs of 16 bytes)
    ref = malloc(48)
    mem.set_long(ref, 0, val)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_long(ref, 16, setter)
    mem.set_ptr(ref, 24, mem.long_to_ptr(mem.ptr_to_long(ref)))
    mem.set_long(ref, 32, this_obj)
    mem.set_ptr(ref, 40, mem.long_to_ptr(mem.ptr_to_long(ref) + 16))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(ref) + 32))
    int err = JS_StackCheck(ctx, 3)
    val = mem.get_long(ref, 0)
    setter = mem.get_long(ref, 16)
    this_obj = mem.get_long(ref, 32)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if err != 0 { return jstag.JS_EXCEPTION }
    JS_PushArg(ctx, val)
    JS_PushArg(ctx, setter)
    JS_PushArg(ctx, this_obj)
    return JS_Call(ctx, 1)
}

// JSValue JS_SetPropertyInternal(JSContext *ctx, JSValue this_obj, JSValue prop, JSValue val, BOOL allow_tail_call)
JS_SetPropertyInternal(ctx: ptr, this_obj: long, prop: long, val: long, allow_tail_call: int) -> long {
    p = mem.long_to_ptr(0)
    int is_obj = 0
    int do_proto_lookup = 0

    if jstag.is_ptr(this_obj) == 0 {
        is_obj = 0
        if jstag.is_int(this_obj) != 0 || spi_is_short_float(this_obj) != 0 {
            p = spi_proto(ctx, consts.JS_CLASS_NUMBER)
            do_proto_lookup = 1
        } else {
            int tag = jstag.get_special_tag(this_obj)
            if tag == jstag.TAG_BOOL { p = spi_proto(ctx, consts.JS_CLASS_BOOLEAN)  do_proto_lookup = 1 }
            else { if tag == jstag.TAG_SHORT_FUNC { p = spi_proto(ctx, consts.JS_CLASS_CLOSURE)  do_proto_lookup = 1 }
            else { if tag == jstag.TAG_STRING_CHAR { p = spi_proto(ctx, consts.JS_CLASS_STRING)  do_proto_lookup = 1 }
            else { if tag == jstag.TAG_NULL { return js_throw_prop_access_error(ctx, 3, prop) }
            else { if tag == jstag.TAG_UNDEFINED { return js_throw_prop_access_error(ctx, 4, prop) }
            else { return js_throw_prop_access_error(ctx, 5, prop) } } } } }
        }
    } else {
        is_obj = 1
        p = jstag.value_to_ptr(this_obj)
    }

    if do_proto_lookup == 0 && spi_mtag(p) != consts.JS_MTAG_OBJECT {
        is_obj = 0
        int mt = spi_mtag(p)
        if mt == consts.JS_MTAG_FLOAT64 { p = spi_proto(ctx, consts.JS_CLASS_NUMBER)  do_proto_lookup = 1 }
        else { if mt == consts.JS_MTAG_STRING { p = spi_proto(ctx, consts.JS_CLASS_STRING)  do_proto_lookup = 1 }
        else { return js_throw_prop_access_error(ctx, 5, prop) } }
    }

    if do_proto_lookup == 0 {
        int cid = spi_class_id(p)
        if cid == consts.JS_CLASS_ARRAY {
            if jstag.is_int(prop) != 0 {
                int idx = prop >> 1
                int alen = mem.get_uint32(p, consts.JSOBJ_ARRAY_LEN)
                if idx < alen {
                    long tab = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(p, consts.JSOBJ_ARRAY_TAB))) + consts.VA_ARR
                    mem.set_long(mem.long_to_ptr(tab + idx * 8), 0, val)
                    return jstag.JS_UNDEFINED
                }
                if idx == alen {
                    // append: GC-root this_obj, val across resize
                    ref = malloc(32)
                    mem.set_long(ref, 0, this_obj)
                    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                    mem.set_long(ref, 16, val)
                    mem.set_ptr(ref, 24, mem.long_to_ptr(mem.ptr_to_long(ref)))
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(ref) + 16))
                    long new_tab = js_resize_value_array(ctx, mem.get_long(p, consts.JSOBJ_ARRAY_TAB), idx + 1)
                    this_obj = mem.get_long(ref, 0)
                    val = mem.get_long(ref, 16)
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
                    free(ref)
                    if jstag.is_exception(new_tab) != 0 { return jstag.JS_EXCEPTION }
                    p = jstag.value_to_ptr(this_obj)
                    mem.set_long(p, consts.JSOBJ_ARRAY_TAB, new_tab)
                    long tab2 = mem.ptr_to_long(jstag.value_to_ptr(new_tab)) + consts.VA_ARR
                    mem.set_long(mem.long_to_ptr(tab2 + idx * 8), 0, val)
                    mem.set_uint32(p, consts.JSOBJ_ARRAY_LEN, alen + 1)
                    return jstag.JS_UNDEFINED
                }
                return spi_invalid_subscript(ctx)
            } else {
                if JS_IsNumericProperty(ctx, prop) != 0 { return spi_invalid_subscript(ctx) }
            }
        } else {
            if cid >= consts.JS_CLASS_UINT8C_ARRAY && cid <= consts.JS_CLASS_FLOAT64_ARRAY {
                if jstag.is_int(prop) != 0 {
                    int idx = prop >> 1
                    // GC-root this_obj, val across coercion
                    ref = malloc(32)
                    mem.set_long(ref, 0, this_obj)
                    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                    mem.set_long(ref, 16, val)
                    mem.set_ptr(ref, 24, mem.long_to_ptr(mem.ptr_to_long(ref)))
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(ref) + 16))
                    int st = spi_ta_store_outer(ctx, ref, idx, cid)
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
                    free(ref)
                    if st == 1 { return jstag.JS_EXCEPTION }
                    if st == 2 { return spi_invalid_subscript(ctx) }
                    return jstag.JS_UNDEFINED
                } else {
                    if JS_IsNumericProperty(ctx, prop) != 0 { return spi_invalid_subscript(ctx) }
                }
            }
        }
    }

    // find own property (with redo after a ROM->RAM conversion)
    int redo = 1
    while redo != 0 {
        redo = 0
        if do_proto_lookup == 0 {
            pr = find_own_property(ctx, p, prop)
            if pr != null {
                int pt = spi_prop_type(pr)
                int need_convert = 0
                if pt == consts.JS_PROP_NORMAL {
                    if spi_is_rom(ctx, mem.ptr_to_long(pr)) != 0 { need_convert = 1 }
                    else { mem.set_long(pr, consts.PROP_VALUE, val)  return jstag.JS_UNDEFINED }
                } else { if pt == consts.JS_PROP_VARREF {
                    pv = jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))
                    mem.set_long(pv, consts.VARREF_VALUE, val)
                    return jstag.JS_UNDEFINED
                } else { if pt == consts.JS_PROP_SPECIAL {
                    need_convert = 1
                } else {
                    // getset: value is [getter, setter]
                    long gsarr = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))) + consts.VA_ARR
                    long setter = mem.get_long(mem.long_to_ptr(gsarr + 8), 0)
                    return spi_call_setter(ctx, setter, this_obj, val, allow_tail_call)
                } } }

                if need_convert != 0 {
                    box = malloc(48)
                    mem.set_long(box, 0, this_obj)  mem.set_ptr(box, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
                    mem.set_long(box, 16, prop)     mem.set_ptr(box, 24, mem.long_to_ptr(mem.ptr_to_long(box)))
                    mem.set_long(box, 32, val)      mem.set_ptr(box, 40, mem.long_to_ptr(mem.ptr_to_long(box) + 16))
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.long_to_ptr(mem.ptr_to_long(box) + 32))
                    int e = js_update_props(ctx, this_obj)
                    this_obj = mem.get_long(box, 0)  prop = mem.get_long(box, 16)  val = mem.get_long(box, 32)
                    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(box, 8))
                    free(box)
                    if e != 0 { return jstag.JS_EXCEPTION }
                    p = jstag.value_to_ptr(this_obj)
                    redo = 1
                }
            }
        }
    }

    // prototype-chain lookup for setters
    int walking = 1
    int first = do_proto_lookup       // if we jumped straight to prototype_lookup, check p first
    while walking != 0 {
        if first == 0 {
            long proto = mem.get_long(p, consts.JSOBJ_PROTO)
            if proto == jstag.JS_NULL { walking = 0 }
            else { p = jstag.value_to_ptr(proto) }
        }
        if walking != 0 {
            first = 0
            pr = find_own_property(ctx, p, prop)
            if pr != null {
                if spi_prop_type(pr) == consts.JS_PROP_GETSET {
                    long gsarr = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(pr, consts.PROP_VALUE))) + consts.VA_ARR
                    long setter = mem.get_long(mem.long_to_ptr(gsarr + 8), 0)
                    return spi_call_setter(ctx, setter, this_obj, val, allow_tail_call)
                }
                walking = 0      // stop prototype chain lookup
            }
        }
    }

    // add the property to the object
    if is_obj == 0 { return JS_ThrowTypeErrorNotAnObject(ctx) }
    return define.JS_DefinePropertyInternal(ctx, this_obj, prop, val, jstag.JS_UNDEFINED, consts.JS_DEF_PROP_HAS_VALUE)
}

// helpers referenced above
spi_ta_store_outer(ctx: ptr, ref: ptr, idx: int, cid: int) -> int {
    long val = mem.get_long(ref, 16)
    // coerce
    pres = malloc(8)
    int conv_ret = 0
    if cid == consts.JS_CLASS_UINT8C_ARRAY { conv_ret = JS_ToUint8Clamp(ctx, pres, val) }
    else { if cid == consts.JS_CLASS_FLOAT32_ARRAY || cid == consts.JS_CLASS_FLOAT64_ARRAY { conv_ret = JS_ToNumber(ctx, pres, val) }
    else { conv_ret = JS_ToInt32(ctx, pres, val) } }
    if conv_ret != 0 { free(pres)  return 1 }
    int iv = mem.get_int(pres, 0)
    float dv = mem.get_float64(pres, 0)
    free(pres)
    // reload p (this_obj may have moved)
    long this_obj = mem.get_long(ref, 0)
    p = jstag.value_to_ptr(this_obj)
    int talen = mem.get_uint32(p, consts.JSOBJ_TA_LEN)
    if idx >= talen { return 2 }
    int ix = idx + mem.get_uint32(p, consts.JSOBJ_TA_OFFSET)
    pbuf = jstag.value_to_ptr(mem.get_long(p, consts.JSOBJ_TA_BUFFER))
    arr = jstag.value_to_ptr(mem.get_long(pbuf, consts.JSOBJ_AB_BYTEBUF))
    long b = mem.ptr_to_long(arr) + consts.BA_BUF
    if cid == consts.JS_CLASS_UINT8C_ARRAY || cid == consts.JS_CLASS_INT8_ARRAY || cid == consts.JS_CLASS_UINT8_ARRAY {
        mem.set_byte(mem.long_to_ptr(b + ix), 0, iv & 0xff)
    } else { if cid == consts.JS_CLASS_INT16_ARRAY || cid == consts.JS_CLASS_UINT16_ARRAY {
        mem.set_uint16(mem.long_to_ptr(b + ix * 2), 0, iv & 0xffff)
    } else { if cid == consts.JS_CLASS_INT32_ARRAY || cid == consts.JS_CLASS_UINT32_ARRAY {
        mem.set_uint32(mem.long_to_ptr(b + ix * 4), 0, iv)
    } else { if cid == consts.JS_CLASS_FLOAT32_ARRAY {
        mem.set_float32(mem.long_to_ptr(b + ix * 4), 0, dv)
    } else {
        mem.set_float64(mem.long_to_ptr(b + ix * 8), 0, dv)
    } } } }
    return 0
}

// ===== from set_prototype.ae =====
// js_set_prototype_internal ported from mquickjs.c: set an object's
// prototype, rejecting a change that would create a cycle. 'obj' is an
// object and 'proto' is JS_NULL or an object. Provides the bare C
// symbol; C body removed.






// JSValue js_set_prototype_internal(JSContext *ctx, JSValue obj, JSValue proto)
js_set_prototype_internal(ctx: ptr, obj: long, proto: long) -> long {
    p = jstag.value_to_ptr(obj)
    if mem.get_long(p, consts.JSOBJ_PROTO) != proto {
        if proto != jstag.JS_NULL {
            // walk proto's chain; if we reach p there is a cycle
            long p1 = mem.ptr_to_long(jstag.value_to_ptr(proto))
            int looping = 1
            while looping != 0 {
                if p1 == mem.ptr_to_long(p) {
                    return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "circular prototype chain")
                }
                long pp = mem.get_long(mem.long_to_ptr(p1), consts.JSOBJ_PROTO)
                if pp == jstag.JS_NULL { looping = 0 }
                else { p1 = mem.ptr_to_long(jstag.value_to_ptr(pp)) }
            }
        }
        mem.set_long(p, consts.JSOBJ_PROTO, proto)
    }
    return jstag.JS_UNDEFINED
}

// define_hoisted_functions ported from mquickjs.c: finalise a function's
// hoisted inner-function definitions. First append the pc2line length
// marker (byte-aligned + a varint of hoisted_code_len); then, if there is
// hoisted setup code, insert it at the start of the bytecode — for each
// constant-pool entry that is an inner function with a slot, emit an
// OP_fclosure followed by the store opcode (put_var_ref/put_arg/put_loc).
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts

extern pc2line_put_bits(s: ptr, n: int, bits: int)
extern emit_insert(s: ptr, pos: int, n: int)
extern emit_u8(s: ptr, val: int)
extern emit_u16(s: ptr, val: int)

exports (define_hoisted_functions)

const OP_fclosure = opcodes.OP_fclosure
const OP_put_loc = opcodes.OP_put_loc
const OP_put_arg = opcodes.OP_put_arg
const OP_put_var_ref_nocheck = opcodes.OP_put_var_ref_nocheck


dhf_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }
// JSFunctionBytecode arg_count = header bits 7..22 (16 bits)
dhf_arg_count(p: ptr) -> int { return (mem.get_long(p, 0) >> 7) & 0xffff }

// void define_hoisted_functions(JSParseState *s, BOOL is_eval)
define_hoisted_functions(s: ptr, is_eval: int) {
    b = jstag.value_to_ptr(mem.get_long(s, consts.JSPS_CUR_FUNC))

    // add pc2line info
    if mem.get_long(b, consts.FB_PC2LINE) != jstag.JS_NULL {
        // byte align
        int bitlen = mem.get_uint32(s, consts.JSPS_PC2LINE_BIT_LEN)
        int n = (0 - bitlen) & 7
        if n != 0 { pc2line_put_bits(s, n, 0) }

        n = mem.get_uint32(s, consts.JSPS_HOISTED_CODE_LEN)
        int h = 0
        int writing = 1
        while writing != 0 {
            pc2line_put_bits(s, 8, (n & 0x7f) | h)
            n = (n >> 7) & 0x1ffffff
            if n == 0 { writing = 0 }
            else { h = 0x80 }
        }
    }

    int hoisted_len = mem.get_uint32(s, consts.JSPS_HOISTED_CODE_LEN)
    if hoisted_len == 0 { return }
    emit_insert(s, 0, hoisted_len)

    b = jstag.value_to_ptr(mem.get_long(s, consts.JSPS_CUR_FUNC))
    int arg_count = dhf_arg_count(b)

    int saved_bclen = mem.get_uint32(s, consts.JSPS_BYTE_CODE_LEN)
    mem.set_uint32(s, consts.JSPS_BYTE_CODE_LEN, 0)
    long cpool = mem.get_long(b, consts.FB_CPOOL)
    long cpool_base = mem.ptr_to_long(jstag.value_to_ptr(cpool)) + consts.VA_ARR
    int cpool_len = mem.get_uint16(s, consts.JSPS_CPOOL_LEN)

    int i = 0
    while i < cpool_len {
        long val = mem.get_long(mem.long_to_ptr(cpool_base + i * 8), 0)
        if jstag.is_ptr(val) != 0 {
            fb = jstag.value_to_ptr(val)
            if dhf_mtag(fb) == consts.JS_MTAG_FUNCTION_BYTECODE {
                int fac = dhf_arg_count(fb)
                if fac != 0 {
                    int idx = fac - 1
                    int op = OP_put_loc
                    if is_eval != 0 {
                        op = OP_put_var_ref_nocheck
                    } else { if idx < arg_count {
                        op = OP_put_arg
                    } else {
                        idx = idx - arg_count
                        op = OP_put_loc
                    } }
                    emit_u8(s, OP_fclosure)
                    emit_u16(s, i)
                    emit_u8(s, op)
                    emit_u16(s, idx)
                }
            }
        }
        i = i + 1
    }
    mem.set_uint32(s, consts.JSPS_BYTE_CODE_LEN, saved_bclen)
}

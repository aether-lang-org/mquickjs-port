// Interrupt poll + function-variable lookup ported from mquickjs.c.
// __js_poll_interrupt resets the interrupt counter and runs the user
// interrupt handler (via a C trampoline), raising an uncatchable error
// if it requests interruption; find_func_var scans a function's vars
// array for a name. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long

exports (__js_poll_interrupt, find_func_var, vm_call_interrupt)

// Call the C interrupt handler held as a raw pointer.
// int(*)(JSContext *, void *)
vm_call_interrupt(fnptr: long, ctx: ptr, opaque: ptr) -> int {
    f = mem.long_to_ptr(fnptr) as fn(ptr, ptr) -> int
    return f(ctx, opaque)
}

const JS_INTERRUPT_COUNTER_INIT = 10000
const JS_CLASS_INTERNAL_ERROR = 16
const JSCTX_INTERRUPT_COUNTER = 58
const JSCTX_UNCATCHABLE = 60
const JSCTX_INTERRUPT_HANDLER = 144
const JSCTX_OPAQUE = 160

// JSValue __js_poll_interrupt(JSContext *ctx)
__js_poll_interrupt(ctx: ptr) -> long {
    mem.set_int16(ctx, JSCTX_INTERRUPT_COUNTER, JS_INTERRUPT_COUNTER_INIT)
    long h = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_INTERRUPT_HANDLER))
    if h != 0 {
        opaque = mem.get_ptr(ctx, JSCTX_OPAQUE)
        if vm_call_interrupt(h, ctx, opaque) != 0 {
            JS_ThrowError(ctx, JS_CLASS_INTERNAL_ERROR, "interrupted")
            mem.set_byte(ctx, JSCTX_UNCATCHABLE, 1)
            return jstag.JS_EXCEPTION
        }
    }
    return jstag.JS_UNDEFINED
}

// JSValueArray: vars @ JSFunctionBytecode+32 (a JSValue); arr[] @8; size = hdr>>4
va_get(arrval: long, i: int) -> long {
    long p = mem.ptr_to_long(jstag.value_to_ptr(arrval))
    return mem.get_long(mem.long_to_ptr(p + 8 + i * 8), 0)
}
va_size(arrval: long) -> int {
    long p = mem.ptr_to_long(jstag.value_to_ptr(arrval))
    return mem.get_long(mem.long_to_ptr(p), 0) >> 4
}

// int find_func_var(JSContext *ctx, JSValue func, JSValue name)
find_func_var(ctx: ptr, fobj: long, name: long) -> int {
    b = jstag.value_to_ptr(fobj)
    long vars = mem.get_long(b, 32)   // JSFunctionBytecode.vars
    if vars == jstag.JS_NULL { return 0 - 1 }
    int n = va_size(vars)
    int i = 0
    while i < n {
        if va_get(vars, i) == name { return i }
        i = i + 1
    }
    return 0 - 1
}

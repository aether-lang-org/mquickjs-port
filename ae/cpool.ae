// Constant-pool insertion ported from mquickjs.c. cpool_add dedups a
// value into the current function's cpool (a JSValueArray), growing it
// as needed, and returns its index. Provides the bare C symbol; C body
// removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern js_parse_error_mem(s: ptr)
extern js_resize_value_array(ctx: ptr, val: long, new_size: int) -> long

exports (cpool_add)

const GCREF_VAL = 0
const GCREF_PREV = 8
const FB_CPOOL_OFF = 24   // JSFunctionBytecode.cpool @24

cp_ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
cp_ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
cp_gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, GCREF_PREV, cp_ctx_top(ctx))
    cp_ctx_set_top(ctx, ref)
    mem.set_long(ref, GCREF_VAL, v)
}
cp_gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, GCREF_VAL)
    cp_ctx_set_top(ctx, mem.get_ptr(ref, GCREF_PREV))
    return v
}

// int cpool_add(JSParseState *s, JSValue val)
cpool_add(s: ptr, val: long) -> int {
    ctx = (s as *JSParseState).ctx
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    arr = jstag.value_to_ptr(mem.get_long(b, FB_CPOOL_OFF))
    int cpool_len = (s as *JSParseState).cpool_len
    long tail = mem.ptr_to_long(arr) + 8

    // dedup
    int i = 0
    while i < cpool_len {
        if mem.get_long(mem.long_to_ptr(tail + i * 8), 0) == val { return i }
        i = i + 1
    }

    if cpool_len > 65535 { js_parse_error(s, "too many constants") }

    ref = malloc(16)
    cp_gc_push(ctx, ref, val)
    int new_size = cpool_len + 1
    if new_size < 4 { new_size = 4 }
    long new_cpool = js_resize_value_array(ctx, mem.get_long(b, FB_CPOOL_OFF), new_size)
    val = cp_gc_pop(ctx, ref)
    free(ref)
    if jstag.is_exception(new_cpool) != 0 { js_parse_error_mem(s) }

    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    mem.set_long(b, FB_CPOOL_OFF, new_cpool)
    arr = jstag.value_to_ptr(new_cpool)
    tail = mem.ptr_to_long(arr) + 8
    mem.set_long(mem.long_to_ptr(tail + cpool_len * 8), 0, val)
    (s as *JSParseState).cpool_len = cpool_len + 1
    return cpool_len
}

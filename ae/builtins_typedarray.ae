// Object-class predicates + typed-array / ArrayBuffer accessors,
// ported from mquickjs.c. These read the JSObject union variant
// overlays (typed_array.len/offset/buffer, array_buffer.byte_buffer).
// Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts
import ae.ops

extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToInt32Clamp(ctx: ptr, pres: ptr, val: long, mn: int, mx: int, min_offset: int) -> int
extern JS_NewObjectClass(ctx: ptr, class_id: int, extra_size: int) -> long
extern JS_ToIndex(ctx: ptr, plen: ptr, val: long) -> int
extern js_array_buffer_alloc(ctx: ptr, len: long) -> long
extern js_typed_array_constructor_obj(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long
extern JS_ToInt32Sat(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ThrowTypeErrorNotAnObject(ctx: ptr) -> long
extern JS_GetPropertyUint32(ctx: ptr, obj: long, idx: int) -> long
extern JS_SetPropertyUint32(ctx: ptr, this_obj: long, idx: int, val: long) -> long
extern memmove(dst: ptr, src: ptr, n: long) -> ptr

exports (
    JS_IsObject, js_get_object_class, get_typed_array,
    js_typed_array_get_length, js_array_buffer_get_byteLength,
    js_typed_array_subarray, js_typed_array_base_constructor, js_typed_array_constructor,
    js_typed_array_set
)


// typed_array_size_log2[] = {0,0,0,1,1,2,2,2,3}
size_log2_of(class_id: int) -> int {
    int idx = class_id - consts.JS_CLASS_UINT8C_ARRAY
    if idx == 0 { return 0 }
    if idx == 1 { return 0 }
    if idx == 2 { return 0 }
    if idx == 3 { return 1 }
    if idx == 4 { return 1 }
    if idx == 5 { return 2 }
    if idx == 6 { return 2 }
    if idx == 7 { return 2 }
    return 3
}

// BOOL JS_IsObject(JSContext *ctx, JSValue val)
JS_IsObject(ctx: ptr, val: long) -> int {
    if jstag.is_ptr(val) == 0 { return 0 }
    p = jstag.value_to_ptr(val)
    if (p as *JSObject).mtag == consts.MTAG_OBJECT { return 1 }
    return 0
}

// JSObject *js_get_object_class(JSContext *ctx, JSValue val, int class_id)
js_get_object_class(ctx: ptr, val: long, class_id: int) -> ptr {
    if jstag.is_ptr(val) == 0 { return null }
    p = jstag.value_to_ptr(val)
    if (p as *JSObject).mtag != consts.MTAG_OBJECT { return null }
    if (p as *JSObject).class_id != class_id { return null }
    return p
}

// JSObject *get_typed_array(JSContext *ctx, JSValue val)
get_typed_array(ctx: ptr, val: long) -> ptr {
    if JS_IsObject(ctx, val) == 0 {
        JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a TypedArray")
        return null
    }
    p = jstag.value_to_ptr(val)
    int cid = (p as *JSObject).class_id
    if cid < consts.JS_CLASS_UINT8C_ARRAY {
        JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a TypedArray")
        return null
    }
    if cid > consts.JS_CLASS_FLOAT64_ARRAY {
        JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a TypedArray")
        return null
    }
    return p
}

// JSValue js_typed_array_get_length(ctx, this_val, argc, argv, magic)
// this_val is a JSValue* (deref at offset 0). The JSTypedArray union
// is at JSObject offset 24: buffer@24, len@32, offset@36.
js_typed_array_get_length(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long {
    long tv = mem.get_long(this_val, 0)
    p = get_typed_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int cid = (p as *JSObject).class_id
    int s = size_log2_of(cid)
    // union @24: typed_array { buffer(long)@0, len(u32)@8, offset(u32)@12 }
    long ta = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    tap = mem.long_to_ptr(ta)
    if magic == 0 {
        int len = mem.get_uint32(tap, 8)
        return jstag.new_short_int(len)
    }
    if magic == 1 {
        int len = mem.get_uint32(tap, 8)
        return jstag.new_short_int(len << s)
    }
    if magic == 2 {
        int off = mem.get_uint32(tap, 12)
        return jstag.new_short_int(off << s)
    }
    // magic == 3: return the buffer JSValue
    return mem.get_long(tap, 0)
}

// JSValue js_array_buffer_get_byteLength(ctx, this_val, argc, argv)
js_array_buffer_get_byteLength(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_object_class(ctx, tv, consts.JS_CLASS_ARRAY_BUFFER)
    if p == null {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "expected an ArrayBuffer")
    }
    // array_buffer union @24: { byte_buffer(long)@0 }
    long ab = mem.ptr_to_long(p) + consts.OFFSETOF_JSOBJECT_U
    long byte_buffer = mem.get_long(mem.long_to_ptr(ab), 0)
    arr = jstag.value_to_ptr(byte_buffer)
    long size = (arr as *JSByteArray).size
    return jstag.new_short_int(size)
}

// JSValue js_typed_array_subarray(ctx, this_val, argc, argv)
// JSTypedArray union @ JSObject+24: buffer@0, len@8, offset@12.
js_typed_array_subarray(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = get_typed_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    long pu = mem.ptr_to_long(p) + 24
    pup = mem.long_to_ptr(pu)
    int len = mem.get_uint32(pup, 8)

    slot = malloc(8)
    if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 0), 0, len, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int start = mem.get_int(slot, 0)
    int final = len
    if jstag.is_undefined(mem.get_long(argv, 8)) == 0 {
        if JS_ToInt32Clamp(ctx, slot, mem.get_long(argv, 8), 0, len, len) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        final = mem.get_int(slot, 0)
    }
    free(slot)

    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    pup = mem.long_to_ptr(mem.ptr_to_long(p) + 24)
    int offset = mem.get_uint32(pup, 12) + start
    int count = final - start
    if count < 0 { count = 0 }

    // bounds check against the backing buffer
    long buffer = mem.get_long(pup, 0)
    p1 = jstag.value_to_ptr(buffer)
    p1u = mem.long_to_ptr(mem.ptr_to_long(p1) + 24)
    long bb = mem.get_long(p1u, 0)   // array_buffer.byte_buffer
    barr = jstag.value_to_ptr(bb)
    // JSByteArray.size: header bits 4..63
    long bsz = (mem.get_long(barr, 0) >> 4) & 0xfffffffffffffff
    if (offset + count) > bsz {
        return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid length")
    }

    int cid = (p as *JSObject).class_id
    long obj = JS_NewObjectClass(ctx, cid, consts.SIZEOF_JSTYPEDARRAY)
    if jstag.is_exception(obj) != 0 { return jstag.JS_EXCEPTION }
    // re-fetch source
    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    pup = mem.long_to_ptr(mem.ptr_to_long(p) + 24)
    p1 = jstag.value_to_ptr(obj)
    p1u2 = mem.long_to_ptr(mem.ptr_to_long(p1) + 24)
    mem.set_long(p1u2, 0, mem.get_long(pup, 0))    // buffer
    mem.set_uint32(p1u2, 12, offset)                // offset
    mem.set_uint32(p1u2, 8, count)                  // len
    return obj
}

ta_ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
ta_ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
ta_gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, consts.GCREF_PREV, ta_ctx_top(ctx))
    ta_ctx_set_top(ctx, ref)
    mem.set_long(ref, consts.GCREF_VAL, v)
}
ta_gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, consts.GCREF_VAL)
    ta_ctx_set_top(ctx, mem.get_ptr(ref, consts.GCREF_PREV))
    return v
}

// JSValue js_typed_array_base_constructor(ctx, this_val, argc, argv)
js_typed_array_base_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "cannot be called")
}

// JSValue js_typed_array_constructor(ctx, this_val, argc, argv, magic)
js_typed_array_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long {
    if (argc & consts.FRAME_CF_CTOR) == 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "must be called with new")
    }
    int size_log2 = size_log2_of(magic)
    long len = 0
    long offset = 0
    long buffer = 0
    slot = malloc(8)

    long a0 = mem.get_long(argv, 0)
    if JS_IsObject(ctx, a0) == 0 {
        if JS_ToIndex(ctx, slot, a0) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        len = mem.get_long(slot, 0)
        buffer = js_array_buffer_alloc(ctx, len << size_log2)
        if jstag.is_exception(buffer) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        offset = 0
    } else {
        p = jstag.value_to_ptr(a0)
        int cid = (p as *JSObject).class_id
        if cid == consts.JS_CLASS_ARRAY_BUFFER {
            long pu = mem.ptr_to_long(p) + 24
            arr = jstag.value_to_ptr(mem.get_long(mem.long_to_ptr(pu), 0))   // array_buffer.byte_buffer
            long byte_length = (mem.get_long(arr, 0) >> 4) & 0xfffffffffffffff  // JSByteArray.size
            if JS_ToIndex(ctx, slot, mem.get_long(argv, 8)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
            offset = mem.get_long(slot, 0)
            long align_mask = (1 << size_log2) - 1
            if (offset & align_mask) != 0 { free(slot)  return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid offset") }
            if offset > byte_length { free(slot)  return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid offset") }
            if jstag.is_undefined(mem.get_long(argv, 16)) != 0 {
                if (byte_length & align_mask) != 0 { free(slot)  return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid length") }
                len = (byte_length - offset) >> size_log2
            } else {
                if JS_ToIndex(ctx, slot, mem.get_long(argv, 16)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
                len = mem.get_long(slot, 0)
                if (offset + (len << size_log2)) > byte_length { free(slot)  return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid length") }
            }
            buffer = a0
            offset = offset >> size_log2
        } else {
            free(slot)
            return js_typed_array_constructor_obj(ctx, this_val, argc, argv, magic)
        }
    }
    free(slot)

    buf_ref = malloc(16)
    ta_gc_push(ctx, buf_ref, buffer)
    long obj = JS_NewObjectClass(ctx, magic, consts.SIZEOF_JSTYPEDARRAY)
    buffer = ta_gc_pop(ctx, buf_ref)
    free(buf_ref)
    if jstag.is_exception(obj) != 0 { return obj }
    p = jstag.value_to_ptr(obj)
    long ou = mem.ptr_to_long(p) + 24
    oup = mem.long_to_ptr(ou)
    mem.set_long(oup, 0, buffer)   // buffer
    mem.set_uint32(oup, 12, offset)  // offset
    mem.set_uint32(oup, 8, len)      // len
    return obj
}

// JSValue js_typed_array_set(ctx, this_val, argc, argv)
js_typed_array_set(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = get_typed_array(ctx, tv)
    if p == null { return jstag.JS_EXCEPTION }
    int offset = 0
    if argc > 1 {
        slot = malloc(8)
        if JS_ToInt32Sat(ctx, slot, mem.get_long(argv, 8)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        offset = mem.get_int(slot, 0)
        free(slot)
    }
    if offset < 0 { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length") }
    long a0 = mem.get_long(argv, 0)
    if JS_IsObject(ctx, a0) == 0 { return JS_ThrowTypeErrorNotAnObject(ctx) }

    p = jstag.value_to_ptr(mem.get_long(this_val, 0))
    long pu = mem.ptr_to_long(p) + 24
    int dst_len = mem.get_uint32(mem.long_to_ptr(pu), 8)
    int dst_cid = (p as *JSObject).class_id

    p1 = jstag.value_to_ptr(a0)
    int src_cid = (p1 as *JSObject).class_id
    int src_len = 0
    int handled = 0
    if src_cid >= consts.JS_CLASS_UINT8C_ARRAY {
        if src_cid <= consts.JS_CLASS_FLOAT64_ARRAY {
            long p1u = mem.ptr_to_long(p1) + 24
            src_len = mem.get_uint32(mem.long_to_ptr(p1u), 8)
            if src_len > dst_len { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length") }
            if offset > (dst_len - src_len) { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length") }
            if src_cid == dst_cid {
                int shift = size_log2_of(dst_cid)
                // dst buffer bytes
                long dbuf = mem.get_long(mem.long_to_ptr(pu), 0)
                dbp = jstag.value_to_ptr(dbuf)
                long dbb = mem.get_long(mem.long_to_ptr(mem.ptr_to_long(dbp) + 24), 0)
                darr = jstag.value_to_ptr(dbb)
                int doff = mem.get_uint32(mem.long_to_ptr(pu), 12)
                // src buffer bytes
                long sbuf = mem.get_long(mem.long_to_ptr(p1u), 0)
                sbp = jstag.value_to_ptr(sbuf)
                long sbb = mem.get_long(mem.long_to_ptr(mem.ptr_to_long(sbp) + 24), 0)
                sarr = jstag.value_to_ptr(sbb)
                int soff = mem.get_uint32(mem.long_to_ptr(p1u), 12)
                dst = mem.long_to_ptr(mem.ptr_to_long(darr) + 8 + ((doff + offset) << shift))
                srcp = mem.long_to_ptr(mem.ptr_to_long(sarr) + 8 + (soff << shift))
                memmove(dst, srcp, src_len << shift)
                handled = 1
            }
        }
    }
    if handled == 0 {
        if src_cid < consts.JS_CLASS_UINT8C_ARRAY {
            slot = malloc(8)
            if ops.js_get_length32(ctx, slot, a0) != 0 { free(slot)  return jstag.JS_EXCEPTION }
            src_len = mem.get_uint32(slot, 0)
            free(slot)
            if src_len > dst_len { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length") }
            if offset > (dst_len - src_len) { return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array length") }
        }
        int i = 0
        while i < src_len {
            long val = JS_GetPropertyUint32(ctx, a0, i)
            if jstag.is_exception(val) != 0 { return jstag.JS_EXCEPTION }
            long r = JS_SetPropertyUint32(ctx, mem.get_long(this_val, 0), offset + i, val)
            if jstag.is_exception(r) != 0 { return jstag.JS_EXCEPTION }
            i = i + 1
        }
    }
    return jstag.JS_UNDEFINED
}

// skip — merged package (auto-assembled from 3 files).

import ae.consts
import ae.jstag
import ae.mqtypes
import std.mem

extern next_token(s: ptr)
extern js_parse_error_expect_char(s: ptr, c: int)
extern js_get_atom(ctx: ptr, a: int) -> long
extern js_parse_error_nested_blocks(s: ptr)
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_parse_get_pos(s: ptr, sp: ptr)
extern js_parse_seek_token(s: ptr, sp: ptr)

exports (
    is_label, js_skip_expr, js_skip_parens, js_parse_skip_parens_token
)

// ===== from skip_expr.ae =====
// is_label / js_skip_expr ported from mquickjs.c. is_label peeks whether the
// current identifier token is immediately followed by ':' (a labelled
// statement) — relying on next_token leaving no space before the colon.
// js_skip_expr advances tokens until the matching ')', recursing over nested
// (), [] and {} via js_skip_parens, and erroring on a premature ';' or EOF.
// Provides the bare C symbols; C bodies removed.






// BOOL is_label(JSParseState *s)
is_label(s: ptr) -> int {
    if (s as *JSParseState).tok_val != consts.TOK_IDENT { return 0 }
    long buf = mem.ptr_to_long((s as *JSParseState).source_buf)
    int pos = (s as *JSParseState).buf_pos
    int c = mem.get_byte(mem.long_to_ptr(buf + pos), 0) & 0xff
    if c == 58 { return 1 }     // ':'
    return 0
}

// void js_skip_expr(JSParseState *s)
js_skip_expr(s: ptr) {
    int done = 0
    while done == 0 {
        int tok = (s as *JSParseState).tok_val
        if tok == 41 {                 // ')'
            done = 1
        } else { if tok == 59 || tok == consts.TOK_EOF {   // ';' or EOF
            js_parse_error_expect_char(s, 41)        // expecting ')'
        } else { if tok == 40 || tok == 91 || tok == 123 {  // '(' '[' '{'
            js_skip_parens(s, mem.long_to_ptr(0))
        } else {
            next_token(s)
        } } }
    }
}

// ===== from skip_parens.ae =====
// js_skip_parens ported from mquickjs.c: from an opening '(', '[' or '{',
// consume tokens until the matching close, tracking nesting on a small
// bracket stack and reporting mismatched/EOF/over-deep nesting as parse
// errors. While scanning it sets flag bits: HAS_ARGUMENTS if the identifier
// `arguments` appears, HAS_FUNC_NAME if the (optional) function name appears,
// and HAS_SEMI if a ';' is seen at the first nesting level. Returns the bit
// set. Provides the bare C symbol; C body removed.





const STATE_MAX = 128

// int js_skip_parens(JSParseState *s, JSValue *pfunc_name)
js_skip_parens(s: ptr, pfunc_name: ptr) -> int {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)
    state = malloc(STATE_MAX)
    int level = 0
    mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(state) + level), 0, 0)  // underflow guard
    level = level + 1
    int bits = 0

    int looping = 1
    while looping != 0 {
        int tok = (s as *JSParseState).tok_val

        if tok == 40 || tok == 91 || tok == 123 {           // '(' '[' '{'
            int c = 41                                       // ')'
            if tok == 91 { c = 93 }                          // ']'
            if tok == 123 { c = 125 }                        // '}'
            if level >= STATE_MAX { js_parse_error_nested_blocks(s) }
            mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(state) + level), 0, c)
            level = level + 1
        } else { if tok == 41 || tok == 93 || tok == 125 {   // ')' ']' '}'
            level = level - 1
            int c = mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(state) + level), 0) & 0xff
            if tok != c { js_parse_error_expect_char(s, c) }
        } else { if tok == consts.TOK_EOF {
            int c = mem.get_byte(mem.long_to_ptr(mem.ptr_to_long(state) + level - 1), 0) & 0xff
            js_parse_error_expect_char(s, c)
        } else { if tok == consts.TOK_IDENT {
            long tv = (s as *JSParseState).tok_value
            if tv == js_get_atom(ctx, consts.JS_ATOM_arguments) { bits = bits | consts.SKIP_HAS_ARGUMENTS }
            if mem.ptr_to_long(pfunc_name) != 0 {
                if tv == mem.get_long(pfunc_name, 0) { bits = bits | consts.SKIP_HAS_FUNC_NAME }
            }
        } else { if tok == 59 {                              // ';'
            if level == 2 { bits = bits | consts.SKIP_HAS_SEMI }
        } else { } } } } }

        next_token(s)
        if level <= 1 { looping = 0 }
    }

    free(state)
    return bits
}

// ===== from skip_parens_token.ae =====
// js_parse_skip_parens_token ported from mquickjs.c: peek past a
// parenthesised group to classify it (the returned bits flag whether it
// contains arguments, a function name, a semicolon, etc.) without
// consuming it — save the parse position, skip, then seek back. Provides
// the bare C symbol; C body removed.





// int js_parse_skip_parens_token(JSParseState *s)
js_parse_skip_parens_token(s: ptr) -> int {
    pos = malloc(8)            // JSParsePos: got_lf@0, regexp_allowed@1, source_pos@4
    js_parse_get_pos(s, pos)
    int bits = js_skip_parens(s, null)
    js_parse_seek_token(s, pos)
    free(pos)
    return bits
}

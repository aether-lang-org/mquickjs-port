// Variable-declaration parser ported from mquickjs.c. js_parse_var
// parses `name [= expr] (, name [= expr])*`, defining each variable and
// emitting its initializer. Plain recursive descent (calls the
// expression ladder via js_parse_assign_expr2). Provides the bare C
// symbol; C body removed.

import std.mem
import ae.mqtypes
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_parse_error(s: ptr, fmt: ptr, ...) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern define_var(s: ptr, pvar_kind: ptr, name: long) -> int
extern next_token(s: ptr)
extern js_parse_assign_expr2(s: ptr, parse_flags: int)
extern put_var(s: ptr, var_kind: int, var_idx: int, source_pos: int)

exports (js_parse_var)

const PF_NO_IN = 1

// void js_parse_var(JSParseState *s, BOOL in_accepted)
js_parse_var(s: ptr, in_accepted: int) {
    ctx = (s as *JSParseState).ctx
    kslot = malloc(8)
    int looping = 1
    while looping != 0 {
        int ident_source_pos = mem.get_uint32(s, 12)   // token.source_pos
        if mem.get_int(s, 8) != consts.TOK_IDENT {             // token.val
            js_parse_error(s, "variable name expected")
        }
        long tok_value = mem.get_long(s, 24)            // token.value
        if tok_value == js_get_atom(ctx, consts.JS_ATOM_arguments) {
            js_parse_error(s, "invalid variable name")
        }
        int var_idx = define_var(s, kslot, tok_value)
        int var_kind = mem.get_int(kslot, 0)
        next_token(s)
        if mem.get_int(s, 8) == 61 {   // '='
            next_token(s)
            int pf = 0
            if in_accepted == 0 { pf = PF_NO_IN }
            js_parse_assign_expr2(s, pf)
            put_var(s, var_kind, var_idx, ident_source_pos)
        }
        if mem.get_int(s, 8) != 44 { looping = 0 }   // ','
        else { next_token(s) }
    }
    free(kslot)
}

// compute_stack_size ported from mquickjs.c: a worklist walk over a
// function's compiled bytecode that determines the maximum operand-stack
// depth (stored into the bytecode header) and validates the bytecode. An
// "explore" byte array records the stack depth seen at each pc; branches
// enqueue their targets via the parser value stack. compute_stack_size_
// push seeds one position. The static-const opcode_info[] table is read
// through a C accessor; the %d-formatted validation errors go through C
// shims. Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.opcode_data
import ae.consts
import ae.stackalloc

extern js_alloc_byte_array(ctx: ptr, size: int) -> ptr
extern js_parse_error_mem(s: ptr)
extern js_free(ctx: ptr, p: ptr)
extern js_parse_error_pc1(s: ptr, kind: int, a: int)
extern js_parse_error_pc3(s: ptr, a: int, b: int, pc: int)
extern memset(dst: ptr, c: int, n: long) -> ptr

exports (compute_stack_size, compute_stack_size_push)

const OP_COUNT = 126
const OP_FMT_npop = 13


css_short_int(v: long) -> long { return v << 1 }
css_va_size(arr: long) -> int { long h = mem.get_long(mem.long_to_ptr(arr), 0)  long sz = h >> 4  return sz }
// opcode size/n_pop/n_push/fmt from the shared opcode_data const arrays
oi_size(op: int) -> int { return opcode_data.oi_size(op) }
oi_n_pop(op: int) -> int { return opcode_data.oi_n_pop(op) }
oi_n_push(op: int) -> int { return opcode_data.oi_n_push(op) }
oi_fmt(op: int) -> int { return opcode_data.oi_fmt(op) }

// void compute_stack_size_push(JSParseState *s, JSByteArray *arr, uint8_t *explore_tab, uint32_t pos, int stack_len)
compute_stack_size_push(s: ptr, arr: ptr, explore_tab: ptr, pos: int, stack_len: int) {
    int size = css_va_size(mem.ptr_to_long(arr))
    if pos >= size { js_parse_error_pc1(s, 0, pos) }       // bytecode buffer overflow
    long sl = stack_len & 0xffffffff
    int short_stack_len = 1 + (sl % 255)
    int cur = mem.get_byte(explore_tab, pos) & 0xff
    if cur != 0 {
        if cur != short_stack_len { js_parse_error_pc3(s, cur - 1, short_stack_len - 1, pos) }
    } else {
        mem.set_byte(explore_tab, pos, short_stack_len)
        stackalloc.js_parse_push_val(s, css_short_int(pos))
        stackalloc.js_parse_push_val(s, css_short_int(stack_len))
    }
}

// void compute_stack_size(JSParseState *s, JSValue *pfunc)
compute_stack_size(s: ptr, pfunc: ptr) {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)

    b = jstag.value_to_ptr(mem.get_long(pfunc, 0))
    long arrv = mem.get_long(b, consts.FB_BYTE_CODE)
    int bc_size = css_va_size(mem.ptr_to_long(jstag.value_to_ptr(arrv)))

    explore_arr = js_alloc_byte_array(ctx, bc_size)
    if explore_arr == null { js_parse_error_mem(s) }
    long explore_val = jstag.value_from_ptr(explore_arr)

    // re-read after possible GC during alloc
    b = jstag.value_to_ptr(mem.get_long(pfunc, 0))
    arrv = mem.get_long(b, consts.FB_BYTE_CODE)
    long explore_tab = mem.ptr_to_long(explore_arr) + consts.BA_BUF
    memset(mem.long_to_ptr(explore_tab), 0, bc_size)

    // GC-root explore_val on the parser stack so reloads find it
    // (we keep its value in a local ref slot via push/pop pattern)
    ref = malloc16()
    mem.set_long(ref, 0, explore_val)
    mem.set_ptr(ref, 8, (ctx as *JSContext).top_gc_ref)
    (ctx as *JSContext).top_gc_ref = ref

    long stack_top = mem.ptr_to_long((ctx as *JSContext).sp)

    compute_stack_size_push(s, jstag.value_to_ptr(arrv), mem.long_to_ptr(explore_tab), 0, 0)

    int outer = 1
    while outer != 0 {
        long sp = mem.ptr_to_long((ctx as *JSContext).sp)
        if sp >= stack_top { outer = 0 }
        else {
            int stack_len = stackalloc.js_parse_pop_val(s) >> 1
            int pos = stackalloc.js_parse_pop_val(s) >> 1

            // reload (compute_stack_size_push may have GC'd)
            b = jstag.value_to_ptr(mem.get_long(pfunc, 0))
            arrv = mem.get_long(b, consts.FB_BYTE_CODE)
            long bcbase = mem.ptr_to_long(jstag.value_to_ptr(arrv)) + consts.BA_BUF
            explore_tab = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(ref, 0))) + consts.BA_BUF
            int cur_size = css_va_size(mem.ptr_to_long(jstag.value_to_ptr(arrv)))

            int op = mem.get_byte(mem.long_to_ptr(bcbase + pos), 0) & 0xff
            pos = pos + 1
            if op == opcodes.OP_invalid || op >= OP_COUNT { js_parse_error_pc1(s, 1, pos - 1) }
            int op_len = oi_size(op)
            if (pos + op_len - 1) > cur_size { js_parse_error_pc1(s, 0, pos - 1) }
            int n_pop = oi_n_pop(op)
            if oi_fmt(op) == OP_FMT_npop {
                n_pop = n_pop + mem.get_uint16(mem.long_to_ptr(bcbase + pos), 0)
            }
            if stack_len < n_pop { js_parse_error_pc1(s, 2, pos - 1) }
            stack_len = stack_len + oi_n_push(op) - n_pop
            int cur_ss = mem.get_uint16(b, consts.FB_STACK_SIZE)
            if stack_len > cur_ss {
                if stack_len > consts.JS_MAX_FUNC_STACK_SIZE { js_parse_error_pc1(s, 3, pos - 1) }
                mem.set_uint16(b, consts.FB_STACK_SIZE, stack_len)
            }

            int done = 0
            if op == opcodes.OP_return || op == opcodes.OP_return_undef || op == opcodes.OP_throw || op == opcodes.OP_ret {
                done = 1   // no code after
            } else { if op == opcodes.OP_goto {
                pos = pos + mem.get_uint32(mem.long_to_ptr(bcbase + pos), 0)
            } else { if op == opcodes.OP_if_true || op == opcodes.OP_if_false {
                int pos1 = pos + mem.get_uint32(mem.long_to_ptr(bcbase + pos), 0)
                compute_stack_size_push(s, jstag.value_to_ptr(arrv), mem.long_to_ptr(explore_tab), pos1, stack_len)
                pos = pos + op_len - 1
            } else { if op == opcodes.OP_gosub {
                int pos1 = pos + mem.get_uint32(mem.long_to_ptr(bcbase + pos), 0)
                compute_stack_size_push(s, jstag.value_to_ptr(arrv), mem.long_to_ptr(explore_tab), pos1, stack_len + 1)
                pos = pos + op_len - 1
            } else {
                pos = pos + op_len - 1
            } } } }

            if done == 0 {
                // reload explore_tab/arr before the fallthrough push (push may GC)
                b = jstag.value_to_ptr(mem.get_long(pfunc, 0))
                arrv = mem.get_long(b, consts.FB_BYTE_CODE)
                explore_tab = mem.ptr_to_long(jstag.value_to_ptr(mem.get_long(ref, 0))) + consts.BA_BUF
                compute_stack_size_push(s, jstag.value_to_ptr(arrv), mem.long_to_ptr(explore_tab), pos, stack_len)
            }
        }
    }

    // unroot + free explore array
    explore_val = mem.get_long(ref, 0)
    (ctx as *JSContext).top_gc_ref = mem.get_ptr(ref, 8)
    free16(ref)
    js_free(ctx, jstag.value_to_ptr(explore_val))
}

extern malloc(n: long) -> ptr
extern free(p: ptr)
malloc16() -> ptr { return malloc(16) }
free16(p: ptr) { free(p) }

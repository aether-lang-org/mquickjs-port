// Centralized engine constants — one authoritative source for the
// numeric constants that were otherwise re-declared file-by-file. Import
// this module (`import ae.consts`) and refer to e.g. consts.JS_CLASS_TYPE_ERROR
// so every consumer reads the same value and a change lands in one place.
//
// Values mirror the C source of truth (mquickjs.h / mquickjs_build.h).
// Verified against those headers; keep them in sync.
//
// Naming note: these keep their original JS_/JSCTX_/etc. spellings so the
// migration from local `const` blocks is a mechanical name → consts.NAME
// rewrite with no value change.

exports (
    // JSObjectClassEnum (mquickjs.h:91) — object class IDs, 0-based sequential.
    JS_CLASS_OBJECT, JS_CLASS_ARRAY, JS_CLASS_C_FUNCTION, JS_CLASS_CLOSURE,
    JS_CLASS_NUMBER, JS_CLASS_BOOLEAN, JS_CLASS_STRING, JS_CLASS_DATE,
    JS_CLASS_REGEXP,
    JS_CLASS_ERROR, JS_CLASS_EVAL_ERROR, JS_CLASS_RANGE_ERROR,
    JS_CLASS_REFERENCE_ERROR, JS_CLASS_SYNTAX_ERROR, JS_CLASS_TYPE_ERROR,
    JS_CLASS_URI_ERROR, JS_CLASS_INTERNAL_ERROR,
    JS_CLASS_ARRAY_BUFFER, JS_CLASS_TYPED_ARRAY,
    JS_CLASS_UINT8C_ARRAY, JS_CLASS_INT8_ARRAY, JS_CLASS_UINT8_ARRAY,
    JS_CLASS_INT16_ARRAY, JS_CLASS_UINT16_ARRAY, JS_CLASS_INT32_ARRAY,
    JS_CLASS_UINT32_ARRAY, JS_CLASS_FLOAT32_ARRAY, JS_CLASS_FLOAT64_ARRAY,
    JS_CLASS_USER,
    // Alias spelling used by some call sites.
    JS_CLASS_RANGE_ERROR_C,

    // JSContext struct field byte offsets (guarded by ae/layout_guard.c).
    JSCTX_HEAP_BASE, JSCTX_HEAP_FREE, JSCTX_STACK_TOP, JSCTX_STACK_BOTTOM,
    JSCTX_SP, JSCTX_FP, JSCTX_MIN_FREE_SIZE, JSCTX_IN_OUT_OF_MEMORY,
    JSCTX_N_ROM_ATOM_TABLES, JSCTX_SPC_COUNTER, JSCTX_CLASS_COUNT,
    JSCTX_INTERRUPT_COUNTER, JSCTX_UNCATCHABLE, JSCTX_PARSE_STATE,
    JSCTX_UNIQUE_STRINGS_LEN, JSCTX_TOP_GC_REF, JSCTX_LAST_GC_REF,
    JSCTX_ATOM_TABLE, JSCTX_ROM_ATOM_TABLES, JSCTX_CFUNC_TABLE,
    JSCTX_C_FUNCTION_TABLE, JSCTX_C_FINALIZER_TABLE, JSCTX_RANDOM_STATE,
    JSCTX_INTERRUPT_HANDLER, JSCTX_WRITE_FUNC, JSCTX_OPAQUE, JSCTX_CLASS_OBJ,
    JSCTX_SPC, JSCTX_STRING_POS_CACHE, JSCTX_UNIQUE_STRINGS,
    JSCTX_CURRENT_EXCEPTION, JSCTX_EMPTY_PROPS, JSCTX_GLOBAL_OBJ,
    JSCTX_MINUS_ZERO, JSCTX_CLASS_PROTO, JSCTX_CLASS_PROTO_OFFSET,

    // Struct field offsets, struct sizes, and memory tags.
    MTAG_FREE, MTAG_OBJECT, MTAG_FLOAT64, MTAG_STRING,
    MTAG_FUNCTION_BYTECODE, MTAG_VALUE_ARRAY, MTAG_BYTE_ARRAY, MTAG_VARREF,
    JS_MTAG_FREE, JS_MTAG_OBJECT, JS_MTAG_FLOAT64, JS_MTAG_STRING,
    JS_MTAG_FUNCTION_BYTECODE, JS_MTAG_VALUE_ARRAY, JS_MTAG_BYTE_ARRAY, JS_MTAG_VARREF,
    JS_MTAG_COUNT, GCREF_VAL, GCREF_PREV, JSOBJ_PROTO,
    JSOBJ_PROPS, JSOBJ_PROPS_OFF, JSOBJ_AB_BYTEBUF, JSOBJ_ARRAYBUFFER_BYTEBUF,
    JSOBJ_ARRAY_TAB, JSOBJ_CFUNC_IDX, JSOBJ_CLOSURE_FUNC_BYTECODE, JSOBJ_TA_BUFFER,
    JSOBJ_U, JSOBJ_USER_OPAQUE, JSOBJ_U_OFFSET, JSOBJ_U_OPAQUE,
    JSOBJ_ARRAY_LEN, JSOBJ_TA_LEN, JSOBJ_TA_OFFSET, PROP_KEY,
    PROP_NORMAL, PROP_VALUE, PROP_HASH_NEXT, JSPS_CTX,
    JSPS_SP, JSPS_TOK_VALUE, JSPS_IS_EVAL, JSPS_HAS_RETVAL,
    JSPS_IS_REPL, JSPS_HAS_COLUMN, JSPS_FILENAME_STR, JSPS_SOURCE_BUF,
    JSPS_BUF_POS, JSPS_BUF_LEN, JSPS_CUR_FUNC, JSPS_BYTE_CODE,
    JSPS_BYTE_CODE_LEN, JSPS_LAST_OPCODE_POS, JSPS_PC2LINE_BIT_LEN, JSPS_PC2LINE_SOURCE_POS,
    JSPS_CPOOL_LEN, JSPS_HOISTED_CODE_LEN, JSPS_LOCAL_VARS_LEN, JSPS_EVAL_RET_IDX,
    JSPS_TOP_BREAK, JSPS_CAPTURE_COUNT, JSPS_RE_FLAGS_BITS, JSPS_JMP_ENV_OFFSET,
    JSPS_ERROR_MSG, JSPS_ERROR_MSG_OFFSET, PS_CTX, PS_TOK_SOURCE_POS,
    PS_IS_EVAL, PS_HAS_RETVAL, PS_IS_REPL, PS_HAS_COLUMN,
    PS_SOURCE_STR, PS_FILENAME_STR, PS_SOURCE_BUF, PS_BUF_POS,
    PS_BUF_LEN, PS_TOP_BREAK, PS_ERROR_MSG, FB_FUNC_NAME,
    FB_BYTE_CODE, FB_CPOOL, FB_CPOOL_OFF, FB_VARS,
    FB_EXT_VARS, FB_STACK_SIZE, FB_EXT_VARS_LEN, FB_FILENAME,
    FB_PC2LINE, FB_SOURCE_POS, SFB_FUNC_NAME, SFB_BYTE_CODE,
    SFB_CPOOL, SFB_VARS, SFB_EXT_VARS, SFB_STACK_SIZE,
    SFB_EXT_VARS_LEN, SFB_FILENAME, SFB_PC2LINE, SFB_SOURCE_POS,
    OFFSETOF_JSOBJECT_U, OFFSETOF_U, JSWORD_SIZE, JSVARREF_U_OFFSET,
    SIZEOF_JSARRAYBUFFER, SIZEOF_JSBYTEARRAY, SIZEOF_JSBYTEARRAY_HEADER, SIZEOF_JSCLOSUREDATA,
    SIZEOF_JSDATE, SIZEOF_JSFREEBLOCK, SIZEOF_JSOBJECTUSERDATA, SIZEOF_JSSTRING,
    SIZEOF_JSVALUE, SIZEOF_JSVALUEARRAY, SIZEOF_CFUNCDATA, SIZEOF_JSARRAYDATA,
    SIZEOF_JSERRORDATA, SIZEOF_JSFLOAT64, SIZEOF_JSTYPEDARRAY, SIZEOF_JSVARREF_DETACHED,
    SIZEOF_JSCFUNCTIONDEF, SIZEOF_JSREGEXP, SIZEOF_JSVARREF, SIZEOF_JSBYTECODEHEADER,
    SIZEOF_BLOCKENV, SIZEOF_JSFUNCTIONBYTECODE, SIZEOF_JSATODTEMPMEM, SIZEOF_JSCONTEXT,
    SIZEOF_JSDTOATEMPMEM, SIZEOF_TEMPMEM, SIZEOF_JSPARSESTATE
)


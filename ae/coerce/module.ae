// coerce — value coercion implementations. Import-only library
// (`import ae.coerce`); the public JS_To* C symbols that wrap these live
// in ae/api_forwarders.ae so they stay bare globals for the C hosts and
// the stdlib ROM. Aether callers may use coerce.to_cstring_len(...)
// directly, or the forwarded JS_ToCStringLen.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern get_short_string(buf: ptr, val: long) -> int

extern js_get_short_float(val: long) -> float
extern js_get_mtag(p: ptr) -> int
extern JS_ToPrimitive(ctx: ptr, val: long, hint: int) -> long
extern js_atod1(ctx: ptr, pres: ptr, val: long, radix: int, flags: int) -> int

extern i32toa(buf: ptr, n: int) -> long
extern js_dtoa2(ctx: ptr, d: float, radix: int, n_digits: int, flags: int) -> long
extern JS_NewString(ctx: ptr, buf: ptr) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern js_tostring_mtag_str(ctx: ptr, mtag: int) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (to_cstring_len, to_cstring, to_number, to_string)

// JSString.len = header >> 7
c_str_len(p: ptr) -> int { return mem.get_long(p, 0) >> 7 }

// const char *to_cstring_len(ctx, size_t *plen, JSValue val, JSCStringBuf *buf):
// coerce to string and expose its UTF-8 bytes. STRING_CHAR special renders
// into the caller's 5-byte scratch; a heap string returns a pointer into its
// own bytes. No allocation when the value already is a string.
to_cstring_len(ctx: ptr, plen: ptr, val: long, buf: ptr) -> ptr {
    val = to_string(ctx, val)
    if jstag.is_exception(val) != 0 { return null }
    p = mem.long_to_ptr(0)
    int len = 0
    if jstag.get_special_tag(val) == jstag.TAG_STRING_CHAR {
        len = get_short_string(buf, val)
        p = buf
    } else {
        r = jstag.value_to_ptr(val)
        p = mem.long_to_ptr(mem.ptr_to_long(r) + consts.STR_BUF)
        len = c_str_len(r)
    }
    if plen != null {
        long l = len & 0xffffffff
        mem.set_long(plen, 0, l)
    }
    return p
}

to_cstring(ctx: ptr, val: long, buf: ptr) -> ptr {
    return to_cstring_len(ctx, null, val, buf)
}

// ===== from to_number.ae =====
// to_number ported from mquickjs.c: coerce a value to a double via
// *pres, returning 0 on success or -1 on exception. Ints and short floats
// convert directly; strings parse through js_atod1; heap floats read their
// stored double; objects are reduced with JS_ToPrimitive(consts.HINT_NUMBER) and
// retried; null/false -> 0, true -> 1, undefined -> NaN. Provides the bare
// C symbol; C body removed.




tn_is_short_float(v: long) -> int { if (v & 7) == 5 { return 1 } return 0 }
tn_nan() -> float { return mem.float_from_bits(0x7ff8000000000000) }

// int to_number(JSContext *ctx, double *pres, JSValue val)
to_number(ctx: ptr, pres: ptr, val: long) -> int {
    int redo = 1
    while redo != 0 {
        redo = 0
        if jstag.is_int(val) != 0 {
            int iv = val >> 1                       // JS_VALUE_GET_INT
            float d = iv
            mem.set_float64(pres, 0, d)
            return 0
        }
        if tn_is_short_float(val) != 0 {
            mem.set_float64(pres, 0, js_get_short_float(val))
            return 0
        }
        if jstag.is_ptr(val) != 0 {
            p = jstag.value_to_ptr(val)
            int mtag = js_get_mtag(p)
            if mtag == consts.JS_MTAG_STRING {
                return js_atod1(ctx, pres, val, 0, consts.JS_ATOD_ACCEPT_BIN_OCT | consts.JS_ATOD_TOSTRING)
            }
            if mtag == consts.JS_MTAG_FLOAT64 {
                mem.set_float64(pres, 0, mem.get_float64(p, consts.JSFLOAT64_DVAL))
                return 0
            }
            if mtag == consts.JS_MTAG_OBJECT {
                val = JS_ToPrimitive(ctx, val, consts.HINT_NUMBER)
                if jstag.is_exception(val) != 0 {
                    mem.set_float64(pres, 0, tn_nan())
                    return 0 - 1
                }
                redo = 1
            } else {
                mem.set_float64(pres, 0, tn_nan())
                return 0
            }
        } else {
            int tag = jstag.get_special_tag(val)
            if tag == jstag.TAG_NULL || tag == jstag.TAG_BOOL {
                int sv = jstag.get_special_value(val)
                float d = sv
                mem.set_float64(pres, 0, d)
                return 0
            }
            if tag == jstag.TAG_UNDEFINED {
                mem.set_float64(pres, 0, tn_nan())
                return 0
            }
            if tag == jstag.TAG_STRING_CHAR {
                return js_atod1(ctx, pres, val, 0, consts.JS_ATOD_ACCEPT_BIN_OCT | consts.JS_ATOD_TOSTRING)
            }
            mem.set_float64(pres, 0, tn_nan())
            return 0
        }
    }
    mem.set_float64(pres, 0, tn_nan())
    return 0
}

// ===== from to_string.ae =====
// to_string ported from mquickjs.c: coerce a value to a string. Ints
// render via i32toa; short floats and heap floats via js_dtoa2; strings
// pass through; objects/short-functions reduce with JS_ToPrimitive
// (consts.HINT_STRING) and retry; null/undefined/true/false map to their atoms.
// The unreachable "[mtag N]" debug case goes through a small C shim.
// Provides the bare C symbol; C body removed.




ts_is_short_float(v: long) -> int { if (v & 7) == 5 { return 1 } return 0 }

// JSValue to_string(JSContext *ctx, JSValue val)
to_string(ctx: ptr, val: long) -> long {
    int redo = 1
    while redo != 0 {
        redo = 0
        if jstag.is_int(val) != 0 {
            int iv = val >> 1                      // JS_VALUE_GET_INT
            buf = malloc(32)
            long len = i32toa(buf, iv)
            mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(buf) + len), 0, 0)
            long r = JS_NewString(ctx, buf)
            free(buf)
            return r
        }
        if ts_is_short_float(val) != 0 {
            return js_dtoa2(ctx, js_get_short_float(val), 10, 0, consts.JS_DTOA_FORMAT_FREE)
        }
        if jstag.is_ptr(val) != 0 {
            p = jstag.value_to_ptr(val)
            int mtag = js_get_mtag(p)
            if mtag == consts.JS_MTAG_OBJECT {
                val = JS_ToPrimitive(ctx, val, consts.HINT_STRING)
                if jstag.is_exception(val) != 0 { return val }
                redo = 1
            } else { if mtag == consts.JS_MTAG_STRING {
                return val
            } else { if mtag == consts.JS_MTAG_FLOAT64 {
                return js_dtoa2(ctx, mem.get_float64(p, consts.JSFLOAT64_DVAL), 10, 0, consts.JS_DTOA_FORMAT_FREE)
            } else {
                return js_tostring_mtag_str(ctx, mtag)
            } } }
        } else {
            int tag = jstag.get_special_tag(val)
            if tag == jstag.TAG_NULL { return js_get_atom(ctx, consts.JS_ATOM_null) }
            if tag == jstag.TAG_UNDEFINED { return js_get_atom(ctx, consts.JS_ATOM_undefined) }
            if tag == jstag.TAG_BOOL {
                int sv = jstag.get_special_value(val)
                int atom = consts.JS_ATOM_false
                if sv != 0 { atom = consts.JS_ATOM_true }
                return js_get_atom(ctx, atom)
            }
            if tag == jstag.TAG_STRING_CHAR { return val }
            if tag == jstag.TAG_SHORT_FUNC {
                val = JS_ToPrimitive(ctx, val, consts.HINT_STRING)
                if jstag.is_exception(val) != 0 { return val }
                redo = 1
            } else {
                scratch = malloc(2)
                mem.set_byte(scratch, 0, 63)       // '?'
                mem.set_byte(mem.long_to_ptr(mem.ptr_to_long(scratch) + 1), 0, 0)
                long r = JS_NewString(ctx, scratch)
                free(scratch)
                return r
            }
        }
    }
    return jstag.JS_UNDEFINED
}

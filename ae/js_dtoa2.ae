// js_dtoa2 / js_atod1: the engine-facing wrappers around the dtoa.c
// number<->string converters. js_dtoa2 renders a double to a JS string using
// a freshly-allocated result buffer and a scratch temp-mem block. js_atod1
// parses a string to a double (handling the short-string-char fast path and
// the ToString whitespace rules). The multi-precision core (js_dtoa / js_atod
// / js_dtoa_max_len) stays in dtoa.c. Provide the bare C symbols; C bodies
// removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_dtoa_max_len(d: float, radix: int, n_digits: int, flags: int) -> int
extern js_dtoa(buf: ptr, d: float, radix: int, n_digits: int, flags: int, tmp_mem: ptr) -> int
extern js_atod(str: ptr, pnext: ptr, radix: int, flags: int, tmp_mem: ptr) -> float
extern js_alloc_byte_array(ctx: ptr, size: int) -> ptr
extern js_free(ctx: ptr, p: ptr)
extern js_byte_array_to_string(ctx: ptr, val: long, len: int, is_ascii: int) -> long
extern skip_spaces(p1: ptr) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_dtoa2, js_atod1)

const BA_BUF = 8
const STR_BUF = 8
const JS_ATOD_TOSTRING = 256       // 1<<8

d2_nan() -> float { return mem.float_from_bits(0x7ff8000000000000) }
d2_str_len(p: ptr) -> int { return mem.get_long(p, 0) >> 7 }

// JSValue js_dtoa2(JSContext *ctx, double d, int radix, int n_digits, int flags)
js_dtoa2(ctx: ptr, d: float, radix: int, n_digits: int, flags: int) -> long {
    int len_max = js_dtoa_max_len(d, radix, n_digits, flags)
    p = js_alloc_byte_array(ctx, len_max + 1)
    if p == null { return jstag.JS_EXCEPTION }
    long str = jstag.value_from_ptr(p)

    // GC-root str across the second allocation
    ref = malloc(16)
    mem.set_long(ref, 0, str)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    tmp_arr = js_alloc_byte_array(ctx, consts.SIZEOF_JSDTOATEMPMEM)
    str = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if tmp_arr == null { return jstag.JS_EXCEPTION }

    p = jstag.value_to_ptr(str)
    long pbuf = mem.ptr_to_long(p) + BA_BUF
    long tmpmem = mem.ptr_to_long(tmp_arr) + BA_BUF
    int len = js_dtoa(mem.long_to_ptr(pbuf), d, radix, n_digits, flags, mem.long_to_ptr(tmpmem))
    js_free(ctx, tmp_arr)
    return js_byte_array_to_string(ctx, str, len, 1)
}

// int js_atod1(JSContext *ctx, double *pres, JSValue val, int radix, int flags)
js_atod1(ctx: ptr, pres: ptr, val: long, radix: int, flags: int) -> int {
    if jstag.get_special_tag(val) == jstag.TAG_STRING_CHAR {
        int c = jstag.get_special_value(val)
        if c >= 48 && c <= 57 {
            mem.set_float64(pres, 0, c - 48)
        } else {
            mem.set_float64(pres, 0, d2_nan())
        }
        return 0
    }

    // GC-root val across js_alloc_byte_array
    ref = malloc(16)
    mem.set_long(ref, 0, val)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    tmp_arr = js_alloc_byte_array(ctx, consts.SIZEOF_JSATODTEMPMEM)
    val = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if tmp_arr == null {
        mem.set_float64(pres, 0, d2_nan())
        return 0 - 1
    }
    long tmpmem = mem.ptr_to_long(tmp_arr) + BA_BUF

    p = jstag.value_to_ptr(val)
    long pbuf = mem.ptr_to_long(p) + STR_BUF
    int plen = d2_str_len(p)
    long p1 = pbuf + skip_spaces(mem.long_to_ptr(pbuf))

    float d = d2_nan()
    int empty = 0
    if (p1 - pbuf) == plen {
        // matches the C: on an all-whitespace string it returns without
        // touching tmp_arr (GC reclaims it)
        if (flags & JS_ATOD_TOSTRING) != 0 { d = 0.0 } else { d = d2_nan() }
        empty = 1
    }

    if empty == 0 {
        pnext = malloc(8)
        d = js_atod(mem.long_to_ptr(p1), pnext, radix, flags, mem.long_to_ptr(tmpmem))
        long rend = mem.get_long(pnext, 0)
        free(pnext)
        js_free(ctx, tmp_arr)
        if (flags & JS_ATOD_TOSTRING) != 0 {
            long aftpos = rend + skip_spaces(mem.long_to_ptr(rend))
            if (aftpos - pbuf) < plen { d = d2_nan() }
        }
    }

    mem.set_float64(pres, 0, d)
    return 0
}

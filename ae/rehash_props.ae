// js_rehash_props ported from mquickjs.c: rebuild the hash chains of an
// object's property array (after a GC move, or after the layout changed).
// ROM property arrays are immutable and skipped. Walks the live property
// records, recomputing each key's bucket and prepending it to the chain.
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

exports (js_rehash_props)

// JSProperty stride 24 bytes (3 JSValues): key@0, (hash_next:30|prop_type:2)@16

rhp_short_int(v: long) -> long { return v << 1 }

// hash_prop(prop) = (prop/8) ^ (prop%8)  (JSW==8)
rhp_hash(prop: long) -> long {
    long q = prop / 8
    long r = prop % 8
    return q ^ r
}

// JS_IS_ROM_PTR(ctx, ptr): UNSIGNED (ptr < ctx) || (ptr >= ctx->stack_top).
// Aether longs are signed; bias by 2^63 to get an unsigned compare.
rhp_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
rhp_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_STACK_TOP))
    if rhp_ult(p, ctxl) != 0 { return 1 }
    if rhp_ult(p, stop) == 0 { return 1 }    // p >= stop
    return 0
}

// void js_rehash_props(JSContext *ctx, JSObject *p, BOOL gc_rehash)
js_rehash_props(ctx: ptr, p: ptr, gc_rehash: int) {
    long arrval = mem.get_long(p, consts.JSOBJ_PROPS)
    arr = jstag.value_to_ptr(arrval)
    long base = mem.ptr_to_long(arr) + consts.VA_ARR
    if rhp_is_rom(ctx, mem.ptr_to_long(arr)) != 0 { return }

    // hash_mask = JS_VALUE_GET_INT(arr[1]); prop_count = arr[0]
    int hash_mask = mem.get_long(mem.long_to_ptr(base + 8), 0) >> 1
    if hash_mask == 0 && gc_rehash != 0 { return }
    int prop_count = mem.get_long(mem.long_to_ptr(base), 0) >> 1

    // clear hash table
    int i = 0
    while i <= hash_mask {
        mem.set_long(mem.long_to_ptr(base + (2 + i) * 8), 0, rhp_short_int(0))
        i = i + 1
    }

    // rebuild chains over the live property records
    i = 0
    int j = 0
    while j < prop_count {
        long idx = 2 + (hash_mask + 1) + 3 * i
        long pr = base + idx * 8
        long key = mem.get_long(mem.long_to_ptr(pr + consts.PROP_KEY), 0)
        if key != jstag.JS_UNINITIALIZED {
            long h = rhp_hash(key) & hash_mask
            // pr->hash_next = arr[2+h] (prior chain head = a raw 2*idx value),
            // preserving prop_type in bits 30-31 of the u32 word.
            long head = mem.get_long(mem.long_to_ptr(base + (2 + h) * 8), 0)
            int oldword = mem.get_int(mem.long_to_ptr(pr + consts.PROP_HASH_NEXT), 0)
            long ptype = (oldword & 0xffffffff) & 0xc0000000
            long hn = (head & 0x3fffffff) | ptype
            mem.set_int(mem.long_to_ptr(pr + consts.PROP_HASH_NEXT), 0, hn)
            // arr[2+h] = JS_NewShortInt(idx)
            mem.set_long(mem.long_to_ptr(base + (2 + h) * 8), 0, rhp_short_int(idx))
            j = j + 1
        }
        i = i + 1
    }
}

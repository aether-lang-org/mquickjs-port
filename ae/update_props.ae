// js_update_props ported from mquickjs.c: when an object's properties
// still live in ROM (immutable), copy them to a fresh RAM property array
// so they can be mutated, converting JS_PROP_SPECIAL records (the ROM
// "prototype"/"constructor" slots) to normal values. Returns 0 on success
// (or if already in RAM), -1 on OOM. Provides the bare C symbol.

import std.mem
import ae.jstag
import ae.mqtypes

extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr
extern get_special_prop(ctx: ptr, val: long) -> long
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_update_props)

const JSOBJ_PROPS = 16
const JSCTX_STACK_TOP = 16
const JSCTX_TOP_GC_REF = 80
const VA_ARR = 8
const JS_PROP_SPECIAL = 3
// JSProperty: value@8, (hash_next:30|prop_type:2)@16
const PROP_VALUE = 8
const PROP_HASH_NEXT = 16

// JSValueArray.size = hdr >> 4
up_va_size(arr: ptr) -> int { long h = mem.get_long(arr, 0)  long s = h >> 4  return s }

// JS_IS_ROM_PTR via unsigned bias compare (Aether longs are signed)
up_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
up_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_STACK_TOP))
    if up_ult(p, ctxl) != 0 { return 1 }
    if up_ult(p, stop) == 0 { return 1 }
    return 0
}

// int js_update_props(JSContext *ctx, JSValue obj)
js_update_props(ctx: ptr, obj: long) -> int {
    p = jstag.value_to_ptr(obj)
    arr = jstag.value_to_ptr(mem.get_long(p, JSOBJ_PROPS))
    if up_is_rom(ctx, mem.ptr_to_long(arr)) == 0 { return 0 }

    int size = up_va_size(arr)

    // GC-root obj across js_alloc_value_array
    ref = malloc(16)
    mem.set_long(ref, 0, obj)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, JSCTX_TOP_GC_REF, ref)

    arr1 = js_alloc_value_array(ctx, 0, size)

    obj = mem.get_long(ref, 0)
    mem.set_ptr(ctx, JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)

    if arr1 == null { return 0 - 1 }

    // re-fetch arr (obj may have moved; arr is in ROM so stable, but obj's
    // props pointer is read fresh below)
    p = jstag.value_to_ptr(obj)
    arr = jstag.value_to_ptr(mem.get_long(p, JSOBJ_PROPS))

    long sbase = mem.ptr_to_long(arr) + VA_ARR
    long dbase = mem.ptr_to_long(arr1) + VA_ARR
    long nbytes = size
    memcpy(mem.long_to_ptr(dbase), mem.long_to_ptr(sbase), nbytes * 8)

    int prop_count = mem.get_long(mem.long_to_ptr(dbase), 0) >> 1
    int hash_mask = mem.get_long(mem.long_to_ptr(dbase + 8), 0) >> 1

    // convert JS_PROP_SPECIAL -> normal
    int i = 0
    while i < prop_count {
        long idx = 2 + (hash_mask + 1) + 3 * i
        long pr = dbase + idx * 8
        int word = mem.get_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0)
        long ptype = (word & 0xffffffff) >> 30
        ptype = ptype & 3
        if ptype == JS_PROP_SPECIAL {
            long nv = get_special_prop(ctx, mem.get_long(mem.long_to_ptr(pr + PROP_VALUE), 0))
            mem.set_long(mem.long_to_ptr(pr + PROP_VALUE), 0, nv)
            // prop_type = JS_PROP_NORMAL (0): clear bits 30-31
            int w2 = mem.get_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0)
            long cleared = (w2 & 0xffffffff) & 0x3fffffff
            mem.set_int(mem.long_to_ptr(pr + PROP_HASH_NEXT), 0, cleared)
        }
        i = i + 1
    }

    p = jstag.value_to_ptr(obj)
    mem.set_long(p, JSOBJ_PROPS, jstag.value_from_ptr(arr1))
    return 0
}

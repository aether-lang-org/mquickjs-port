// js_parse_regexp ported from mquickjs.c: compile a regexp source (already
// the parser's current input) into a JSByteArray of regexp bytecode. Sets the
// flag bits from re_flags, lays down the 4-byte header (flags, capture count,
// register count placeholders), an optional non-sticky ".*?" search prefix,
// the save_start/disjunction/save_end/match body, then back-patches the
// capture and register counts and shrinks the buffer. Returns the byte_code
// JSValue (or an exception if a sub-step threw). Provides the bare C symbol.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.reopcodes
import ae.consts

extern emit_u16(s: ptr, val: int)
extern emit_u8(s: ptr, val: int)
extern re_emit_op(s: ptr, op: int)
extern re_emit_op_u8(s: ptr, op: int, val: int)
extern re_emit_op_u32(s: ptr, op: int, val: int) -> int
extern js_parse_call(s: ptr, func_idx: int, param: int) -> int
extern re_compute_register_count(s: ptr, bc_buf: ptr, bc_buf_len: int) -> int
extern js_shrink_byte_array(ctx: ptr, pval: ptr, new_size: int)
extern js_parse_error_re_extraneous(s: ptr)

exports (js_parse_regexp)

const LRE_FLAG_IGNORECASE = 2     // 1<<1
const LRE_FLAG_MULTILINE = 4      // 1<<2
const LRE_FLAG_DOTALL = 8         // 1<<3
const LRE_FLAG_UNICODE = 16       // 1<<4
const LRE_FLAG_STICKY = 32        // 1<<5

const REOP_match = reopcodes.REOP_match
const REOP_save_start = reopcodes.REOP_save_start
const REOP_save_end = reopcodes.REOP_save_end
const REOP_any = reopcodes.REOP_any
const REOP_split_goto_first = reopcodes.REOP_split_goto_first
const REOP_goto = reopcodes.REOP_goto

const RE_HEADER_CAPTURE_COUNT = 2
const RE_HEADER_REGISTER_COUNT = 3
const RE_HEADER_LEN = 4

const PARSE_FUNC_re_parse_disjunction = 11
const VA_BUF = 8

// JSValue js_parse_regexp(JSParseState *s, int re_flags)
js_parse_regexp(s: ptr, re_flags: int) -> long {
    // set flag bits: preserve re_in_js (b0), write multi_line/dotall/
    // ignore_case/is_unicode into bits 1..4
    int fb = mem.get_byte(s, consts.JSPS_RE_FLAGS_BITS) & 1   // keep re_in_js
    if (re_flags & LRE_FLAG_MULTILINE) != 0 { fb = fb | 2 }
    if (re_flags & LRE_FLAG_DOTALL) != 0 { fb = fb | 4 }
    if (re_flags & LRE_FLAG_IGNORECASE) != 0 { fb = fb | 8 }
    if (re_flags & LRE_FLAG_UNICODE) != 0 { fb = fb | 16 }
    mem.set_byte(s, consts.JSPS_RE_FLAGS_BITS, fb)

    (s as *JSParseState).byte_code = jstag.JS_NULL
    (s as *JSParseState).byte_code_len = 0
    mem.set_byte(s, consts.JSPS_CAPTURE_COUNT, 1)

    emit_u16(s, re_flags)
    emit_u8(s, 0)   // number of captures
    emit_u8(s, 0)   // number of registers

    if (re_flags & LRE_FLAG_STICKY) == 0 {
        re_emit_op_u32(s, REOP_split_goto_first, 1 + 5)
        re_emit_op(s, REOP_any)
        re_emit_op_u32(s, REOP_goto, 0 - (5 + 1 + 5))
    }
    re_emit_op_u8(s, REOP_save_start, 0)

    js_parse_call(s, PARSE_FUNC_re_parse_disjunction, 0)

    re_emit_op_u8(s, REOP_save_end, 0)
    re_emit_op(s, REOP_match)

    if (s as *JSParseState).buf_pos != (s as *JSParseState).buf_len {
        js_parse_error_re_extraneous(s)
    }

    arr = jstag.value_to_ptr((s as *JSParseState).byte_code)
    long buf = mem.ptr_to_long(arr) + VA_BUF
    int cap = mem.get_byte(s, consts.JSPS_CAPTURE_COUNT) & 0xff
    mem.set_byte(mem.long_to_ptr(buf + RE_HEADER_CAPTURE_COUNT), 0, cap)

    int bcl = (s as *JSParseState).byte_code_len
    int register_count = re_compute_register_count(s, mem.long_to_ptr(buf + RE_HEADER_LEN), bcl - RE_HEADER_LEN)
    mem.set_byte(mem.long_to_ptr(buf + RE_HEADER_REGISTER_COUNT), 0, register_count)

    ctx = mem.get_ptr(s, consts.JSPS_CTX)
    js_shrink_byte_array(ctx, mem.long_to_ptr(mem.ptr_to_long(s) + 80), bcl)

    return (s as *JSParseState).byte_code
}

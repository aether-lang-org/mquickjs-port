// parse_stack_alloc / pop_break_entry ported from mquickjs.c. parse_stack_
// alloc GC-roots `val` across a parser stack-depth check (which may trigger a
// GC that relocates pointer values), reports a stack-overflow parse error if
// the engine stack is exhausted, and returns the possibly-relocated value.
// pop_break_entry pops the innermost break/continue BlockEnv off the engine
// value stack. Provide the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern JS_StackCheck(ctx: ptr, len: int) -> int
extern js_parse_error_stack_overflow(s: ptr)
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (parse_stack_alloc, pop_break_entry, push_break_entry)

const BE_PREV = 0
const BE_LABEL_NAME = 8
const BE_LABEL_BREAK = 16
const BE_LABEL_CONT = 24
const BE_LABEL_FINALLY = 32
const BE_DROP_COUNT = 40
const LABEL_NONE = 0 - 2      // JS_NewShortInt(-1)
const BLOCK_ENV_LEN = 6       // JSValue units

// BlockEnv *push_break_entry(JSParseState *s, JSValue label_name,
//                            JSValue label_break, JSValue label_cont, int drop_count)
push_break_entry(s: ptr, label_name: long, label_break: long, label_cont: long, drop_count: int) -> ptr {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)

    // GC-root label_name across the stack check
    ref = malloc(16)
    mem.set_long(ref, 0, label_name)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    int err = JS_StackCheck(ctx, BLOCK_ENV_LEN)
    label_name = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if err != 0 { js_parse_error_stack_overflow(s) }

    long sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP)) - consts.SIZEOF_BLOCKENV
    mem.set_ptr(ctx, consts.JSCTX_SP, mem.long_to_ptr(sp))
    long be = sp
    mem.set_long(mem.long_to_ptr(be + BE_PREV), 0, (s as *JSParseState).top_break)
    // SP_TO_VALUE(ctx, be) = JS_NewShortInt(be - ctx)
    (s as *JSParseState).top_break = (be - mem.ptr_to_long(ctx)) << 1
    mem.set_long(mem.long_to_ptr(be + BE_LABEL_NAME), 0, label_name)
    mem.set_long(mem.long_to_ptr(be + BE_LABEL_BREAK), 0, label_break)
    mem.set_long(mem.long_to_ptr(be + BE_LABEL_CONT), 0, label_cont)
    mem.set_long(mem.long_to_ptr(be + BE_LABEL_FINALLY), 0, LABEL_NONE)
    mem.set_long(mem.long_to_ptr(be + BE_DROP_COUNT), 0, drop_count << 1)   // JS_NewShortInt
    return mem.long_to_ptr(be)
}

// JSValue parse_stack_alloc(JSParseState *s, JSValue val)
parse_stack_alloc(s: ptr, val: long) -> long {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)

    // GC-root val across the stack check
    ref = malloc(16)
    mem.set_long(ref, 0, val)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    int err = JS_StackCheck(ctx, 1)
    val = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)

    if err != 0 { js_parse_error_stack_overflow(s) }
    return val
}

// void pop_break_entry(JSParseState *s): pop the innermost break/continue
// scope. top_break holds a stack offset (ctx + GET_INT) to the BlockEnv;
// restore top_break from its prev field and release its slot by raising
// both ctx->sp and ctx->stack_bottom past it.
pop_break_entry(s: ptr) {
    ctx = mem.get_ptr(s, consts.JSPS_CTX)
    long tb = (s as *JSParseState).top_break
    int off = jstag.get_int(tb)              // JS_VALUE_GET_INT
    long be = mem.ptr_to_long(ctx) + off
    (s as *JSParseState).top_break = mem.get_long(mem.long_to_ptr(be), 0)  // be->prev
    long new_sp = mem.ptr_to_long(mem.get_ptr(ctx, consts.JSCTX_SP)) + consts.SIZEOF_BLOCKENV
    mem.set_ptr(ctx, consts.JSCTX_SP, mem.long_to_ptr(new_sp))
    mem.set_ptr(ctx, consts.JSCTX_STACK_BOTTOM, mem.long_to_ptr(new_sp))
}

// js_string_compare ported from mquickjs.c: order two strings the way
// JS String comparison does — by UTF-16 code unit. Find the first
// differing byte; if the strings share a prefix, the shorter sorts first.
// At a difference, decode both code points and compare, accounting for
// the fact that UTF-8 byte order does not match UTF-16 order across the
// astral boundary (a code point >= 0x10000 begins with a high surrogate
// 0xd800..0xdbff in UTF-16, which sorts below 0xe000..). Provides the
// bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts
import ae.getpkg

extern string_get_cp(p: ptr) -> int
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_string_compare)


// JSString.len = header >> 7
str_len(p: ptr) -> int { return mem.get_long(p, 0) >> 7 }
min_int(a: int, b: int) -> int { if a < b { return a } return b }

// int js_string_compare(JSContext *ctx, JSValue val1, JSValue val2)
js_string_compare(ctx: ptr, val1: long, val2: long) -> int {
    buf1 = malloc(24)
    buf2 = malloc(24)
    p1 = getpkg.get_string_ptr(ctx, buf1, val1)
    p2 = getpkg.get_string_ptr(ctx, buf2, val2)
    int len1 = str_len(p1)
    int len2 = str_len(p2)
    int len = min_int(len1, len2)

    long b1 = mem.ptr_to_long(p1) + consts.STR_BUF
    long b2 = mem.ptr_to_long(p2) + consts.STR_BUF

    int res = 0
    // index of the first differing byte (-1 if the shared prefix is equal)
    int diff = 0 - 1
    int k = 0
    while k < len {
        int x = mem.get_byte(mem.long_to_ptr(b1 + k), 0)
        int y = mem.get_byte(mem.long_to_ptr(b2 + k), 0)
        if x != y {
            if diff < 0 { diff = k }
        }
        k = k + 1
    }

    if diff >= 0 {
        int c1 = string_get_cp(mem.long_to_ptr(b1 + diff))
        int c2 = string_get_cp(mem.long_to_ptr(b2 + diff))
        int both_bmp = 0
        if c1 < 0x10000 {
            if c2 < 0x10000 { both_bmp = 1 }
        }
        int both_astral = 0
        if c1 >= 0x10000 {
            if c2 >= 0x10000 { both_astral = 1 }
        }
        if both_bmp != 0 || both_astral != 0 {
            if c1 < c2 { res = 0 - 1 } else { res = 1 }
        } else {
            if c1 < 0x10000 {
                // p1 < p2 if same first UTF-16 char
                int hs = 0xd800 + ((c2 - 0x10000) >> 10)
                if c1 <= hs { res = 0 - 1 } else { res = 1 }
            } else {
                int hs = 0xd800 + ((c1 - 0x10000) >> 10)
                if hs < c2 { res = 0 - 1 } else { res = 1 }
            }
        }
    } else {
        if len1 == len2 { res = 0 }
        else { if len1 < len2 { res = 0 - 1 } else { res = 1 } }
    }

    free(buf1)
    free(buf2)
    return res
}

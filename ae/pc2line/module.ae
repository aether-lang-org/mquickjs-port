// pc2line — merged package (auto-assembled from 2 files).

import ae.consts
import ae.jstag
import ae.mqtypes
import ae.vstore
import std.mem

extern js_parse_error_mem(s: ptr)

exports (
    get_bit, get_bits_slow, get_bits, get_ugolomb, get_sgolomb,
    get_pc2line, get_pc2line_hoisted_code_len, pc2line_put_bits_short, pc2line_put_bits, put_ugolomb,
    put_sgolomb
)

// ===== from pc2line.ae =====
// Bitstream + pc2line decoders — a self-contained stateless cluster
// ported from mquickjs.c. Reads the Golomb-coded line/column debug
// info attached to compiled functions. All functions operate over a
// raw byte buffer with no engine state; uint32_t* out-params are real
// caller pointers written via std.mem.
//
// These present the same bare C ABI symbols the engine links against
// (get_bit, get_bits, get_bits_slow, get_ugolomb, get_sgolomb,
// get_pc2line, get_pc2line_hoisted_code_len), so the corresponding C
// bodies are removed from mquickjs.c.




// uint32_t get_bit(const uint8_t *buf, uint32_t index)
get_bit(buf: ptr, index: int) -> int {
    long idx = index & 0xffffffff
    int bv = mem.get_byte(buf, idx >> 3)
    return (bv >> (7 - (idx & 7))) & 1
}

// uint32_t get_bits_slow(const uint8_t *buf, uint32_t index, int n)
get_bits_slow(buf: ptr, index: int, n: int) -> int {
    long val = 0
    int i = 0
    while i < n {
        long bit = get_bit(buf, index + i)
        val = val | (bit << (n - 1 - i))
        i = i + 1
    }
    return val
}

// uint32_t get_bits(const uint8_t *buf, uint32_t buf_len, uint32_t index, int n)
get_bits(buf: ptr, buf_len: int, index: int, n: int) -> int {
    long lidx = index & 0xffffffff
    long llen = buf_len & 0xffffffff
    long pos = lidx >> 3
    if n > 25 { return get_bits_slow(buf, index, n) }
    if (pos + 3) >= llen { return get_bits_slow(buf, index, n) }
    // fast case: 32-bit big-endian load at pos
    long val = mem.get_u32_be(buf, pos)
    long shift = 32 - (lidx & 7) - n
    long mask = (1 << n) - 1
    return (val >> shift) & mask
}

// uint32_t get_ugolomb(const uint8_t *buf, uint32_t buf_len, uint32_t *pindex)
get_ugolomb(buf: ptr, buf_len: int, pindex: ptr) -> int {
    long index = mem.get_uint32(pindex, 0) & 0xffffffff
    int i = 0
    int done = 0
    while done == 0 {
        int b = get_bit(buf, index)
        index = index + 1
        if b != 0 { done = 1 }
        else {
            i = i + 1
            if i == 32 {
                mem.set_uint32(pindex, 0, index)
                return 0 - 1   // 0xffffffff as uint32
            }
        }
    }
    long v = 0
    if i == 0 {
        v = 0
    } else {
        long hibit = 1 << i
        long lowbits = get_bits(buf, buf_len, index, i) & 0xffffffff
        v = (hibit | lowbits) - 1
        index = index + i
    }
    mem.set_uint32(pindex, 0, index)
    return v
}

// int32_t get_sgolomb(const uint8_t *buf, uint32_t buf_len, uint32_t *pindex)
// returns (val >> 1) ^ -(val & 1) — zigzag decode
get_sgolomb(buf: ptr, buf_len: int, pindex: ptr) -> int {
    long val = get_ugolomb(buf, buf_len, pindex) & 0xffffffff
    long neg = 0 - (val & 1)
    return (val >> 1) ^ neg
}

// void get_pc2line(int *pline_num, int *pcol_num, const uint8_t *buf,
//                  uint32_t buf_len, uint32_t *pindex, BOOL has_column)
get_pc2line(pline_num: ptr, pcol_num: ptr, buf: ptr, buf_len: int, pindex: ptr, has_column: int) {
    int line_num = mem.get_int(pline_num, 0)
    int col_num = mem.get_int(pcol_num, 0)

    int line_delta = get_sgolomb(buf, buf_len, pindex)
    line_num = line_num + line_delta
    if has_column != 0 {
        if line_delta == 0 {
            int col_delta = get_sgolomb(buf, buf_len, pindex)
            col_num = col_num + col_delta
        } else {
            col_num = get_ugolomb(buf, buf_len, pindex) + 1
        }
    } else {
        col_num = 0
    }
    mem.set_int(pline_num, 0, line_num)
    mem.set_int(pcol_num, 0, col_num)
}

// int get_pc2line_hoisted_code_len(const uint8_t *buf, size_t buf_len)
get_pc2line_hoisted_code_len(buf: ptr, buf_len: long) -> int {
    long i = buf_len
    int v = 0
    while i > 0 {
        i = i - 1
        int bv = mem.get_byte(buf, i)
        v = (v << 7) | (bv & 0x7f)
        if (bv & 0x80) == 0 { break }
    }
    return v
}

// ===== from pc2line_emit.ae =====
// pc2line bit-writers ported from mquickjs.c (the codegen counterparts of
// the ae/pc2line.ae decoders). pc2line_put_bits_short/pc2line_put_bits
// append n bits to the current function's pc2line bitstream, growing the
// backing JSByteArray as needed; put_ugolomb/put_sgolomb append a value
// in the (un)signed Golomb code used for line/column deltas. Provides the
// bare C symbols; C bodies removed.






// get_be32 / put_be32 on a raw byte pointer.
get_be32(p: long) -> long {
    long b0 = mem.get_byte(mem.long_to_ptr(p), 0) & 0xff
    long b1 = mem.get_byte(mem.long_to_ptr(p + 1), 0) & 0xff
    long b2 = mem.get_byte(mem.long_to_ptr(p + 2), 0) & 0xff
    long b3 = mem.get_byte(mem.long_to_ptr(p + 3), 0) & 0xff
    long hi = b0 << 24
    long r = hi | (b1 << 16)
    r = r | (b2 << 8)
    r = r | b3
    return r
}
put_be32(p: long, v: long) {
    mem.set_byte(mem.long_to_ptr(p), 0, (v >> 24) & 0xff)
    mem.set_byte(mem.long_to_ptr(p + 1), 0, (v >> 16) & 0xff)
    mem.set_byte(mem.long_to_ptr(p + 2), 0, (v >> 8) & 0xff)
    mem.set_byte(mem.long_to_ptr(p + 3), 0, v & 0xff)
}

// precondition: 1 <= n <= 25
pc2line_put_bits_short(s: ptr, n: int, bits: int) {
    long index = (s as *JSParseState).pc2line_bit_len & 0xffffffff
    long pos = index >> 3

    // grow b->pc2line to pos+4
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    long ipos = pos
    long val1 = vstore.js_resize_byte_array((s as *JSParseState).ctx,
                                     (b as *JSFunctionBytecode).pc2line, ipos + 4)
    if jstag.is_exception(val1) != 0 { js_parse_error_mem(s) }
    b = jstag.value_to_ptr((s as *JSParseState).cur_func)
    (b as *JSFunctionBytecode).pc2line = val1

    arr = jstag.value_to_ptr(val1)
    long p = mem.ptr_to_long(arr) + consts.BA_BUF + pos
    long val = get_be32(p)
    long nn = n
    int shift = 32 - (index & 7) - n
    // reset the n bits: val &= ~(((1<<n)-1) << shift)
    long ones = (1 << nn) - 1
    long mask = ones << shift
    long notmask = (0 - 1) ^ mask
    val = val & notmask
    long bl = bits & 0xffffffff
    long placed = bl << shift
    val = val | placed
    val = val & 0xffffffff
    put_be32(p, val)
    (s as *JSParseState).pc2line_bit_len = index + n
}

// precondition: 1 <= n <= 32
pc2line_put_bits(s: ptr, n: int, bits: int) {
    int n_max = 25
    int nn = n
    int b = bits
    if nn > n_max {
        long bhi = (bits & 0xffffffff) >> n_max
        pc2line_put_bits_short(s, nn - n_max, bhi)
        long lowmask = (1 << n_max) - 1
        b = b & lowmask
        nn = n_max
    }
    pc2line_put_bits_short(s, nn, b)
}

// 0 <= v < 2^32-1
put_ugolomb(s: ptr, v: int) {
    long vv = (v & 0xffffffff) + 1
    int n = 32 - mem.clz32(vv)
    if n > 1 { pc2line_put_bits(s, n - 1, 0) }
    pc2line_put_bits(s, n, vv)
}

// v != -2^31
put_sgolomb(s: ptr, v1: int) {
    // (2*v) ^ -(v>>31): v>>31 is the top bit of the uint32 (== sign of v1),
    // negated to 0 or 0xffffffff.
    long v = v1 & 0xffffffff
    long twov = (v << 1) & 0xffffffff
    long neg = 0
    if v1 < 0 { neg = 0xffffffff }
    long code = (twov ^ neg) & 0xffffffff
    put_ugolomb(s, code)
}

// js_compact_props ported from mquickjs.c: shrink an object's property
// array after deletions by squeezing out JS_UNINITIALIZED records and
// reducing the hash table to fit the live count, then rehash. No-op if
// already minimal. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern get_prop_hash_size_log2(prop_count: int) -> int
extern js_shrink_value_array(ctx: ptr, pval: ptr, new_size: int)
extern js_rehash_props(ctx: ptr, p: ptr, gc_rehash: int)

exports (js_compact_props)


cp_short_int(v: long) -> long { return v << 1 }
cp_min(a: int, b: int) -> int { if a < b { return a } return b }
// JSValueArray.size = hdr >> 4
cp_va_size(arr: ptr) -> int { long h = mem.get_long(arr, 0)  long s = h >> 4  return s }

// void js_compact_props(JSContext *ctx, JSObject *p)
js_compact_props(ctx: ptr, p: ptr) {
    long arrval = mem.get_long(p, consts.JSOBJ_PROPS)
    arr = jstag.value_to_ptr(arrval)
    long base = mem.ptr_to_long(arr) + consts.VA_ARR

    int prop_count = mem.get_long(mem.long_to_ptr(base), 0) >> 1
    if prop_count == 0 {
        long empty = mem.get_long(ctx, consts.JSCTX_EMPTY_PROPS)
        if arrval != empty {
            mem.set_long(p, consts.JSOBJ_PROPS, empty)
        }
        return
    }

    int hash_mask = mem.get_long(mem.long_to_ptr(base + 8), 0) >> 1
    int hash_size_log2 = get_prop_hash_size_log2(prop_count)
    int new_hash_mask = cp_min(hash_mask, (1 << hash_size_log2) - 1)
    int new_size = 2 + new_hash_mask + 1 + 3 * prop_count
    if new_size >= cp_va_size(arr) { return }

    long nhm = new_hash_mask
    mem.set_long(mem.long_to_ptr(base + 8), 0, cp_short_int(nhm))

    // move live properties, skipping deleted (JS_UNINITIALIZED) ones
    int i = 0
    int j = 0
    while j < prop_count {
        long src = base + (2 + (hash_mask + 1) + 3 * i) * 8
        long key = mem.get_long(mem.long_to_ptr(src), 0)
        if key != jstag.JS_UNINITIALIZED {
            long dst = base + (2 + (new_hash_mask + 1) + 3 * j) * 8
            // *pr1 = *pr : copy 3 JSValues (24 bytes)
            mem.set_long(mem.long_to_ptr(dst), 0, mem.get_long(mem.long_to_ptr(src), 0))
            mem.set_long(mem.long_to_ptr(dst + 8), 0, mem.get_long(mem.long_to_ptr(src + 8), 0))
            mem.set_long(mem.long_to_ptr(dst + 16), 0, mem.get_long(mem.long_to_ptr(src + 16), 0))
            j = j + 1
        }
        i = i + 1
    }

    // js_shrink_value_array(ctx, &p->props, new_size)
    js_shrink_value_array(ctx, mem.long_to_ptr(mem.ptr_to_long(p) + consts.JSOBJ_PROPS), new_size)
    js_rehash_props(ctx, p, 0)
}

// add_global_var ported from mquickjs.c: ensure a binding for a global
// variable named `prop` exists on the global object. If an own property
// already exists it must be a var-ref (else a ReferenceError); when defining,
// an uninitialized var-ref slot is promoted to undefined, and the var-ref
// value is returned. If no property exists it is created via
// define.JS_DefinePropertyInternal as undefined (define) or uninitialized (declare).
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts
import ae.define

extern find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr
extern js_throw_global_not_ref(ctx: ptr, prop: long) -> long

exports (add_global_var)


agv_prop_type(pr: ptr) -> int {
    return (pr as *JSProperty).prop_type
}

// JSValue add_global_var(JSContext *ctx, JSValue prop, BOOL define_flag)
add_global_var(ctx: ptr, prop: long, define_flag: int) -> long {
    long gobj = (ctx as *JSContext).global_obj
    p = jstag.value_to_ptr(gobj)
    pr = find_own_property(ctx, p, prop)
    if mem.ptr_to_long(pr) != 0 {
        if agv_prop_type(pr) != consts.JS_PROP_VARREF {
            return js_throw_global_not_ref(ctx, prop)
        }
        long pval = (pr as *JSProperty).value
        if define_flag != 0 {
            pv = jstag.value_to_ptr(pval)
            if mem.get_long(pv, consts.VARREF_VALUE) == jstag.JS_UNINITIALIZED {
                mem.set_long(pv, consts.VARREF_VALUE, jstag.JS_UNDEFINED)
            }
        }
        return pval
    }
    long initial = jstag.JS_UNINITIALIZED
    if define_flag != 0 { initial = jstag.JS_UNDEFINED }
    return define.JS_DefinePropertyInternal(ctx, gobj, prop, initial, jstag.JS_NULL,
                                     consts.JS_DEF_PROP_RET_VAL | consts.JS_DEF_PROP_HAS_VALUE)
}

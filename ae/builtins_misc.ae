// Assorted numeric / predicate builtins ported from mquickjs.c. Each
// is a JSCFunction (ctx, this_val, argc, argv) -> JSValue. They call
// into the engine's coercion API (JS_ToNumber/Int32/Uint32, JS_NewInt32,
// JS_IsArray) via extern; out-params use the malloc-slot idiom. argv is
// a JSValue array (8-byte elements). Provides the bare C symbols.

import std.mem
import ae.jstag

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToUint32(ctx: ptr, pres: ptr, val: long) -> int
extern JS_NewInt32(ctx: ptr, val: int) -> long
extern JS_IsArray(ctx: ptr, val: long) -> int

exports (
    js_array_isArray, js_global_isNaN, js_global_isFinite,
    js_math_clz32, js_math_imul
)

const EXP_MASK = 0x7ff0000000000000
const MANT_MASK = 0x000fffffffffffff

// isnan: exponent all-ones and mantissa nonzero (math.h isnan is a macro)
f_isnan(d: float) -> int {
    long bits = mem.bits_of_float(d)
    if (bits & EXP_MASK) == EXP_MASK {
        if (bits & MANT_MASK) != 0 { return 1 }
    }
    return 0
}

// isfinite: exponent not all-ones
f_isfinite(d: float) -> int {
    long bits = mem.bits_of_float(d)
    if (bits & EXP_MASK) == EXP_MASK { return 0 }
    return 1
}

argv_get(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// JSValue js_array_isArray(ctx, this_val, argc, argv)
js_array_isArray(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int r = JS_IsArray(ctx, argv_get(argv, 0))
    return jstag.new_bool(r)
}

// JSValue js_global_isNaN(ctx, this_val, argc, argv)
js_global_isNaN(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    slot = malloc(8)
    int err = JS_ToNumber(ctx, slot, argv_get(argv, 0))
    if err != 0 { free(slot)  return jstag.JS_EXCEPTION }
    float d = mem.get_float64(slot, 0)
    free(slot)
    return jstag.new_bool(f_isnan(d))
}

// JSValue js_global_isFinite(ctx, this_val, argc, argv)
js_global_isFinite(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    slot = malloc(8)
    int err = JS_ToNumber(ctx, slot, argv_get(argv, 0))
    if err != 0 { free(slot)  return jstag.JS_EXCEPTION }
    float d = mem.get_float64(slot, 0)
    free(slot)
    return jstag.new_bool(f_isfinite(d))
}

// JSValue js_math_clz32(ctx, this_val, argc, argv)
js_math_clz32(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    slot = malloc(8)
    int err = JS_ToUint32(ctx, slot, argv_get(argv, 0))
    if err != 0 { free(slot)  return jstag.JS_EXCEPTION }
    long a = mem.get_uint32(slot, 0) & 0xffffffff
    free(slot)
    int r = 32
    if a != 0 { r = mem.clz32(a) }
    return JS_NewInt32(ctx, r)
}

// JSValue js_math_imul(ctx, this_val, argc, argv) — 32-bit wraparound mul
js_math_imul(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    slot = malloc(8)
    int erra = JS_ToInt32(ctx, slot, argv_get(argv, 0))
    if erra != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int a = mem.get_int(slot, 0)
    int errb = JS_ToInt32(ctx, slot, argv_get(argv, 1))
    if errb != 0 { free(slot)  return jstag.JS_EXCEPTION }
    int b = mem.get_int(slot, 0)
    free(slot)
    // (uint32_t)a * (uint32_t)b, truncated to 32 bits
    long prod = (a & 0xffffffff) * (b & 0xffffffff)
    int r = prod & 0xffffffff
    return JS_NewInt32(ctx, r)
}

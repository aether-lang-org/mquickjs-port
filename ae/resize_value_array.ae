// js_resize_value_array2 ported from mquickjs.c: grow a JSValueArray
// (1.5x growth, optional multiple-of-3 alignment for property tables),
// GC-rooting the old value across the allocation and copying the live
// slots over. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_resize_value_array2)

const HEADER = 8

va_size(arrval: long) -> int {
    long p = mem.ptr_to_long(jstag.value_to_ptr(arrval))
    return mem.get_long(mem.long_to_ptr(p), 0) >> 4
}
max_int(a: int, b: int) -> int { if a > b { return a } return b }

// JSValue js_resize_value_array2(JSContext *ctx, JSValue val, int new_size, int prop_base)
js_resize_value_array2(ctx: ptr, val: long, new_size: int, prop_base: int) -> long {
    int old_size = 0
    if val != jstag.JS_NULL { old_size = va_size(val) }

    if new_size > old_size {
        int new_size1 = old_size + old_size / 2
        if new_size1 > new_size {
            new_size = new_size1
            if prop_base != 0 {
                int align = (new_size - prop_base) - ((new_size - prop_base) / 3) * 3   // % 3
                if align != 0 { new_size = new_size + (3 - align) }
            }
        }
        new_size = max_int(new_size, old_size + old_size / 2)

        // GC-root val across js_alloc_value_array
        ref = malloc(16)
        mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
        mem.set_long(ref, 0, val)

        new_slots = js_alloc_value_array(ctx, old_size, new_size)

        val = mem.get_long(ref, 0)
        mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
        free(ref)

        if new_slots == null { return jstag.JS_EXCEPTION }
        if old_size > 0 {
            slots = jstag.value_to_ptr(val)
            memcpy(mem.long_to_ptr(mem.ptr_to_long(new_slots) + HEADER),
                   mem.long_to_ptr(mem.ptr_to_long(slots) + HEADER),
                   old_size * 8)
        }
        val = jstag.value_from_ptr(new_slots)
    }
    return val
}

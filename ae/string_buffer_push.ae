// string_buffer_push ported from mquickjs.c: initialise a StringBuffer
// and push its backing JSGCRef onto the context's GC-root chain. For a
// nonzero hint it allocates a byte array; otherwise it starts from the
// interned empty atom. Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_alloc_byte_array(ctx: ptr, size: int) -> ptr
extern js_get_atom(ctx: ptr, a: int) -> long

exports (string_buffer_push)

// StringBuffer: buffer_ref{val@0, prev@8}, len@16, is_ascii@20

// int string_buffer_push(JSContext *ctx, StringBuffer *s, int len)
string_buffer_push(ctx: ptr, s: ptr, len: int) -> int {
    mem.set_int(s, consts.SB_LEN, 0)
    mem.set_int(s, consts.SB_IS_ASCII, 1)
    if len > 0 {
        arr = js_alloc_byte_array(ctx, len)
        if arr == null { return 0 - 1 }
        mem.set_long(s, consts.SB_VAL, jstag.value_from_ptr(arr))
    } else {
        mem.set_long(s, consts.SB_VAL, js_get_atom(ctx, consts.JS_ATOM_empty))
    }
    // s->buffer_ref.prev = ctx->top_gc_ref; ctx->top_gc_ref = &s->buffer_ref
    mem.set_ptr(s, consts.SB_PREV, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, s)
    return 0
}

// gc_thread_pointer ported from mquickjs.c: the pointer-threading step of
// the compacting GC. For a heap (non-ROM) pointer slot *pval, swap the
// slot's value with the target block's header and leave a threaded
// back-pointer (tagged pval) in the target so the block can later be
// relocated and all referrers fixed up. Provides the bare C symbol.

import std.mem
import ae.jstag
import ae.mqtypes

exports (gc_thread_pointer)

const JSCTX_STACK_TOP = 16

// JS_IS_ROM_PTR(ctx,ptr) = ptr < ctx || ptr >= ctx->stack_top, UNSIGNED.
// Aether longs are signed; bias by 2^63 for an unsigned compare.
gtp_ult(a: long, b: long) -> int {
    long bias = 0x8000000000000000
    long ab = a ^ bias
    long bb = b ^ bias
    if ab < bb { return 1 }
    return 0
}
gtp_is_rom(ctx: ptr, p: long) -> int {
    long ctxl = mem.ptr_to_long(ctx)
    long stop = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_STACK_TOP))
    if gtp_ult(p, ctxl) != 0 { return 1 }
    if gtp_ult(p, stop) == 0 { return 1 }    // p >= stop
    return 0
}

// void gc_thread_pointer(JSContext *ctx, JSValue *pval)
gc_thread_pointer(ctx: ptr, pval: ptr) {
    long val = mem.get_long(pval, 0)            // *pval
    if jstag.is_ptr(val) == 0 { return }
    tgt = jstag.value_to_ptr(val)               // JS_VALUE_TO_PTR(val)
    if gtp_is_rom(ctx, mem.ptr_to_long(tgt)) != 0 { return }
    // *pval = *ptr ; *ptr = js_value_from_pval(ctx, pval)
    mem.set_long(pval, 0, mem.get_long(tgt, 0))
    mem.set_long(tgt, 0, jstag.value_from_ptr(pval))
}

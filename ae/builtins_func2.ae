// More Function builtins ported from mquickjs.c: the length/name
// getter, toString, and the Function() constructor (which builds a
// source string and evals it). Provides the bare C symbols; C bodies
// removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_function_get_length_name1(ctx: ptr, this_val: ptr, is_name: int, pb: ptr) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern JS_NewString(ctx: ptr, buf: ptr) -> long
extern JS_ConcatString(ctx: ptr, val1: long, val2: long) -> long
extern string_buffer_push(ctx: ptr, s: ptr, len: int) -> int
extern string_buffer_putc(ctx: ptr, s: ptr, c: int) -> int
extern string_buffer_puts(ctx: ptr, s: ptr, str: ptr) -> int
extern string_buffer_concat(ctx: ptr, s: ptr, val2: long) -> int
extern string_buffer_pop(ctx: ptr, s: ptr) -> long
extern JS_Parse2(ctx: ptr, source_str: long, input: ptr, input_len: long, filename: ptr, eval_flags: int) -> long
extern JS_Run(ctx: ptr, val: long) -> long
extern JS_NewObject(ctx: ptr) -> long
extern JS_DefinePropertyValue(ctx: ptr, obj: long, prop: long, val: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern js_alloc_value_array(ctx: ptr, init_base: int, new_size: int) -> ptr
extern JS_NewCFunctionParams(ctx: ptr, func_idx: int, params: long) -> long
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)

exports (js_function_get_length_name, js_function_toString, js_function_constructor, js_function_get_prototype, js_function_bind, js_function_bound)

const TAG_SHORT_FUNC = 19
const TAG_EXCEPTION = 15

ctx_top(ctx: ptr) -> ptr { return (ctx as *JSContext).top_gc_ref }
ctx_set_top(ctx: ptr, v: ptr) { (ctx as *JSContext).top_gc_ref = v }
gc_push(ctx: ptr, ref: ptr, v: long) {
    mem.set_ptr(ref, consts.GCREF_PREV, ctx_top(ctx))
    ctx_set_top(ctx, ref)
    mem.set_long(ref, consts.GCREF_VAL, v)
}
gc_pop(ctx: ptr, ref: ptr) -> long {
    long v = mem.get_long(ref, consts.GCREF_VAL)
    ctx_set_top(ctx, mem.get_ptr(ref, consts.GCREF_PREV))
    return v
}

// JSValue js_function_get_length_name(ctx, this_val, argc, argv, is_name)
js_function_get_length_name(ctx: ptr, this_val: ptr, argc: int, argv: ptr, is_name: int) -> long {
    bslot = malloc(8)
    long ret = js_function_get_length_name1(ctx, this_val, is_name, bslot)
    free(bslot)
    if jstag.is_null(ret) != 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }
    return ret
}

// JSValue js_function_toString(ctx, this_val, argc, argv)
js_function_toString(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    bslot = malloc(8)
    long str = js_function_get_length_name1(ctx, this_val, 1, bslot)
    free(bslot)
    if jstag.is_exception(str) != 0 { return str }

    str_ref = malloc(16)
    gc_push(ctx, str_ref, str)
    long val = JS_NewString(ctx, "function ")
    str = gc_pop(ctx, str_ref)
    str = JS_ConcatString(ctx, val, str)
    gc_push(ctx, str_ref, str)
    val = JS_NewString(ctx, "() {\n    [native code]\n}")
    str = gc_pop(ctx, str_ref)
    free(str_ref)
    return JS_ConcatString(ctx, str, val)
}

// JSValue js_function_constructor(ctx, this_val, argc, argv)
js_function_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int a = argc & (0 - 1 - consts.FRAME_CF_CTOR)
    b = malloc(24)
    string_buffer_push(ctx, b, 0)
    string_buffer_puts(ctx, b, "(function anonymous(")
    int n = a - 1
    int i = 0
    int failed = 0
    while i < n {
        if i != 0 { string_buffer_putc(ctx, b, 44) }   // ','
        if string_buffer_concat(ctx, b, mem.get_long(argv, i * 8)) != 0 { failed = 1  i = n }
        else { i = i + 1 }
    }
    if failed == 0 {
        string_buffer_puts(ctx, b, "\n) {\n")
        if n >= 0 {
            if string_buffer_concat(ctx, b, mem.get_long(argv, n * 8)) != 0 { failed = 1 }
        }
    }
    if failed == 0 {
        string_buffer_puts(ctx, b, "\n})")
    }
    long val = string_buffer_pop(ctx, b)
    free(b)
    if jstag.is_exception(val) != 0 { return val }
    val = JS_Parse2(ctx, val, null, 0, "<input>", consts.JS_EVAL_RETVAL)
    if jstag.is_exception(val) != 0 { return val }
    return JS_Run(ctx, val)
}

// JSValue js_function_get_prototype(ctx, this_val, argc, argv)
js_function_get_prototype(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    long obj = 0
    if jstag.is_ptr(tv) == 0 {
        // short-func -> undefined, else fail
        if jstag.get_special_tag(tv) != TAG_SHORT_FUNC {
            return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
        }
        return jstag.JS_UNDEFINED
    }
    p = jstag.value_to_ptr(tv)
    int mtag = (p as *JSString).mtag   // header mtag
    if mtag != consts.MTAG_OBJECT {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }
    int cid = (p as *JSObject).class_id
    if cid == consts.JS_CLASS_CLOSURE {
        obj = JS_NewObject(ctx)
        if jstag.is_exception(obj) != 0 { return obj }
    } else if cid == consts.JS_CLASS_C_FUNCTION {
        return jstag.JS_UNDEFINED
    } else {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }

    obj_ref = malloc(16)
    gc_push(ctx, obj_ref, obj)
    JS_DefinePropertyValue(ctx, mem.get_long(obj_ref, consts.GCREF_VAL), js_get_atom(ctx, consts.JS_ATOM_constructor), mem.get_long(this_val, 0))
    JS_DefinePropertyValue(ctx, mem.get_long(this_val, 0), js_get_atom(ctx, consts.JS_ATOM_prototype), mem.get_long(obj_ref, consts.GCREF_VAL))
    long result = gc_pop(ctx, obj_ref)
    free(obj_ref)
    return result
}

new_tail_call(val: int) -> long {
    return jstag.make_special(TAG_EXCEPTION, consts.JS_EX_CALL + val)
}

// JSValue js_function_bind(ctx, this_val, argc, argv)
js_function_bind(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int arg_count = argc - 1
    if arg_count < 0 { arg_count = 0 }
    arr = js_alloc_value_array(ctx, 0, 2 + arg_count)
    if arr == null { return jstag.JS_EXCEPTION }
    long tail = mem.ptr_to_long(arr) + 8
    mem.set_long(mem.long_to_ptr(tail), 0, mem.get_long(this_val, 0))   // arr[0] = func
    int i = 0
    while i < (arg_count + 1) {
        mem.set_long(mem.long_to_ptr(tail + (1 + i) * 8), 0, mem.get_long(argv, i * 8))
        i = i + 1
    }
    return JS_NewCFunctionParams(ctx, consts.JS_CFUNCTION_bound, jstag.value_from_ptr(arr))
}

// JSValue js_function_bound(ctx, this_val, argc, argv, params)
js_function_bound(ctx: ptr, this_val: ptr, argc: int, argv: ptr, params: long) -> long {
    arr = jstag.value_to_ptr(params)
    // JSValueArray.size: header bits 4..63 (uint64 @0 >> 4)
    long hdr = mem.get_long(arr, 0)
    int size = (hdr >> 4) & 0xfffffff
    params_ref = malloc(16)
    gc_push(ctx, params_ref, params)
    int err = JS_StackCheck(ctx, size + argc)
    long params2 = gc_pop(ctx, params_ref)
    free(params_ref)
    if err != 0 { return jstag.JS_EXCEPTION }
    int argc2 = size - 2 + argc
    if argc2 > consts.JS_MAX_ARGC { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "too many call arguments") }
    arr = jstag.value_to_ptr(params2)
    long tail = mem.ptr_to_long(arr) + 8
    int i = argc - 1
    while i >= 0 {
        JS_PushArg(ctx, mem.get_long(argv, i * 8))
        i = i - 1
    }
    i = size - 1
    while i >= 2 {
        JS_PushArg(ctx, mem.get_long(mem.long_to_ptr(tail + i * 8), 0))
        i = i - 1
    }
    JS_PushArg(ctx, mem.get_long(mem.long_to_ptr(tail), 0))         // func (arr[0])
    JS_PushArg(ctx, mem.get_long(mem.long_to_ptr(tail + 8), 0))     // this (arr[1])
    return new_tail_call(argc2)
}

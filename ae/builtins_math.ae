// Math builtins ported from mquickjs.c: sign, fround, atan2, pow,
// random, min/max. Float results box through JS_NewFloat64; the int
// fast path in min/max uses the short-int tag directly. js_atan2/js_pow
// come from libm; xorshift64star and js_fmin/js_fmax are already Aether.
// Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.jsutil2   // xorshift64star
import ae.jshelpers // js_fmin, js_fmax
import ae.consts

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern js_atan2(y: float, x: float) -> float
extern js_pow(x: float, y: float) -> float

exports (
    js_math_sign, js_math_fround, js_math_atan2, js_math_pow,
    js_math_random, js_math_min_max
)


f_isnan(d: float) -> int {
    long bits = mem.bits_of_float(d)
    if (bits & consts.EXP_MASK) == consts.EXP_MASK {
        if (bits & consts.MANT_MASK) != 0 { return 1 }
    }
    return 0
}

argv_get(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// double js_math_sign(double a)
js_math_sign(a: float) -> float {
    if f_isnan(a) != 0 { return a }
    if a == 0.0 { return a }
    if a < 0.0 { return 0.0 - 1.0 }
    return 1.0
}

// double js_math_fround(double a) — round to float32 precision
js_math_fround(a: float) -> float {
    slot = malloc(8)
    mem.set_float32(slot, 0, a)
    float r = mem.get_float32(slot, 0)
    free(slot)
    return r
}

// JSValue js_math_atan2(ctx, this_val, argc, argv)
js_math_atan2(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    sy = malloc(8)
    if JS_ToNumber(ctx, sy, argv_get(argv, 0)) != 0 { free(sy)  return jstag.JS_EXCEPTION }
    float y = mem.get_float64(sy, 0)
    if JS_ToNumber(ctx, sy, argv_get(argv, 1)) != 0 { free(sy)  return jstag.JS_EXCEPTION }
    float x = mem.get_float64(sy, 0)
    free(sy)
    return JS_NewFloat64(ctx, js_atan2(y, x))
}

// JSValue js_math_pow(ctx, this_val, argc, argv)
js_math_pow(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    s = malloc(8)
    if JS_ToNumber(ctx, s, argv_get(argv, 0)) != 0 { free(s)  return jstag.JS_EXCEPTION }
    float x = mem.get_float64(s, 0)
    if JS_ToNumber(ctx, s, argv_get(argv, 1)) != 0 { free(s)  return jstag.JS_EXCEPTION }
    float y = mem.get_float64(s, 0)
    free(s)
    return JS_NewFloat64(ctx, js_pow(x, y))
}

// JSValue js_math_random(ctx, this_val, argc, argv)
// v = xorshift64star(&ctx->random_state); d = uint64_as_float64(
//   (0x3ff << 52) | (v >> 12)); return d - 1.0  (1.0 <= d < 2)
js_math_random(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    // &ctx->random_state — random_state @136 in JSContext
    rstate = mem.long_to_ptr(mem.ptr_to_long(ctx) + 136)
    long v = jsutil2.xorshift64star(rstate)
    long exp_base = 0x3ff       // force 64-bit before the shift
    long exp = exp_base << 52
    long frac = (v >> 12) & 0x000fffffffffffff   // logical >> 12, keep 52 bits
    float d = mem.float_from_bits(exp | frac)
    return JS_NewFloat64(ctx, d - 1.0)
}

// JSValue js_math_min_max(ctx, this_val, argc, argv, int magic)
// magic != 0 -> max, else min.
js_math_min_max(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long {
    int is_max = magic
    if argc == 0 {
        float inf = 1.0 / 0.0
        if is_max != 0 { inf = 0.0 - (1.0 / 0.0) }
        return JS_NewFloat64(ctx, inf)
    }

    float r = 0.0
    int i = 1
    int generic = 0

    long a0 = argv_get(argv, 0)
    if jstag.is_int(a0) != 0 {
        int r1 = jstag.get_int(a0)
        int broke = 0
        while i < argc {
            long ai = argv_get(argv, i)
            if jstag.is_int(ai) == 0 {
                r = r1
                broke = 1
                break
            }
            int a1 = jstag.get_int(ai)
            if is_max != 0 {
                if a1 > r1 { r1 = a1 }
            } else {
                if a1 < r1 { r1 = a1 }
            }
            i = i + 1
        }
        if broke == 0 {
            return jstag.new_short_int(r1)
        }
        generic = 1
    } else {
        s = malloc(8)
        if JS_ToNumber(ctx, s, a0) != 0 { free(s)  return jstag.JS_EXCEPTION }
        r = mem.get_float64(s, 0)
        free(s)
        i = 1
        generic = 1
    }

    // generic case: r holds the running result, scan from i
    slot = malloc(8)
    while i < argc {
        if JS_ToNumber(ctx, slot, argv_get(argv, i)) != 0 { free(slot)  return jstag.JS_EXCEPTION }
        float a = mem.get_float64(slot, 0)
        if f_isnan(r) == 0 {
            if f_isnan(a) != 0 {
                r = a
            } else {
                if is_max != 0 { r = jshelpers.js_fmax(r, a) }
                else { r = jshelpers.js_fmin(r, a) }
            }
        }
        i = i + 1
    }
    free(slot)
    return JS_NewFloat64(ctx, r)
}

// find_own_property + expand_short_float ported from mquickjs.c.
// find_own_property delegates to the inlined own-property lookup;
// expand_short_float boxes an inline short-float value into a heap
// JSFloat64 (header + dval@8). Provides the bare C symbols; C bodies
// removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern find_own_property_inlined(ctx: ptr, p: ptr, prop: long) -> ptr
extern js_malloc(ctx: ptr, size: int, mtag: int) -> ptr
extern js_get_short_float(val: long) -> float

exports (find_own_property, expand_short_float)


// JSProperty *find_own_property(JSContext *ctx, JSObject *p, JSValue prop)
find_own_property(ctx: ptr, p: ptr, prop: long) -> ptr {
    return find_own_property_inlined(ctx, p, prop)
}

// int expand_short_float(JSContext *ctx, JSValue *pval)
expand_short_float(ctx: ptr, pval: ptr) -> int {
    long v = mem.get_long(pval, 0)
    if (v & 7) == 5 {   // JS_IsShortFloat
        f = js_malloc(ctx, consts.SIZEOF_JSFLOAT64, consts.JS_MTAG_FLOAT64)
        if f == null { return 0 - 1 }
        mem.set_float64(f, consts.JSFLOAT64_DVAL, js_get_short_float(v))
        mem.set_long(pval, 0, jstag.value_from_ptr(f))
    }
    return 0
}

// Function + Date builtins ported from mquickjs.c: Function.prototype
// .call (tail-call dispatch), the prototype setter, and Date.valueOf.
// Provides the bare C symbols; C bodies removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_IsFunctionObject(ctx: ptr, val: long) -> int
extern JS_DefinePropertyValue(ctx: ptr, obj: long, prop: long, val: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long
extern js_get_object_class(ctx: ptr, val: long, class_id: int) -> ptr
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern js_regexp_exec(ctx: ptr, this_val: ptr, argc: int, argv: ptr, magic: int) -> long

exports (js_function_call, js_function_set_prototype, js_date_valueOf, js_function_apply, js_string_search)

const JS_MAX_ARGC = 65535
const MAGIC_REGEXP_SEARCH = 2
const JS_ATOM_prototype = 130
const TAG_EXCEPTION = 15
const JS_EX_CALL = 1

argv_get(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// JS_NewTailCall(val) = make_special(TAG_EXCEPTION, JS_EX_CALL + val)
new_tail_call(val: int) -> long {
    return jstag.make_special(TAG_EXCEPTION, JS_EX_CALL + val)
}

// JSValue js_function_call(ctx, this_val, argc, argv)
js_function_call(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    int a = argc
    if a < 1 { a = 1 }   // max_int(argc, 1)
    if JS_StackCheck(ctx, a + 1) != 0 { return jstag.JS_EXCEPTION }
    int i = 0
    while i < (a - 1) {
        JS_PushArg(ctx, argv_get(argv, a - 1 - i))
        i = i + 1
    }
    JS_PushArg(ctx, mem.get_long(this_val, 0))
    JS_PushArg(ctx, argv_get(argv, 0))
    return new_tail_call(a - 1)
}

// JSValue js_function_set_prototype(ctx, this_val, argc, argv)
js_function_set_prototype(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    if JS_IsFunctionObject(ctx, tv) == 0 {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a function")
    }
    JS_DefinePropertyValue(ctx, tv, js_get_atom(ctx, JS_ATOM_prototype), argv_get(argv, 0))
    return jstag.JS_UNDEFINED
}

// JSValue js_date_valueOf(ctx, this_val, argc, argv)
js_date_valueOf(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    long tv = mem.get_long(this_val, 0)
    p = js_get_object_class(ctx, tv, consts.JS_CLASS_DATE)
    if p == null {
        return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not a Date object")
    }
    // JSDate.dval at union offset 24 (double @ union+0)
    float d = mem.get_float64(mem.long_to_ptr(mem.ptr_to_long(p) + mqtypes.OFFSETOF_JSOBJECT_U), 0)
    return JS_NewFloat64(ctx, d)
}

// JSValue js_function_apply(ctx, this_val, argc, argv)
js_function_apply(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    p = js_get_object_class(ctx, argv_get(argv, 1), consts.JS_CLASS_ARRAY)
    if p == null { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not an array") }
    long u = mem.ptr_to_long(p) + mqtypes.OFFSETOF_JSOBJECT_U
    int len = mem.get_uint32(mem.long_to_ptr(u), 8)
    if len > JS_MAX_ARGC { return JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "too many call arguments") }
    if JS_StackCheck(ctx, len + 2) != 0 { return jstag.JS_EXCEPTION }
    // re-fetch
    p = jstag.value_to_ptr(argv_get(argv, 1))
    u = mem.ptr_to_long(p) + mqtypes.OFFSETOF_JSOBJECT_U
    arr = jstag.value_to_ptr(mem.get_long(mem.long_to_ptr(u), 0))
    long tail = mem.ptr_to_long(arr) + 8
    int i = 0
    while i < len {
        JS_PushArg(ctx, mem.get_long(mem.long_to_ptr(tail + (len - 1 - i) * 8), 0))
        i = i + 1
    }
    JS_PushArg(ctx, mem.get_long(this_val, 0))
    JS_PushArg(ctx, argv_get(argv, 0))
    return new_tail_call(len)
}

// JSValue js_string_search(ctx, this_val, argc, argv)
// = js_regexp_exec(ctx, &argv[0], 1, this_val, MAGIC_REGEXP_SEARCH)
js_string_search(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    // &argv[0] is the address of the first argv slot (the regexp)
    return js_regexp_exec(ctx, argv, 1, this_val, MAGIC_REGEXP_SEARCH)
}

// JS_Run ported from mquickjs.c: execute a compiled top-level bytecode
// function. Validates that `val` is a function-bytecode block, wraps it in a
// closure, GC-roots it across a stack check, then invokes it with (closure,
// this=null) through JS_Call. Throws a TypeError if `val` is not bytecode.
// Provides the bare C symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_closure(ctx: ptr, bfunc: long, fp: ptr) -> long
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_Call(ctx: ptr, call_flags: int) -> long
extern js_throw_bytecode_expected(ctx: ptr) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (JS_Run)


run_mtag(p: ptr) -> int { return (mem.get_long(p, 0) >> 1) & 7 }

// JSValue JS_Run(JSContext *ctx, JSValue val)
JS_Run(ctx: ptr, val: long) -> long {
    int ok = 0
    if jstag.is_ptr(val) != 0 {
        b = jstag.value_to_ptr(val)
        if run_mtag(b) == consts.JS_MTAG_FUNCTION_BYTECODE { ok = 1 }
    }
    if ok == 0 { return js_throw_bytecode_expected(ctx) }

    val = js_closure(ctx, val, mem.long_to_ptr(0))
    if jstag.is_exception(val) != 0 { return val }

    // GC-root val across the stack check
    ref = malloc(16)
    mem.set_long(ref, 0, val)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    int err = JS_StackCheck(ctx, 2)
    val = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)
    if err != 0 { return jstag.JS_EXCEPTION }

    JS_PushArg(ctx, val)
    JS_PushArg(ctx, jstag.JS_NULL)
    val = JS_Call(ctx, 0)
    return val
}

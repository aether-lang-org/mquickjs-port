// The 'in' operator slow path ported from mquickjs.c: js_operator_in
// checks that the right operand (sp[0]) is an object, coerces the left
// (sp[1]) to a property key, and tests membership. Provides the bare C
// symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes

extern js_eq_get_type(ctx: ptr, val: long) -> int
extern JS_ToPropertyKey(ctx: ptr, val: long) -> long
extern JS_HasProperty(ctx: ptr, obj: long, prop: long) -> int
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern JS_IsFunctionObject(ctx: ptr, val: long) -> int
extern JS_IsObject(ctx: ptr, val: long) -> int
extern JS_GetProperty(ctx: ptr, obj: long, prop: long) -> long
extern js_get_atom(ctx: ptr, a: int) -> long

extern JS_IsFunction(ctx: ptr, val: long) -> int
extern js_strict_eq(ctx: ptr, op1: long, op2: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_ToPrimitive(ctx: ptr, val: long, hint: int) -> long
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_operator_in, js_operator_instanceof, js_operator_typeof, js_eq_slow)

const JS_ETAG_NUMBER = 35   // SPECIAL | (8 << 2)
const JS_ETAG_STRING = 39   // SPECIAL | (9 << 2)
const JS_ETAG_OBJECT = 43   // JS_TAG_SPECIAL | (10 << 2)
const JS_TAG_BOOL = 3
const JS_TAG_NULL = 7
const JS_CLASS_TYPE_ERROR = 14
const JSCTX_SP = 32
const JS_ATOM_prototype = 130
const JS_ATOM_function = 54
const JS_ATOM_number = 104
const JS_ATOM_object = 106
const JS_ATOM_undefined = 108
const JS_ATOM_string = 111
const JS_ATOM_boolean = 113
const JS_TAG_UNDEFINED = 11
const HINT_NONE = 1

sp_set(ctx: ptr, i: int, v: long) {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_SP))
    mem.set_long(mem.long_to_ptr(sp + i * 8), 0, v)
}

sp_at(ctx: ptr, i: int) -> long {
    long sp = mem.ptr_to_long(mem.get_ptr(ctx, JSCTX_SP))
    return mem.get_long(mem.long_to_ptr(sp + i * 8), 0)
}

// JSValue js_operator_in(JSContext *ctx)
js_operator_in(ctx: ptr) -> long {
    if js_eq_get_type(ctx, sp_at(ctx, 0)) != JS_ETAG_OBJECT {
        return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "invalid 'in' operand")
    }
    long prop = JS_ToPropertyKey(ctx, sp_at(ctx, 1))
    if jstag.is_exception(prop) != 0 { return prop }
    int res = JS_HasProperty(ctx, sp_at(ctx, 0), prop)
    return jstag.new_bool(res)
}

// JSValue js_operator_instanceof(JSContext *ctx)
js_operator_instanceof(ctx: ptr) -> long {
    long op1 = sp_at(ctx, 1)
    long op2 = sp_at(ctx, 0)
    if JS_IsFunctionObject(ctx, op2) == 0 {
        return JS_ThrowError(ctx, JS_CLASS_TYPE_ERROR, "invalid 'instanceof' right operand")
    }
    long proto = JS_GetProperty(ctx, op2, js_get_atom(ctx, JS_ATOM_prototype))
    if jstag.is_exception(proto) != 0 { return proto }
    if JS_IsObject(ctx, op1) == 0 { return jstag.new_bool(0) }
    long p = mem.ptr_to_long(jstag.value_to_ptr(op1))
    int looping = 1
    while looping != 0 {
        long pproto = mem.get_long(mem.long_to_ptr(p), 8)   // p->proto @8
        if pproto == jstag.JS_NULL { return jstag.new_bool(0) }
        if pproto == proto { return jstag.new_bool(1) }
        p = mem.ptr_to_long(jstag.value_to_ptr(pproto))
    }
    return jstag.new_bool(0)
}

// JSValue js_operator_typeof(JSContext *ctx, JSValue val)
js_operator_typeof(ctx: ptr, val: long) -> long {
    int tag = js_eq_get_type(ctx, val)
    int atom = JS_ATOM_undefined
    if tag == JS_ETAG_NUMBER { atom = JS_ATOM_number }
    else if tag == JS_ETAG_STRING { atom = JS_ATOM_string }
    else if tag == JS_TAG_BOOL { atom = JS_ATOM_boolean }
    else if tag == JS_ETAG_OBJECT {
        if JS_IsFunction(ctx, val) != 0 { atom = JS_ATOM_function }
        else { atom = JS_ATOM_object }
    } else if tag == JS_TAG_NULL { atom = JS_ATOM_object }
    else { atom = JS_ATOM_undefined }
    return js_get_atom(ctx, atom)
}

// JSValue js_eq_slow(JSContext *ctx, BOOL is_neq) : abstract (==) equality
js_eq_slow(ctx: ptr, is_neq: int) -> long {
    int res = 0
    int done = 0
    while done == 0 {
        long op1 = sp_at(ctx, 1)
        long op2 = sp_at(ctx, 0)
        int t1 = js_eq_get_type(ctx, op1)
        int t2 = js_eq_get_type(ctx, op2)
        if t1 == t2 {
            res = js_strict_eq(ctx, op1, op2)
            done = 1
        } else if nullundef(t1, t2) != 0 {
            res = 1  done = 1
        } else if strnum(t1, t2) != 0 {
            pa = malloc(8)  pb = malloc(8)
            if JS_ToNumber(ctx, pa, op1) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
            if JS_ToNumber(ctx, pb, op2) != 0 { free(pa)  free(pb)  return jstag.JS_EXCEPTION }
            float d1 = mem.get_float64(pa, 0)
            float d2 = mem.get_float64(pb, 0)
            free(pa)  free(pb)
            if d1 == d2 { res = 1 }
            done = 1
        } else if t1 == JS_TAG_BOOL {
            sp_set(ctx, 1, jstag.new_short_int(op1 >> 5))   // GET_SPECIAL_VALUE
        } else if t2 == JS_TAG_BOOL {
            sp_set(ctx, 0, jstag.new_short_int(op2 >> 5))
        } else if t1 == JS_ETAG_OBJECT {
            if t2 == JS_ETAG_NUMBER { res = obj_to_prim(ctx, 1, op1) }
            else if t2 == JS_ETAG_STRING { res = obj_to_prim(ctx, 1, op1) }
            else { res = 0  done = 1 }
            if done == 0 { if exc_pending(ctx, 1) != 0 { return jstag.JS_EXCEPTION } }
        } else if t2 == JS_ETAG_OBJECT {
            if t1 == JS_ETAG_NUMBER { res = obj_to_prim(ctx, 0, op2) }
            else if t1 == JS_ETAG_STRING { res = obj_to_prim(ctx, 0, op2) }
            else { res = 0  done = 1 }
            if done == 0 { if exc_pending(ctx, 0) != 0 { return jstag.JS_EXCEPTION } }
        } else {
            res = 0  done = 1
        }
    }
    return jstag.new_bool(res ^ is_neq)
}

// coerce sp[i] to a primitive in place; returns 0 (caller re-loops).
obj_to_prim(ctx: ptr, i: int, v: long) -> int {
    sp_set(ctx, i, JS_ToPrimitive(ctx, v, HINT_NONE))
    return 0
}
exc_pending(ctx: ptr, i: int) -> int {
    if jstag.is_exception(sp_at(ctx, i)) != 0 { return 1 }
    return 0
}
nullundef(t1: int, t2: int) -> int {
    if t1 == JS_TAG_NULL { if t2 == JS_TAG_UNDEFINED { return 1 } }
    if t2 == JS_TAG_NULL { if t1 == JS_TAG_UNDEFINED { return 1 } }
    return 0
}
strnum(t1: int, t2: int) -> int {
    if t1 == JS_ETAG_STRING { if t2 == JS_ETAG_NUMBER { return 1 } }
    if t2 == JS_ETAG_STRING { if t1 == JS_ETAG_NUMBER { return 1 } }
    return 0
}

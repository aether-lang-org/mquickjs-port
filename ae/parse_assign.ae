// The upper expression ladder ported from mquickjs.c:
// js_parse_logical_and_or, js_parse_cond_expr, js_parse_assign_expr,
// js_parse_expr_comma. These are co-routine-style parse functions
// driven by js_parse_call: each takes (s, st, parse_flags) and
// returns an encoded st|(func<<8)|(param<<16) at every sub-call
// point so the driver can resume it. The C goto-after-return machinery
// (PARSE_START/PARSE_CALL) is re-expressed as a switch on `st` with
// saved locals popped on re-entry. Provides the bare C symbols.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts
import ae.emit
import ae.put

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern js_parse_push_val(s: ptr, val: long)
extern js_parse_pop_val(s: ptr) -> long
extern next_token(s: ptr)
extern js_parse_expect(s: ptr, ch: int)
extern new_label(s: ptr) -> long
extern get_lvalue(s: ptr, popcode: ptr, pvar_idx: ptr, psource_pos: ptr, keep: int)

exports (js_parse_logical_and_or, js_parse_cond_expr,
         js_parse_assign_expr, js_parse_expr_comma)







// token.val @8, token.source_pos @12, dropped_result @37, last_opcode_pos @92
tok_val(s: ptr) -> int { return mem.get_int(s, 8) }
tok_source_pos(s: ptr) -> int { return mem.get_uint32(s, 12) }
set_dropped(s: ptr, v: int) { mem.set_byte(s, 37, v) }
get_dropped(s: ptr) -> int { return mem.get_byte(s, 37) }

push_int(s: ptr, v: int) { js_parse_push_val(s, jstag.new_short_int(v)) }
pop_int(s: ptr) -> int { return jstag.get_int(js_parse_pop_val(s)) }

// encode a PARSE_CALL: st | (fn << 8) | (param << 16)
enc(cur_state: int, fn: int, param: int) -> int {
    return cur_state | (fn << 8) | (param << 16)
}

may_drop_result(s: ptr, parse_flags: int) -> int {
    if (parse_flags & consts.PF_DROP) == 0 { return 0 }
    int v = tok_val(s)
    if v == 59 { return 1 }   // ';'
    if v == 41 { return 1 }   // ')'
    if v == 44 { return 1 }   // ','
    return 0
}

// int js_parse_logical_and_or(JSParseState *s, int st, int parse_flags)
js_parse_logical_and_or(s: ptr, st: int, parse_flags: int) -> int {
    long label1 = jstag.JS_NULL
    int level = 0
    int op = 0

    if st == consts.PARSE_STATE_INIT {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 0 {
            // PARSE_CALL(s, 0, js_parse_expr_binary, (pf & ~MASK) | (8<<SHIFT))
            return enc(0, consts.PARSE_FUNC_expr_binary, (parse_flags & (0 - 1 - consts.PF_LEVEL_MASK)) | (8 << consts.PF_LEVEL_SHIFT))
        }
        // PARSE_CALL_SAVE1(s, 1, logical_and_or, pf - (1<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    if st == 0 {
        return consts.PARSE_STATE_RET
    }

    if st == 1 {
        parse_flags = pop_int(s)
    } else {
        // st == 2: resume inside the for-loop after the recursive call.
        // SAVE1 pushed parse_flags last (after PUSH_VAL label1), so pop
        // parse_flags first, then label1.
        parse_flags = pop_int(s)
        label1 = js_parse_pop_val(s)
    }

    if st == 1 {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 1 { op = consts.TOK_LAND } else { op = consts.TOK_LOR }
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
        if tok_val(s) != op { return consts.PARSE_STATE_RET }
        label1 = new_label(s)
        // enter loop body
        next_token(s)
        emit.emit_op(s, opcodes.OP_dup)
        int g = opcodes.OP_if_true
        if op == consts.TOK_LAND { g = opcodes.OP_if_false }
        label1 = emit_goto_val(s, g, label1)
        emit.emit_op(s, opcodes.OP_drop)
        js_parse_push_val(s, label1)
        push_int(s, parse_flags)
        return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    // st == 2 loop continuation
    int looping = 1
    while looping != 0 {
        level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 1 { op = consts.TOK_LAND } else { op = consts.TOK_LOR }
        if tok_val(s) != op { looping = 0 }
        else {
            next_token(s)
            emit.emit_op(s, opcodes.OP_dup)
            int g = opcodes.OP_if_true
            if op == consts.TOK_LAND { g = opcodes.OP_if_false }
            label1 = emit_goto_val(s, g, label1)
            emit.emit_op(s, opcodes.OP_drop)
            js_parse_push_val(s, label1)
            push_int(s, parse_flags)
            return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
        }
    }
    label1 = emit_label_val(s, label1)
    return consts.PARSE_STATE_RET
}

// emit.emit_goto / emit.emit_label take JSValue* and may mutate the label
// (backpatch-chain head / resolved flag). Return the updated value.
emit_goto_val(s: ptr, opcode: int, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit.emit_goto(s, opcode, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}
emit_label_val(s: ptr, label: long) -> long {
    slot = malloc(8)
    mem.set_long(slot, 0, label)
    emit.emit_label(s, slot)
    long out = mem.get_long(slot, 0)
    free(slot)
    return out
}

// int js_parse_cond_expr(JSParseState *s, int st, int parse_flags)
js_parse_cond_expr(s: ptr, st: int, parse_flags: int) -> int {
    long label1 = jstag.JS_NULL
    long label2 = jstag.JS_NULL

    if st == consts.PARSE_STATE_INIT {
        // PARSE_CALL_SAVE1(s, 2, logical_and_or, pf | (2<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(2, consts.PARSE_FUNC_logical_and_or, parse_flags | (2 << consts.PF_LEVEL_SHIFT))
    }

    if st == 2 {
        parse_flags = pop_int(s)
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
        if tok_val(s) != 63 { return consts.PARSE_STATE_RET }   // '?'
        next_token(s)
        label1 = new_label(s)
        label1 = emit_goto_val(s, opcodes.OP_if_false, label1)
        js_parse_push_val(s, label1)
        push_int(s, parse_flags)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    if st == 0 {
        parse_flags = pop_int(s)
        label1 = js_parse_pop_val(s)
        label2 = new_label(s)
        label2 = emit_goto_val(s, opcodes.OP_goto, label2)
        js_parse_expect(s, 58)   // ':'
        label1 = emit_label_val(s, label1)
        js_parse_push_val(s, label2)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    // st == 1
    parse_flags = pop_int(s)
    label2 = js_parse_pop_val(s)
    label2 = emit_label_val(s, label2)
    return consts.PARSE_STATE_RET
}

// int js_parse_assign_expr(JSParseState *s, int st, int parse_flags)
js_parse_assign_expr(s: ptr, st: int, parse_flags: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        // PARSE_CALL_SAVE1(s, 1, cond_expr, parse_flags, parse_flags)
        push_int(s, parse_flags)
        return enc(1, consts.PARSE_FUNC_cond_expr, parse_flags)
    }

    if st == 1 {
        parse_flags = pop_int(s)
        int op = tok_val(s)
        int is_assign = 0
        if op == 61 { is_assign = 1 }                          // '='
        if op >= consts.TOK_MUL_ASSIGN { if op <= consts.TOK_OR_ASSIGN { is_assign = 1 } }
        if is_assign == 0 { return consts.PARSE_STATE_RET }

        int op_source_pos = tok_source_pos(s)
        next_token(s)
        lv = malloc(12)
        int keep = 1
        if op == 61 { keep = 0 }
        get_lvalue(s, lv, mem.long_to_ptr(mem.ptr_to_long(lv) + 4), mem.long_to_ptr(mem.ptr_to_long(lv) + 8), keep)
        int opcode = mem.get_int(lv, 0)
        int var_idx = mem.get_int(lv, 4)
        int source_pos = mem.get_uint32(lv, 8)
        free(lv)

        // PARSE_CALL_SAVE6(s, 0, assign_expr, pf & ~consts.PF_DROP,
        //   op, opcode, var_idx, parse_flags, op_source_pos, source_pos)
        push_int(s, op)
        push_int(s, opcode)
        push_int(s, var_idx)
        push_int(s, parse_flags)
        push_int(s, op_source_pos)
        push_int(s, source_pos)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags & (0 - 1 - consts.PF_DROP))
    }

    // st == 0: restore 6 saved ints (reverse push order)
    int source_pos = pop_int(s)
    int op_source_pos = pop_int(s)
    parse_flags = pop_int(s)
    int var_idx = pop_int(s)
    int opcode = pop_int(s)
    int op = pop_int(s)

    if op != 61 {   // '='
        emit.emit_op_pos(s, assign_opcode(op), op_source_pos)
    }
    int special = consts.PUT_LVALUE_KEEP_TOP
    if may_drop_result(s, parse_flags) != 0 {
        special = consts.PUT_LVALUE_NOKEEP_TOP
        set_dropped(s, 1)
    }
    put.put_lvalue(s, opcode, var_idx, source_pos, special)
    return consts.PARSE_STATE_RET
}

// assign_opcodes[op - consts.TOK_MUL_ASSIGN]:
//   mul div mod add sub shl sar shr and xor or pow
assign_opcode(op: int) -> int {
    int i = op - consts.TOK_MUL_ASSIGN
    if i == 0 { return 71 }    // opcodes.OP_mul
    if i == 1 { return 72 }    // opcodes.OP_div
    if i == 2 { return 73 }    // opcodes.OP_mod
    if i == 3 { return 74 }    // opcodes.OP_add
    if i == 4 { return 75 }    // opcodes.OP_sub
    if i == 5 { return 77 }    // opcodes.OP_shl
    if i == 6 { return 78 }    // opcodes.OP_sar
    if i == 7 { return 79 }    // opcodes.OP_shr
    if i == 8 { return 90 }    // opcodes.OP_and
    if i == 9 { return 91 }    // opcodes.OP_xor
    if i == 10 { return 92 }   // opcodes.OP_or
    return 76                  // opcodes.OP_pow
}

// int js_parse_expr_comma(JSParseState *s, int st, int parse_flags)
js_parse_expr_comma(s: ptr, st: int, parse_flags: int) -> int {
    int comma = 0

    if st == consts.PARSE_STATE_INIT {
        set_dropped(s, 0)
        // PARSE_CALL_SAVE2(s, 0, assign_expr, parse_flags, comma, parse_flags)
        push_int(s, comma)
        push_int(s, parse_flags)
        return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
    }

    // st == 0
    parse_flags = pop_int(s)
    comma = pop_int(s)

    int looping = 1
    while looping != 0 {
        if comma != 0 {
            mem.set_int(s, 92, 0 - 1)   // s->last_opcode_pos = -1
        }
        if tok_val(s) != 44 { looping = 0 }   // ','
        else {
            comma = 1
            if get_dropped(s) == 0 { emit.emit_op(s, opcodes.OP_drop) }
            next_token(s)
            set_dropped(s, 0)
            push_int(s, comma)
            push_int(s, parse_flags)
            return enc(0, consts.PARSE_FUNC_assign_expr, parse_flags)
        }
    }
    if (parse_flags & consts.PF_DROP) != 0 {
        if get_dropped(s) == 0 { emit.emit_op(s, opcodes.OP_drop) }
    }
    return consts.PARSE_STATE_RET
}

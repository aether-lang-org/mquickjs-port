// Array helpers ported from mquickjs.c. js_get_array unwraps an array
// object (throwing if not one); js_array_buffer_alloc allocates an
// ArrayBuffer wrapping a zeroed byte array, GC-rooting the backing buffer
// across the wrapper-object allocation. Provides the bare C symbols.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.consts

extern js_get_object_class(ctx: ptr, val: long, class_id: int) -> ptr
extern js_alloc_byte_array(ctx: ptr, size: int) -> ptr
extern JS_NewObjectClass(ctx: ptr, class_id: int, extra_size: int) -> long
extern JS_ThrowError(ctx: ptr, error_num: int, fmt: ptr, ...) -> long
extern memset(dst: ptr, c: int, n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)

exports (js_get_array, js_array_buffer_alloc)

const JS_SHORTINT_MAX = 0x3fffffff
const SIZEOF_JSARRAYBUFFER = 8
const JSOBJ_ARRAYBUFFER_BYTEBUF = 24   // u.array_buffer.byte_buffer
const BA_BUF = 8

// JSObject *js_get_array(JSContext *ctx, JSValue obj)
js_get_array(ctx: ptr, obj: long) -> ptr {
    p = js_get_object_class(ctx, obj, consts.JS_CLASS_ARRAY)
    if p == null {
        JS_ThrowError(ctx, consts.JS_CLASS_TYPE_ERROR, "not an array")
        return null
    }
    return p
}

// JSValue js_array_buffer_alloc(JSContext *ctx, uint64_t len)
js_array_buffer_alloc(ctx: ptr, len: long) -> long {
    if len > JS_SHORTINT_MAX {
        return JS_ThrowError(ctx, consts.JS_CLASS_RANGE_ERROR, "invalid array buffer length")
    }
    int ilen = len
    arr = js_alloc_byte_array(ctx, ilen)
    if arr == null { return jstag.JS_EXCEPTION }
    memset(mem.long_to_ptr(mem.ptr_to_long(arr) + BA_BUF), 0, len)
    long buffer = jstag.value_from_ptr(arr)

    // GC-root buffer across JS_NewObjectClass
    ref = malloc(16)
    mem.set_ptr(ref, 8, mem.get_ptr(ctx, consts.JSCTX_TOP_GC_REF))
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, ref)
    mem.set_long(ref, 0, buffer)

    long obj = JS_NewObjectClass(ctx, consts.JS_CLASS_ARRAY_BUFFER, SIZEOF_JSARRAYBUFFER)

    buffer = mem.get_long(ref, 0)
    mem.set_ptr(ctx, consts.JSCTX_TOP_GC_REF, mem.get_ptr(ref, 8))
    free(ref)

    if jstag.is_exception(obj) != 0 { return obj }
    p = jstag.value_to_ptr(obj)
    mem.set_long(p, JSOBJ_ARRAYBUFFER_BYTEBUF, buffer)
    return obj
}

// Public API entry wrappers ported from mquickjs.c: JS_GC (full GC),
// JS_Parse (parse to a function) and JS_Eval (parse then run). Thin
// delegations to JS_GC2 / JS_Parse2 / JS_Run. Provides the bare C
// symbols; C bodies removed.

import std.mem
import ae.jstag

extern JS_GC2(ctx: ptr, keep_atoms: int)
extern JS_Parse2(ctx: ptr, source_str: long, input: ptr, input_len: long, filename: ptr, eval_flags: int) -> long
extern JS_Run(ctx: ptr, val: long) -> long

exports (JS_GC, JS_Parse, JS_Eval)

// void JS_GC(JSContext *ctx)
JS_GC(ctx: ptr) {
    JS_GC2(ctx, 1)
}

// JSValue JS_Parse(JSContext *ctx, const char *input, size_t input_len, const char *filename, int eval_flags)
JS_Parse(ctx: ptr, input: ptr, input_len: long, filename: ptr, eval_flags: int) -> long {
    return JS_Parse2(ctx, jstag.JS_NULL, input, input_len, filename, eval_flags)
}

// JSValue JS_Eval(JSContext *ctx, const char *input, size_t input_len, const char *filename, int eval_flags)
JS_Eval(ctx: ptr, input: ptr, input_len: long, filename: ptr, eval_flags: int) -> long {
    long val = JS_Parse(ctx, input, input_len, filename, eval_flags)
    if jstag.is_exception(val) != 0 { return val }
    return JS_Run(ctx, val)
}

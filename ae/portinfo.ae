// First Aether translation unit linked into the engine — proves the
// mixed C+Aether build path end to end before any engine logic moves
// across. Exports a single constant accessor; nothing depends on it
// yet, but linking it exercises aetherc --emit=lib + libaether.a in
// the real build.

export aether_linked

aether_linked() -> int {
    return 1
}

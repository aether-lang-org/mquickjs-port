// The binary-operator precedence climber ported from mquickjs.c:
// js_parse_expr_binary. A resumable parse function driven by
// js_parse_call: one PF_LEVEL per binary precedence band (1=* / %,
// 2=+ -, 3=shifts, 4=relational, 5=equality, 6=&, 7=^, 8=|). At each
// level it parses the next-tighter level, then folds left while the
// current token matches an operator at this level. The C goto-after-
// return state machine becomes a switch on the entry state with locals
// saved on / restored from the parser value stack. Provides the bare C
// symbol; C body removed.

import std.mem
import ae.jstag
import ae.mqtypes
import ae.opcodes
import ae.consts

extern js_parse_push_val(s: ptr, val: long)
extern js_parse_pop_val(s: ptr) -> long
extern next_token(s: ptr)
extern emit_op_pos(s: ptr, op: int, source_pos: int)

exports (js_parse_expr_binary)


const PARSE_FUNC_expr_binary = 4
const PARSE_FUNC_unary = 5




tok_val(s: ptr) -> int { return mem.get_int(s, 8) }
tok_source_pos(s: ptr) -> int { return mem.get_uint32(s, 12) }

push_int(s: ptr, v: int) { js_parse_push_val(s, jstag.new_short_int(v)) }
pop_int(s: ptr) -> int { return jstag.get_int(js_parse_pop_val(s)) }

enc(cur_state: int, fn: int, param: int) -> int {
    return cur_state | (fn << 8) | (param << 16)
}

// opcode for (level, op) or -1 if the token is not an operator here.
binary_opcode(level: int, op: int, parse_flags: int) -> int {
    if level == 1 {
        if op == 42 { return opcodes.OP_mul }    // '*'
        if op == 47 { return opcodes.OP_div }    // '/'
        if op == 37 { return opcodes.OP_mod }    // '%'
        return 0 - 1
    }
    if level == 2 {
        if op == 43 { return opcodes.OP_add }    // '+'
        if op == 45 { return opcodes.OP_sub }    // '-'
        return 0 - 1
    }
    if level == 3 {
        if op == consts.TOK_SHL { return opcodes.OP_shl }
        if op == consts.TOK_SAR { return opcodes.OP_sar }
        if op == consts.TOK_SHR { return opcodes.OP_shr }
        return 0 - 1
    }
    if level == 4 {
        if op == 60 { return opcodes.OP_lt }     // '<'
        if op == 62 { return opcodes.OP_gt }     // '>'
        if op == consts.TOK_LTE { return opcodes.OP_lte }
        if op == consts.TOK_GTE { return opcodes.OP_gte }
        if op == consts.TOK_INSTANCEOF { return opcodes.OP_instanceof }
        if op == consts.TOK_IN {
            if (parse_flags & consts.PF_NO_IN) == 0 { return opcodes.OP_in }
            return 0 - 1
        }
        return 0 - 1
    }
    if level == 5 {
        if op == consts.TOK_EQ { return opcodes.OP_eq }
        if op == consts.TOK_NEQ { return opcodes.OP_neq }
        if op == consts.TOK_STRICT_EQ { return opcodes.OP_strict_eq }
        if op == consts.TOK_STRICT_NEQ { return opcodes.OP_strict_neq }
        return 0 - 1
    }
    if level == 6 {
        if op == 38 { return opcodes.OP_and }    // '&'
        return 0 - 1
    }
    if level == 7 {
        if op == 94 { return opcodes.OP_xor }    // '^'
        return 0 - 1
    }
    if level == 8 {
        if op == 124 { return opcodes.OP_or }    // '|'
        return 0 - 1
    }
    return 0 - 1
}

// int js_parse_expr_binary(JSParseState *s, int state, int parse_flags)
js_parse_expr_binary(s: ptr, st: int, parse_flags: int) -> int {
    if st == consts.PARSE_STATE_INIT {
        int level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        if level == 0 {
            return enc(0, PARSE_FUNC_unary, parse_flags)
        }
        // PARSE_CALL_SAVE1(s, 1, expr_binary, pf - (1<<SHIFT), parse_flags)
        push_int(s, parse_flags)
        return enc(1, PARSE_FUNC_expr_binary, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
    }

    if st == 0 {
        return consts.PARSE_STATE_RET
    }

    if st == 1 {
        parse_flags = pop_int(s)
        parse_flags = parse_flags & (0 - 1 - consts.PF_DROP)
    } else {
        // st == 2: resume after the recursive fold call. SAVE3 pushed
        // parse_flags, opcode, op_source_pos; pop in reverse.
        int op_source_pos = pop_int(s)
        int opcode = pop_int(s)
        parse_flags = pop_int(s)
        emit_op_pos(s, opcode, op_source_pos)
    }

    int looping = 1
    while looping != 0 {
        int op = tok_val(s)
        int op_source_pos = tok_source_pos(s)
        int level = (parse_flags & consts.PF_LEVEL_MASK) >> consts.PF_LEVEL_SHIFT
        int opcode = binary_opcode(level, op, parse_flags)
        if opcode < 0 { looping = 0 }
        else {
            next_token(s)
            push_int(s, parse_flags)
            push_int(s, opcode)
            push_int(s, op_source_pos)
            return enc(2, PARSE_FUNC_expr_binary, parse_flags - (1 << consts.PF_LEVEL_SHIFT))
        }
    }
    return consts.PARSE_STATE_RET
}
